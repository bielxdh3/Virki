+// validateV53ReceiverIdentity requires all real, effective, and saved IDs to
+// match the supervisor-assigned nonroot identity. Checking only real/effective
+// IDs would let a receiver retain saved UID/GID 0 and regain those credentials
+// after the policy gate.
+func validateV53ReceiverIdentity(uid, euid, suid, gid, egid, sgid uint32, policy V24ReceiverCustodyPolicy) error {
+	if uid == 0 || euid == 0 || uid != euid || uid != suid ||
+		gid != egid || gid != sgid ||
+		euid != *policy.ExpectedReceiverUID || egid != *policy.ExpectedReceiverGID {
+		return errors.New("C1 V53 receiver real/effective/saved UID and GID must match supervisor policy")
+	}
+	return nil
+}
