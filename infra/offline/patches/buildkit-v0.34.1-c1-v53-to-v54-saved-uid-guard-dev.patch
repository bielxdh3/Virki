@@ -0,0 +1,32 @@
+//go:build linux && virki_c1c4_dev
+
+package filesync
+
+import "testing"
+
+func TestC1V54ReceiverIdentityRejectsSavedRootUIDGID(t *testing.T) {
+	policy := V24ReceiverCustodyPolicy{
+		ExpectedReceiverUID: v53UintPtr(v53ReceiverUID),
+		ExpectedReceiverGID: v53UintPtr(v53ReceiverUID),
+	}
+	cases := []struct {
+		name                             string
+		uid, euid, suid, gid, egid, sgid uint32
+		wantErr                          bool
+	}{
+		{name: "fully-dropped", uid: v53ReceiverUID, euid: v53ReceiverUID, suid: v53ReceiverUID, gid: v53ReceiverUID, egid: v53ReceiverUID, sgid: v53ReceiverUID},
+		{name: "saved-uid-root", uid: v53ReceiverUID, euid: v53ReceiverUID, suid: 0, gid: v53ReceiverUID, egid: v53ReceiverUID, sgid: v53ReceiverUID, wantErr: true},
+		{name: "saved-gid-root", uid: v53ReceiverUID, euid: v53ReceiverUID, suid: v53ReceiverUID, gid: v53ReceiverUID, egid: v53ReceiverUID, sgid: 0, wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := validateV53ReceiverIdentity(tc.uid, tc.euid, tc.suid, tc.gid, tc.egid, tc.sgid, policy)
+			if tc.wantErr && err == nil {
+				t.Fatal("V53 accepted a receiver retaining a privileged saved UID/GID")
+			}
+			if !tc.wantErr && err != nil {
+				t.Fatalf("fully dropped receiver rejected: %v", err)
+			}
+		})
+	}
+}
