+	for _, name := range localcontext.RequiredContextNames() {
+		root := loadCausalRoot(t, llbScratchCopyingLocals([]string{name}))
+		contextRoots[name] = root
+		contextSources[name] = findLoadedLocalSource(t, root.Vertex, name)
+		require.True(t, graphContainsDigest(root.Vertex, contextSources[name].Digest().String()))
+	}
+	unrelated := loadCausalRoot(t, llb.Scratch().File(llb.Mkfile("/unrelated", 0o644, []byte("unrelated exported image root"))))
+	for _, name := range localcontext.RequiredContextNames() {
