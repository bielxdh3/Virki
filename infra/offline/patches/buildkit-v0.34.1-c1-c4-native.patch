+			if err := ClaimRootIgnoreFileSyncV11(ctx); err == nil {
+				t.Fatal("root transfer admitted without canonical preferred ENOENT")
+			}
+		})
+	}
+}
diff --git a/util/localcontext/root_ignore_excludes_v11.go b/util/localcontext/root_ignore_excludes_v11.go
new file mode 100644
index 0000000..86d2d64
--- /dev/null
+++ b/util/localcontext/root_ignore_excludes_v11.go
@@ -0,0 +1,156 @@
+package localcontext
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"time"
+
+	"github.com/moby/patternmatcher/ignorefile"
+)
+
+// RootIgnoreExcludesProofV11 is an experimental diagnostic, NOT a release
+// receipt. It cannot authenticate the builtin frontend, owner C4, or host.
+type RootIgnoreExcludesProofV11 struct {
+	ContentSHA256    string `json:"contentSha256"`
+	PatternsSHA256   string `json:"patternsSha256"`
+	MainVertexDigest string `json:"mainVertexDigest"`
+}
+
+func HashRootIgnorePatternsV11(patterns []string) string {
+	// Distinguish the normalized ordered patterns, including inverse patterns;
+	// an empty slice always has the same unambiguous JSON encoding.
+	b, _ := json.Marshal(append([]string{}, patterns...))
+	h := sha256.Sum256(append([]byte("virki-c1-root-ignore-excludes-v11\x00"), b...))
+	return fmt.Sprintf("sha256:%x", h)
+}
+
+// BindParsedRootIgnoreV11 must be called by the builtin frontend AFTER it
+// successfully parsed the root ignore file and BEFORE constructing main COPY
+// local SourceOp. Re-parse original read bytes to prevent a self-consistent
+// but different parsed slice from being accepted. It is same-process evidence.
+func BindParsedRootIgnoreV11(ctx context.Context, selectedName string, original []byte, parsed []string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V11 no private scope for effective root ignore parsing")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if !scope.auth.BindRootIgnoreExcludesV11 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V11 effective excludes lack an approved root read or are replayed")
+	}
+	if pref := scope.auth.PreferredDockerignoreV12; pref != nil {
+		if !scope.preferredDockerignoreReadVerifiedV12 || selectedName != pref.Path ||
+			SHA256BytesV4(original) != pref.ContentSHA256 {
+			return errors.New("C1 V12 effective excludes differ from owner-selected preferred Dockerfile ignore")
+		}
+	} else if !scope.auxiliaryRootIgnoreReadVerifiedV10 || scope.auth.RootDockerignoreV10 == nil ||
+		selectedName != ".dockerignore" ||
+		SHA256BytesV4(original) != scope.auth.RootDockerignoreV10.ContentSHA256 {
+		return errors.New("C1 V11 effective excludes lack an approved root read or are replayed")
+	}
+	expected, err := ignorefile.ReadAll(bytes.NewReader(original))
+	if err != nil || !slices.Equal(expected, parsed) {
+		return errors.New("C1 V11 parsed ignore patterns differ from approved raw read")
+	}
+	if scope.rootIgnoreExcludesBoundV11 {
+		// Dockerfile2LLB calls DockerIgnorePatterns in dispatchStages and
+		// again when MainContext is constructed. Same approved bytes and parser
+		// result are idempotent; any divergent second call fails closed.
+		if !slices.Equal(scope.rootIgnoreExcludesV11, expected) {
+			return errors.New("C1 V11 repeated effective ignore parsing diverged")
+		}
+		return nil
+	}
+	scope.rootIgnoreExcludesV11 = slices.Clone(expected)
+	scope.rootIgnoreExcludesBoundV11 = true
+	return nil
+}
+
+// The real builtin main source remains local://context. A literal
+// local://source can be crafted directly by an untrusted LLB client and
+// cannot inherit the frontend's effective ignore event by name alone.
+func RefuseLiteralMainAliasV11(ctx context.Context) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V11 literal source alias lacks a private owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.auth.BindRootIgnoreExcludesV11 {
+		return errors.New("C1 V11 literal local://source is not the verified builtin main COPY source")
+	}
+	return nil
+}
+
+// RequireMainSourceExcludesV11 runs on all protected main context paths
+// BEFORE worker cache lookup or FileSync. The shape/attrs remain separate
+// from this comparison and are checked by canonicalOwnerContextNameV9.
+func RequireMainSourceExcludesV11(ctx context.Context, patterns []string, raw string, rawPresent bool) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V11 missing private scope for main source exclusions")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if !scope.auth.BindRootIgnoreExcludesV11 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) ||
+		!scope.rootIgnoreExcludesBoundV11 || !slices.Equal(scope.rootIgnoreExcludesV11, patterns) {
+		return errors.New("C1 V11 main source excludes differ from owner-approved parsed root ignore")
+	}
+	if len(patterns) == 0 {
+		if rawPresent {
+			return errors.New("C1 V11 main SourceOp declared noncanonical empty excludes")
+		}
+	} else {
+		canonical, err := json.Marshal(patterns)
+		if err != nil || !rawPresent || raw != string(canonical) {
+			return errors.New("C1 V11 main SourceOp excludes are not canonical builtin LLB attrs")
+		}
+	}
+	return nil
+}
+
+// RecordMainSourceExcludesV11 is called only after FSSync, snapshot Commit,
+// and verification against the committed worker tree. This prevents a mere
+// pre-transfer CacheKey from satisfying the one-use completion requirement.
+func RecordMainSourceExcludesV11(ctx context.Context, patterns []string, vertexDigest string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V11 missing private scope for committed source")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if !scope.auth.BindRootIgnoreExcludesV11 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) ||
+		!scope.rootIgnoreExcludesBoundV11 || scope.rootIgnoreMainMatchedV11 ||
+		!sha256Pattern.MatchString(vertexDigest) || !slices.Equal(scope.rootIgnoreExcludesV11, patterns) {
+		return errors.New("C1 V11 committed main source excludes are unbound or replayed")
+	}
+	scope.rootIgnoreMainMatchedV11 = true
+	scope.rootIgnoreMainVertexV11 = vertexDigest
+	return nil
+}
diff --git a/util/localcontext/root_ignore_excludes_v11_test.go b/util/localcontext/root_ignore_excludes_v11_test.go
