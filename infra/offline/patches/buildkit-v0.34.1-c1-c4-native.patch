+package builder
+
+import (
+	"testing"
+
+	"github.com/moby/buildkit/frontend/dockerfile/dockerfile2llb"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/stretchr/testify/require"
+)
+
+// This calls the REAL pinned Dockerfile2LLB conversion, not synthetic
+// definition hashes. It does not execute the generated LLB in a BuildKit
+// worker or assert any approval/publication authority.
+func TestC1BuiltinFrontendV4RealDockerfile2LLBEmptyScratchAndRootedRun(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		file       string
+		expectHead bool
+	}{
+		{name: "scratch metadata only", file: "FROM scratch\nLABEL marker=value\n", expectHead: false},
+		{name: "scratch with run", file: "FROM scratch\nRUN echo allowed\n", expectHead: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := t.Context()
+			events := localcontext.NewBuiltinFrontendEventsV4()
+			ctx = localcontext.WithBuiltinFrontendEventsV4(ctx, events)
+			data := []byte(tc.file)
+			require.NoError(t, localcontext.ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "Dockerfile", data))
+			converted, err := dockerfile2llb.Dockerfile2LLB(ctx, data, dockerfile2llb.ConvertOpt{})
+			require.NoError(t, err)
+			def, err := converted.State.Marshal(ctx)
+			require.NoError(t, err)
+			head, err := def.Head()
+			require.NoError(t, err)
+			require.Equal(t, tc.expectHead, head != "")
+			require.NoError(t, localcontext.ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", data, head.String()))
+			read, transform := events.SnapshotV4()
+			require.NotNil(t, read)
+			require.Equal(t, localcontext.SHA256BytesV4(data), read.ContentSHA256)
+			require.Equal(t, head.String(), transform["linux/amd64"].DefinitionHead)
+		})
+	}
+}
