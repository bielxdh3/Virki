+package llbsolver
+
+import (
+	"context"
+	"fmt"
+	"sort"
+
+	"github.com/moby/buildkit/cache"
+	"github.com/moby/buildkit/exporter"
+	"github.com/moby/buildkit/exporter/containerimage"
+	"github.com/moby/buildkit/exporter/containerimage/exptypes"
+	"github.com/moby/buildkit/frontend"
+	"github.com/moby/buildkit/solver"
+	"github.com/moby/buildkit/solver/result"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/moby/buildkit/worker"
+	"github.com/pkg/errors"
+)
+
+func validateLocalContextExporterRequest(scope *localcontext.SolveScope, exporters []exporter.ExporterInstance, cacheExporters []RemoteCacheExporter, enableSessionExporter bool) error {
+	if scope == nil {
+		return nil
+	}
+	if len(exporters) != 1 || len(cacheExporters) != 0 || enableSessionExporter {
+		return errors.New("C1 requires exactly one image exporter with no cache or session exporters")
+	}
+	exp := exporters[0]
+	if !containerimage.IsExporterInstance(exp) {
+		return errors.New("C1 exporter is not the concrete BuildKit containerimage exporter")
+	}
+	if !containerimage.IsNonPublishingExporterInstance(exp) {
+		return errors.New("C1 authorization remains pending: registry push, image tag/store, unpack and named exporters are prohibited before independent owner approval")
+	}
+	intent, err := localcontext.NewExporterIntent(exp.Type(), exp.ID(), exp.Attrs())
+	if err != nil {
+		return err
+	}
+	_, authorizedIntent, err := scope.ExporterPolicy()
+	if err != nil {
+		return err
+	}
+	if intent != authorizedIntent {
+		return errors.New("resolved BuildKit exporter differs from the owner-authorized image exporter")
+	}
+	return nil
+}
+
+func validateLocalContextFrontendMode(scope *localcontext.SolveScope, req frontend.SolveRequest) error {
+	if scope == nil {
+		return nil
+	}
+	if req.Frontend != "" || req.Definition == nil {
+		return errors.New("C1 frontend bridge is not yet authenticated: Dockerfile frontend and arbitrary gateway builds must not claim four-source export causality")
+	}
+	return nil
+}
+
+// Preflight the exact loaded graph BEFORE the anonymous content export. This
+// does not prove genuine Dockerfile frontend parsing (blocked above) nor
+// authorize publication. Descriptor validation still occurs after staging.
+func preflightLocalContextExport(ctx context.Context, scope *localcontext.SolveScope,
+	res *frontend.Result, cached *result.Result[solver.CachedResult], inp *exporter.Source) error {
+	if scope == nil {
+		return nil
+	}
+	workerID, _, contexts, err := scope.CausalInputs()
+	if err != nil {
+		return err
+	}
+	// C1 staging must bind platform IDs to EXACT resolved exporter refs before
+	// running any exporter. In particular do not permit FindRef's single-key
+	// fallback or a postprocessor platform->ref remap to go unnoticed.
+	selected, err := selectedLocalContextPlatformRootsV4(ctx, res, cached, inp, workerID)
+	if err != nil {
+		return err
+	}
+	if err := AssertV4SelectedPlatformOutputIdentity(selected, inp); err != nil {
+		return err
+	}
+	_, err = localContextRoots(ctx, res, cached, inp, workerID, contexts)
+	return err
+}
+
+func localContextOutputFromExport(
+	ctx context.Context,
+	scope *localcontext.SolveScope,
+	response map[string]string,
+	exporters []exporter.ExporterInstance,
+	descrefs []exporter.DescriptorReference,
+	res *frontend.Result,
+	cached *result.Result[solver.CachedResult],
+	inp *exporter.Source,
+) (*localcontext.Output, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, context.Cause(ctx)
+	}
+	if scope == nil || len(exporters) != 1 || len(descrefs) != 1 || descrefs[0] == nil {
+		return nil, errors.New("C1 requires one successful image exporter and exactly one typed output descriptor")
+	}
+	exp := exporters[0]
+	if !containerimage.IsExporterInstance(exp) {
+		return nil, errors.New("C1 exporter is not the concrete BuildKit containerimage exporter")
+	}
+	intent, err := localcontext.NewExporterIntent(exp.Type(), exp.ID(), exp.Attrs())
+	if err != nil {
+		return nil, err
+	}
+	workerID, authorizedIntent, contexts, err := scope.CausalInputs()
+	if err != nil {
+		return nil, err
+	}
+	if intent != authorizedIntent {
+		return nil, errors.New("resolved BuildKit exporter differs from the owner-authorized image exporter")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, context.Cause(ctx)
+	}
+
+	image, err := localContextImageDescriptor(response, descrefs[0])
+	if err != nil {
+		return nil, err
+	}
+
+	roots, err := localContextRoots(ctx, res, cached, inp, workerID, contexts)
+	if err != nil {
+		return nil, err
+	}
+	proof := localcontext.CausalityProof{
+		SchemaVersion: 3,
+		Exporter:      intent,
+		Roots:         roots,
+	}
+	proof.ProofDigest, err = localcontext.CausalityProofDigest(proof)
+	if err != nil {
+		return nil, err
+	}
+	ociDAG, err := localContextOCIDAGProof(image, response)
+	if err != nil {
+		return nil, err
+	}
+	return &localcontext.Output{
+		WorkerID:  workerID,
+		Image:     image,
+		Causality: proof,
+		OCIDAG:    ociDAG,
+	}, nil
+}
+
+func localContextOCIDAGProof(image localcontext.ImageDescriptor, response map[string]string) (*localcontext.OCIDAGProof, error) {
+	nodes := []localcontext.OCIDAGNode{
+		{
+			MediaType: image.MediaType,
+			Digest:    image.Digest,
+			Size:      image.Size,
+			Role:      "root",
+		},
+	}
+	if cfgDigest := response[exptypes.ExporterImageConfigDigestKey]; cfgDigest != "" {
+		nodes = append(nodes, localcontext.OCIDAGNode{
+			MediaType: "application/vnd.oci.image.config.v1+json",
+			Digest:    cfgDigest,
+			Role:      "config",
+		})
+	}
+	dag := &localcontext.OCIDAGProof{
+		SchemaVersion: 1,
+		Root:          image,
+		Nodes:         nodes,
+	}
+	digest, err := localcontext.OCIDAGProofDigest(*dag)
+	if err != nil {
+		return nil, err
+	}
+	dag.ProofDigest = digest
+	return dag, nil
+}
+
+func localContextImageDescriptor(response map[string]string, ref exporter.DescriptorReference) (localcontext.ImageDescriptor, error) {
+	if ref == nil {
+		return localcontext.ImageDescriptor{}, errors.New("C1 image exporter returned no typed output descriptor")
+	}
+	descriptor := ref.Descriptor()
+	if err := descriptor.Digest.Validate(); err != nil || descriptor.Digest.Algorithm().String() != "sha256" || descriptor.Size <= 0 {
+		return localcontext.ImageDescriptor{}, errors.New("BuildKit image exporter returned an invalid typed descriptor")
+	}
+	if got, ok := response[exptypes.ExporterImageDigestKey]; ok && got != descriptor.Digest.String() {
+		return localcontext.ImageDescriptor{}, errors.New("image exporter response conflicts with its typed descriptor reference")
+	}
+	return localcontext.ImageDescriptor{
+		MediaType: descriptor.MediaType,
+		Digest:    descriptor.Digest.String(),
+		Size:      descriptor.Size,
+	}, nil
+}
+
+func localContextRoots(
+	ctx context.Context,
+	res *frontend.Result,
+	cached *result.Result[solver.CachedResult],
+	inp *exporter.Source,
+	expectedWorker string,
+	contexts []localcontext.Consumption,
+) ([]localcontext.CausalRoot, error) {
+	if res == nil || cached == nil || inp == nil {
+		return nil, errors.New("C1 exporter is missing its resolved BuildKit result roots")
+	}
+	if len(res.Attestations) != 0 || len(cached.Attestations) != 0 || len(inp.Attestations) != 0 {
+		return nil, errors.New("C1 does not accept additional attestation roots in the image export result")
+	}
+	if len(res.Refs) != len(cached.Refs) || len(cached.Refs) != len(inp.Refs) {
+		return nil, errors.New("C1 image exporter result root maps have conflicting cardinality")
+	}
+	roots := make([]localcontext.CausalRoot, 0, 1+len(res.Refs))
+	if res.Ref != nil || cached.Ref != nil || inp.Ref != nil {
+		if res.Ref == nil || cached.Ref == nil || inp.Ref == nil {
+			return nil, errors.New("C1 single image root result is incomplete")
+		}
+		root, err := localContextRoot(ctx, res.Ref, cached.Ref, inp.Ref, expectedWorker, contexts)
+		if err != nil {
+			return nil, err
+		}
+		roots = append(roots, root)
+	}
+	for key, proxy := range res.Refs {
+		cachedRef, ok := cached.Refs[key]
+		if !ok {
+			return nil, fmt.Errorf("C1 image root %q is missing its cached solver result", key)
+		}
+		inputRef, ok := inp.Refs[key]
+		if !ok {
+			return nil, fmt.Errorf("C1 image root %q is missing its exporter input reference", key)
+		}
+		if proxy == nil || cachedRef == nil || inputRef == nil {
+			return nil, fmt.Errorf("C1 image root %q contains a nil solver result", key)
+		}
+		root, err := localContextRoot(ctx, proxy, cachedRef, inputRef, expectedWorker, contexts)
+		if err != nil {
+			return nil, fmt.Errorf("C1 image root %q: %w", key, err)
+		}
+		roots = append(roots, root)
+	}
+	if len(roots) == 0 {
+		return nil, errors.New("C1 image exporter has no resolved image root")
+	}
+	sort.Slice(roots, func(i, j int) bool {
+		if roots[i].RefID != roots[j].RefID {
+			return roots[i].RefID < roots[j].RefID
+		}
+		if roots[i].VertexDigest != roots[j].VertexDigest {
+			return roots[i].VertexDigest < roots[j].VertexDigest
+		}
+		return roots[i].OutputIndex < roots[j].OutputIndex
+	})
+	return roots, nil
+}
+
+func localContextRoot(
+	ctx context.Context,
+	proxy solver.ResultProxy,
+	cached solver.CachedResult,
+	input cache.ImmutableRef,
+	expectedWorker string,
+	contexts []localcontext.Consumption,
+) (localcontext.CausalRoot, error) {
+	if proxy == nil || cached == nil || input == nil {
+		return localcontext.CausalRoot{}, errors.New("C1 image root has a missing solver or exporter reference")
+	}
+	proxyResult, err := proxy.Result(ctx)
+	if err != nil {
+		return localcontext.CausalRoot{}, err
+	}
+	if proxyResult == nil || proxyResult.ID() != cached.ID() {
+		return localcontext.CausalRoot{}, errors.New("C1 image root changed between ResultProxy and exporter resolution")
+	}
+	workerRef, ok := proxyResult.Sys().(*worker.WorkerRef)
+	if !ok || workerRef.Worker == nil || workerRef.ImmutableRef == nil {
+		return localcontext.CausalRoot{}, errors.Errorf("C1 image root has unsupported worker result %T", proxyResult.Sys())
+	}
+	cachedWorkerRef, ok := cached.Sys().(*worker.WorkerRef)
+	if !ok || cachedWorkerRef == nil || cachedWorkerRef.ID() != workerRef.ID() {
+		return localcontext.CausalRoot{}, errors.New("C1 worker reference changed between solver and exporter results")
+	}
+	if workerRef.Worker.ID() != expectedWorker || workerRef.ImmutableRef.ID() != input.ID() {
+		return localcontext.CausalRoot{}, errors.New("C1 exported root belongs to a replacement worker or immutable reference")
+	}
+	rootProvider, ok := proxy.(interface {
+		RootEdge() (solver.Edge, bool)
+	})
+	if !ok {
+		return localcontext.CausalRoot{}, errors.Errorf("C1 image result %T does not expose its actual loaded solver root", proxy)
+	}
+	edge, ok := rootProvider.RootEdge()
+	if !ok || edge.Vertex == nil || edge.Index < 0 {
+		return localcontext.CausalRoot{}, errors.New("C1 image result has no actual loaded solver root edge")
+	}
+	root := localcontext.CausalRoot{
+		WorkerID:     workerRef.Worker.ID(),
+		RefID:        workerRef.ImmutableRef.ID(),
+		VertexDigest: edge.Vertex.Digest().String(),
+		OutputIndex:  int(edge.Index),
+	}
+	for _, record := range contexts {
+		path, err := localContextPath(edge, record)
+		if err != nil {
+			return localcontext.CausalRoot{}, err
+		}
+		root.ContextPaths = append(root.ContextPaths, path)
+	}
+	return root, nil
+}
+
+func localContextPath(root solver.Edge, record localcontext.Consumption) (localcontext.ContextPath, error) {
+	path := localcontext.ContextPath{
+		Name:               record.Name,
+		Generation:         record.Generation,
+		ContextIdentity:    record.ContextIdentity,
+		SnapshotID:         record.SnapshotID,
+		TreeDigest:         record.TreeDigest,
+		SourceVertexDigest: record.VertexDigest,
+		SourceOutputIndex:  record.VertexOutputIndex,
+	}
+	var visit func(solver.Vertex, int, []localcontext.CausalEdge, map[string]struct{}) ([]localcontext.CausalEdge, bool, error)
+	visit = func(vertex solver.Vertex, outputIndex int, edges []localcontext.CausalEdge, ancestors map[string]struct{}) ([]localcontext.CausalEdge, bool, error) {
+		if vertex == nil {
+			return nil, false, nil
+		}
+		digest := vertex.Digest().String()
+		if digest == record.VertexDigest {
+			return edges, outputIndex == record.VertexOutputIndex, nil
+		}
+		if _, cycle := ancestors[digest]; cycle {
+			return nil, false, errors.Errorf("BuildKit solver graph contains a cycle at %s", digest)
+		}
+		ancestors[digest] = struct{}{}
+		defer delete(ancestors, digest)
+		for inputIndex, input := range vertex.Inputs() {
+			if input.Vertex == nil {
+				return nil, false, errors.Errorf("BuildKit vertex %s has a nil input edge", digest)
+			}
+			childDigest := input.Vertex.Digest().String()
+			edge := localcontext.CausalEdge{
+				ParentVertexDigest: digest,
+				ParentOutputIndex:  outputIndex,
+				ParentInputIndex:   inputIndex,
+				ChildVertexDigest:  childDigest,
+				ChildOutputIndex:   int(input.Index),
+			}
+			candidate := append(append([]localcontext.CausalEdge(nil), edges...), edge)
+			found, ok, err := visit(input.Vertex, int(input.Index), candidate, ancestors)
+			if err != nil || ok {
+				return found, ok, err
+			}
+		}
+		return nil, false, nil
+	}
+	edges, found, err := visit(root.Vertex, int(root.Index), nil, make(map[string]struct{}))
+	if err != nil {
+		return localcontext.ContextPath{}, err
+	}
+	if !found {
+		return localcontext.ContextPath{}, fmt.Errorf("exported BuildKit root %s has no solver input path to approved %q source vertex %s output %d", root.Vertex.Digest(), record.Name, record.VertexDigest, record.VertexOutputIndex)
+	}
+	path.Edges = edges
+	return path, nil
+}
