@@ -0,0 +1,244 @@
+package localcontext
+
+import (
+	"context"
+	"io/fs"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/moby/patternmatcher/ignorefile"
+)
+
+type v11OwnerFixture struct{ v10AuxOwnerFixture }
+
+func (f *v11OwnerFixture) Begin(ctx context.Context, binding Binding) (Authorization, error) {
+	a, err := f.v10AuxOwnerFixture.Begin(ctx, binding)
+	a.BindRootIgnoreExcludesV11 = true
+	return a, err
+}
+
+func v11Fixture(t *testing.T, data []byte, present bool) (context.Context, *Manager, *SolveScope, *v11OwnerFixture, Consumption, BuiltinLoadedRefV6) {
+	t.Helper()
+	a := v10Approval(present)
+	if present {
+		a.ContentSHA256 = SHA256BytesV4(data)
+	}
+	service := &v11OwnerFixture{v10AuxOwnerFixture: v10AuxOwnerFixture{approval: a}}
+	m, err := NewManager(service, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := m.BeginSolve(t.Context(), testBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	entryCount := 0
+	if present {
+		entryCount = 1
+	}
+	record := Consumption{Name: RootDockerignoreRoleV10, WorkerID: testWorker, SessionID: a.SessionID,
+		SnapshotID: "snapshot-v11-root-ignore", VertexDigest: testVertexDigest("aux-v11"),
+		TreeDigestSchema: BuildKitContextTreeDigestSchema, TreeDigest: a.TreeDigest,
+		RegularFileBytes: int64(len(data)), EntryCount: entryCount}
+	loaded := BuiltinLoadedRefV6{WorkerID: record.WorkerID, RefID: record.SnapshotID,
+		RootVertex: record.VertexDigest, SourceIdentifier: "local://context", SourceSessionID: record.SessionID,
+		SourceFollowPaths: `[".dockerignore"]`, SourceSharedKeyHint: "context-.dockerignore", SourceDiffer: "none"}
+	return ctx, m, scope, service, record, loaded
+}
+
+func TestC1V11RejectsAbsentAuxiliaryAuthorizationAtBegin(t *testing.T) {
+	service := &v11OwnerFixture{}
+	m, err := NewManager(service, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := m.BeginSolve(t.Context(), testBinding()); err == nil {
+		t.Fatal("V11 enabled without owner-approved root auxiliary")
+	}
+}
+
+func TestC1V11AuxiliaryFileSyncOneShotAndFirstReadFailureTerminal(t *testing.T) {
+	ctx, m, _, _, record, loaded := v11Fixture(t, nil, false)
+	if err := ClaimRootIgnoreFileSyncV11(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := ClaimRootIgnoreFileSyncV11(ctx); err == nil {
+		t.Fatal("concurrent auxiliary inner snapshot allowed a second transfer")
+	}
+	if err := ObserveRootDockerignoreV10(ctx, m, record); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, nil, fs.ErrPermission, loaded); err == nil {
+		t.Fatal("ambiguous read status was accepted")
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, nil, fs.ErrNotExist, loaded); err == nil {
+		t.Fatal("corrected second read laundered a failed first read")
+	}
+}
+
+func TestC1V11ConcurrentAuxiliaryTransfersAdmitExactlyOne(t *testing.T) {
+	ctx, _, _, _, _, _ := v11Fixture(t, nil, false)
+	const contenders = 24
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	var admitted atomic.Int32
+	for i := 0; i < contenders; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			if ClaimRootIgnoreFileSyncV11(ctx) == nil {
+				admitted.Add(1)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if admitted.Load() != 1 {
+		t.Fatalf("one-use pre-FileSync claim admitted %d contenders", admitted.Load())
+	}
+}
+
+func TestC1V11RejectedOwnerMainSnapshotDoesNotConsumeExcludeMatch(t *testing.T) {
+	ctx, m, _, _, root, loaded := v11Fixture(t, nil, false)
+	if err := ObserveRootDockerignoreV10(ctx, m, root); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, nil, fs.ErrNotExist, loaded); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindParsedRootIgnoreV11(ctx, ".dockerignore", nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	bad := testConsumption("source")
+	bad.TreeDigest = "sha256:" + strings.Repeat("f", 64)
+	if err := m.ContextConsumed(ctx, bad); err == nil {
+		t.Fatal("bad worker tree accepted")
+	}
+	good := testConsumption("source")
+	if err := m.ContextConsumed(ctx, good); err != nil {
+		t.Fatalf("rejected first source poisoned owner record: %v", err)
+	}
+	if err := RecordMainSourceExcludesV11(ctx, nil, good.VertexDigest); err != nil {
+		t.Fatalf("rejected first source poisoned V11 match: %v", err)
+	}
+}
+
+func TestC1V11EffectiveRootPatternsMustMatchRealReadAndCanonicalMainAttrs(t *testing.T) {
+	data := []byte("# comment\n*.log\n !keep.log \n/secret\n")
+	parsed, err := ignorefile.ReadAll(strings.NewReader(string(data)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Equal(parsed, []string{"*.log", "!keep.log", "secret"}) {
+		t.Fatalf("unexpected parser output: %v", parsed)
+	}
+	ctx, m, _, _, record, loaded := v11Fixture(t, data, true)
+	if err := RequireMainSourceExcludesV11(ctx, parsed, `["*.log","!keep.log","secret"]`, true); err == nil {
+		t.Fatal("main COPY accepted before verified root read and parse")
+	}
+	if err := ObserveRootDockerignoreV10(ctx, m, record); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, data, nil, loaded); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name     string
+		file     string
+		bytes    []byte
+		patterns []string
+	}{
+		{"wrong preferred file", "Dockerfile.dockerignore", data, parsed},
+		{"tampered bytes", ".dockerignore", []byte("*.tmp\n"), parsed},
+		{"tampered pattern", ".dockerignore", data, []string{"*.tmp"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := BindParsedRootIgnoreV11(ctx, tc.file, tc.bytes, tc.patterns); err == nil {
+				t.Fatal("different raw/parsed effective ignore was accepted")
+			}
+		})
+	}
+	if err := BindParsedRootIgnoreV11(ctx, ".dockerignore", data, parsed); err != nil {
+		t.Fatal(err)
+	}
+	// Actual builtin Dockerfile conversion requests effective patterns twice:
+	// once while dispatching and again while constructing the main context.
+	if err := BindParsedRootIgnoreV11(ctx, ".dockerignore", append([]byte(nil), data...), append([]string(nil), parsed...)); err != nil {
+		t.Fatalf("identical second effective parse must be idempotent: %v", err)
+	}
+	for _, tc := range []struct {
+		patterns []string
+		raw      string
+		present  bool
+	}{
+		{parsed, `["*.log","!keep.log","secret"]`, true},
+		{[]string{"*.log"}, `["*.log"]`, true},
+		{parsed, `[ "*.log", "!keep.log", "secret" ]`, true},
+		{parsed, "", false},
+	} {
+		err := RequireMainSourceExcludesV11(ctx, tc.patterns, tc.raw, tc.present)
+		if err == nil && (!slices.Equal(tc.patterns, parsed) || tc.raw != `["*.log","!keep.log","secret"]`) {
+			t.Fatalf("wrong main excludes passed: %v %q", tc.patterns, tc.raw)
+		}
+		if err != nil && slices.Equal(tc.patterns, parsed) && tc.raw == `["*.log","!keep.log","secret"]` {
+			t.Fatal(err)
+		}
+	}
+	if err := RecordMainSourceExcludesV11(ctx, []string{"*.tmp"}, testVertexDigest("source")); err == nil {
+		t.Fatal("worker-side excludes mismatch passed")
+	}
+	if err := RecordMainSourceExcludesV11(ctx, parsed, testVertexDigest("source")); err != nil {
+		t.Fatal(err)
+	}
+	if err := RecordMainSourceExcludesV11(ctx, parsed, testVertexDigest("source")); err == nil {
+		t.Fatal("committed main source replay accepted")
+	}
+}
+
+func TestC1V11CompletionRequiresParsedRootAndMatchingCommittedSource(t *testing.T) {
+	ctx, m, scope, service, root, loaded := v11Fixture(t, nil, false)
+	for _, name := range RequiredContextNames() {
+		if err := m.ContextConsumed(ctx, testConsumption(name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := ObserveRootDockerignoreV10(ctx, m, root); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, nil, fs.ErrNotExist, loaded); err != nil {
+		t.Fatal(err)
+	}
+	if err := scope.Complete(ctx, testOutput(scope)); err == nil || !strings.Contains(err.Error(), "lineage is incomplete") {
+		t.Fatalf("unparsed root silently completed: %v", err)
+	}
+	if err := BindParsedRootIgnoreV11(ctx, ".dockerignore", nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := scope.Complete(ctx, testOutput(scope)); err == nil || !strings.Contains(err.Error(), "lineage is incomplete") {
+		t.Fatalf("missing main source match silently completed: %v", err)
+	}
+	if err := RequireMainSourceExcludesV11(ctx, nil, "", false); err != nil {
+		t.Fatal(err)
+	}
+	if err := RecordMainSourceExcludesV11(ctx, nil, testVertexDigest("source")); err != nil {
+		t.Fatal(err)
+	}
+	if err := scope.Complete(ctx, testOutput(scope)); err != nil {
+		t.Fatal(err)
+	}
+	if service.completed.SchemaVersion != 11 || service.completed.RootIgnoreExcludesV11 == nil ||
+		service.completed.RootIgnoreExcludesV11.MainVertexDigest != testVertexDigest("source") ||
+		service.completed.RootIgnoreExcludesV11.PatternsSHA256 != HashRootIgnorePatternsV11(nil) {
+		t.Fatalf("V11 completion lost versioned provenance: %+v", service.completed)
+	}
+	if err := BindParsedRootIgnoreV11(ctx, ".dockerignore", nil, nil); err == nil {
+		t.Fatal("closed solve rebound")
+	}
+	if err := RecordMainSourceExcludesV11(ctx, nil, testVertexDigest("source")); err == nil {
+		t.Fatal("closed solve replayed main binding")
+	}
+}
diff --git a/util/localcontext/service_linux.go b/util/localcontext/service_linux.go
new file mode 100644
index 0000000..6e8a0d2
--- /dev/null
+++ b/util/localcontext/service_linux.go
@@ -0,0 +1,306 @@
+//go:build linux
+
+package localcontext
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const maxServiceMessageBytes = 64 * 1024
+
+// UnixSocketService sends observations to a separately controlled local owner
+// service. The socket is never used to expose a Docker API.
+type UnixSocketService struct {
+	path                  string
+	ownerUID              uint32
+	allowGroupSocketWrite bool
+}
+
+// NewUnixSocketService requires an absolute, non-symlink socket path owned by
+// ownerUID and protected from untrusted writes.
+func NewUnixSocketService(path string, ownerUID uint32) (*UnixSocketService, error) {
+	service := &UnixSocketService{path: path, ownerUID: ownerUID}
+	if err := service.verifySocketPath(); err != nil {
+		return nil, err
+	}
+	return service, nil
+}
+
+func (s *UnixSocketService) Begin(ctx context.Context, binding Binding) (Authorization, error) {
+	request := ServiceRequest{Version: 1, Operation: "begin", Binding: &binding}
+	response, err := s.call(ctx, request)
+	if err != nil {
+		return Authorization{}, err
+	}
+	if !response.OK || response.Authorization == nil {
+		return Authorization{}, serviceError(response)
+	}
+	// The v1 transport has no authenticated schema-10/11/12 capability ACK.
+	// Never allow its experimental authorization to start a worker transfer
+	// that could only be rejected after a costly solve on Complete.
+	if err := refuseLegacyExperimentalBeginV12(*response.Authorization); err != nil {
+		return Authorization{}, err
+	}
+	return *response.Authorization, nil
+}
+
+func refuseLegacyExperimentalBeginV12(auth Authorization) error {
+	if auth.RootDockerignoreV10 != nil || auth.BindRootIgnoreExcludesV11 ||
+		auth.PreferredDockerignoreV12 != nil || auth.RequirePreferredMissingV12 || auth.MainFollowPathsV13 != nil {
+		return errors.New("owner observer protocol v1 cannot begin experimental C1 V10/V11/V12 authorization")
+	}
+	return nil
+}
+
+func (s *UnixSocketService) Complete(ctx context.Context, completion Completion) error {
+	// Protocol v1 has no authenticated capability negotiation or versioned
+	// completion acknowledgement. A legacy owner could return a generic OK
+	// while silently ignoring V10/V11 sidecars. Refuse before sending ANY
+	// experimental completion until a new native owner protocol is installed.
+	if completion.SchemaVersion != 2 || completion.RootDockerignoreV10 != nil ||
+		completion.RootIgnoreExcludesV11 != nil || completion.PreferredDockerignoreV12 != nil ||
+		completion.Authorization.RootDockerignoreV10 != nil ||
+		completion.Authorization.PreferredDockerignoreV12 != nil ||
+		completion.Authorization.BindRootIgnoreExcludesV11 ||
+		completion.Authorization.RequirePreferredMissingV12 || completion.Authorization.MainFollowPathsV13 != nil ||
+		completion.MainFollowPathsV13 != nil {
+		return errors.New("owner observer protocol v1 cannot acknowledge V10/V11 auxiliary completion")
+	}
+	request := ServiceRequest{
+		Version:            1,
+		Operation:          "complete",
+		AuthorizationToken: completion.Authorization.Token,
+		Completion:         &completion,
+	}
+	response, err := s.call(ctx, request)
+	if err != nil {
+		return err
+	}
+	if !response.OK || response.Authorization != nil {
+		return serviceError(response)
+	}
+	return nil
+}
+
+func (s *UnixSocketService) Abort(ctx context.Context, token, reason string) error {
+	request := ServiceRequest{
+		Version:            1,
+		Operation:          "abort",
+		AuthorizationToken: token,
+		Reason:             reason,
+	}
+	response, err := s.call(ctx, request)
+	if err != nil {
+		return err
+	}
+	if !response.OK || response.Authorization != nil {
+		return serviceError(response)
+	}
+	return nil
+}
+
+func (s *UnixSocketService) call(ctx context.Context, request ServiceRequest) (ServiceResponse, error) {
+	if err := s.verifySocketPath(); err != nil {
+		return ServiceResponse{}, err
+	}
+	before, err := os.Lstat(s.path)
+	if err != nil {
+		return ServiceResponse{}, err
+	}
+	dialer := net.Dialer{Timeout: 5 * time.Second}
+	conn, err := dialer.DialContext(ctx, "unix", s.path)
+	if err != nil {
+		return ServiceResponse{}, fmt.Errorf("connect to owner local-context observer: %w", err)
+	}
+	defer conn.Close()
+	if err := s.verifyConnectedPeer(conn); err != nil {
+		return ServiceResponse{}, err
+	}
+	after, err := os.Lstat(s.path)
+	if err != nil || !os.SameFile(before, after) {
+		return ServiceResponse{}, errors.New("owner local-context observer socket replaced during connect")
+	}
+	if err := s.verifySocketPath(); err != nil {
+		return ServiceResponse{}, err
+	}
+	return s.callOnConn(ctx, conn, request)
+}
+
+// SO_PEERCRED binds this already-connected Unix stream to its peer process.
+// Path checks alone cannot authenticate the service after a rename race.
+func (s *UnixSocketService) verifyConnectedPeer(conn net.Conn) error {
+	unixConn, ok := conn.(*net.UnixConn)
+	if !ok {
+		return errors.New("owner local-context observer requires a Unix peer")
+	}
+	raw, err := unixConn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var peer *syscall.Ucred
+	var peerErr error
+	err = raw.Control(func(fd uintptr) {
+		peer, peerErr = syscall.GetsockoptUcred(int(fd), syscall.SOL_SOCKET, syscall.SO_PEERCRED)
+	})
+	if err != nil {
+		return err
+	}
+	if peerErr != nil || peer == nil || peer.Pid <= 0 || peer.Uid != s.ownerUID {
+		return errors.New("owner local-context observer connected peer identity mismatch")
+	}
+	return nil
+}
+
+func (s *UnixSocketService) callOnConn(ctx context.Context, conn net.Conn, request ServiceRequest) (ServiceResponse, error) {
+	payload, err := json.Marshal(request)
+	if err != nil {
+		return ServiceResponse{}, err
+	}
+	if len(payload) == 0 || len(payload) > maxServiceMessageBytes {
+		return ServiceResponse{}, errors.New("local-context observer request exceeds the message bound")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	if ctxDeadline, ok := ctx.Deadline(); ok && ctxDeadline.Before(deadline) {
+		deadline = ctxDeadline
+	}
+	if err := conn.SetDeadline(deadline); err != nil {
+		return ServiceResponse{}, err
+	}
+	message := append(payload, '\n')
+	for len(message) > 0 {
+		written, err := conn.Write(message)
+		if err != nil {
+			return ServiceResponse{}, err
+		}
+		if written == 0 {
+			return ServiceResponse{}, io.ErrShortWrite
+		}
+		message = message[written:]
+	}
+	// One bounded newline-delimited response per connection; the owner service
+	// may keep its socket open after writing the reply. Waiting for EOF would
+	// deadlock a valid persistent connection until the five-second timeout.
+	reader := bufio.NewReader(io.LimitReader(conn, maxServiceMessageBytes+2))
+	responseBytes, err := reader.ReadBytes('\n')
+	if err != nil {
+		return ServiceResponse{}, fmt.Errorf("owner local-context observer response requires a newline frame: %w", err)
+	}
+	if len(responseBytes) < 2 || len(responseBytes) > maxServiceMessageBytes+1 || reader.Buffered() != 0 {
+		return ServiceResponse{}, errors.New("owner local-context observer response is empty or oversized")
+	}
+	responseBytes = bytes.TrimSuffix(responseBytes, []byte("\n"))
+	decoder := json.NewDecoder(bytes.NewReader(responseBytes))
+	decoder.DisallowUnknownFields()
+	var response ServiceResponse
+	if err := decoder.Decode(&response); err != nil {
+		return ServiceResponse{}, fmt.Errorf("decode owner local-context observer response: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return ServiceResponse{}, errors.New("owner local-context observer response has trailing data")
+	}
+	if response.Version != 1 {
+		return ServiceResponse{}, errors.New("unsupported owner local-context observer response version")
+	}
+	if response.OK && response.Error != "" {
+		return ServiceResponse{}, errors.New("owner local-context observer returned conflicting status fields")
+	}
+	return response, nil
+}
+
+func serviceError(response ServiceResponse) error {
+	if response.Error == "" {
+		return errors.New("owner local-context observer refused the request")
+	}
+	if len(response.Error) > 256 {
+		return errors.New("owner local-context observer refused the request")
+	}
+	return fmt.Errorf("owner local-context observer refused the request: %s", response.Error)
+}
+
+func (s *UnixSocketService) verifySocketPath() error {
+	if s == nil || s.path == "" || !filepath.IsAbs(s.path) || filepath.Clean(s.path) != s.path {
+		return errors.New("owner local-context observer path must be absolute and canonical")
+	}
+	// A nonroot BuildKit process must not be able to impersonate the owner
+	// service under the very same Unix UID. Root-owned provisioning is an
+	// external prerequisite, not something this DEV client can establish.
+	if s.ownerUID != 0 && s.ownerUID == uint32(os.Geteuid()) {
+		return errors.New("owner local-context observer cannot trust a same-UID service")
+	}
+	current := string(filepath.Separator)
+	rootInfo, err := os.Lstat(current)
+	if err != nil {
+		return err
+	}
+	rootStat, ok := rootInfo.Sys().(*syscall.Stat_t)
+	if !ok || !rootInfo.IsDir() || rootStat.Uid != 0 || rootInfo.Mode().Perm()&0022 != 0 {
+		return errors.New("owner local-context observer filesystem root is not trusted")
+	}
+	parts := strings.Split(strings.TrimPrefix(s.path, current), current)
+	for index, part := range parts {
+		if part == "" || part == "." || part == ".." {
+			return errors.New("owner local-context observer path contains an invalid component")
+		}
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if err != nil {
+			return fmt.Errorf("inspect owner local-context observer path: %w", err)
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("owner local-context observer path cannot contain symlinks")
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok {
+			return errors.New("owner local-context observer path has no Unix ownership metadata")
+		}
+		isFinal := index == len(parts)-1
+		if isFinal {
+			perm := info.Mode().Perm()
+			if info.Mode()&os.ModeSocket == 0 || stat.Uid != s.ownerUID || perm&0002 != 0 {
+				return errors.New("owner local-context observer socket has an unexpected type, owner, or mode")
+			}
+			if perm&0020 != 0 {
+				if !s.allowGroupSocketWrite || !callerInGroup(stat.Gid) {
+					return errors.New("owner local-context observer socket group-write mode is not permitted")
+				}
+			}
+			continue
+		}
+		if !info.IsDir() {
+			return errors.New("owner local-context observer parent is not a directory")
+		}
+		if (stat.Uid != 0 && stat.Uid != s.ownerUID) || info.Mode().Perm()&0022 != 0 {
+			return errors.New("owner local-context observer parent is not trusted or is replaceable")
+		}
+	}
+	return nil
+}
+
+func callerInGroup(gid uint32) bool {
+	if gid == uint32(os.Getegid()) {
+		return true
+	}
+	groups, err := os.Getgroups()
+	if err != nil {
+		return false
+	}
+	for _, g := range groups {
+		if g >= 0 && uint32(g) == gid {
+			return true
+		}
+	}
+	return false
+}
