new file mode 100644
index 0000000..fabec0c
--- /dev/null
+++ b/session/filesync/sealed_owner_v15.go
@@ -0,0 +1,80 @@
+package filesync
+
+import (
+	"crypto/ed25519"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+)
+
+// V15OwnerPermit is a cryptographically verifiable test-only authorizer
+// envelope. The trusted public key MUST come from outside the sending client.
+// The native C4 v2 protocol does NOT yet issue this permit; a fixture signer
+// does not establish real C4 owner approval or source provenance.
+type V15OwnerPermit struct {
+	Domain         string `json:"domain"`
+	ApprovalID     string `json:"approvalId"`
+	ManifestDigest string `json:"manifestDigest"`
+	WorkerID       string `json:"workerId"`
+	SessionID      string `json:"sessionId"`
+	ContextName    string `json:"contextName"`
+	Nonce          string `json:"nonce"`
+	Epoch          uint64 `json:"epoch"`
+	ExpiresUnix    int64  `json:"expiresUnix"`
+	Signature      []byte `json:"signature"`
+}
+
+const V15OwnerDomain = "virki-c1-v15-test-owner-permit-1"
+
+func v15PermitBytes(p V15OwnerPermit) []byte {
+	p.Signature = nil
+	b, _ := json.Marshal(p)
+	return append([]byte("virki-c1-v15-ed25519-owner-permit\x00"), b...)
+}
+
+// V15LocalReplayLedger is a LOCAL, VOLATILE test ledger. It cannot replace
+// the independent monotonic C4 floor, durable PREPARE/COMMIT or crash fencing.
+type V15LocalReplayLedger struct {
+	mu       sync.Mutex
+	consumed map[string]struct{}
+	floor    uint64
+}
+
+func NewV15LocalReplayLedger(floor uint64) *V15LocalReplayLedger {
+	return &V15LocalReplayLedger{consumed: make(map[string]struct{}), floor: floor}
+}
+
+func (l *V15LocalReplayLedger) VerifyAndClaim(m V15SealedManifest, p V15OwnerPermit, pub ed25519.PublicKey) error {
+	if l == nil || len(pub) != ed25519.PublicKeySize || len(p.Signature) != ed25519.SignatureSize ||
+		p.Domain != V15OwnerDomain || p.ApprovalID == "" || p.Epoch == 0 ||
+		p.ManifestDigest != m.Digest || p.WorkerID != m.WorkerID ||
+		p.SessionID != m.SessionID || p.ContextName != m.ContextName ||
+		p.Nonce != m.Nonce || m.Digest == "" || v15ManifestDigest(m) != m.Digest ||
+		p.ExpiresUnix <= time.Now().Unix() {
+		return errors.New("C1 V15 expired, malformed or mismatched signed permit")
+	}
+	if !ed25519.Verify(pub, v15PermitBytes(p), p.Signature) {
+		return errors.New("C1 V15 Ed25519 owner permit signature failed")
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if p.Epoch < l.floor {
+		return errors.New("C1 V15 owner epoch stale against local test floor")
+	}
+	key := fmt.Sprintf("%d/%s/%s/%s/%s", p.Epoch, p.ApprovalID, p.ContextName, p.SessionID, p.Nonce)
+	if _, ok := l.consumed[key]; ok {
+		return errors.New("C1 V15 signed permit replayed or concurrent duplicate")
+	}
+	// Consume BEFORE capability negotiation or network bytes; ambiguous error
+	// is terminal. The test ledger itself is NOT crash durable.
+	l.consumed[key] = struct{}{}
+	// Fence every previously accepted lower epoch within this live worker
+	// process, not only epochs older than the ledger's initial floor.
+	// This is still volatile and NOT a durable C4 monotonic authority.
+	if p.Epoch > l.floor {
+		l.floor = p.Epoch
+	}
+	return nil
+}
diff --git a/session/filesync/sealed_postcommit_v22.go b/session/filesync/sealed_postcommit_v22.go
new file mode 100644
index 0000000..ce01534
--- /dev/null
+++ b/session/filesync/sealed_postcommit_v22.go
@@ -0,0 +1,36 @@
+package filesync
+
+import (
+	"context"
+	"fmt"
+)
+
+// V22PublishedButUnadmittedError is an AMBIGUOUS terminal outcome: the
+// verified tree was already atomically published into the destination,
+// but the worker's post-publication observation/owner acceptance failed.
+// The caller MUST NOT retry the same nonce or infer a clean rollback.
+// This is not an owner C4 release receipt or a production acknowledgment.
+type V22PublishedButUnadmittedError struct {
+	Destination string
+	Cause       error
+}
+
+func (e *V22PublishedButUnadmittedError) Error() string {
+	return fmt.Sprintf("C1 V22 PUBLISHED BUT UNADMITTED at %q; no retry or signing permitted: %v", e.Destination, e.Cause)
+}
+
+func (e *V22PublishedButUnadmittedError) Unwrap() error { return e.Cause }
+
+func observePublishedV22(ctx context.Context, dest, name string, observer LocalContextObserver) error {
+	if observer == nil {
+		return nil
+	}
+	obs, err := observeLocalContext(dest, name)
+	if err != nil {
+		return &V22PublishedButUnadmittedError{Destination: dest, Cause: err}
+	}
+	if err := observer(ctx, obs); err != nil {
+		return &V22PublishedButUnadmittedError{Destination: dest, Cause: err}
+	}
+	return nil
+}
diff --git a/session/filesync/sealed_protocol_v15.go b/session/filesync/sealed_protocol_v15.go
new file mode 100644
index 0000000..cf970bb
--- /dev/null
+++ b/session/filesync/sealed_protocol_v15.go
@@ -0,0 +1,173 @@
+package filesync
+
+import (
+	"context"
+	"crypto/ed25519"
+	"errors"
+	"fmt"
+	"slices"
+
+	"github.com/moby/buildkit/session"
+	"github.com/tonistiigi/fsutil"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+// V15 is a distinct RPC, NEVER an unknown flag on legacy DiffCopy. It is a
+// testable capability boundary, NOT independent client identity or a C4 ACK.
+const sealedServiceNameV15 = "moby.filesync.sealed.v15.SealedFileSync"
+const sealedMethodV15 = "DiffCopySealedV15"
+const sealedRPCV15 = "/" + sealedServiceNameV15 + "/" + sealedMethodV15
+
+const (
+	v15MDManifest = "virki-v15-manifest"
+	v15MDWorker   = "virki-v15-worker"
+	v15MDSession  = "virki-v15-session"
+	v15MDNonce    = "virki-v15-nonce"
+	v15MDRole     = "virki-v15-role"
+)
+
+type sealedServiceV15 interface{ DiffCopySealedV15(grpc.ServerStream) error }
+
+var sealedServiceDescV15 = grpc.ServiceDesc{
+	ServiceName: sealedServiceNameV15,
+	HandlerType: (*sealedServiceV15)(nil),
+	Streams: []grpc.StreamDesc{{StreamName: sealedMethodV15, ServerStreams: true, ClientStreams: true,
+		Handler: func(srv any, stream grpc.ServerStream) error {
+			return srv.(sealedServiceV15).DiffCopySealedV15(stream)
+		}}},
+}
+
+type sealedProviderV15 struct{ snapshot *V15SealedSnapshot }
+
+// NewSealedFSSyncProviderV15 only accepts a completely frozen in-memory
+// snapshot constructed with Linux openat2. Caller must retain its session
+// identity; do not wire this into unrestricted NewFSSyncProvider.
+func NewSealedFSSyncProviderV15(s *V15SealedSnapshot) session.Attachable {
+	return &sealedProviderV15{snapshot: s}
+}
+
+func (p *sealedProviderV15) Register(server *grpc.Server) {
+	server.RegisterService(&sealedServiceDescV15, p)
+}
+
+func v15One(md metadata.MD, key, want string) bool {
+	v := md.Get(key)
+	return len(v) == 1 && v[0] == want
+}
+
+func (p *sealedProviderV15) DiffCopySealedV15(stream grpc.ServerStream) error {
+	if p == nil || p.snapshot == nil {
+		return errors.New("C1 V15 missing sealed source")
+	}
+	m := p.snapshot.Manifest()
+	md, ok := metadata.FromIncomingContext(stream.Context())
+	if !ok || m.Digest == "" || v15ManifestDigest(m) != m.Digest ||
+		!v15One(md, v15MDManifest, m.Digest) || !v15One(md, v15MDWorker, m.WorkerID) ||
+		!v15One(md, v15MDSession, m.SessionID) || !v15One(md, v15MDNonce, m.Nonce) ||
+		!v15One(md, v15MDRole, m.ContextName) {
+		return errors.New("C1 V15 sealed client refuses mismatched worker/session/nonce/manifest")
+	}
+	if err := p.snapshot.reserveV15(); err != nil {
+		return err
+	}
+	// This handshake confirms an explicit versioned method + frozen manifest
+	// match, NOT that a malicious client cannot fabricate its own response.
+	if err := stream.SendHeader(metadata.Pairs(v15MDManifest, m.Digest, v15MDWorker, m.WorkerID,
+		v15MDSession, m.SessionID, v15MDNonce, m.Nonce)); err != nil {
+		return err
+	}
+	return sendDiffCopy(stream, p.snapshot, nil)
+}
+
+// FSSyncSealedV15 exercises REAL gRPC FileSync with a frozen Linux sender.
+// It is NOT called from protected C1 V13 while V14 denies physical transfers.
+// V15's first coherent prototype intentionally supports only explicit,
+// non-overlapping regular files and EMPTY effective ignore exclusions. A
+// future trusted client must validate selected Dockerfile ignore semantics.
+func FSSyncSealedV15(ctx context.Context, c session.Caller, opt FSSendRequestOpt, m V15SealedManifest,
+	permit V15OwnerPermit, trustedOwnerPub ed25519.PublicKey, ledger *V15LocalReplayLedger) error {
+	return fsSyncSealedWithCustody(ctx, c, opt, m, permit, trustedOwnerPub, ledger, defaultV24ReceiverCustodyPolicy())
+}
+
+// FSSyncSealedV24 is a DEV-only entry point for a receiver already started
+// under a trusted supervisor's independently provisioned identity. It does
+// not start a privileged process, enable C1, or authorize native C4.
+func FSSyncSealedV24(ctx context.Context, c session.Caller, opt FSSendRequestOpt, m V15SealedManifest,
+	permit V15OwnerPermit, trustedOwnerPub ed25519.PublicKey, ledger *V15LocalReplayLedger,
+	policy V24ReceiverCustodyPolicy) error {
+	if err := validateV24IndependentCustody(opt.DestDir, policy); err != nil {
+		return err
+	}
+	return fsSyncSealedWithCustody(ctx, c, opt, m, permit, trustedOwnerPub, ledger, policy)
+}
+
+func fsSyncSealedWithCustody(ctx context.Context, c session.Caller, opt FSSendRequestOpt, m V15SealedManifest,
+	permit V15OwnerPermit, trustedOwnerPub ed25519.PublicKey, ledger *V15LocalReplayLedger,
+	policy V24ReceiverCustodyPolicy) error {
+	if c == nil || m.Schema != "virki-c1-v15-memory-fs-1" ||
+		m.Digest == "" || v15ManifestDigest(m) != m.Digest ||
+		opt.Name != m.ContextName || len(opt.IncludePatterns) != 0 ||
+		len(opt.ExcludePatterns) != 0 || len(m.ExcludePatterns) != 0 ||
+		opt.MetadataOnly || opt.DestDir == "" ||
+		opt.CacheUpdater != nil || opt.ProgressCb != nil ||
+		opt.Filter != nil || opt.MetadataOnlyFilter != nil {
+		return errors.New("C1 V22 sealed receiver refuses mismatched manifest/filters/role or precommit callbacks")
+	}
+	paths := make([]string, 0, len(m.Files))
+	var pinBytes int64
+	for _, file := range m.Files {
+		paths = append(paths, file.Path)
+		pinBytes += file.Size
+	}
+	if pinBytes != m.Bytes || m.Bytes > 64<<20 || m.Bytes < 0 {
+		return errors.New("C1 V15 signed file lengths mismatch aggregate budget")
+	}
+	if !slices.Equal(paths, opt.FollowPaths) {
+		return errors.New("C1 V15 worker rejects widened/subset/reordered FollowPaths")
+	}
+	if err := validateV15Request(V15SnapshotRequest{Root: "pinned-by-client", ContextName: m.ContextName,
+		WorkerID: m.WorkerID, SessionID: m.SessionID, Nonce: m.Nonce, Files: m.Files}); err != nil {
+		return err
+	}
+	if err := ledger.VerifyAndClaim(m, permit, trustedOwnerPub); err != nil {
+		return err
+	}
+	if !c.Supports(session.MethodURL(sealedServiceNameV15, sealedMethodV15)) {
+		return errors.New("C1 V15 sealed FileSync capability absent: legacy diffcopy fallback forbidden")
+	}
+	ctx = c.Context(ctx)
+	ctx = metadata.NewOutgoingContext(ctx, metadata.Pairs(v15MDManifest, m.Digest, v15MDWorker, m.WorkerID,
+		v15MDSession, m.SessionID, v15MDNonce, m.Nonce, v15MDRole, m.ContextName))
+	stream, err := c.Conn().NewStream(ctx, &grpc.StreamDesc{StreamName: sealedMethodV15,
+		ServerStreams: true, ClientStreams: true}, sealedRPCV15)
+	if err != nil {
+		return err
+	}
+	hdr, err := stream.Header()
+	if err != nil {
+		return fmt.Errorf("C1 V15 sealed sender handshake denied: %w", err)
+	}
+	if !v15One(hdr, v15MDManifest, m.Digest) || !v15One(hdr, v15MDWorker, m.WorkerID) ||
+		!v15One(hdr, v15MDSession, m.SessionID) || !v15One(hdr, v15MDNonce, m.Nonce) {
+		return errors.New("C1 V15 sealed sender gave wrong or missing versioned manifest header")
+	}
+	// C1 V22/V24: never direct unverified gRPC DATA to the caller-visible
+	// destination. Enforce V24 receiver custody invariants, receive into a
+	// private quarantine owned by this Linux worker, verify against the frozen
+	// manifest, and atomically publish only after complete success.
+	// This remains DEV-only and does not enable the V14 physical C1 path.
+	guard := newV15PacketGuard(stream, m)
+	if policy.ExpectedSenderUID != nil && policy.ExpectedSenderGID != nil {
+		guard = newV15PacketGuardWithOwner(stream, m, *policy.ExpectedSenderUID, *policy.ExpectedSenderGID)
+	}
+	if err := receiveV24WithCustody(opt.DestDir, m, policy, func(stage string) error {
+		return recvDiffCopy(guard, stage, nil,
+			nil, opt.Differ, nil, nil)
+	}); err != nil {
+		return err
+	}
+	return observePublishedV22(ctx, opt.DestDir, opt.Name, opt.OnConsumed)
+}
+
+var _ fsutil.FS = (*V15SealedSnapshot)(nil)
diff --git a/session/filesync/sealed_snapshot_v15.go b/session/filesync/sealed_snapshot_v15.go
new file mode 100644
index 0000000..9fe475e
--- /dev/null
+++ b/session/filesync/sealed_snapshot_v15.go
@@ -0,0 +1,231 @@
+package filesync
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"slices"
+	"strings"
+	"sync"
+
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/tonistiigi/fsutil"
+	"github.com/tonistiigi/fsutil/types"
+)
+
+// V15FilePin is a content approval supplied independently of the local
+// client. A forged caller-supplied pin is never owner authentication.
+type V15FilePin struct {
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+	Size   int64  `json:"size"`
+}
+
+type V15SnapshotRequest struct {
+	Root            string
+	ContextName     string
+	WorkerID        string
+	SessionID       string
+	Nonce           string
+	Files           []V15FilePin
+	ExcludePatterns []string
+}
+
+type V15SealedManifest struct {
+	Schema          string       `json:"schema"`
+	ContextName     string       `json:"contextName"`
+	WorkerID        string       `json:"workerId"`
+	SessionID       string       `json:"sessionId"`
+	Nonce           string       `json:"nonce"`
+	Files           []V15FilePin `json:"files"`
+	ExcludePatterns []string     `json:"excludePatterns"`
+	Bytes           int64        `json:"bytes"`
+	Digest          string       `json:"digest"`
+}
+
+type v15FrozenEntry struct {
+	stat    *types.Stat
+	content []byte // never exposed to the caller; Open returns a fresh reader
+}
+
+// V15SealedSnapshot is an immutable, bounded IN-MEMORY FileSync FS. Its
+// generation does not rely on mutable os.Open(path) after the manifest is
+// checked. Ownership of the process/FS still is not independently attested.
+type V15SealedSnapshot struct {
+	manifest V15SealedManifest
+	entries  map[string]v15FrozenEntry
+	paths    []string
+	mu       sync.Mutex
+	consumed bool
+}
+
+func (s *V15SealedSnapshot) Manifest() V15SealedManifest {
+	if s == nil {
+		return V15SealedManifest{}
+	}
+	m := s.manifest
+	m.Files = slices.Clone(m.Files)
+	m.ExcludePatterns = slices.Clone(m.ExcludePatterns)
+	return m
+}
+
+func (s *V15SealedSnapshot) reserveV15() error {
+	if s == nil {
+		return errors.New("C1 V15 nil sealed snapshot")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.consumed {
+		return errors.New("C1 V15 immutable snapshot replayed")
+	}
+	s.consumed = true
+	return nil
+}
+
+func v15Hash(bytes []byte) string {
+	h := sha256.Sum256(bytes)
+	return fmt.Sprintf("sha256:%x", h)
+}
+
+func v15ManifestDigest(m V15SealedManifest) string {
+	m.Digest = ""
+	b, _ := json.Marshal(m)
+	return v15Hash(append([]byte("virki-c1-v15-frozen-client-manifest\x00"), b...))
+}
+
+func validateV15Request(r V15SnapshotRequest) error {
+	if r.Root == "" || r.ContextName == "" || r.WorkerID == "" ||
+		r.SessionID == "" || len(r.Nonce) < 16 || len(r.Files) == 0 || len(r.Files) > 128 {
+		return errors.New("C1 V15 sealed snapshot lacks mandatory owner-bound request fields")
+	}
+	paths := make([]string, 0, len(r.Files))
+	var total int64
+	for _, pin := range r.Files {
+		paths = append(paths, pin.Path)
+		if pin.Size < 0 || pin.Size > 16<<20 || total+pin.Size > 64<<20 {
+			return errors.New("C1 V15 owner-approved file sizes exceed strict budget")
+		}
+		total += pin.Size
+		if len(pin.SHA256) != 71 || !strings.HasPrefix(pin.SHA256, "sha256:") {
+			return errors.New("C1 V15 invalid independently approved file hash syntax")
+		}
+		for _, ch := range pin.SHA256[7:] {
+			if !(ch >= '0' && ch <= '9') && !(ch >= 'a' && ch <= 'f') {
+				return errors.New("C1 V15 expected hash must be canonical lowercase hex")
+			}
+		}
+	}
+	if err := localcontext.ValidateMainFollowPathsV13(paths); err != nil {
+		return fmt.Errorf("C1 V15 unsafe selected file paths: %w", err)
+	}
+	return nil
+}
+
+func newV15SealedSnapshot(r V15SnapshotRequest, contents map[string][]byte) (*V15SealedSnapshot, error) {
+	if err := validateV15Request(r); err != nil {
+		return nil, err
+	}
+	if len(contents) != len(r.Files) {
+		return nil, errors.New("C1 V15 source file count differs from authorized list")
+	}
+	m := V15SealedManifest{Schema: "virki-c1-v15-memory-fs-1", ContextName: r.ContextName,
+		WorkerID: r.WorkerID, SessionID: r.SessionID, Nonce: r.Nonce,
+		Files: slices.Clone(r.Files), ExcludePatterns: slices.Clone(r.ExcludePatterns)}
+	s := &V15SealedSnapshot{entries: make(map[string]v15FrozenEntry)}
+	for _, pin := range r.Files {
+		content, ok := contents[pin.Path]
+		if !ok || int64(len(content)) != pin.Size || v15Hash(content) != pin.SHA256 {
+			return nil, fmt.Errorf("C1 V15 frozen bytes mismatch owner pin for %q", pin.Path)
+		}
+		m.Bytes += int64(len(content))
+		if m.Bytes > 64<<20 {
+			return nil, errors.New("C1 V15 snapshot exceeds bounded 64 MiB size")
+		}
+		parts := strings.Split(pin.Path, "/")
+		for i := 1; i < len(parts); i++ {
+			parent := strings.Join(parts[:i], "/")
+			if _, ok := s.entries[parent]; !ok {
+				s.entries[parent] = v15FrozenEntry{stat: &types.Stat{Path: parent, Mode: uint32(os.ModeDir | 0755), Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid())}}
+			}
+		}
+		// These synthetic stable modes/mtimes are NOT physical host metadata.
+		// Physical provenance requires a separately signed owner manifest.
+		s.entries[pin.Path] = v15FrozenEntry{stat: &types.Stat{Path: pin.Path, Mode: 0644, Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid()),
+			Size: int64(len(content))}, content: slices.Clone(content)}
+	}
+	for p := range s.entries {
+		s.paths = append(s.paths, p)
+	}
+	slices.Sort(s.paths)
+	m.Digest = v15ManifestDigest(m)
+	s.manifest = m
+	return s, nil
+}
+
+func (s *V15SealedSnapshot) Walk(ctx context.Context, target string, callback fs.WalkDirFunc) error {
+	if s == nil {
+		return errors.New("C1 V15 nil FS")
+	}
+	if target == "" || target == "." || target == "/" {
+		target = ""
+	} else {
+		if path.Clean(target) != target || strings.HasPrefix(target, "/") || strings.HasPrefix(target, "../") {
+			return errors.New("C1 V15 unsafe FS walk target")
+		}
+	}
+	found := false
+	var skip string
+	for _, name := range s.paths {
+		if target != "" && name != target && !strings.HasPrefix(name, target+"/") {
+			continue
+		}
+		if skip != "" && strings.HasPrefix(name, skip+"/") {
+			continue
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		entry := s.entries[name]
+		found = true
+		err := callback(name, &fsutil.DirEntryInfo{Stat: entry.stat.Clone()}, nil)
+		if errors.Is(err, fs.SkipDir) {
+			if entry.stat.Mode&uint32(os.ModeDir) != 0 {
+				skip = name
+			}
+			continue
+		}
+		if err != nil {
+			return err
+		}
+	}
+	if !found && target != "" {
+		return fmt.Errorf("C1 V15 walk %q: %w", target, os.ErrNotExist)
+	}
+	return nil
+}
+
+func (s *V15SealedSnapshot) Open(p string) (io.ReadCloser, error) {
+	if s == nil {
+		return nil, errors.New("C1 V15 nil FS")
+	}
+	if p == "" || p == "." || path.Clean(p) != p || strings.HasPrefix(p, "/") || strings.HasPrefix(p, "../") {
+		return nil, errors.New("C1 V15 unsafe frozen FS open")
+	}
+	entry, ok := s.entries[p]
+	if !ok {
+		return nil, fmt.Errorf("C1 V15 open %q: %w", p, os.ErrNotExist)
+	}
+	if entry.stat.Mode&uint32(os.ModeDir) != 0 {
+		return nil, fmt.Errorf("C1 V15 directory open %q: %w", p, fs.ErrInvalid)
+	}
+	return io.NopCloser(bytes.NewReader(entry.content)), nil
+}
+
+var _ fsutil.FS = (*V15SealedSnapshot)(nil)
diff --git a/session/filesync/sealed_snapshot_v15_linux.go b/session/filesync/sealed_snapshot_v15_linux.go
new file mode 100644
index 0000000..8456069
--- /dev/null
+++ b/session/filesync/sealed_snapshot_v15_linux.go
@@ -0,0 +1,101 @@
+//go:build linux
+
+package filesync
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// NewLinuxSealedSnapshotV15 copies a BOUNDED exact owner-hash-pinned list of
+// regular file bytes through openat2 beneath an already open directory FD.
+// Every path component must be non-symlink (including proc magic links), no
+// mount crossing, hardlinks or special files; no future Open touches source.
+// The entire file is frozen in memory BEFORE a FileSync service is exposed.
+//
+// A caller can lie about r.Files. This is an isolation primitive, NOT proof
+// that a separate owner supplied the pins or that the sender is trusted.
+func NewLinuxSealedSnapshotV15(ctx context.Context, r V15SnapshotRequest) (*V15SealedSnapshot, error) {
+	if err := validateV15Request(r); err != nil {
+		return nil, err
+	}
+	if !filepath.IsAbs(r.Root) || filepath.Clean(r.Root) != r.Root || r.Root == "/" {
+		return nil, errors.New("C1 V15 root must be a canonical absolute non-root Linux directory")
+	}
+	// Also reject symlinks in the PARENTS of the configured root. O_NOFOLLOW
+	// on the leaf alone does not protect /trusted/parent-symlink/root.
+	baseFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(baseFD)
+	rootFD, err := unix.Openat2(baseFD, strings.TrimPrefix(r.Root, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("C1 V15 open trusted root without following link: %w", err)
+	}
+	defer unix.Close(rootFD)
+	contents := make(map[string][]byte, len(r.Files))
+	total := int64(0)
+	for _, pin := range r.Files {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		fd, err := unix.Openat2(rootFD, pin.Path, &unix.OpenHow{
+			Flags:   uint64(unix.O_RDONLY | unix.O_NONBLOCK | unix.O_NOFOLLOW | unix.O_CLOEXEC),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_XDEV,
+		})
+		if err != nil {
+			return nil, fmt.Errorf("C1 V15 secure openat2 refused %q: %w", pin.Path, err)
+		}
+		funcErr := func() error {
+			// os.File owns and closes this descriptor, including clearing its
+			// finalizer. A separate unix.Close would risk a later double-close
+			// of a reused descriptor when the File is garbage collected.
+			f := os.NewFile(uintptr(fd), pin.Path)
+			defer f.Close()
+			var before, after unix.Stat_t
+			if err := unix.Fstat(fd, &before); err != nil {
+				return err
+			}
+			if before.Mode&unix.S_IFMT != unix.S_IFREG || before.Nlink != 1 || before.Size != pin.Size || before.Size < 0 || before.Size > 16<<20 ||
+				total+before.Size > 64<<20 {
+				return errors.New("C1 V15 refuses nonregular/hardlinked/oversized source inode")
+			}
+			// Read from the pinned descriptor, never reopen mutable path.
+			data, err := io.ReadAll(io.LimitReader(f, (16<<20)+1))
+			if err != nil {
+				return err
+			}
+			if len(data) > 16<<20 {
+				return errors.New("C1 V15 file changed past bounded read size")
+			}
+			if err := unix.Fstat(fd, &after); err != nil {
+				return err
+			}
+			if before.Dev != after.Dev || before.Ino != after.Ino || before.Size != after.Size ||
+				before.Mtim != after.Mtim || before.Ctim != after.Ctim || after.Size != int64(len(data)) {
+				return errors.New("C1 V15 concurrent file mutation during pinned content capture")
+			}
+			if actual := v15Hash(data); actual != pin.SHA256 {
+				return fmt.Errorf("C1 V15 physical bytes differ from independently pinned hash for %q", pin.Path)
+			}
+			contents[pin.Path] = data
+			total += int64(len(data))
+			return nil
+		}()
+		if funcErr != nil {
+			return nil, fmt.Errorf("C1 V15 snapshot %q refused: %w", pin.Path, funcErr)
+		}
+	}
+	return newV15SealedSnapshot(r, contents)
+}
