+	}
+	good := makeHandler(valid)
+	_, err = good.canonicalOwnerContextNameV9(ctx)
+	require.NoError(t, err)
+	_, _, _, _, err = good.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.NoError(t, err)
+	for _, tc := range []struct {
+		name  string
+		key   string
+		value string
+		drop  bool
+	}{
+		{"unknown attr", "local.untrusted-attestor", "true", false},
+		{"foreign shared hint", pb.AttrSharedKeyHint, "other", false},
+		{"wrong followed path", pb.AttrFollowPaths, `["Dockerfile"]`, false},
+		{"wrong differ", pb.AttrLocalDiffer, pb.AttrLocalDifferMetadata, false},
+		{"illegal excludes", pb.AttrExcludePatterns, `["secret"]`, false},
+		{"missing differ", pb.AttrLocalDiffer, "", true},
+		{"missing session", pb.AttrLocalSessionID, "", true},
