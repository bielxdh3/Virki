+		{"metadata mode", func(id *LocalIdentifier) { id.MetadataOnly = true }},
+		{"extra include", func(id *LocalIdentifier) { id.IncludePatterns = []string{"custom"} }},
+		{"raw empty follow paths", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrFollowPaths] = "[]" }},
+		{"raw null follow paths", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrFollowPaths] = "null" }},
+		{"wrong raw differ", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrLocalDiffer] = pb.AttrLocalDifferMetadata }},
+		{"extra unknown raw attr", func(id *LocalIdentifier) { id.rawAttributesV9["virki.fake-authority"] = "true" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			bad := *handler
+			id := handler.src
+			id.rawAttributesV9 = map[string]string{}
+			for k, v := range handler.src.rawAttributesV9 {
+				id.rawAttributesV9[k] = v
