+package local
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"io/fs"
+	"strings"
+	"testing"
+
+	"github.com/moby/buildkit/client/llb"
+	"github.com/moby/buildkit/solver/pb"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/stretchr/testify/require"
+	"github.com/tonistiigi/fsutil"
+)
+
+func TestC1V11ActualBuiltinLocalLLBExcludeEncoding(t *testing.T) {
+	for _, tc := range []struct {
+		patterns []string
+		expected string
+	}{
+		{nil, ""},
+		{[]string{"*.log", "!keep.log", "secret"}, `["*.log","!keep.log","secret"]`},
+	} {
+		st := llb.Local("context", llb.SessionID("session-approved-v9"),
+			llb.SharedKeyHint("context"), llb.ExcludePatterns(tc.patterns))
+		def, err := st.Marshal(t.Context())
+		require.NoError(t, err)
+		var found bool
+		for _, raw := range def.ToPB().Def {
+			var op pb.Op
+			require.NoError(t, op.Unmarshal(raw))
+			if op.GetSource() == nil {
+				continue
+			}
+			found = true
+			require.Equal(t, "local://context", op.GetSource().Identifier)
+			attrs := op.GetSource().Attrs
+			require.Equal(t, tc.expected, attrs[pb.AttrExcludePatterns])
+			_, exists := attrs[pb.AttrExcludePatterns]
+			require.Equal(t, len(tc.patterns) != 0, exists)
+			id, err := (&localSource{}).Identifier("local", "context", attrs, nil)
+			require.NoError(t, err)
+			require.Equal(t, tc.patterns, id.(*LocalIdentifier).ExcludePatterns)
+		}
+		require.True(t, found, "real LLB Marshal must emit a source op")
+	}
+}
+
+type v11MainOwnerService struct{ v10AuxSourceService }
+
+func (v11MainOwnerService) Begin(ctx context.Context, b localcontext.Binding) (localcontext.Authorization, error) {
+	a, err := (v10AuxSourceService{}).Begin(ctx, b)
+	a.BindRootIgnoreExcludesV11 = true
+	return a, err
+}
+
+func TestC1V11MainLoadedExcludeOverrideDeniedBeforeAnyFileSync(t *testing.T) {
+	exporter, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "v11.example/runtime:dev"})
+	require.NoError(t, err)
+	m, err := localcontext.NewManager(v11MainOwnerService{}, false)
+	require.NoError(t, err)
+	ctx, scope, err := m.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-v11", Role: "runtime", Nonce: strings.Repeat("b", 32),
+		ApprovalID: "approval-v11", ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: exporter,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	attrs := map[string]string{pb.AttrLocalSessionID: "session-approved-v9", pb.AttrSharedKeyHint: "context"}
+	id, err := (&localSource{}).Identifier("local", "context", attrs, nil)
+	require.NoError(t, err)
+	handler := &localSourceHandler{localSource: &localSource{consumptionObserver: m},
+		src: *id.(*LocalIdentifier), vertexDigest: "sha256:" + strings.Repeat("1", 64)}
+	require.Equal(t, fsutil.DiffMetadata, handler.src.Differ)
+	_, _, _, _, err = handler.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "C1 V11")
+	ref, err := handler.Snapshot(ctx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V11")
+	ref, err = handler.snapshot(ctx, "session-approved-v9", nil)
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V11")
+
+	tree := sha256.Sum256([]byte(localcontext.BuildKitContextTreeDigestSchema + "\x00"))
+	aux := localcontext.Consumption{
+		Name: localcontext.RootDockerignoreRoleV10, WorkerID: "worker-v7", SessionID: "session-approved-v9",
+		SnapshotID: "immutable-v11-root", VertexDigest: "sha256:" + strings.Repeat("e", 64),
+		TreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+		TreeDigest:       fmt.Sprintf("sha256:%x", tree), EntryCount: 0,
+	}
+	require.NoError(t, localcontext.ObserveRootDockerignoreV10(ctx, m, aux))
+	loaded := localcontext.BuiltinLoadedRefV6{
+		WorkerID: aux.WorkerID, RefID: aux.SnapshotID, RootVertex: aux.VertexDigest,
