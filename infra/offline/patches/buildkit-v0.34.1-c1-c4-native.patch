+func TestC1V22LiveGRPCBadSenderNeverPublishesPartialQuarantine(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		want    string
+		packets []*types.Packet
+	}{
+		{"bad SHA after DATA", "DATA digest/size mismatch", []*types.Packet{
+			v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_DATA, ID: 0, Data: []byte("EVIL")},
+			{Type: types.PACKET_DATA, ID: 0},
+		}},
+		{"unexpected secret STAT", "unapproved sender STAT", []*types.Packet{
+			v15StatPacket("secret.env", 0644, 6), {Type: types.PACKET_STAT},
+		}},
+		{"premature FIN", "premature FIN", []*types.Packet{
+			v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_FIN},
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("TMPDIR", "/tmp")
+			ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+			defer cancel()
+			m := v15PacketManifest()
+			p, pub, ledger := v15SignedPermitFixture(t, m)
+			s, err := session.NewSession(ctx, "v22-staged-hostile")
+			require.NoError(t, err)
+			manager, err := session.NewManager()
+			require.NoError(t, err)
+			s.Allow(&v22MaliciousSealedProvider{manifest: m, packets: tc.packets})
+			g, ctx := errgroup.WithContext(ctx)
+			g.Go(func() error {
+				return s.Run(ctx, session.Dialer(testutil.TestStream(testutil.Handler(manager.HandleConn))))
+			})
+			g.Go(func() (retErr error) {
+				defer func() {
+					if err := s.Close(); retErr == nil {
+						retErr = err
+					}
+				}()
+				caller, err := manager.Get(ctx, s.ID(), false)
+				if err != nil {
+					return err
+				}
+				parent := t.TempDir()
+				if err := os.Chmod(parent, 0700); err != nil {
+					return err
+				}
+				dest := filepath.Join(parent, "published")
+				err = FSSyncSealedV15(ctx, caller, FSSendRequestOpt{
+					Name: "context", FollowPaths: []string{"app.js"}, DestDir: dest,
+				}, m, p, pub, ledger)
+				if err == nil {
+					return errors.New("C1 V22 malicious gRPC publisher unexpectedly succeeded")
+				}
+				if !strings.Contains(err.Error(), tc.want) {
+					return errors.New("C1 V22 malicious test false-green: rejected before targeted packet guard: " + err.Error())
+				}
+				if _, statErr := os.Lstat(dest); !errors.Is(statErr, os.ErrNotExist) {
+					return errors.New("C1 V22 leaked unverified destination after malicious gRPC DATA")
+				}
+				entries, err := os.ReadDir(parent)
+				if err != nil {
+					return err
+				}
+				for _, entry := range entries {
+					if strings.HasPrefix(entry.Name(), ".virki-v19-") {
+						return errors.New("C1 V22 left private quarantine after malicious stream")
+					}
+				}
+				return nil
+			})
+			require.NoError(t, g.Wait())
+		})
+	}
+}
