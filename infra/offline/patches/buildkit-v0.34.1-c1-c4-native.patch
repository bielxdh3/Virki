+	"github.com/stretchr/testify/require"
+)
+
+type v13FilteredSourceOwner struct {
+	v12DockerfileShapeOwnerService
+	approved localcontext.Authorization
+}
+
+func (s *v13FilteredSourceOwner) Begin(ctx context.Context, b localcontext.Binding) (localcontext.Authorization, error) {
+	a, err := s.v12DockerfileShapeOwnerService.Begin(ctx, b)
+	a.MainFollowPathsV13 = []string{"app.js"}
+	s.approved = a
+	return a, err
+}
+
+func TestC1V13BuiltinFilteredContextRawLLBSourceOpAndEarlyDenials(t *testing.T) {
+	st := llb.Local("context", llb.SessionID("session-approved-v9"),
+		llb.SharedKeyHint("context"), llb.FollowPaths([]string{"app.js"}))
+	def, err := st.Marshal(t.Context())
+	require.NoError(t, err)
+	var actual map[string]string
+	for _, raw := range def.ToPB().Def {
+		var op pb.Op
+		require.NoError(t, op.Unmarshal(raw))
+		if op.GetSource() != nil && op.GetSource().Identifier == "local://context" {
+			actual = op.GetSource().Attrs
+		}
+	}
+	require.NotNil(t, actual)
+	require.Equal(t, `["app.js"]`, actual[pb.AttrFollowPaths])
+	require.Equal(t, "context", actual[pb.AttrSharedKeyHint])
+	service := &v13FilteredSourceOwner{}
+	m, err := localcontext.NewManager(service, false)
+	require.NoError(t, err)
+	exporter, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "v13.example/runtime:dev"})
+	require.NoError(t, err)
+	ctx, scope, err := m.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-v13-main", Role: "runtime", Nonce: strings.Repeat("b", 32),
+		ApprovalID: "approval-v13-main", ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: exporter,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	makeHandler := func(attrs map[string]string) *localSourceHandler {
+		id, idErr := (&localSource{}).Identifier("local", "context", attrs, nil)
+		require.NoError(t, idErr)
+		return &localSourceHandler{localSource: &localSource{consumptionObserver: m}, src: *id.(*LocalIdentifier), vertexDigest: "sha256:" + strings.Repeat("1", 64)}
+	}
+	h := makeHandler(actual)
+	_, _, _, _, err = h.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "C1 V11") // no selected ignore read yet
+	// V14 blocks even the EARLIER canonical Dockerfile source in a V13
+	// generation. A symlinked Dockerfile could otherwise leak bytes before
+	// the later main-context hard stop is reached.
+	dockerfileAttrs := map[string]string{
+		pb.AttrLocalSessionID: "session-approved-v9",
+		pb.AttrSharedKeyHint:  "dockerfile",
+		pb.AttrFollowPaths:    `["Dockerfile","Dockerfile.dockerignore","dockerfile"]`,
+		pb.AttrLocalDiffer:    pb.AttrLocalDifferNone,
+	}
+	dockerfileID, err := (&localSource{}).Identifier("local", "dockerfile", dockerfileAttrs, nil)
+	require.NoError(t, err)
+	dockerfileHandler := &localSourceHandler{
+		localSource: &localSource{consumptionObserver: m},
+		src:         *dockerfileID.(*LocalIdentifier),
+	}
+	ref, err := dockerfileHandler.Snapshot(ctx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V14 PHYSICAL FILESYNC DENIED")
+	ref, err = dockerfileHandler.snapshot(ctx, "session-approved-v9", nil)
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V14 PHYSICAL FILESYNC DENIED")
+	a := service.approved
+	d := localcontext.Consumption{Name: "dockerfile", WorkerID: a.WorkerID,
+		SessionID: a.ContextSessionIDsV8["dockerfile"], SnapshotID: "immutable-v13-dockerfile",
+		VertexDigest: "sha256:" + strings.Repeat("a", 64), TreeDigestSchema: a.ContextTreeDigestSchema,
+		TreeDigest: a.ContextTreeDigests["dockerfile"], EntryCount: 1}
+	require.NoError(t, m.ContextConsumed(ctx, d))
+	loaded := localcontext.BuiltinLoadedRefV6{WorkerID: d.WorkerID, RefID: d.SnapshotID, RootVertex: d.VertexDigest,
+		SourceIdentifier: "local://dockerfile", SourceSessionID: d.SessionID,
+		SourceSharedKeyHint: "dockerfile", SourceDiffer: "none",
+		SourceFollowPaths: `["Dockerfile","Dockerfile.dockerignore","dockerfile"]`}
+	require.NoError(t, localcontext.ClaimPreferredDockerignoreReadV12(ctx))
+	require.NoError(t, localcontext.VerifyPreferredDockerignoreReadV12(ctx, "Dockerfile.dockerignore", nil, nil, loaded))
+	require.NoError(t, localcontext.BindParsedRootIgnoreV11(ctx, "Dockerfile.dockerignore", nil, nil))
+	_, _, _, _, err = h.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "C1 V13") // fake SourceOp alone cannot bind derived Dockerfile COPY
+	require.NoError(t, localcontext.BindDerivedMainFollowPathsV13(ctx, []string{"app.js"}))
+	_, _, _, _, err = h.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.NoError(t, err)
+	// V14: the same owner-approved raw LLB shape is still usable for
+	// nonauthorizing diagnostics (CacheKey), but cannot reach any session
+	// dial, cache mount or FileSync on the protected physical worker path.
+	ref, err = h.Snapshot(ctx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V14 PHYSICAL FILESYNC DENIED")
+	ref, err = h.snapshot(ctx, "session-approved-v9", nil)
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "C1 V14 PHYSICAL FILESYNC DENIED")
+	for _, tc := range []struct {
+		name   string
+		mutate func(map[string]string)
+	}{
+		{"unknown extra attr", func(m map[string]string) { m["local.client-claims-owner"] = "true" }},
+		{"wrong path", func(m map[string]string) { m[pb.AttrFollowPaths] = `["secret.env"]` }},
+		{"empty array", func(m map[string]string) { m[pb.AttrFollowPaths] = `[]` }},
+		{"null", func(m map[string]string) { m[pb.AttrFollowPaths] = `null` }},
+		{"no followed path", func(m map[string]string) { delete(m, pb.AttrFollowPaths) }},
+		{"reordered and extra", func(m map[string]string) { m[pb.AttrFollowPaths] = `["secret.env","app.js"]` }},
+		{"illegal include", func(m map[string]string) { m[pb.AttrIncludePatterns] = `["other"]` }},
+		{"wrong shared key", func(m map[string]string) { m[pb.AttrSharedKeyHint] = "context-.dockerignore" }},
+		{"foreign session", func(m map[string]string) { m[pb.AttrLocalSessionID] = "another-session" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			attrs := map[string]string{}
+			for k, v := range actual {
+				attrs[k] = v
+			}
+			tc.mutate(attrs)
+			bad := makeHandler(attrs)
+			_, _, _, _, err := bad.CacheKey(ctx, v7SessionJobContext{}, 0)
+			require.Error(t, err)
+			ref, err := bad.Snapshot(ctx, v7SessionJobContext{})
+			require.Nil(t, ref)
+			require.Error(t, err)
+			ref, err = bad.snapshot(ctx, "session-approved-v9", nil)
+			require.Nil(t, ref)
+			require.Error(t, err)
+		})
+	}
+	alias := *h
+	alias.src = h.src
+	alias.src.Name = "source"
+	_, _, _, _, err = alias.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "literal local://source")
+}
