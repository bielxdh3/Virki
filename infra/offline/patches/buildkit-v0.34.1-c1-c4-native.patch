+package dockerfile2llb
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/moby/buildkit/client/llb"
+	"github.com/moby/buildkit/solver/pb"
+	"github.com/stretchr/testify/require"
+)
+
+func TestC1V13ActualDockerfileNormalizerToMainLocalLLB(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		ctxPaths   map[string]struct{}
+		expected   []string
+		expectAttr bool
+	}{
+		{"COPY file", map[string]struct{}{"/app.js": {}}, []string{"app.js"}, true},
+		{"two sorted COPYs", map[string]struct{}{"/static/logo.png": {}, "/app.js": {}}, []string{"app.js", "static/logo.png"}, true},
+		{"full-root COPY dot", map[string]struct{}{"/": {}, "/app.js": {}}, nil, false},
+		{"no local COPY", map[string]struct{}{}, nil, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			normal := normalizeContextPaths(tc.ctxPaths)
+			require.Equal(t, tc.expected, normal)
+			opts := append([]llb.LocalOption{llb.SessionID("session-approved-v9"), llb.SharedKeyHint("context")}, filterPaths(tc.ctxPaths)...)
+			st := llb.Local("context", opts...)
+			def, err := st.Marshal(t.Context())
+			require.NoError(t, err)
+			var seen bool
+			for _, encoded := range def.ToPB().Def {
+				var op pb.Op
+				require.NoError(t, op.Unmarshal(encoded))
+				if op.GetSource() == nil || op.GetSource().Identifier != "local://context" {
+					continue
+				}
+				seen = true
+				raw, exists := op.GetSource().Attrs[pb.AttrFollowPaths]
+				require.Equal(t, tc.expectAttr, exists)
+				if tc.expectAttr {
+					require.NotContains(t, raw, " ")
+					require.True(t, strings.HasPrefix(raw, "[\""))
+				}
+			}
+			require.True(t, seen)
+		})
+	}
+}
+
+func TestC1V13RemoteGitAddMustNotPolluteOwnerPinnedLocalPaths(t *testing.T) {
+	for _, tc := range []struct {
+		src    string
+		remote bool
+	}{
+		{"app.js", false},
+		{"static/logo.png", false},
+		{"git://example.com/owner/repo.git", true},
+		{"git@github.com:owner/repo.git", true},
+		{"github.com/owner/repo", false},
+	} {
+		require.Equal(t, tc.remote, distinguishableGitAddSourceV13(tc.src), tc.src)
+	}
+}
