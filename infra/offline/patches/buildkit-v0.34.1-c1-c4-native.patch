index 0000000..144ff76
--- /dev/null
+++ b/util/localcontext/main_follow_paths_v13_test.go
@@ -0,0 +1,223 @@
+package localcontext
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+)
+
+type v13FollowOwnerService struct {
+	v12PreferredService
+	paths []string
+}
+
+func (s *v13FollowOwnerService) Begin(ctx context.Context, b Binding) (Authorization, error) {
+	a, err := s.v12PreferredService.Begin(ctx, b)
+	a.MainFollowPathsV13 = s.paths
+	return a, err
+}
+
+func v13FollowFixture(t *testing.T, paths []string) (context.Context, *Manager, *SolveScope, *v13FollowOwnerService, []string) {
+	t.Helper()
+	data := []byte("*.log\n!keep.log\n")
+	s := &v13FollowOwnerService{v12PreferredService: v12PreferredService{
+		preferred:      &PreferredDockerignoreApprovalV12{Path: "Dockerfile.dockerignore", ContentSHA256: SHA256BytesV4(data)},
+		bindingEnabled: true}, paths: paths}
+	m, err := NewManager(s, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := m.BeginSolve(t.Context(), testBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := testConsumption("dockerfile")
+	if err := m.ContextConsumed(ctx, d); err != nil {
+		t.Fatal(err)
+	}
+	loaded := BuiltinLoadedRefV6{WorkerID: d.WorkerID, RefID: d.SnapshotID, RootVertex: d.VertexDigest,
+		SourceIdentifier: "local://dockerfile", SourceSessionID: d.SessionID,
+		SourceFollowPaths:   `["Dockerfile","Dockerfile.dockerignore","dockerfile"]`,
+		SourceSharedKeyHint: "dockerfile", SourceDiffer: "none"}
+	if err := ClaimPreferredDockerignoreReadV12(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := VerifyPreferredDockerignoreReadV12(ctx, "Dockerfile.dockerignore", data, nil, loaded); err != nil {
+		t.Fatal(err)
+	}
+	excludes := []string{"*.log", "!keep.log"}
+	if err := BindParsedRootIgnoreV11(ctx, "Dockerfile.dockerignore", data, excludes); err != nil {
+		t.Fatal(err)
+	}
+	return ctx, m, scope, s, excludes
+}
+
+func TestC1V13OwnerRequiresSortedCanonicalLiteralPaths(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		paths []string
+	}{
+		{"root", []string{"."}}, {"absolute", []string{"/etc/passwd"}},
+		{"parent", []string{"../secrets"}}, {"nested parent", []string{"a/../../b"}},
+		{"trailing slash", []string{"a/"}}, {"dot prefix", []string{"./a"}},
+		{"duplicate", []string{"a", "a"}}, {"reordered", []string{"b", "a"}},
+		{"wildcard", []string{"*.js"}}, {"question mark", []string{"a?.js"}},
+		{"backslash", []string{"x\\y"}}, {"empty", []string{""}},
+		{"ancestor overlap", []string{"src", "src/app.js"}},
+		{"windows drive", []string{"C:app.js"}},
+		{"explicit dot-dot", []string{".."}},
+		{"explicitly empty owner subset", []string{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := ValidateMainFollowPathsV13(tc.paths); err == nil {
+				t.Fatalf("unsafe path approval accepted: %#v", tc.paths)
+			}
+			s := &v13FollowOwnerService{v12PreferredService: v12PreferredService{
+				preferred:      &PreferredDockerignoreApprovalV12{Path: "Dockerfile.dockerignore", ContentSHA256: SHA256BytesV4(nil)},
+				bindingEnabled: true}, paths: tc.paths}
+			m, err := NewManager(s, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, _, err = m.BeginSolve(t.Context(), testBinding()); err == nil {
+				t.Fatal("invalid owner paths passed Begin")
+			}
+		})
+	}
+}
+
+func TestC1V13RealSortedSourcePathsAreFrozenAndExactlyMatched(t *testing.T) {
+	approved := []string{"app.js", "static/logo.png"}
+	ctx, m, scope, s, excludes := v13FollowFixture(t, approved)
+	approved[0] = "attacker.js"
+	s.paths[1] = "attacker/logo.png"
+	if err := RequireMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}, `["app.js","static/logo.png"]`, true); err == nil {
+		t.Fatal("main worker accepted owner paths before actual Dockerfile2LLB path derivation")
+	}
+	if err := BindDerivedMainFollowPathsV13(ctx, []string{"other.js"}); err == nil {
+		t.Fatal("wrong Dockerfile2LLB-derived COPY list admitted")
+	}
+	if err := BindDerivedMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindDerivedMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindDerivedMainFollowPathsV13(ctx, nil); err == nil {
+		t.Fatal("multi-platform changed source paths accepted")
+	}
+	for _, raw := range []string{"../evil", "./app.js", "/etc/passwd", "a*.js", "a/../app.js"} {
+		if err := VerifyOriginalCopyPathV13(ctx, raw); err == nil {
+			t.Fatalf("raw Dockerfile path normalized into false-green: %q", raw)
+		}
+	}
+	if err := VerifyOriginalCopyPathV13(ctx, "app.js"); err != nil {
+		t.Fatal(err)
+	}
+	if err := RefuseIndependentUnfilteredMainV13(ctx); err == nil {
+		t.Fatal("SOURCE_DATE_EPOCH=context accepted despite V13 filtered main approval")
+	}
+	if err := RequireBuiltinMainContextOriginV13(ctx, false, false); err == nil {
+		t.Fatal("missing builtin client enabled custom main")
+	}
+	if err := RequireBuiltinMainContextOriginV13(ctx, true, true); err == nil {
+		t.Fatal("prebuilt main state bypassed derived filters")
+	}
+	if err := RefuseCustomMainContextV13(ctx); err == nil {
+		t.Fatal("custom dockerui MainContext bypassed filterPaths")
+	}
+	if err := RequireBuiltinMainContextOriginV13(ctx, true, false); err != nil {
+		t.Fatal(err)
+	}
+	if err := RequireMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}, `["app.js","static/logo.png"]`, true); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name    string
+		paths   []string
+		raw     string
+		present bool
+	}{
+		{"extra", []string{"app.js", "other.js", "static/logo.png"}, `["app.js","other.js","static/logo.png"]`, true},
+		{"subset", []string{"app.js"}, `["app.js"]`, true},
+		{"reordered", []string{"static/logo.png", "app.js"}, `["static/logo.png","app.js"]`, true},
+		{"raw escaped", []string{"app.js", "static/logo.png"}, `[ "app.js", "static/logo.png" ]`, true},
+		{"raw null", []string{"app.js", "static/logo.png"}, `null`, true},
+		{"raw absent", []string{"app.js", "static/logo.png"}, ``, false},
+		{"unfiltered SOURCE_DATE_EPOCH", nil, ``, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := RequireMainFollowPathsV13(ctx, tc.paths, tc.raw, tc.present); err == nil {
+				t.Fatal("unapproved source paths admitted before FileSync")
+			}
+		})
+	}
+	if err := RecordMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}, testVertexDigest("source")); err == nil {
+		t.Fatal("worker-only CacheKey could complete without committed V11 main record")
+	}
+	for _, name := range RequiredContextNames() {
+		if name == "dockerfile" {
+			continue
+		}
+		if err := m.ContextConsumed(ctx, testConsumption(name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := RecordMainSourceExcludesV11(ctx, excludes, testVertexDigest("source")); err != nil {
+		t.Fatal(err)
+	}
+	if err := RecordMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}, testVertexDigest("source")); err != nil {
+		t.Fatal(err)
+	}
+	if err := RecordMainFollowPathsV13(ctx, []string{"app.js", "static/logo.png"}, testVertexDigest("source")); err == nil {
+		t.Fatal("replayed committed follow paths admitted")
+	}
+	r := testConsumption("source")
+	loaded := BuiltinLoadedRefV6{WorkerID: r.WorkerID, RefID: r.SnapshotID, RootVertex: r.VertexDigest,
+		SourceIdentifier: "local://context", SourceSessionID: r.SessionID,
+		SourceSharedKeyHint: "context", SourceFollowPaths: `["app.js","static/logo.png"]`,
+		SourceExcludePatterns: `["*.log","!keep.log"]`}
+	if err := scope.Complete(ctx, testOutput(scope)); err == nil || !strings.Contains(err.Error(), "C1 V13") {
+		t.Fatalf("schema13 completion accepted worker record WITHOUT loaded main ref: %v", err)
+	}
+	if err := scope.VerifyLoadedWorkerSourceV8("main-context", loaded); err != nil {
+		t.Fatal(err)
+	}
+	bad := loaded
+	bad.SourceFollowPaths = `["other.js"]`
+	if err := scope.VerifyLoadedWorkerSourceV8("main-context", bad); err == nil {
+		t.Fatal("foreign loaded worker FollowPaths passed")
+	}
+	bad = loaded
+	bad.SourceExcludePatterns = `["other.secret"]`
+	if err := scope.VerifyLoadedWorkerSourceV8("main-context", bad); err == nil {
+		t.Fatal("foreign loaded worker excludes passed")
+	}
+	if err := scope.Complete(ctx, testOutput(scope)); err != nil {
+		t.Fatal(err)
+	}
+	if s.completed.SchemaVersion != 13 || s.completed.MainFollowPathsV13 == nil ||
+		s.completed.MainFollowPathsV13.PathsSHA256 != HashMainFollowPathsV13([]string{"app.js", "static/logo.png"}) ||
+		!slices.Equal(s.completed.Authorization.MainFollowPathsV13, []string{"app.js", "static/logo.png"}) {
+		t.Fatalf("schema13 completion lost immutable paths: %+v", s.completed)
+	}
+}
+
+func TestC1V13LegacyUnfilteredSourceHasNoFollowPaths(t *testing.T) {
+	ctx, _, _, _, _ := v12PreferredFixture(t, []byte(""))
+	if err := RequireMainFollowPathsV13(ctx, nil, "", false); err != nil {
+		t.Fatal(err)
+	}
+	for _, raw := range []string{`[]`, `null`, `["app.js"]`} {
+		if err := RequireMainFollowPathsV13(ctx, nil, raw, true); err == nil {
+			t.Fatal("noncanonical unapproved FollowPaths attr admitted")
+		}
+	}
+	if err := RequireMainFollowPathsV13(ctx, []string{"app.js"}, `["app.js"]`, true); err == nil {
+		t.Fatal("non-opted-in V12 context admitted filtered main COPY")
+	}
+	if strings.TrimSpace(HashMainFollowPathsV13([]string{"app.js"})) == "" {
+		t.Fatal("empty hash")
+	}
+}
diff --git a/util/localcontext/observer.go b/util/localcontext/observer.go
new file mode 100644
index 0000000..1df112c
--- /dev/null
+++ b/util/localcontext/observer.go
@@ -0,0 +1,1076 @@
+// Package localcontext carries non-authorizing worker observations to a
+// separately controlled owner service. It does not sign receipts or grant
+// execution authority.
+package localcontext
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"maps"
+	"regexp"
+	"slices"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+var (
+	identifierPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:+-]{0,255}$`)
+	noncePattern      = regexp.MustCompile(`^[a-f0-9]{32}$`)
+	sha256Pattern     = regexp.MustCompile(`^sha256:[a-f0-9]{64}$`)
+)
+
+// requiredContexts is the exact canonical context set accepted for one role.
+var requiredContexts = [...]string{
+	"source",
+	"dockerfile",
+	"offline-npm-cacache",
+	"offline-prisma-engines",
+}
+
+// RequiredContextNames returns a copy of the exact protocol context set.
+func RequiredContextNames() []string {
+	return append([]string(nil), requiredContexts[:]...)
+}
