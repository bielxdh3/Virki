+	require.ErrorContains(t, validateLocalContextExporterRequest(scope, []exporter.ExporterInstance{resolved}, nil, true), "no cache or session exporters")
+	require.ErrorContains(t, validateLocalContextExporterRequest(scope, []exporter.ExporterInstance{resolved, resolved}, nil, false), "exactly one image exporter")
+	require.ErrorContains(t, validateLocalContextExporterRequest(scope, []exporter.ExporterInstance{causalTestForeignExporter{}}, nil, false), "not the concrete BuildKit containerimage exporter")
+	for _, forbidden := range []map[string]string{
