+func loadCausalRoot(t *testing.T, state llb.State) solver.Edge {
+	t.Helper()
+	definition, err := state.Marshal(t.Context())
+	require.NoError(t, err)
+	root, err := Load(t.Context(), definition.ToPB(), nil)
+	require.NoError(t, err)
+	require.NotNil(t, root.Vertex)
+	return root
+}
+
+func llbScratchCopyingLocals(names []string) llb.State {
+	if len(names) == 0 {
+		return llb.Scratch()
+	}
+	action := llb.Copy(llb.Local(names[0]), "payload", "/"+names[0])
+	for _, name := range names[1:] {
+		action = action.Copy(llb.Local(name), "payload", "/"+name)
+	}
+	return llb.Scratch().File(action)
+}
+
+func findLoadedLocalSource(t *testing.T, root solver.Vertex, name string) solver.Vertex {
+	t.Helper()
+	seen := map[string]struct{}{}
+	var visit func(solver.Vertex) solver.Vertex
+	visit = func(vertex solver.Vertex) solver.Vertex {
+		if vertex == nil {
+			return nil
+		}
+		digest := vertex.Digest().String()
+		if _, ok := seen[digest]; ok {
+			return nil
+		}
+		seen[digest] = struct{}{}
+		if op, ok := vertex.Sys().(*pb.Op); ok && op.GetSource() != nil && strings.Contains(op.GetSource().Identifier, name) {
+			return vertex
+		}
+		for _, input := range vertex.Inputs() {
+			if found := visit(input.Vertex); found != nil {
+				return found
+			}
+		}
+		return nil
+	}
+	vertex := visit(root)
+	require.NotNil(t, vertex, "loaded graph has no local source vertex for %q", name)
+	return vertex
+}
+
+func causalConsumption(name, sourceVertexDigest string) localcontext.Consumption {
+	return localcontext.Consumption{
+		Name: name, Generation: "0123456789abcdef0123456789abcdef",
+		ContextIdentity: "owner-context:" + name, WorkerID: "worker-causal-test",
+		SessionID: "session-causal-test", VertexDigest: sourceVertexDigest,
+		VertexOutputIndex: 0, SnapshotID: "snapshot-" + name,
+		TreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+		TreeDigest:       "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		RegularFileBytes: 10, EntryCount: 2,
+	}
+}
+
+func graphContainsDigest(root solver.Vertex, want string) bool {
+	seen := map[string]struct{}{}
+	var visit func(solver.Vertex) bool
+	visit = func(vertex solver.Vertex) bool {
+		if vertex == nil {
+			return false
+		}
+		digest := vertex.Digest().String()
+		if digest == want {
+			return true
+		}
+		if _, ok := seen[digest]; ok {
+			return false
+		}
+		seen[digest] = struct{}{}
+		for _, input := range vertex.Inputs() {
+			if visit(input.Vertex) {
+				return true
+			}
+		}
+		return false
+	}
+	return visit(root)
+}
diff --git a/solver/llbsolver/local_context_platform_v4.go b/solver/llbsolver/local_context_platform_v4.go
new file mode 100644
index 0000000..0854c77
--- /dev/null
+++ b/solver/llbsolver/local_context_platform_v4.go
@@ -0,0 +1,117 @@
+package llbsolver
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/containerd/platforms"
+	"github.com/moby/buildkit/cache"
+	"github.com/moby/buildkit/exporter"
+	"github.com/moby/buildkit/exporter/containerimage/exptypes"
+	"github.com/moby/buildkit/frontend"
+	"github.com/moby/buildkit/solver"
+	"github.com/moby/buildkit/solver/result"
+	"github.com/moby/buildkit/util/localcontext"
+)
+
+// selectedLocalContextPlatformRootsV4 derives the exact platform->LOADED
+// RootEdge/worker/immutable-ref relation from the postprocessor's actual
+// frontend, cached, and exporter input results. It never uses FindRef: that
+// method has a one-key fallback allowing wrong platform identifiers.
+//
+// This is a separate non-authorizing verification primitive. The current C1
+// frontend remains refused. The owner must additionally bind this metadata to
+// the trusted concrete frontend, physical worker, and actual ImageWriter
+// manifest platform/descriptor mapping before permitting publication.
+func selectedLocalContextPlatformRootsV4(
+	ctx context.Context,
+	res *frontend.Result,
+	cached *result.Result[solver.CachedResult],
+	inp *exporter.Source,
+	workerID string,
+) (map[string]localcontext.CausalRoot, error) {
+	if res == nil || cached == nil || inp == nil || workerID == "" {
+		return nil, errors.New("C1 v4 missing actual BuildKit selected result sets or worker")
+	}
+	if len(res.Attestations) != 0 || len(cached.Attestations) != 0 || len(inp.Attestations) != 0 {
+		return nil, errors.New("C1 v4 refuses unrelated attestation roots")
+	}
+	ps, err := exptypes.ParsePlatforms(inp.Metadata)
+	if err != nil {
+		return nil, fmt.Errorf("C1 v4 invalid effective exporter platforms: %w", err)
+	}
+	if len(ps.Platforms) == 0 || len(ps.Platforms) > 32 {
+		return nil, errors.New("C1 v4 invalid platform root cardinality")
+	}
+	out := make(map[string]localcontext.CausalRoot, len(ps.Platforms))
+	if res.Ref != nil || cached.Ref != nil || inp.Ref != nil {
+		if len(ps.Platforms) != 1 || res.Ref == nil || cached.Ref == nil || inp.Ref == nil ||
+			len(res.Refs) != 0 || len(cached.Refs) != 0 || len(inp.Refs) != 0 {
+			return nil, errors.New("C1 v4 mismatched single-ref export and declared platforms")
+		}
+		p := ps.Platforms[0]
+		if platforms.FormatAll(p.Platform) != p.ID {
+			return nil, errors.New("C1 v4 noncanonical exporter single-platform ID")
+		}
+		root, err := localContextRoot(ctx, res.Ref, cached.Ref, inp.Ref, workerID, nil)
+		if err != nil {
+			return nil, err
+		}
+		out[p.ID] = root
+		return out, nil
+	}
+	if len(res.Refs) != len(ps.Platforms) || len(cached.Refs) != len(ps.Platforms) || len(inp.Refs) != len(ps.Platforms) {
+		return nil, errors.New("C1 v4 exporter platforms differ from exact selected ref maps")
+	}
+	for _, platform := range ps.Platforms {
+		if platform.ID == "" || platforms.FormatAll(platform.Platform) != platform.ID {
+			return nil, errors.New("C1 v4 untrusted or noncanonical platform ID")
+		}
+		if _, duplicate := out[platform.ID]; duplicate {
+			return nil, errors.New("C1 v4 duplicate exporter platform ID")
+		}
+		proxy, foundProxy := res.Refs[platform.ID]
+		cachedResult, foundCache := cached.Refs[platform.ID]
+		exportRef, foundExport := inp.Refs[platform.ID]
+		if !foundProxy || !foundCache || !foundExport || proxy == nil || cachedResult == nil || exportRef == nil {
+			return nil, fmt.Errorf("C1 v4 missing exact loaded/cache/exporter ref for platform %q", platform.ID)
+		}
+		root, err := localContextRoot(ctx, proxy, cachedResult, exportRef, workerID, nil)
+		if err != nil {
+			return nil, fmt.Errorf("C1 v4 invalid exporter platform %q: %w", platform.ID, err)
+		}
+		out[platform.ID] = root
+	}
+	return out, nil
+}
+
+// AssertV4SelectedPlatformOutputIdentity independently cross-checks candidate
+// platform-selected roots with the original exporter Source. This function
+// does not itself authorize a build or perform publication.
+func AssertV4SelectedPlatformOutputIdentity(selected map[string]localcontext.CausalRoot, inp *result.Result[cache.ImmutableRef]) error {
+	if inp == nil || len(selected) == 0 || len(selected) > 32 {
+		return errors.New("C1 v4 exporter has no selected platform root set")
+	}
+	if inp.Ref != nil {
+		if len(selected) != 1 || len(inp.Refs) != 0 {
+			return errors.New("C1 v4 selected single-root platform mismatch")
+		}
+		for _, selectedRoot := range selected {
+			if inp.Ref.ID() != selectedRoot.RefID {
+				return errors.New("C1 v4 selected single-root immutable ref changed")
+			}
+		}
+		return nil
+	}
+	if len(inp.Refs) != len(selected) {
+		return errors.New("C1 v4 selected exporter platform count mismatch")
+	}
+	for key, root := range selected {
+		ref, exists := inp.Refs[key]
+		if !exists || ref == nil || ref.ID() != root.RefID {
+			return errors.New("C1 v4 selected exporter platform immutable ref differs")
+		}
+	}
+	return nil
+}
