+func testConsumption(name string) Consumption {
+	return Consumption{
+		Name:              name,
+		WorkerID:          testWorker,
+		SessionID:         "session-c1-01",
+		VertexDigest:      testVertexDigest(name),
+		VertexOutputIndex: 0,
+		SnapshotID:        "snapshot-c1-01-" + name,
+		TreeDigestSchema:  BuildKitContextTreeDigestSchema,
+		TreeDigest:        "sha256:" + testContextDigests[name],
+		RegularFileBytes:  10,
+		EntryCount:        2,
+	}
+}
+
+func testVertexDigest(name string) string {
+	for i, candidate := range RequiredContextNames() {
+		if name == candidate {
+			return "sha256:" + strings.Repeat(fmt.Sprintf("%x", i+1), 64)
+		}
+	}
+	return "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
+}
