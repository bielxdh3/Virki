+package local
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/moby/buildkit/session"
+	"github.com/moby/buildkit/solver"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/stretchr/testify/require"
+)
+
+type v7SessionJobContext struct{ solver.JobContext }
+
+func (v7SessionJobContext) Session() session.Group { return session.NewGroup("session-approved-v7") }
+
+func TestC1V7RequiredWorkerLocalSessionCannotFallback(t *testing.T) {
+	ownerCtx, manager := v8OptionalOwnerWithManager(t)
+	for _, reason := range []error{errors.New("requested caller absent"), context.DeadlineExceeded, errors.New("invalid requested session")} {
+		ls := &localSourceHandler{localSource: &localSource{requireConsumptionObserver: true, consumptionObserver: v8NoopObserver{}}}
+		ref, err := ls.fallbackOrDenyObservedSessionV7(t.Context(), session.NewGroup("foreign-session"), reason)
+		require.Nil(t, ref)
+		require.ErrorContains(t, err, "cross-session fallback forbidden")
+		require.ErrorIs(t, err, reason)
+	}
+	missing := &localSourceHandler{localSource: &localSource{requireConsumptionObserver: true, consumptionObserver: manager}, src: LocalIdentifier{Name: "dockerfile"}}
+	_, _, _, _, cacheErr := missing.CacheKey(ownerCtx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, cacheErr, "unpinned session")
+	ref, err := missing.Snapshot(ownerCtx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "cross-session fallback forbidden")
+	// The helper is intentionally NOT proof of real session manager + FileSync
+	// execution. A native gRPC integration still has to verify a missing caller
+	// with an otherwise available foreign session cannot transfer bytes.
+}
+
+type v7OptionalOwnerService struct{}
+
+func (v7OptionalOwnerService) Begin(_ context.Context, b localcontext.Binding) (localcontext.Authorization, error) {
+	ids := map[string]string{}
+	digests := map[string]string{}
+	for i, name := range localcontext.RequiredContextNames() {
+		ids[name] = "owner-context:" + name
+		digests[name] = "sha256:" + strings.Repeat(string(rune('a'+i)), 64)
+	}
+	return localcontext.Authorization{
+		Token: "owner-token-v7", Generation: b.Nonce, WorkerID: "worker-v7",
+		ContextIdentities: ids, ContextTreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+		ContextTreeDigests: digests, ExporterPolicy: b.Exporter,
+		ExpectedImage: localcontext.ImageDescriptor{
+			MediaType: "application/vnd.oci.image.manifest.v1+json",
+			Digest:    "sha256:" + strings.Repeat("f", 64), Size: 1024,
+		}, ExpiresAt: time.Now().Add(time.Minute),
+	}, nil
+}
+func (v7OptionalOwnerService) Complete(context.Context, localcontext.Completion) error { return nil }
+func (v7OptionalOwnerService) Abort(context.Context, string, string) error             { return nil }
+
+func TestC1V7OptionalObserverOwnerScopeStillRejectsFallback(t *testing.T) {
+	exporter, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "c1.example/runtime:approved"})
+	require.NoError(t, err)
+	mgr, err := localcontext.NewManager(v7OptionalOwnerService{}, false)
+	require.NoError(t, err)
+	binding := localcontext.Binding{
+		JobID: "job-session-v7", Role: "runtime", Nonce: strings.Repeat("b", 32),
+		ApprovalID:       "approval-session-v7",
+		ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: exporter,
+	}
+	ctx, scope, err := mgr.BeginSolve(t.Context(), binding)
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	require.True(t, localcontext.OwnerScopedSolveActiveV7(ctx))
+	// No global worker observer requirement, but this one solve DID acquire an
+	// independently supplied owner scope. It must not pick a foreign session.
+	optional := &localSourceHandler{localSource: &localSource{requireConsumptionObserver: false, consumptionObserver: mgr}, src: LocalIdentifier{Name: "dockerfile"}}
+	_, _, _, _, err = optional.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "unpinned session")
+	ref, err := optional.Snapshot(ctx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "cross-session fallback forbidden")
+	ref, err = optional.fallbackOrDenyObservedSessionV7(ctx, session.NewGroup("foreign-session"), context.DeadlineExceeded)
+	require.Nil(t, ref)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+}
