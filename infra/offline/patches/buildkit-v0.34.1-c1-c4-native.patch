index 0000000..ba9110f
--- /dev/null
+++ b/source/local/consumption.go
@@ -0,0 +1,70 @@
+package local
+
+import (
+	"context"
+	"errors"
+
+	"github.com/moby/buildkit/cache"
+	"github.com/moby/buildkit/session"
+	"github.com/moby/buildkit/session/filesync"
+	"github.com/moby/buildkit/snapshot"
+	"github.com/moby/buildkit/util/localcontext"
+)
+
+// ContextConsumption identifies the immutable local-source snapshot committed
+// after the worker received and measured its destination tree.
+type ContextConsumption = localcontext.Consumption
+
+type ConsumptionObserver = localcontext.ContextObserver
+
+type ConsumptionObserverFunc func(context.Context, localcontext.Consumption) error
+
+func (f ConsumptionObserverFunc) ContextConsumed(ctx context.Context, record localcontext.Consumption) error {
+	return f(ctx, record)
+}
+
+func verifyCommittedLocalContext(transferred, committed filesync.LocalContextObservation) error {
+	if transferred.Name != committed.Name || transferred.TreeDigestSchema != committed.TreeDigestSchema ||
+		transferred.TreeDigest != committed.TreeDigest ||
+		transferred.RegularFileBytes != committed.RegularFileBytes || transferred.EntryCount != committed.EntryCount {
+		return errors.New("committed local-source snapshot differs from the observed FileSync destination")
+	}
+	return nil
+}
+
+func measureCommittedLocalContext(ctx context.Context, ref cache.ImmutableRef, sessionID, name string) (filesync.LocalContextObservation, error) {
+	obs, _, err := measureCommittedLocalContextImpl(ctx, ref, sessionID, name, false)
+	return obs, err
+}
+
+func measureCommittedLocalContextStream(ctx context.Context, ref cache.ImmutableRef, sessionID, name string) (filesync.LocalContextObservation, []byte, error) {
+	return measureCommittedLocalContextImpl(ctx, ref, sessionID, name, true)
+}
+
+func measureCommittedLocalContextImpl(ctx context.Context, ref cache.ImmutableRef, sessionID, name string, captureStream bool) (filesync.LocalContextObservation, []byte, error) {
+	mount, err := ref.Mount(ctx, true, session.NewGroup(sessionID))
+	if err != nil {
+		return filesync.LocalContextObservation{}, nil, err
+	}
+	lm := snapshot.LocalMounter(mount)
+	root, err := lm.Mount()
+	if err != nil {
+		return filesync.LocalContextObservation{}, nil, err
+	}
+	var observation filesync.LocalContextObservation
+	var streamBytes []byte
+	var observeErr error
+	if captureStream {
+		observation, streamBytes, observeErr = filesync.BuildLocalContextStream(root, name, filesync.MaxLocalContextStreamBytes)
+	} else {
+		observation, observeErr = filesync.ObserveLocalContext(root, name)
+	}
+	unmountErr := lm.Unmount()
+	if observeErr != nil {
+		return filesync.LocalContextObservation{}, nil, observeErr
+	}
+	if unmountErr != nil {
+		return filesync.LocalContextObservation{}, nil, unmountErr
+	}
+	return observation, streamBytes, nil
+}
