+func TestC1V22PublishedButObserverDeniedIsTerminalAndExplicit(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+	defer cancel()
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("APPROVED"), 0600))
+	snapshot, err := NewLinuxSealedSnapshotV15(ctx, v15Request(root, "app.js"))
+	require.NoError(t, err)
+	m := snapshot.Manifest()
+	p, pub, ledger := v15SignedPermitFixture(t, m)
+	s, err := session.NewSession(ctx, "v22-postcommit-refusal")
+	require.NoError(t, err)
+	manager, err := session.NewManager()
+	require.NoError(t, err)
+	s.Allow(NewSealedFSSyncProviderV15(snapshot))
+	g, ctx := errgroup.WithContext(ctx)
+	g.Go(func() error {
+		return s.Run(ctx, session.Dialer(testutil.TestStream(testutil.Handler(manager.HandleConn))))
+	})
+	g.Go(func() (retErr error) {
+		defer func() {
+			if err := s.Close(); retErr == nil {
+				retErr = err
+			}
+		}()
+		caller, err := manager.Get(ctx, s.ID(), false)
+		if err != nil {
+			return err
+		}
+		parent := t.TempDir()
+		if err := os.Chmod(parent, 0700); err != nil {
+			return err
+		}
+		dest := filepath.Join(parent, "published")
+		callbackCount := 0
+		opt := FSSendRequestOpt{Name: "context", FollowPaths: []string{"app.js"}, DestDir: dest,
+			OnConsumed: func(_ context.Context, obs LocalContextObservation) error {
+				callbackCount++
+				if obs.Name != "context" || obs.EntryCount != 1 {
+					return errors.New("wrong actual committed context")
+				}
+				return errors.New("synthetic C4 observer refused")
+			}}
+		err = FSSyncSealedV15(ctx, caller, opt, m, p, pub, ledger)
+		var terminal *V22PublishedButUnadmittedError
+		if !errors.As(err, &terminal) || !strings.Contains(terminal.Error(), "no retry or signing permitted") {
+			return fmt.Errorf("C1 V22 failed to distinguish published-but-unadmitted: %v", err)
+		}
+		if callbackCount != 1 {
+			return fmt.Errorf("C1 V22 callback ran %d times, expected once", callbackCount)
+		}
+		got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+		if err != nil {
+			return err
+		}
+		if string(got) != "APPROVED" {
+			return errors.New("C1 V22 published bytes changed after observer denial")
+		}
+		if err := FSSyncSealedV15(ctx, caller, opt, m, p, pub, ledger); err == nil {
+			return errors.New("C1 V22 repeated ambiguous published nonce")
+		}
+		return nil
+	})
+	require.NoError(t, g.Wait())
+}
