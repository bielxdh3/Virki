diff --git a/session/filesync/link_preflight_v14.go b/session/filesync/link_preflight_v14.go
new file mode 100644
index 0000000..6cf7c19
--- /dev/null
+++ b/session/filesync/link_preflight_v14.go
@@ -0,0 +1,75 @@
+package filesync
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"slices"
+	"strings"
+	"unicode"
+
+	"github.com/tonistiigi/fsutil"
+)
+
+// InspectStaticNoLinksV14 is a DEV-only client-side diagnostic; it is NOT
+// an immutable snapshot, attestation, confidentiality policy, or proof that
+// the sending process cannot change the underlying filesystem between this
+// walk and the later async fsutil.Open. It must never satisfy a release gate.
+//
+// The legitimate hard V14 safety guard runs on the worker and refuses V13
+// owner-filtered physical FileSync before the stream exists.
+func InspectStaticNoLinksV14(ctx context.Context, source fsutil.FS, follow []string) error {
+	if source == nil || len(follow) == 0 || len(follow) > 128 {
+		return errors.New("C1 V14 diagnostic requires a concrete FS and bounded nonempty FollowPaths")
+	}
+	for i, p := range follow {
+		if p == "" || p == "." || p == ".." || path.IsAbs(p) || path.Clean(p) != p ||
+			strings.ContainsAny(p, "\\*?[]:") || strings.IndexFunc(p, unicode.IsControl) >= 0 ||
+			(i > 0 && follow[i-1] >= p) {
+			return errors.New("C1 V14 diagnostic denies noncanonical FollowPaths")
+		}
+	}
+	// FollowLinks is exactly the vendor helper which would expand symlink
+	// targets to additional include patterns inside NewFilterFS. Its result is
+	// checked BEFORE any network send, not merely after receiving a tree.
+	expanded, err := fsutil.FollowLinks(source, follow)
+	if err != nil {
+		return fmt.Errorf("C1 V14 diagnostic failed to inspect link expansion: %w", err)
+	}
+	if !slices.Equal(expanded, follow) {
+		return errors.New("C1 V14 diagnostic refuses FollowLinks expansion beyond approved literal paths")
+	}
+	for _, selected := range follow {
+		seen := false
+		err := source.Walk(ctx, selected, func(p string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if entry == nil {
+				return fmt.Errorf("C1 V14 diagnostic missing entry %q", p)
+			}
+			seen = true
+			if entry.Type()&os.ModeSymlink != 0 {
+				return fmt.Errorf("C1 V14 diagnostic refuses link at %q", p)
+			}
+			info, err := entry.Info()
+			if err != nil {
+				return err
+			}
+			if info.Mode()&os.ModeSymlink != 0 {
+				return fmt.Errorf("C1 V14 diagnostic refuses linked entry %q", p)
+			}
+			return nil
+		})
+		if err != nil {
+			return fmt.Errorf("C1 V14 diagnostic walk %q refused: %w", selected, err)
+		}
+		if !seen {
+			return fmt.Errorf("C1 V14 diagnostic selected path %q was not observed", selected)
+		}
+	}
+	return nil
+}
diff --git a/session/filesync/link_preflight_v14_test.go b/session/filesync/link_preflight_v14_test.go
new file mode 100644
index 0000000..1eeb582
--- /dev/null
+++ b/session/filesync/link_preflight_v14_test.go
@@ -0,0 +1,86 @@
+package filesync
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tonistiigi/fsutil"
+)
+
+// This demonstrates a *static* test preflight on a real host FS; its success
+// does not freeze the filesystem. V14's worker denial is the actual safety
+// boundary, not this diagnostic helper.
+func TestC1V14StaticPreflightCatchesLinksWithoutClaimingTOCTOUSafety(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Windows symlink/reparse privileges are not equivalent to POSIX")
+	}
+	root := t.TempDir()
+	write := func(p, data string) {
+		t.Helper()
+		full := filepath.Join(root, p)
+		require.NoError(t, os.MkdirAll(filepath.Dir(full), 0700))
+		require.NoError(t, os.WriteFile(full, []byte(data), 0600))
+	}
+	link := func(target, name string) {
+		t.Helper()
+		require.NoError(t, os.Symlink(target, filepath.Join(root, name)))
+	}
+	write("app.js", "harmless")
+	write("secret.env", "sensitive")
+	write("assets/logo.svg", "logo")
+	fs, err := fsutil.NewFS(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	require.NoError(t, InspectStaticNoLinksV14(t.Context(), fs, []string{"app.js"}))
+	require.NoError(t, InspectStaticNoLinksV14(t.Context(), fs, []string{"app.js", "assets"}))
+	link("secret.env", "linked.js")
+	link("linked.js", "chained.js")
+	link("../secret.env", "assets/leak.env")
+	link("assets", "asset-link")
+	for _, tc := range []struct {
+		name  string
+		paths []string
+	}{
+		{"linked file", []string{"linked.js"}},
+		{"chained file", []string{"chained.js"}},
+		{"linked directory", []string{"asset-link"}},
+		{"link inside approved directory", []string{"assets"}},
+		{"another sibling target", []string{"assets", "linked.js"}},
+		// FollowLinks can return this SAME approved set even though linked.js
+		// points to secret.env. An expansion-equality check alone is unsafe.
+		{"link target also approved", []string{"linked.js", "secret.env"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := InspectStaticNoLinksV14(t.Context(), fs, tc.paths); err == nil {
+				t.Fatalf("static client link preflight accepted symlink path(s): %v", tc.paths)
+			}
+		})
+	}
+	link("/etc/hosts", "abs-link")
+	if err := InspectStaticNoLinksV14(t.Context(), fs, []string{"abs-link"}); err == nil {
+		t.Fatal("absolute symlink target escaped diagnostic preflight")
+	}
+	link("cycle-b", "cycle-a")
+	link("cycle-a", "cycle-b")
+	if err := InspectStaticNoLinksV14(t.Context(), fs, []string{"cycle-a"}); err == nil {
+		t.Fatal("cyclic symlinks accepted as a safe literal source")
+	}
+	for _, raw := range [][]string{{"../secret.env"}, {"app.js", "app.js"}, {"a*.js"}, {}, {"/etc/passwd"}, {"C:windows"}} {
+		if err := InspectStaticNoLinksV14(t.Context(), fs, raw); err == nil {
+			t.Fatalf("unsafe diagnostic FollowPaths admitted: %#v", raw)
+		}
+	}
+	// Critical TOCTOU illustration: a prior successful scan is NOT valid
+	// after a host mutation and cannot independently authorize a later Open.
+	require.NoError(t, os.Remove(filepath.Join(root, "app.js")))
+	link("secret.env", "app.js")
+	err = InspectStaticNoLinksV14(t.Context(), fs, []string{"app.js"})
+	if err == nil || !strings.Contains(err.Error(), "C1 V14") {
+		t.Fatalf("changed live source escaped recheck: %v", err)
+	}
+}
diff --git a/session/filesync/localcontext.go b/session/filesync/localcontext.go
new file mode 100644
index 0000000..076ebb4
--- /dev/null
+++ b/session/filesync/localcontext.go
@@ -0,0 +1,225 @@
+package filesync
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+const (
+	LocalContextTreeDigestSchema = "buildkit-worker-local-context-v2"
+	LocalContextStreamSchema     = "virki-context-stream-v1"
+	MaxLocalContextStreamBytes   = int64(64 * 1024 * 1024)
+)
+
+// LocalContextObservation describes the tree present in the worker destination
+// after a successful FileSync receive. RegularFileBytes excludes symlink target
+// strings, which are still included in TreeDigest.
+type LocalContextObservation struct {
+	Name             string
+	TreeDigestSchema string
+	TreeDigest       string
+	StreamDigest     string
+	StreamLength     int64
+	RegularFileBytes int64
+	EntryCount       int
+}
+
+type LocalContextObserver func(context.Context, LocalContextObservation) error
+
+// ObserveLocalContext measures an existing worker-side destination tree using
+// the canonical local-context digest format.
+func ObserveLocalContext(root, name string) (LocalContextObservation, error) {
+	obs, _, err := observeLocalContextImpl(root, name, false, 0)
+	return obs, err
+}
+
+// BuildLocalContextStream measures an existing worker-side destination tree and
+// emits its deterministic linear stream bounded by maxBytes.
+func BuildLocalContextStream(root, name string, maxBytes int64) (LocalContextObservation, []byte, error) {
+	if maxBytes <= 0 || maxBytes > MaxLocalContextStreamBytes {
+		maxBytes = MaxLocalContextStreamBytes
+	}
+	return observeLocalContextImpl(root, name, true, maxBytes)
+}
+
+func observeLocalContext(root, name string) (LocalContextObservation, error) {
+	obs, _, err := observeLocalContextImpl(root, name, false, 0)
+	return obs, err
+}
+
+func observeLocalContextImpl(root, name string, captureStream bool, maxBytes int64) (LocalContextObservation, []byte, error) {
+	rootInfo, err := os.Lstat(root)
+	if err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	if !rootInfo.IsDir() || rootInfo.Mode()&os.ModeSymlink != 0 {
+		return LocalContextObservation{}, nil, fmt.Errorf("local-source destination is not a real directory")
+	}
+
+	treeHash := sha256.New()
+	_, _ = treeHash.Write([]byte(LocalContextTreeDigestSchema + "\x00"))
+	var streamBuf bytes.Buffer
+	if captureStream {
+		_, _ = streamBuf.WriteString(LocalContextStreamSchema + "\x00")
+		writeSized(&streamBuf, []byte(name))
+		if int64(streamBuf.Len()) > maxBytes {
+			return LocalContextObservation{}, nil, fmt.Errorf("local-source stream exceeds %d bytes", maxBytes)
+		}
+	}
+	observation := LocalContextObservation{Name: name, TreeDigestSchema: LocalContextTreeDigestSchema}
+	err = filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == root {
+			return nil
+		}
+		relative, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		relative = filepath.ToSlash(relative)
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		mode := localContextModeBits(info.Mode())
+
+		switch {
+		case info.IsDir():
+			_, _ = treeHash.Write([]byte{'D'})
+			writeSized(treeHash, []byte(relative))
+			writeUint64(treeHash, mode)
+			if captureStream {
+				_ = streamBuf.WriteByte('D')
+				writeSized(&streamBuf, []byte(relative))
+				writeUint64(&streamBuf, mode)
+			}
+		case info.Mode()&os.ModeSymlink != 0:
+			target, err := os.Readlink(path)
+			if err != nil {
+				return err
+			}
+			_, _ = treeHash.Write([]byte{'L'})
+			writeSized(treeHash, []byte(relative))
+			writeUint64(treeHash, mode)
+			writeSized(treeHash, []byte(target))
+			if captureStream {
+				_ = streamBuf.WriteByte('L')
+				writeSized(&streamBuf, []byte(relative))
+				writeUint64(&streamBuf, mode)
+				writeSized(&streamBuf, []byte(target))
+			}
+		case info.Mode().IsRegular():
+			// Never block opening a file that raced into a FIFO. The Linux
+			// opener uses O_NONBLOCK | O_NOFOLLOW and the fstat below checks
+			// that the opened inode still matches the enumerated regular file.
+			file, err := openLocalContextRegularFile(path)
+			if err != nil {
+				return err
+			}
+			openedInfo, statErr := file.Stat()
+			if statErr != nil {
+				_ = file.Close()
+				return statErr
+			}
+			if !os.SameFile(info, openedInfo) || !openedInfo.Mode().IsRegular() || localContextModeBits(openedInfo.Mode()) != mode {
+				_ = file.Close()
+				return fmt.Errorf("local-source file changed while measuring %q", relative)
+			}
+			if captureStream {
+				if info.Size() < 0 || info.Size() > maxBytes || int64(streamBuf.Len()) > maxBytes-info.Size()-int64(len(relative))-25 {
+					_ = file.Close()
+					return fmt.Errorf("local-source stream exceeds %d bytes at %q", maxBytes, relative)
+				}
+				_ = streamBuf.WriteByte('F')
+				writeSized(&streamBuf, []byte(relative))
+				writeUint64(&streamBuf, mode)
+				writeUint64(&streamBuf, uint64(info.Size()))
+			}
+			contentHash := sha256.New()
+			var dst io.Writer = contentHash
+			if captureStream {
+				dst = io.MultiWriter(contentHash, &streamBuf)
+			}
+			size, copyErr := io.Copy(dst, file)
+			measuredInfo, statErr := file.Stat()
+			closeErr := file.Close()
+			if copyErr != nil {
+				return copyErr
+			}
+			if statErr != nil {
+				return statErr
+			}
+			if closeErr != nil {
+				return closeErr
+			}
+			if !os.SameFile(openedInfo, measuredInfo) || localContextModeBits(measuredInfo.Mode()) != mode || size != info.Size() || measuredInfo.Size() != size {
+				return fmt.Errorf("local-source file changed while measuring %q", relative)
+			}
+			if size > int64(^uint64(0)>>1)-observation.RegularFileBytes {
+				return fmt.Errorf("local-source byte count overflow")
+			}
+			observation.RegularFileBytes += size
+			observation.EntryCount++
+			_, _ = treeHash.Write([]byte{'F'})
+			writeSized(treeHash, []byte(relative))
+			writeUint64(treeHash, mode)
+			writeUint64(treeHash, uint64(size))
+			_, _ = treeHash.Write(contentHash.Sum(nil))
+		default:
+			return fmt.Errorf("unsupported local-source file type at %q", relative)
+		}
+		if captureStream && int64(streamBuf.Len()) > maxBytes {
+			return fmt.Errorf("local-source stream exceeds %d bytes", maxBytes)
+		}
+		if info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			observation.EntryCount++
+		}
+		return nil
+	})
+	if err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	observation.TreeDigest = "sha256:" + hex.EncodeToString(treeHash.Sum(nil))
+	if captureStream {
+		streamBytes := streamBuf.Bytes()
+		sum := sha256.Sum256(streamBytes)
+		observation.StreamDigest = "sha256:" + hex.EncodeToString(sum[:])
+		observation.StreamLength = int64(len(streamBytes))
+		return observation, streamBytes, nil
+	}
+	return observation, nil, nil
+}
+
+func writeSized(h io.Writer, value []byte) {
+	writeUint64(h, uint64(len(value)))
+	_, _ = h.Write(value)
+}
+
+func writeUint64(h io.Writer, value uint64) {
+	var encoded [8]byte
+	binary.BigEndian.PutUint64(encoded[:], value)
+	_, _ = h.Write(encoded[:])
+}
+
+func localContextModeBits(mode os.FileMode) uint64 {
+	bits := uint64(mode.Perm())
+	if mode&os.ModeSetuid != 0 {
+		bits |= 04000
+	}
+	if mode&os.ModeSetgid != 0 {
+		bits |= 02000
+	}
+	if mode&os.ModeSticky != 0 {
+		bits |= 01000
+	}
+	return bits
+}
diff --git a/session/filesync/localcontext_open_linux.go b/session/filesync/localcontext_open_linux.go
new file mode 100644
index 0000000..da1f0d9
--- /dev/null
+++ b/session/filesync/localcontext_open_linux.go
@@ -0,0 +1,42 @@
+//go:build linux
+
+package filesync
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// Open through one pinned directory descriptor, refusing symlinks at EVERY
+// path component. O_NONBLOCK prevents a FIFO/device race from hanging, and
+// Fstat refuses every nonregular inode before any content can be read.
+func openLocalContextRegularFile(path string) (*os.File, error) {
+	if !strings.HasPrefix(path, "/") || path == "/" {
+		return nil, fmt.Errorf("local context source must be an absolute non-root path")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(rootFD)
+	fd, err := unix.Openat2(rootFD, strings.TrimPrefix(path, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_NONBLOCK | unix.O_NOFOLLOW | unix.O_CLOEXEC),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return nil, err
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG {
+		_ = unix.Close(fd)
+		return nil, fmt.Errorf("local source is not a regular file: mode %#o", st.Mode)
+	}
+	return os.NewFile(uintptr(fd), path), nil
+}
diff --git a/session/filesync/localcontext_open_linux_test.go b/session/filesync/localcontext_open_linux_test.go
new file mode 100644
index 0000000..1cbf820
--- /dev/null
+++ b/session/filesync/localcontext_open_linux_test.go
@@ -0,0 +1,108 @@
+//go:build linux
+
+package filesync
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestLocalContextOpenRejectsSymlink(t *testing.T) {
+	dir := t.TempDir()
+	regular := filepath.Join(dir, "regular")
+	link := filepath.Join(dir, "link")
+	if err := os.WriteFile(regular, []byte("ok"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(regular, link); err != nil {
+		if errors.Is(err, syscall.EPERM) || errors.Is(err, syscall.EOPNOTSUPP) {
+			t.Skipf("filesystem does not support symlinks: %v", err)
+		}
+		t.Fatal(err)
+	}
+	fd, err := openLocalContextRegularFile(link)
+	if fd != nil {
+		fd.Close()
+		t.Fatal("followed forbidden path symlink")
+	}
+	if err == nil {
+		t.Fatal("opening symlink did not fail closed")
+	}
+}
+
+func TestLocalContextOpenDoesNotBlockOnReplacedFIFO(t *testing.T) {
+	name := filepath.Join(t.TempDir(), "replacement")
+	if err := syscall.Mkfifo(name, 0600); err != nil {
+		var info syscall.Statfs_t
+		fsErr := syscall.Statfs(filepath.Dir(name), &info)
+		if fsErr == nil && uint64(info.Type) == 0x01021997 &&
+			(errors.Is(err, syscall.EPERM) || errors.Is(err, syscall.EOPNOTSUPP)) {
+			t.Skipf("FIFO unsupported on v9fs / E: WSL; POSIX Linux must exercise FIFO: %v", err)
+		}
+		t.Fatalf("FIFO setup failed on non-v9fs filesystem: %v (statfs error: %v)", err, fsErr)
+	}
+	done := make(chan error, 1)
+	go func() {
+		fd, err := openLocalContextRegularFile(name)
+		if fd != nil {
+			fd.Close()
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("accepted FIFO after regular-file replacement")
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("blocking FIFO open defeats the worker context boundary")
+	}
+}
+
+func TestLocalContextOpenRejectsIntermediateSymlinkWithoutReading(t *testing.T) {
+	base := t.TempDir()
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "secret"), []byte("secret"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(base, "alias")); err != nil {
+		t.Fatal(err)
+	}
+	fd, err := openLocalContextRegularFile(filepath.Join(base, "alias", "secret"))
+	if fd != nil {
+		_ = fd.Close()
+		t.Fatal("intermediate symlink allowed secret read")
+	}
+	if err == nil {
+		t.Fatal("intermediate symlink did not fail closed")
+	}
+}
+
+func TestBuildLocalContextStreamDeterministicAndBounded(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Mkdir(filepath.Join(dir, "sub"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "sub", "hello.txt"), []byte("virki-stream-content"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	obs1, stream1, err := BuildLocalContextStream(dir, "source", MaxLocalContextStreamBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	obs2, stream2, err := BuildLocalContextStream(dir, "source", MaxLocalContextStreamBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if obs1.TreeDigest != obs2.TreeDigest || obs1.StreamDigest != obs2.StreamDigest ||
+		obs1.StreamLength != int64(len(stream1)) || string(stream1) != string(stream2) {
+		t.Fatalf("non-deterministic local context stream: %+v vs %+v", obs1, obs2)
+	}
+	if _, _, err := BuildLocalContextStream(dir, "source", 16); err == nil {
+		t.Fatal("expected stream size bound error")
+	}
+}
