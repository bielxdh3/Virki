+package filesync
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// verifyV15Destination rejects missing, unexpected and nonregular received
+// paths, symlinks and mismatched bytes. It is an AFTER-RECEIVE diagnostic;
+// a trusted sender/worker must separately prove no extra bytes arrived.
+func verifyV15Destination(dest string, m V15SealedManifest) error {
+	if m.Digest == "" || v15ManifestDigest(m) != m.Digest {
+		return errors.New("C1 V15 destination has unbound manifest")
+	}
+	expected := make(map[string]string, len(m.Files))
+	allowedDirs := map[string]bool{}
+	for _, pin := range m.Files {
+		expected[pin.Path] = pin.SHA256
+		parts := strings.Split(pin.Path, "/")
+		for i := 1; i < len(parts); i++ {
+			allowedDirs[strings.Join(parts[:i], "/")] = true
+		}
+	}
+	seen := make(map[string]bool, len(expected))
+	err := filepath.WalkDir(dest, func(p string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if p == dest {
+			return nil
+		}
+		rel, err := filepath.Rel(dest, p)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		if entry.Type()&os.ModeSymlink != 0 {
+			return fmt.Errorf("C1 V15 received unexpected symlink at %q", rel)
+		}
+		if entry.IsDir() {
+			if !allowedDirs[rel] {
+				return fmt.Errorf("C1 V15 unapproved received directory %q", rel)
+			}
+			return nil
+		}
+		want, ok := expected[rel]
+		if !ok || !entry.Type().IsRegular() {
+			return fmt.Errorf("C1 V15 received unapproved or nonregular file %q", rel)
+		}
+		data, err := os.ReadFile(p)
+		if err != nil {
+			return err
+		}
+		if len(data) > 16<<20 || v15Hash(data) != want {
+			return fmt.Errorf("C1 V15 received bytes fail independently expected hash %q", rel)
+		}
+		seen[rel] = true
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if len(seen) != len(expected) {
+		return errors.New("C1 V15 received incomplete file set")
+	}
+	return nil
+}
