+		"forged platform":         func(p *DockerfileTransformV4) { p.Roots[0].Platform = "linux/arm64" },
+		"unproven valid ignore":   func(p *DockerfileTransformV4) { p.Read.IgnorePresent = true; p.Read.IgnorePath = ".dockerignore" },
+		"mismatched final root":   func(p *DockerfileTransformV4) { p.Roots[0].RootVertex = SHA256BytesV4([]byte("other-root")) },
+		"mismatched ref":          func(p *DockerfileTransformV4) { p.Roots[0].RefID = "other-ref" },
+		"mismatched output index": func(p *DockerfileTransformV4) { p.Roots[0].OutputIndex = 1 },
