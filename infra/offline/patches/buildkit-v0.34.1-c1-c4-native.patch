+		{"absent yet file entry", func(r *Consumption) { r.EntryCount = 1 }},
+		{"absent yet bytes", func(r *Consumption) { r.RegularFileBytes = 1 }},
+		{"auxiliary impersonates source", func(r *Consumption) { r.Name = "source" }},
