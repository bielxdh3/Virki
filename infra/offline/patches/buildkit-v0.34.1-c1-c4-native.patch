@@ -0,0 +1,235 @@
+package localcontext
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// RootDockerignoreRoleV10 is deliberately separate from all four canonical
+// local contexts: it represents the auxiliary, filtered root .dockerignore
+// probe, NEVER the main source snapshot consumed by COPY.
+const RootDockerignoreRoleV10 = "root-dockerignore-v10"
+
+// RequireOwnerPinnedCanonicalSessionV10 closes the V9 legacy-name pretransfer
+// gap: source/dockerfile/offline input must not transfer via an arbitrary
+// client-selected session and get rejected only after FSSync. All four
+// canonical sessions must be explicitly approved in the owner scope.
+func RequireOwnerPinnedCanonicalSessionV10(ctx context.Context, name, sessionID string) error {
+	if ctx == nil || !isRequiredContext(name) {
+		return errors.New("C1 V10 invalid canonical local source or missing scope")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V10 canonical source lacks owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V10 canonical source scope has expired or terminated")
+	}
+	expected := scope.auth.ContextSessionIDsV8[name]
+	if len(scope.auth.ContextSessionIDsV8) != len(requiredContexts) ||
+		expected == "" || !validIdentifier(expected) || strings.Contains(expected, ":") ||
+		sessionID != expected {
+		return fmt.Errorf("C1 V10 canonical %q session is not pinned by owner approval", name)
+	}
+	return nil
+}
+
+// RequireOwnerPinnedRootIgnoreV10 refuses the auxiliary FileSync transfer
+// without a distinct owner-issued source session/tree/presence approval. It
+// must run before CacheKey, outer Snapshot and inner snapshot. This is a
+// dormant diagnostic: current native C4 cannot independently issue the
+// approval and protected C1 Dockerfile frontend remains disabled.
+func RequireOwnerPinnedRootIgnoreV10(ctx context.Context, sessionID string) error {
+	if ctx == nil {
+		return errors.New("C1 V10 root ignore probe has no private owner scope")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V10 root ignore probe has no owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V10 root ignore scope expired or terminated")
+	}
+	approved := scope.auth.RootDockerignoreV10
+	if approved == nil {
+		return errors.New("C1 V10 root ignore probe lacks distinct owner approval")
+	}
+	if scope.auth.RequirePreferredMissingV12 && !scope.preferredDockerignoreMissingVerifiedV12 {
+		return errors.New("C1 V12 root probe requires verified canonical preferred Dockerfile ENOENT before FileSync")
+	}
+	// The current builtin frontend chooses exactly the same session for
+	// root ignore as its main context, but the snapshots are DIFFERENT.
+	if sessionID == "" || strings.Contains(sessionID, ":") ||
+		approved.SessionID != sessionID ||
+		scope.auth.ContextSessionIDsV8["source"] != sessionID {
+		return errors.New("C1 V10 root ignore session mismatches pinned main-context session")
+	}
+	if scope.auxiliaryRootIgnoreV10 != nil {
+		return errors.New("C1 V10 root ignore probe is already observed")
+	}
+	return nil
+}
+
+// ClaimRootIgnoreFileSyncV11 is the actual transfer boundary, not CacheKey
+// or outer Snapshot. At most one inner worker snapshot can pass this claim
+// for an approved auxiliary probe. Once claimed, failure is terminal for this
+// solve generation: a partially sent stream is never automatically retried.
+func ClaimRootIgnoreFileSyncV11(ctx context.Context) error {
+	if ctx == nil {
+		return errors.New("C1 V11 root ignore FileSync has no scope")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V11 root ignore FileSync has no owner scope")
+	}
