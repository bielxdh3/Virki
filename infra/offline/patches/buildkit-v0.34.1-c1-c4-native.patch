+package local
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/stretchr/testify/require"
+)
+
+type v8NoopObserver struct{}
+
+func (v8NoopObserver) ContextConsumed(context.Context, localcontext.Consumption) error { return nil }
+
+func v8OptionalOwnerWithManager(t *testing.T) (context.Context, *localcontext.Manager) {
+	t.Helper()
+	exporter, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "c1.example/runtime:v8"})
+	require.NoError(t, err)
+	manager, err := localcontext.NewManager(v7OptionalOwnerService{}, false)
+	require.NoError(t, err)
+	ctx, scope, err := manager.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-source-v8", Role: "runtime", Nonce: strings.Repeat("8", 32),
+		ApprovalID: "approval-source-v8", ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: exporter,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	return ctx, manager
+}
+
+func TestC1V8RequiredWorkerObserverMustBeInstalledBeforeLocalTransfer(t *testing.T) {
+	missing := &localSourceHandler{
+		localSource: &localSource{requireConsumptionObserver: true},
+		src:         LocalIdentifier{Name: "dockerfile", SessionID: "session-v8"},
+	}
+	_, _, _, _, err := missing.CacheKey(t.Context(), v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "no installed worker consumption observer")
+	ref, err := missing.Snapshot(t.Context(), v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "no installed worker consumption observer")
+
+	// Existing optional-global service from V7: this solve still carries a
+	// genuine private Manager.BeginSolve owner scope. The global flag cannot
+	// bypass the required worker observation callback.
+	ownerCtx, manager := v8OptionalOwnerWithManager(t)
+	optional := &localSourceHandler{
+		localSource: &localSource{requireConsumptionObserver: false},
+		src:         LocalIdentifier{Name: "dockerfile", SessionID: "session-v8"},
+	}
+	_, _, _, _, err = optional.CacheKey(ownerCtx, v7SessionJobContext{}, 0)
+	require.ErrorContains(t, err, "no installed worker consumption observer")
+	ref, err = optional.Snapshot(ownerCtx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "no installed worker consumption observer")
+
+	// When no owner scope is present, the safety preflight itself does not
+	// forbid the existing optional observer configuration. A real cache lookup
+	// would be exercised separately, so inspect only the preflight here.
+	require.NoError(t, optional.ensureOwnerScopedObserverV8(t.Context()))
+	optional.localSource.consumptionObserver = v8NoopObserver{}
+	require.ErrorContains(t, optional.ensureOwnerScopedObserverV8(ownerCtx), "does not match owner-reserved")
+	foreignManager, err := localcontext.NewManager(v7OptionalOwnerService{}, false)
+	require.NoError(t, err)
+	optional.localSource.consumptionObserver = foreignManager
+	require.ErrorContains(t, optional.ensureOwnerScopedObserverV8(ownerCtx), "does not match owner-reserved")
+	optional.localSource.consumptionObserver = manager
+	require.NoError(t, optional.ensureOwnerScopedObserverV8(ownerCtx))
+}
