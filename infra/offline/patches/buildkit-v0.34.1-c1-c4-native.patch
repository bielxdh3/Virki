+	}
+	requiredContexts := RequiredContextNames()
+	identities := make(map[string]string, len(requiredContexts))
+	for _, name := range requiredContexts {
+		identities[name] = "owner-context:" + name
+	}
+	expectedImage := testImageDescriptor("sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
+	if f.expectedOutput != (ImageDescriptor{}) {
+		expectedImage = f.expectedOutput
+	}
+	generation := binding.Nonce
+	if f.generation != "" {
+		generation = f.generation
+	}
+	return Authorization{
+		Token:                   "owner-token-c1-01",
+		Generation:              generation,
+		WorkerID:                testWorker,
+		ContextIdentities:       identities,
+		ContextTreeDigestSchema: BuildKitContextTreeDigestSchema,
+		ContextTreeDigests:      approvedDigests(),
+		ExporterPolicy:          binding.Exporter,
+		ExpectedImage:           expectedImage,
+		ExpiresAt:               time.Now().Add(time.Minute),
+	}, nil
