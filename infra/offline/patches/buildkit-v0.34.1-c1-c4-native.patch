@@ -0,0 +1,112 @@
+package filesync
+
+import (
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/tonistiigi/fsutil/types"
+	"google.golang.org/grpc"
+)
+
+type v15PacketFixtureStream struct {
+	grpc.ClientStream
+	packets []*types.Packet
+}
+
+func (f *v15PacketFixtureStream) RecvMsg(dst any) error {
+	if len(f.packets) == 0 {
+		return io.EOF
+	}
+	p := f.packets[0]
+	f.packets = f.packets[1:]
+	*dst.(*types.Packet) = *p
+	return nil
+}
+
+func v15PacketManifest() V15SealedManifest {
+	m := V15SealedManifest{Schema: "virki-c1-v15-memory-fs-1", ContextName: "context",
+		WorkerID: "worker", SessionID: "session", Nonce: strings.Repeat("a", 32),
+		Files: []V15FilePin{{Path: "app.js", SHA256: v15Hash([]byte("SAFE")), Size: 4}}, Bytes: 4}
+	m.Digest = v15ManifestDigest(m)
+	return m
+}
+
+func v15StatPacket(path string, mode uint32, size int64) *types.Packet {
+	return &types.Packet{Type: types.PACKET_STAT, Stat: &types.Stat{Path: path, Mode: mode, Size: size,
+		Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid())}}
+}
+
+func TestC1V15GuardDeniesHostileSTATBeforeDiskWriter(t *testing.T) {
+	m := v15PacketManifest()
+	for _, tc := range []struct {
+		name   string
+		mutate func(*types.Packet)
+	}{
+		{"secret sibling", func(p *types.Packet) { p.Stat.Path = "secret.env" }},
+		{"absolute", func(p *types.Packet) { p.Stat.Path = "/etc/passwd" }},
+		{"traversal", func(p *types.Packet) { p.Stat.Path = "../secret.env" }},
+		{"symlink", func(p *types.Packet) { p.Stat.Mode = uint32(os.ModeSymlink | 0777); p.Stat.Linkname = "secret.env" }},
+		{"directory mode", func(p *types.Packet) { p.Stat.Mode = uint32(os.ModeDir | 0755) }},
+		{"file size inflated", func(p *types.Packet) { p.Stat.Size = 1 << 30 }},
+		{"unexpected root metadata", func(p *types.Packet) { p.Stat.Uid = 0xffffffff }},
+		{"unexpected xattr", func(p *types.Packet) { p.Stat.Xattrs = map[string][]byte{"security.capability": []byte("danger")} }},
+		{"unexpected timestamp", func(p *types.Packet) { p.Stat.ModTime = 1720000000000 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := v15StatPacket("app.js", 0644, 4)
+			tc.mutate(p)
+			guard := newV15PacketGuard(&v15PacketFixtureStream{packets: []*types.Packet{p}}, m)
+			var received types.Packet
+			require.Error(t, guard.RecvMsg(&received))
+		})
+	}
+	guard := newV15PacketGuard(&v15PacketFixtureStream{packets: []*types.Packet{
+		v15StatPacket("app.js", 0644, 4), v15StatPacket("secret.env", 0644, 6)}}, m)
+	var recv types.Packet
+	require.NoError(t, guard.RecvMsg(&recv))
+	require.Error(t, guard.RecvMsg(&recv))
+}
+
+func TestC1V15GuardDeniesExtraBytesWrongSHAAndPartialFIN(t *testing.T) {
+	m := v15PacketManifest()
+	for _, tc := range []struct {
+		name    string
+		packets []*types.Packet
+		failAt  int
+	}{
+		{"wrong digest", []*types.Packet{v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_DATA, ID: 0, Data: []byte("EVIL")}, {Type: types.PACKET_DATA, ID: 0}}, 4},
+		{"oversized data", []*types.Packet{v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_DATA, ID: 0, Data: []byte("DANGER")}}, 3},
+		{"wrong packet ID", []*types.Packet{v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_DATA, ID: 2, Data: []byte("SAFE")}}, 3},
+		{"premature FIN", []*types.Packet{v15StatPacket("app.js", 0644, 4), {Type: types.PACKET_STAT},
+			{Type: types.PACKET_FIN}}, 3},
+		{"missing stat", []*types.Packet{{Type: types.PACKET_STAT}}, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			guard := newV15PacketGuard(&v15PacketFixtureStream{packets: tc.packets}, m)
+			for i := 1; i < tc.failAt; i++ {
+				var recv types.Packet
+				require.NoError(t, guard.RecvMsg(&recv), "packet %d", i)
+			}
+			var recv types.Packet
+			require.Error(t, guard.RecvMsg(&recv))
+		})
+	}
+}
+
+func TestC1V18RejectsDataBeforeCompleteStatManifest(t *testing.T) {
+	m := v15PacketManifest()
+	stream := &v15PacketFixtureStream{packets: []*types.Packet{
+		v15StatPacket("app.js", 0644, 4),
+		{Type: types.PACKET_DATA, ID: 0, Data: []byte("SAFE")},
+	}}
+	g := newV15PacketGuard(stream, m)
+	var packet types.Packet
+	require.NoError(t, g.RecvMsg(&packet))
+	require.ErrorContains(t, g.RecvMsg(&packet), "before complete")
+}
