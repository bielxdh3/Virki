+//go:build !linux
+
+package filesync
+
+import "errors"
+
+type V24ReceiverCustodyPolicy struct {
+	RequireUnprivileged         bool
+	RequirePrivateParent        bool
+	RequireImmutableGrandparent bool
+	ExpectedReceiverUID         *uint32
+	ExpectedReceiverGID         *uint32
+	ForbiddenPeerUIDs           []uint32
+	ExpectedSenderUID           *uint32
+	ExpectedSenderGID           *uint32
+	PrivateTempDir              string
+}
+
+func validateV24IndependentCustody(_ string, _ V24ReceiverCustodyPolicy) error {
+	return errors.New("C1 V24 independent receiver custody requires Linux")
+}
+
+func defaultV24ReceiverCustodyPolicy() V24ReceiverCustodyPolicy {
+	return V24ReceiverCustodyPolicy{
+		RequirePrivateParent: true,
+	}
+}
+
+func receiveV24WithCustody(_ string, _ V15SealedManifest, _ V24ReceiverCustodyPolicy, _ func(string) error) error {
+	return errors.New("C1 V24 receiver custody requires Linux; non-Linux denied")
+}
