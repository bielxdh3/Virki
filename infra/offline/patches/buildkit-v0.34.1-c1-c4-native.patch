+func TestC1V11LegacyOwnerTransportCannotSilentlyAcknowledgeExperimentalCompletion(t *testing.T) {
+	// Deliberately use a service with NO socket. If an experimental completion
+	// ever reaches dial, the rejection will no longer be specifically the
+	// missing versioned acknowledgement capability.
+	service := &UnixSocketService{}
+	for _, completion := range []Completion{
+		{SchemaVersion: 10},
+		{SchemaVersion: 11},
+		{SchemaVersion: 12},
+		{SchemaVersion: 13},
+		{SchemaVersion: 2, MainFollowPathsV13: &MainFollowPathsProofV13{}},
+		{SchemaVersion: 2, Authorization: Authorization{MainFollowPathsV13: []string{"app.js"}}},
+		{SchemaVersion: 2, Authorization: Authorization{MainFollowPathsV13: []string{}}},
+		{SchemaVersion: 2, RootDockerignoreV10: &Consumption{}},
+		{SchemaVersion: 2, RootIgnoreExcludesV11: &RootIgnoreExcludesProofV11{}},
+		{SchemaVersion: 2, Authorization: Authorization{BindRootIgnoreExcludesV11: true}},
+		{SchemaVersion: 2, PreferredDockerignoreV12: &PreferredDockerignoreProofV12{}},
+		{SchemaVersion: 2, Authorization: Authorization{PreferredDockerignoreV12: &PreferredDockerignoreApprovalV12{}}},
+	} {
+		err := service.Complete(t.Context(), completion)
+		if err == nil || !strings.Contains(err.Error(), "cannot acknowledge V10/V11") {
+			t.Fatalf("legacy owner transport did not fail closed for schema %d: %v", completion.SchemaVersion, err)
+		}
+	}
+}
+
+func TestC1V12LegacyOwnerBeginRejectsExperimentalApprovalsBeforeSolve(t *testing.T) {
+	for _, a := range []Authorization{
+		{RootDockerignoreV10: &RootDockerignoreApprovalV10{}},
+		{BindRootIgnoreExcludesV11: true},
+		{PreferredDockerignoreV12: &PreferredDockerignoreApprovalV12{}},
+		{MainFollowPathsV13: []string{"app.js"}},
+		{MainFollowPathsV13: []string{}},
+		{RequirePreferredMissingV12: true},
+	} {
+		if err := refuseLegacyExperimentalBeginV12(a); err == nil || !strings.Contains(err.Error(), "cannot begin experimental") {
+			t.Fatalf("legacy owner Begin accepted experimental policy: %+v, %v", a, err)
+		}
+	}
+	if err := refuseLegacyExperimentalBeginV12(Authorization{}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUnixSocketProtocolRoundTripCarriesCanonicalCompletion(t *testing.T) {
+	service := &UnixSocketService{}
+	binding := testBinding()
+	authorizedImage := testImageDescriptor("sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
+	begin := ServiceRequest{Version: 1, Operation: "begin", Binding: &binding}
+	beginResponse := ServiceResponse{Version: 1, OK: true, Authorization: &Authorization{
+		Token: "owner-token-c1-01", Generation: testNonce, WorkerID: testWorker,
+		ExporterPolicy: binding.Exporter, ExpectedImage: authorizedImage,
+		ContextIdentities: map[string]string{
+			"source":                 "owner-context:source",
+			"dockerfile":             "owner-context:dockerfile",
+			"offline-npm-cacache":    "owner-context:offline-npm-cacache",
+			"offline-prisma-engines": "owner-context:offline-prisma-engines",
+		},
+		ContextTreeDigestSchema: BuildKitContextTreeDigestSchema,
+		ContextTreeDigests:      approvedDigests(),
+		ExpiresAt:               time.Now().Add(time.Minute),
+	}}
+	response, request := roundTripObserverMessage(t, service, begin, beginResponse)
+	if request.Operation != "begin" || request.Binding == nil || request.Binding.JobID != testJobID {
+		t.Fatalf("unexpected begin request: %+v", request)
+	}
+	if !response.OK || response.Authorization == nil || response.Authorization.WorkerID != testWorker {
+		t.Fatalf("unexpected begin response: %+v", response)
+	}
+
+	contexts := make([]Consumption, 0, len(RequiredContextNames()))
+	for _, name := range RequiredContextNames() {
+		record := testConsumption(name)
+		record.Generation = testNonce
+		record.ContextIdentity = "owner-context:" + name
+		contexts = append(contexts, record)
+	}
+	records := make(map[string]Consumption, len(contexts))
+	for _, record := range contexts {
+		records[record.Name] = record
+	}
+	scope := &SolveScope{auth: *beginResponse.Authorization, records: records}
+	completion := Completion{
+		SchemaVersion: 2,
+		Binding:       binding,
+		Authorization: *beginResponse.Authorization,
+		Contexts:      contexts,
+		Output:        testOutput(scope),
+	}
+	completeRequest := ServiceRequest{
+		Version:            1,
+		Operation:          "complete",
+		AuthorizationToken: beginResponse.Authorization.Token,
+		Completion:         &completion,
+	}
+	response, request = roundTripObserverMessage(t, service, completeRequest, ServiceResponse{Version: 1, OK: true})
+	if !response.OK || request.Operation != "complete" || request.Completion == nil || len(request.Completion.Contexts) != 4 {
+		t.Fatalf("unexpected complete round trip: request %+v, response %+v", request, response)
+	}
+	if request.Completion.Contexts[0].Name != "source" || request.Completion.Contexts[3].Name != "offline-prisma-engines" {
+		t.Fatalf("completion contexts are not canonical: %+v", request.Completion.Contexts)
+	}
+}
+
+func TestUnixSocketProtocolRejectsUnknownResponseFields(t *testing.T) {
+	service := &UnixSocketService{}
+	for _, sample := range []struct {
+		responseJSON string
+		expected     string
+	}{
+		{`{"version":1,"ok":true,"unrecognized":true}`, "unknown field"},
+		{`{"version":1,"ok":true,"error":"conflicting"}`, "conflicting status fields"},
+	} {
+		clientConn, serverConn := net.Pipe()
+		go func() {
+			defer serverConn.Close()
+			var request ServiceRequest
+			if err := json.NewDecoder(serverConn).Decode(&request); err != nil {
+				return
+			}
+			_, _ = serverConn.Write([]byte(sample.responseJSON + "\n"))
+		}()
+		if _, err := service.callOnConn(context.Background(), clientConn, ServiceRequest{Version: 1, Operation: "abort"}); err == nil || !strings.Contains(err.Error(), sample.expected) {
+			_ = clientConn.Close()
+			t.Fatalf("invalid response did not reach its intended validator: %s: %v", sample.responseJSON, err)
+		}
+		_ = clientConn.Close()
+	}
+}
+
+func TestUnixSocketProtocolReadsOneFrameWithoutWaitingForPeerClose(t *testing.T) {
+	service := &UnixSocketService{}
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	defer serverConn.Close()
+	release := make(chan struct{})
+	defer close(release)
+	serverDone := make(chan error, 1)
+	go func() {
+		var request ServiceRequest
+		if err := json.NewDecoder(serverConn).Decode(&request); err != nil {
+			serverDone <- err
+			return
+		}
+		if err := json.NewEncoder(serverConn).Encode(ServiceResponse{Version: 1, OK: true}); err != nil {
+			serverDone <- err
+			return
+		}
+		// A valid service can keep the stream open after its complete frame.
+		<-release
+		serverDone <- nil
+	}()
+	response, err := service.callOnConn(context.Background(), clientConn, ServiceRequest{
+		Version: 1, Operation: "abort", AuthorizationToken: "dev-test",
+	})
+	if err != nil || !response.OK {
+		t.Fatalf("valid framed response must not wait for peer EOF: response=%+v err=%v", response, err)
+	}
+}
+
+func TestUnixSocketProtocolRejectsOverlongAndMultipleFrames(t *testing.T) {
+	for _, payload := range []string{
+		strings.Repeat("x", maxServiceMessageBytes+1) + "\n",
+		"{\"version\":1,\"ok\":true}\n{\"version\":1,\"ok\":true}\n",
+		"{\"version\":1,\"ok\":true}",
+	} {
+		client, server := net.Pipe()
+		go func() {
+			defer server.Close()
+			var request ServiceRequest
+			if json.NewDecoder(server).Decode(&request) == nil {
+				_, _ = server.Write([]byte(payload))
+			}
+		}()
+		if _, err := (&UnixSocketService{}).callOnConn(context.Background(), client,
+			ServiceRequest{Version: 1, Operation: "abort"}); err == nil {
+			client.Close()
+			t.Fatal("oversized, multiple, or unterminated owner response was accepted")
+		}
+		client.Close()
+	}
+}
+
+func TestUnixSocketServiceRejectsUnauthenticatedPeer(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	defer serverConn.Close()
+	service := &UnixSocketService{ownerUID: uint32(os.Getuid())}
+	if err := service.verifyConnectedPeer(clientConn); err == nil {
+		t.Fatal("non-Unix peer was accepted as authenticated owner service")
+	}
+	if os.Geteuid() != 0 {
+		service.path = "/run/virki/owner.sock"
+		if err := service.verifySocketPath(); err == nil {
+			t.Fatal("same nonroot UID owner service was accepted")
+		}
+	}
+}
+
+func TestUnixSocketServiceAuthenticatesConnectedSocketPairPeer(t *testing.T) {
+	descriptors, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	localFile := os.NewFile(uintptr(descriptors[0]), "observer-local-peer")
+	peerFile := os.NewFile(uintptr(descriptors[1]), "observer-owner-peer")
+	defer peerFile.Close()
+	conn, err := net.FileConn(localFile)
+	localFile.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	service := &UnixSocketService{ownerUID: uint32(os.Geteuid())}
+	if err := service.verifyConnectedPeer(conn); err != nil {
+		t.Fatalf("actual connected Unix peer credentials were not accepted: %v", err)
+	}
+	service.ownerUID++
+	if err := service.verifyConnectedPeer(conn); err == nil {
+		t.Fatal("accepted connected Unix peer with incorrect pinned UID")
+	}
+}
+
+func TestUnixSocketServiceRejectsUnsafeSocketPaths(t *testing.T) {
+	_, socketPath := listenObserverTestSocket(t)
+	if err := os.Chmod(socketPath, 0666); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NewUnixSocketService(socketPath, uint32(os.Getuid())); err == nil {
+		t.Fatal("world-writable observer socket was accepted")
+	}
+	if _, err := NewUnixSocketService(filepath.Join(filepath.Dir(socketPath), "missing.sock"), uint32(os.Getuid())); err == nil {
+		t.Fatal("missing observer socket was accepted")
+	}
+	if _, err := NewUnixSocketService("relative.sock", uint32(os.Getuid())); err == nil {
+		t.Fatal("relative observer socket path was accepted")
+	}
+}
+
+func roundTripObserverMessage(t *testing.T, service *UnixSocketService, request ServiceRequest, response ServiceResponse) (ServiceResponse, ServiceRequest) {
+	t.Helper()
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	requestCh := make(chan ServiceRequest, 1)
+	serverErr := make(chan error, 1)
+	go func() {
+		defer serverConn.Close()
+		var incoming ServiceRequest
+		if err := json.NewDecoder(serverConn).Decode(&incoming); err != nil {
+			serverErr <- err
+			return
+		}
+		requestCh <- incoming
+		if err := json.NewEncoder(serverConn).Encode(response); err != nil {
+			serverErr <- err
+		}
+	}()
+	gotResponse, err := service.callOnConn(context.Background(), clientConn, request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-serverErr:
+		t.Fatal(err)
+	default:
+	}
+	return gotResponse, <-requestCh
+}
+
+func listenObserverTestSocket(t *testing.T) (net.Listener, string) {
+	t.Helper()
+	root := os.Getenv("BUILDKIT_TEST_UNIX_SOCKET_DIR")
+	if root == "" {
+		root = t.TempDir()
+	}
+	directory, err := os.MkdirTemp(root, "lc-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	socketPath := filepath.Join(directory, "observer.sock")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		if errors.Is(err, syscall.EOPNOTSUPP) || errors.Is(err, syscall.EAFNOSUPPORT) {
+			_ = os.Remove(directory)
+			t.Skipf("temporary filesystem does not support Unix sockets: %v", err)
+		}
+		_ = os.Remove(directory)
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = listener.Close()
+		_ = os.Remove(socketPath)
+		_ = os.Remove(directory)
+	})
+	return listener, socketPath
+}
