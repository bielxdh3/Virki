+package localcontext
+
+import (
+	"context"
+	"errors"
+	"io/fs"
+	"sync"
+	"testing"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestC1BuiltinFrontendEventsV4BindParserBytesAndGeneratedRoots(t *testing.T) {
+	log := NewBuiltinFrontendEventsV4()
+	ctx := WithBuiltinFrontendEventsV4(context.Background(), log)
+	read := []byte("FROM scratch\n")
+	root := SHA256BytesV4([]byte("definition root"))
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "dockerfile", read); err != nil {
+		t.Fatal(err)
+	}
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "dockerfile", read); err == nil {
+		t.Fatal("allowed repeated read to replace original source bytes")
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", []byte("FROM compromised\n"), root); err == nil {
+		t.Fatal("allowed transformed Dockerfile bytes different from successful read")
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", read, root); err != nil {
+		t.Fatal(err)
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", read, root); err == nil {
+		t.Fatal("allowed duplicate platform overwrite")
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/arm64", read, SHA256BytesV4([]byte("root2"))); err != nil {
+		t.Fatal(err)
+	}
+	read[0] = 'X'
+	got, roots := log.SnapshotV4()
+	if got == nil || got.SelectedPath != "dockerfile" || got.ContentSHA256 != SHA256BytesV4([]byte("FROM scratch\n")) || len(roots) != 2 {
+		t.Fatalf("events changed after input mutation or lost actual platform roots: %+v / %+v", got, roots)
+	}
+}
+
+func TestC1BuiltinFrontendEventsV4FailClosedWhenActivatedWithoutRead(t *testing.T) {
+	log := NewBuiltinFrontendEventsV4()
+	ctx := WithBuiltinFrontendEventsV4(context.Background(), log)
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", []byte("FROM scratch\n"), SHA256BytesV4([]byte("root"))); err == nil {
+		t.Fatal("accepted transform without a preceding successful file read")
+	}
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "../Dockerfile", "Dockerfile", []byte("FROM scratch\n")); err == nil {
+		t.Fatal("accepted unsupported Dockerfile request path")
+	}
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "Dockerfile", nil); err == nil {
+		t.Fatal("accepted empty Dockerfile")
+	}
+	if err := ObserveBuiltinDockerfileReadV4(context.Background(), "Dockerfile", "Dockerfile", nil); err != nil {
+		t.Fatalf("ordinary C1-disabled builds must be unaffected: %v", err)
+	}
+}
+
+func TestC1BuiltinFrontendEventsV4EmptyScratchDefinitionIsRecordedNotTrustedAsRoot(t *testing.T) {
+	log := NewBuiltinFrontendEventsV4()
+	ctx := WithBuiltinFrontendEventsV4(context.Background(), log)
+	data := []byte("FROM scratch\nLABEL foo=bar\n")
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "Dockerfile", data); err != nil {
+		t.Fatal(err)
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", data, ""); err != nil {
+		t.Fatalf("false rejected valid empty LLB definition event: %v", err)
+	}
+	if log.ReadyToBindV4() {
+		t.Fatal("claimed scratch-only empty LLB has a real loaded root")
+	}
+	_, roots := log.SnapshotV4()
+	if event, ok := roots["linux/amd64"]; !ok || event.DefinitionHead != "" {
+		t.Fatalf("falsely claimed loaded root for scratch-only source: %+v", roots)
+	}
+	if err := ObserveBuiltinDockerfileTransformV4(ctx, "linux/arm64", data, "not-a-digest"); err == nil {
+		t.Fatal("accepted invalid nonempty definition head")
+	}
+}
+
+func TestC1BuiltinFrontendV4MissingFileClassification(t *testing.T) {
+	for _, tc := range []struct {
+		err     error
+		missing bool
+	}{
+		{fs.ErrNotExist, true}, {status.Error(codes.NotFound, "not found"), true},
+		{fs.ErrPermission, false}, {errors.New("read timeout"), false},
+		{status.Error(codes.DeadlineExceeded, "timeout"), false}, {nil, false},
+	} {
+		if got := IsMissingBuiltinFrontendFileV4(tc.err); got != tc.missing {
+			t.Fatalf("misclassified %v as missing=%t", tc.err, got)
+		}
+	}
+}
+
+func TestC1BuiltinFrontendEventsV4ConcurrentDuplicateReadAndPlatformFence(t *testing.T) {
+	log := NewBuiltinFrontendEventsV4()
+	ctx := WithBuiltinFrontendEventsV4(context.Background(), log)
+	const count = 24
+	var wg sync.WaitGroup
+	results := make(chan error, count)
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results <- ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "Dockerfile", []byte("FROM scratch\n"))
+		}()
+	}
+	wg.Wait()
+	close(results)
+	successes := 0
+	for err := range results {
+		if err == nil {
+			successes++
+		}
+	}
+	if successes != 1 {
+		t.Fatalf("expected exactly one accepted read among %d concurrent callers, got %d", count, successes)
+	}
+	results = make(chan error, count)
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results <- ObserveBuiltinDockerfileTransformV4(ctx, "linux/amd64", []byte("FROM scratch\n"), SHA256BytesV4([]byte("root")))
+		}()
+	}
+	wg.Wait()
+	close(results)
+	successes = 0
+	for err := range results {
+		if err == nil {
+			successes++
+		}
+	}
+	if successes != 1 {
+		t.Fatalf("expected exactly one accepted platform among %d concurrent callers, got %d", count, successes)
+	}
+	if log.ReadyToBindV4() {
+		t.Fatal("claimed a complete frontend event without observing any .dockerignore lookup")
+	}
+}
+
+func TestC1BuiltinFrontendV4IgnorePrecedenceAndVerifiedAbsence(t *testing.T) {
+	newContext := func(t *testing.T) (context.Context, *BuiltinFrontendEventsV4) {
+		t.Helper()
+		log := NewBuiltinFrontendEventsV4()
+		ctx := WithBuiltinFrontendEventsV4(context.Background(), log)
+		if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "dockerfile", []byte("FROM scratch\n")); err != nil {
+			t.Fatal(err)
+		}
+		return ctx, log
+	}
+	t.Run("specific empty success overrides main fallback", func(t *testing.T) {
+		ctx, log := newContext(t)
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", []byte{}, nil); err != nil {
+			t.Fatal(err)
+		}
+		event, complete := log.SnapshotIgnoreV4()
+		if !complete || !event.Present || event.Source != "dockerfile" || event.Path != "Dockerfile.dockerignore" || event.ContentSHA256 != SHA256BytesV4(nil) {
+			t.Fatalf("lost exact empty-success source precedence: %+v complete=%t", event, complete)
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "context", ".dockerignore", []byte("ignored"), nil); err == nil {
+			t.Fatal("allowed an unobserved main-context override after specific success")
+		}
+	})
+	t.Run("missing specific requires observed main result", func(t *testing.T) {
+		ctx, log := newContext(t)
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, fs.ErrNotExist); err != nil {
+			t.Fatal(err)
+		}
+		if _, complete := log.SnapshotIgnoreV4(); complete {
+			t.Fatal("invented absent fallback without a main-context ReadFile")
+		}
+		if log.ReadyToBindV4() {
+			t.Fatal("claimed complete ignored-source proof before main-context lookup")
+		}
+		trace := log.SnapshotIgnoreTraceV4()
+		if trace.Complete || trace.Preferred == nil || trace.Preferred.Present || trace.Main != nil {
+			t.Fatalf("fabricated completed ignore provenance: %+v", trace)
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "context", ".dockerignore", []byte("secret\n"), nil); err != nil {
+			t.Fatal(err)
+		}
+		event, complete := log.SnapshotIgnoreV4()
+		if !complete || !event.Present || event.Source != "context" || event.ContentSHA256 != SHA256BytesV4([]byte("secret\n")) {
+			t.Fatalf("failed to select independently read main-context ignore: %+v complete=%t", event, complete)
+		}
+		trace = log.SnapshotIgnoreTraceV4()
+		if !trace.Complete || trace.Main == nil || trace.Preferred == nil || trace.Preferred.Present || !trace.Main.Present || trace.Effective == nil || trace.Effective.Source != "context" {
+			t.Fatalf("lost preferred ENOENT when selecting main-context read: %+v", trace)
+		}
+	})
+	t.Run("two proven missing reads yield absence", func(t *testing.T) {
+		ctx, log := newContext(t)
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, status.Error(codes.NotFound, "not found")); err != nil {
+			t.Fatal(err)
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "context", ".dockerignore", nil, fs.ErrNotExist); err != nil {
+			t.Fatal(err)
+		}
+		event, complete := log.SnapshotIgnoreV4()
+		if !complete || event.Present || event.ContentSHA256 != SHA256BytesV4(nil) {
+			t.Fatalf("expected proved absence, got %+v complete=%t", event, complete)
+		}
+	})
+	t.Run("ambiguous I/O and permission errors cannot attest absence", func(t *testing.T) {
+		for _, failure := range []error{fs.ErrPermission, errors.New("I/O failure"), status.Error(codes.DeadlineExceeded, "timeout")} {
+			ctx, log := newContext(t)
+			if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, failure); err == nil {
+				t.Fatalf("accepted untrusted absence from %v", failure)
+			}
+			if _, complete := log.SnapshotIgnoreV4(); complete {
+				t.Fatal("generated ignore evidence following failed probe")
+			}
+		}
+	})
+	t.Run("wrong path duplicate and reordered reads are refused", func(t *testing.T) {
+		ctx, log := newContext(t)
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "context", ".dockerignore", nil, fs.ErrNotExist); err == nil {
+			t.Fatal("accepted main before specific")
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "dockerfile.dockerignore", nil, fs.ErrNotExist); err == nil {
+			t.Fatal("accepted lowercase-specific file not actually requested")
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, fs.ErrNotExist); err != nil {
+			t.Fatal(err)
+		}
+		if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, fs.ErrNotExist); err == nil {
+			t.Fatal("accepted duplicate specific read")
+		}
+		if _, complete := log.SnapshotIgnoreV4(); complete {
+			t.Fatal("falsely completed missing fallback")
+		}
+	})
+}
diff --git a/util/localcontext/frontend_loaded_ref_v6.go b/util/localcontext/frontend_loaded_ref_v6.go
new file mode 100644
index 0000000..739b69a
--- /dev/null
+++ b/util/localcontext/frontend_loaded_ref_v6.go
@@ -0,0 +1,159 @@
+package localcontext
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	pb "github.com/moby/buildkit/solver/pb"
+)
+
+// BuiltinLoadedRefV6 is extracted from a concrete in-process BuildKit
+// frontend/gateway/forwarder ref AFTER its actual ResultProxy.Result(ctx)
+// has evaluated. Unlike Definition.Head, RootVertex/OutputIndex come from
+// RootedResultProxy.RootEdge and RefID belongs to worker.ImmutableRef.
+//
+// IMPORTANT: this is an in-process diagnostic, NOT an authenticated remote
+// measurement, signed owner evidence, proof of approval, or publish authority.
+// An arbitrary implementation of this interface is NOT a trust principal.
+type BuiltinLoadedRefV6 struct {
+	WorkerID    string
+	RefID       string
+	RootVertex  string
+	OutputIndex int
+	// SourceIdentifier is derived from the LOADED RootEdge.SourceOp, not a
+	// frontend-supplied role label. Empty on image/exec/file output roots.
+	SourceIdentifier string
+	// V7: these values are copied from the LOADED local SourceOp's attributes,
+	// not from a claimed frontend role. They are neither a cryptographic
+	// snapshot measurement nor independent owner-approved session authority.
+	SourceSessionID               string
+	SourceFollowPaths             string
+	SourceSharedKeyHint           string
+	SourceDiffer                  string
+	SourceIncludePatterns         string
+	SourceExcludePatterns         string
+	SourceMetadataTransfer        string
+	SourceMetadataTransferExclude string
+}
+
+// CheckBuiltinLocalSessionV7 refuses missing, mismatched or non-local source
+// sessions at the concrete in-process source-to-loaded-result boundary. The
+// expected ID must be supplied by daemon-held per-solve session context; it
+// must never be copied from the source attrs being checked.
+func CheckBuiltinLocalSessionV7(ref BuiltinLoadedRefV6, role, expectedSessionID string) error {
+	if role != "dockerfile" && role != "context" {
+		return errors.New("C1 V7 refuses unknown local source role")
+	}
+	if expectedSessionID == "" || !validIdentifier(expectedSessionID) || strings.Contains(expectedSessionID, ":") {
+		return errors.New("C1 V7 refuses an unbound or invalid expected session")
+	}
+	if !validLoadedRefV6(ref) || ref.SourceIdentifier != "local://"+role ||
+		ref.SourceSessionID == "" || ref.SourceSessionID != expectedSessionID {
+		return errors.New("C1 V7 loaded source session/role does not match the expected builtin solve")
+	}
+	return nil
+}
+
+// CheckBuiltinLocalReadShapeV7 distinguishes the separate auxiliary
+// `.dockerignore` probe from the main build-context source. The probe does
+// NOT represent the snapshot later consumed by COPY and must never be used
+// as the owner-approved canonical `source` context evidence.
+// This only checks observable SourceOp attributes for the fixed/default
+// builtin Dockerfile variant; it is NOT independent snapshot attestation.
+func CheckBuiltinLocalReadShapeV7(ref BuiltinLoadedRefV6, kind string) error {
+	var role, sharedKey string
+	var expectedPaths []string
+	switch kind {
+	case "dockerfile":
+		role, sharedKey = "local://dockerfile", "dockerfile"
+		expectedPaths = []string{"Dockerfile", "Dockerfile.dockerignore", "dockerfile"}
+	case "auxiliary-ignore":
+		role, sharedKey = "local://context", "context-.dockerignore"
+		expectedPaths = []string{".dockerignore"}
+	default:
+		return errors.New("C1 V7 unknown loaded local source shape")
+	}
+	if ref.SourceIdentifier != role || ref.SourceSharedKeyHint != sharedKey ||
+		ref.SourceDiffer != pb.AttrLocalDifferNone || ref.SourceFollowPaths == "" ||
+		ref.SourceIncludePatterns != "" || ref.SourceExcludePatterns != "" ||
+		ref.SourceMetadataTransfer != "" || ref.SourceMetadataTransferExclude != "" {
+		return fmt.Errorf("C1 V7 %s source is not the expected filtered local snapshot", kind)
+	}
+	var paths []string
+	if err := json.Unmarshal([]byte(ref.SourceFollowPaths), &paths); err != nil {
+		return errors.New("C1 V7 invalid loaded local FollowPaths encoding")
+	}
+	if len(paths) != len(expectedPaths) {
+		return errors.New("C1 V7 loaded local FollowPaths cardinality differs")
+	}
+	for i := range paths {
+		if paths[i] != expectedPaths[i] {
+			return errors.New("C1 V7 loaded local FollowPaths changed or reordered")
+		}
+	}
+	return nil
+}
+
+func validLoadedRefV6(value BuiltinLoadedRefV6) bool {
+	return validIdentifier(value.WorkerID) && validIdentifier(value.RefID) &&
+		sha256Pattern.MatchString(value.RootVertex) && value.OutputIndex >= 0
+}
+
+type builtinLoadedRefProviderV6 interface {
+	BuiltinLoadedRefV6(context.Context) (BuiltinLoadedRefV6, error)
+}
+
+// builtinDefinitionBoundProviderV6 additionally binds an exact frontend-
+// generated LLB Definition to the very ResultProxy whose loaded RootEdge and
+// worker ImmutableRef are returned. Source-policy rewriting can change the
+// loaded vertex digest; equal definitions, NOT equal pre/post digest strings,
+// are the correct in-process graph-substitution check at this boundary.
+type builtinDefinitionBoundProviderV6 interface {
+	BuiltinLoadedDefinitionV6(context.Context, *pb.Definition) (BuiltinLoadedRefV6, error)
+}
+
+func InspectBuiltinLoadedDefinitionV6(ctx context.Context, reference any, definition *pb.Definition) (BuiltinLoadedRefV6, error) {
+	if err := ctx.Err(); err != nil {
+		return BuiltinLoadedRefV6{}, err
+	}
+	if definition == nil {
+		return BuiltinLoadedRefV6{}, errors.New("C1 V6 no actual frontend-generated LLB definition")
+	}
+	provider, ok := reference.(builtinDefinitionBoundProviderV6)
+	if !ok || provider == nil {
+		return BuiltinLoadedRefV6{}, errors.New("C1 V6 no in-process exact-definition result proxy")
+	}
+	loaded, err := provider.BuiltinLoadedDefinitionV6(ctx, definition)
+	if err != nil {
+		return BuiltinLoadedRefV6{}, err
+	}
+	if !validLoadedRefV6(loaded) {
+		return BuiltinLoadedRefV6{}, errors.New("C1 V6 incomplete definition-bound loaded result")
+	}
+	return loaded, nil
+}
+
+// InspectBuiltinLoadedRefV6 fails closed when the client.Reference was not
+// created by a BuildKit frontend forwarder carrying the loaded-result API.
+// The caller must *additionally* establish the exact concrete builtin
+// frontend dispatch identity and bind its per-solve owner-approved scope.
+func InspectBuiltinLoadedRefV6(ctx context.Context, reference any) (BuiltinLoadedRefV6, error) {
+	if err := ctx.Err(); err != nil {
+		return BuiltinLoadedRefV6{}, err
+	}
+	provider, ok := reference.(builtinLoadedRefProviderV6)
+	if !ok || provider == nil {
+		return BuiltinLoadedRefV6{}, errors.New("C1 V6 requires an in-process loaded-result provider, not remote gateway metadata")
+	}
+	loaded, err := provider.BuiltinLoadedRefV6(ctx)
+	if err != nil {
+		return BuiltinLoadedRefV6{}, err
+	}
+	if !validLoadedRefV6(loaded) {
+		return BuiltinLoadedRefV6{}, errors.New("C1 V6 loaded worker/immutable ref/solver root is incomplete")
+	}
+	return loaded, nil
+}
diff --git a/util/localcontext/frontend_loaded_ref_v6_test.go b/util/localcontext/frontend_loaded_ref_v6_test.go
new file mode 100644
index 0000000..b744188
--- /dev/null
+++ b/util/localcontext/frontend_loaded_ref_v6_test.go
@@ -0,0 +1,191 @@
+package localcontext
+
+import (
+	"context"
+	"io/fs"
+	"testing"
+)
+
+type v6TestProvider struct {
+	value BuiltinLoadedRefV6
+	err   error
+}
+
+func (p v6TestProvider) BuiltinLoadedRefV6(context.Context) (BuiltinLoadedRefV6, error) {
+	return p.value, p.err
+}
+
+func loadedFixtureV6(id string, n int) BuiltinLoadedRefV6 {
+	return BuiltinLoadedRefV6{
+		WorkerID: "worker-v6", RefID: id,
+		RootVertex: SHA256BytesV4([]byte("solver-root-" + id)), OutputIndex: n,
+	}
+}
+
+func TestC1V6ConcreteLoadedReferenceBindingAndCoherentPlatformSwap(t *testing.T) {
+	log := NewBuiltinFrontendEventsV4()
+	ctx := WithBuiltinFrontendEventsV4(t.Context(), log)
+	data := []byte("FROM scratch\nCOPY source /destination\n")
+	source := loadedFixtureV6("immutable-dockerfile", 0)
+	main := loadedFixtureV6("immutable-main-context", 0)
+	source.SourceIdentifier = "local://dockerfile"
+	main.SourceIdentifier = "local://context"
+	amd := loadedFixtureV6("immutable-amd64-output", 0)
+	arm := loadedFixtureV6("immutable-arm64-output", 1)
+	if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "Dockerfile", data); err != nil {
+		t.Fatal(err)
+	}
+	if log.ReadyToBindV6() {
+		t.Fatal("claimed bound before source ref exists")
+	}
+	if err := BindBuiltinDockerfileLoadedReadV6(ctx, source); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindBuiltinDockerfileLoadedReadV6(ctx, source); err == nil {
+		t.Fatal("duplicate immutable source admitted")
+	}
+	if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "dockerfile", "Dockerfile.dockerignore", nil, fs.ErrNotExist); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindBuiltinDockerfileLoadedIgnoreV6(ctx, "dockerfile", main); err == nil {
+		t.Fatal("preferred lookup from changed source ref accepted")
+	}
+	if err := BindBuiltinDockerfileLoadedIgnoreV6(ctx, "dockerfile", source); err != nil {
+		t.Fatal(err)
+	}
+	if err := ObserveBuiltinDockerfileIgnoreV4(ctx, "context", ".dockerignore", nil, fs.ErrNotExist); err != nil {
+		t.Fatal(err)
+	}
+	if err := BindBuiltinDockerfileLoadedIgnoreV6(ctx, "context", main); err != nil {
+		t.Fatal(err)
+	}
+	if log.ReadyToBindV6() {
+		t.Fatal("claimed output before frontend conversion")
+	}
+	for _, tc := range []struct {
+		platform string
+		loaded   BuiltinLoadedRefV6
+	}{
+		{"linux/amd64", amd}, {"linux/arm64", arm},
+	} {
+		if err := ObserveBuiltinDockerfileTransformV4(ctx, tc.platform, data, SHA256BytesV4([]byte("raw-llb-"+tc.platform))); err != nil {
+			t.Fatal(err)
+		}
+		if err := BindBuiltinDockerfileLoadedOutputV6(ctx, tc.platform, tc.loaded); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !log.ReadyToBindV6() {
+		t.Fatal("complete source/ignore/conversion loaded-ref diagnostic rejected")
+	}
+	if got, _ := log.SnapshotV4(); got == nil || got.PrimaryMissing != nil {
+		t.Fatal("normal successful Dockerfile read invented a primary missing observation")
+	}
+	selected := map[string]CausalRoot{
+		"linux/amd64": {WorkerID: amd.WorkerID, RefID: amd.RefID, VertexDigest: amd.RootVertex, OutputIndex: amd.OutputIndex},
+		"linux/arm64": {WorkerID: arm.WorkerID, RefID: arm.RefID, VertexDigest: arm.RootVertex, OutputIndex: arm.OutputIndex},
+	}
+	if err := log.VerifyBuiltinFrontendLoadedOutputV6(selected); err != nil {
+		t.Fatal(err)
+	}
+	// All THREE BuildKit result maps can be coherently swapped and still agree
+	// with one another. They MUST NOT agree with the independent builtin
+	// per-platform solve root previously observed in this recorder.
+	swapped := map[string]CausalRoot{"linux/amd64": selected["linux/arm64"], "linux/arm64": selected["linux/amd64"]}
+	if err := log.VerifyBuiltinFrontendLoadedOutputV6(swapped); err == nil {
+		t.Fatal("accepted coherent platform swap")
+	}
+	delete(swapped, "linux/arm64")
+	if err := log.VerifyBuiltinFrontendLoadedOutputV6(swapped); err == nil {
+		t.Fatal("accepted omitted platform")
+	}
+	read, events := log.SnapshotV4()
+	if read == nil || read.Loaded == nil || events["linux/amd64"].Loaded == nil {
+		t.Fatal("snapshot omitted bounded loaded references")
+	}
+	read.Loaded.RefID = "attacker-snapshot"
+	a := events["linux/amd64"]
+	a.Loaded.RootVertex = SHA256BytesV4([]byte("tampered"))
+	if err := log.VerifyBuiltinFrontendLoadedOutputV6(selected); err != nil {
+		t.Fatalf("caller mutation modified internal authoritative event: %v", err)
+	}
+	trace := log.SnapshotIgnoreTraceV4()
+	if trace.Preferred == nil || trace.Main == nil || trace.Preferred.Loaded == nil || trace.Main.Loaded == nil ||
+		trace.Preferred.Loaded.RefID != source.RefID || trace.Main.Loaded.RefID != main.RefID {
+		t.Fatalf("ignored source identity or dual-absence trace: %+v", trace)
+	}
+	trace.Main.Loaded.WorkerID = "wrong-worker"
+	if second := log.SnapshotIgnoreTraceV4(); second.Main.Loaded.WorkerID != main.WorkerID {
+		t.Fatal("caller modified stored immutable ignore source")
+	}
+}
+
+func TestC1V6LowercaseFallbackRequiresProvenInitialNotFoundOnSameSource(t *testing.T) {
+	src := loadedFixtureV6("dockerfile-source", 0)
+	src.SourceIdentifier = "local://dockerfile"
+	wrong := loadedFixtureV6("other-snapshot", 0)
+	wrong.SourceIdentifier = "local://dockerfile"
+	build := func(t *testing.T, withMissing bool, missing BuiltinLoadedRefV6) (context.Context, *BuiltinFrontendEventsV4) {
+		t.Helper()
+		log := NewBuiltinFrontendEventsV4()
+		ctx := WithBuiltinFrontendEventsV4(t.Context(), log)
+		if withMissing {
+			if err := ObserveBuiltinPrimaryDockerfileENOENTV6(ctx, missing); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := ObserveBuiltinDockerfileReadV4(ctx, "Dockerfile", "dockerfile", []byte("FROM scratch\n")); err != nil {
+			t.Fatal(err)
+		}
+		return ctx, log
+	}
+	t.Run("no first notfound", func(t *testing.T) {
+		ctx, _ := build(t, false, src)
+		if err := BindBuiltinDockerfileLoadedReadV6(ctx, src); err == nil {
+			t.Fatal("accepted lowercase path without primary ENOENT")
+		}
+	})
+	t.Run("first lookup from another immutable ref", func(t *testing.T) {
+		ctx, _ := build(t, true, wrong)
+		if err := BindBuiltinDockerfileLoadedReadV6(ctx, src); err == nil {
+			t.Fatal("accepted unrelated source for primary ENOENT")
+		}
+	})
+	t.Run("same loaded source positive and defensive copy", func(t *testing.T) {
+		ctx, log := build(t, true, src)
+		if err := BindBuiltinDockerfileLoadedReadV6(ctx, src); err != nil {
+			t.Fatal(err)
+		}
+		read, _ := log.SnapshotV4()
+		if read.PrimaryMissing == nil || read.Loaded == nil || !sameLoadedRefV6(*read.PrimaryMissing, src) {
+			t.Fatalf("lost original ENOENT source: %+v", read)
+		}
+		read.PrimaryMissing.RefID = "forged-after-snapshot"
+		again, _ := log.SnapshotV4()
+		if again.PrimaryMissing.RefID != src.RefID {
+			t.Fatal("snapshot mutated stored primary lookup identity")
+		}
+	})
+}
+
+func TestC1V6LoadedRefProviderCanNeverStandInForOwnerCredentials(t *testing.T) {
+	value := loadedFixtureV6("candidate", 0)
+	got, err := InspectBuiltinLoadedRefV6(t.Context(), v6TestProvider{value: value})
+	if err != nil || got != value {
+		t.Fatalf("provider API result unexpected: %+v %v", got, err)
+	}
+	// Deliberately demonstrate that any type can implement this interface.
+	// Verifier must NOT authorize a signature/publish from such a record.
+	if _, err := InspectBuiltinLoadedRefV6(t.Context(), struct{}{}); err == nil {
+		t.Fatal("accepted opaque uninspected input")
+	}
+	if _, err := InspectBuiltinLoadedRefV6(t.Context(), v6TestProvider{value: BuiltinLoadedRefV6{}}); err == nil {
+		t.Fatal("accepted empty forged result")
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, err := InspectBuiltinLoadedRefV6(ctx, v6TestProvider{value: value}); err != context.Canceled {
+		t.Fatalf("canceled context was accepted: %v", err)
+	}
+	_ = context.Background()
+}
diff --git a/util/localcontext/frontend_transform_v4.go b/util/localcontext/frontend_transform_v4.go
new file mode 100644
index 0000000..33f1854
--- /dev/null
+++ b/util/localcontext/frontend_transform_v4.go
@@ -0,0 +1,248 @@
+package localcontext
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path"
+	"strings"
+
+	"github.com/containerd/platforms"
+)
+
+// DockerfileReadV4 models the successful read of the BUILT-IN frontend, not a
+// client-supplied claim. Only worker-bound, per-solve native capture may create
+// authoritative instances; this struct and its digest are NOT owner approval.
+// The source vertex identifies the separate Dockerfile read solve, which is
+// NOT an ancestor of the generated image LLB.
+type DockerfileReadV4 struct {
+	ContextName      string `json:"contextName"`
+	Generation       string `json:"generation"`
+	ContextIdentity  string `json:"contextIdentity"`
+	WorkerID         string `json:"workerId"`
+	SessionID        string `json:"sessionId"`
+	SnapshotID       string `json:"snapshotId"`
+	TreeDigestSchema string `json:"treeDigestSchema"`
+	TreeDigest       string `json:"treeDigest"`
+	SourceVertex     string `json:"sourceVertex"`
+	SourceOutput     int    `json:"sourceOutput"`
+	SelectedPath     string `json:"selectedPath"`
+	DockerfileSHA    string `json:"dockerfileSha256"`
+	IgnorePath       string `json:"ignorePath"`
+	IgnoreSHA        string `json:"ignoreSha256"`
+	IgnorePresent    bool   `json:"ignorePresent"`
+}
+
+// FrontendRootV4 is a generated LLB root AND the actual root selected for
+// export. An LLB digest alone does not prove execution or exporter selection.
+type FrontendRootV4 struct {
+	Platform    string `json:"platform"`
+	RootVertex  string `json:"rootVertex"`
+	OutputIndex int    `json:"outputIndex"`
+	WorkerID    string `json:"workerId"`
+	RefID       string `json:"refId"`
+}
+
+type DockerfileTransformV4 struct {
+	SchemaVersion int              `json:"schemaVersion"`
+	FrontendID    string           `json:"frontendId"`
+	Read          DockerfileReadV4 `json:"read"`
+	Roots         []FrontendRootV4 `json:"roots"`
+	ProofDigest   string           `json:"proofDigest"`
+}
+
+// FrontendCaptureV4 MUST be constructed from daemon-owned successful ReadFile
+// and Dockerfile2LLB instrumentation; caller or result metadata is untrusted.
+// This DTO alone is not such instrumentation and grants no signing authority.
+type FrontendCaptureV4 struct {
+	SelectedPath     string
+	DockerfileData   []byte
+	ReadWorkerID     string
+	ReadSessionID    string
+	ReadGeneration   string
+	ReadSnapshotID   string
+	ReadSourceVertex string
+	ReadSourceOutput int
+	IgnorePath       string
+	IgnoreData       []byte
+	IgnorePresent    bool
+	// The two ignore probes are independent sources: the preferred file on
+	// the Dockerfile ref and the root file on the main-context ref. An absent
+	// effective ignore needs two observed ENOENT outcomes, not an empty/nil
+	// data field. These flags MUST come from independent daemon capture.
+	SpecificIgnoreObserved bool
+	SpecificIgnorePresent  bool
+	SpecificIgnorePath     string
+	SpecificIgnoreSHA      string
+	MainIgnoreObserved     bool
+	MainIgnorePresent      bool
+	MainIgnorePath         string
+	MainIgnoreSHA          string
+	GeneratedRoots         []FrontendGeneratedRootV4
+}
+
+type FrontendGeneratedRootV4 struct {
+	Platform    string
+	RootVertex  string
+	OutputIndex int
+	WorkerID    string
+	RefID       string
+}
+
+const BuiltinDockerfileFrontendV4 = "buildkit-v0.34.1/dockerfile.v0/builtin"
+
+func SHA256BytesV4(data []byte) string {
+	sum := sha256.Sum256(data)
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+
+// DockerfileTransformDigestV4 is a domain-separated canonical digest for v4.
+// The output MUST be independently checked against actual worker observations,
+// frontend execution, and selected exporter roots before any owner may use it.
+func DockerfileTransformDigestV4(proof DockerfileTransformV4) (string, error) {
+	proof.ProofDigest = ""
+	encoded, err := json.Marshal(proof)
+	if err != nil {
+		return "", err
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte("virki-buildkit-builtin-dockerfile-transform-v4\x00"))
+	_, _ = h.Write(encoded)
+	return "sha256:" + hex.EncodeToString(h.Sum(nil)), nil
+}
+
+// ValidateDockerfileTransformV4 checks that a privately captured transform
+// agrees with the EXACT worker consumption and image roots. Calling it with
+// self-reported observations is NOT independent attestation. Publication and
+// release SIGN_ACK remain denied until the physical owner verifies evidence.
+// selectedPlatforms MUST originate from the actual postprocessor/exporter
+// selected platform ID->loaded RootEdge/ref mapping, independently of both
+// the claimed v4 proof and the claimed frontend capture. A map reconstructed
+// from proof.Roots defeats this check and MUST NEVER authorize a build.
+func ValidateDockerfileTransformV4(proof DockerfileTransformV4, dockerfile Consumption, exported []CausalRoot, selectedPlatforms map[string]CausalRoot, captured FrontendCaptureV4) error {
+	if len(proof.Roots) == 0 || len(proof.Roots) > 32 || len(exported) != len(proof.Roots) ||
+		len(selectedPlatforms) != len(proof.Roots) || len(captured.GeneratedRoots) != len(proof.Roots) {
+		return errors.New("C1 v4 root set empty, incomplete or exceeds maximum")
+	}
+	if proof.SchemaVersion != 4 || proof.FrontendID != BuiltinDockerfileFrontendV4 {
+		return errors.New("unsupported or non-builtin Dockerfile frontend")
+	}
+	d, err := DockerfileTransformDigestV4(proof)
+	if err != nil || d != proof.ProofDigest {
+		return errors.New("Dockerfile v4 proof digest mismatch")
+	}
+	r := proof.Read
+	if r.ContextName != "dockerfile" || dockerfile.Name != "dockerfile" ||
+		r.Generation != dockerfile.Generation || r.WorkerID != dockerfile.WorkerID ||
+		r.ContextIdentity != dockerfile.ContextIdentity || r.TreeDigestSchema != dockerfile.TreeDigestSchema ||
+		r.SessionID != dockerfile.SessionID || r.SnapshotID != dockerfile.SnapshotID ||
+		r.TreeDigest != dockerfile.TreeDigest || r.SourceVertex != dockerfile.VertexDigest ||
+		r.SourceOutput != dockerfile.VertexOutputIndex {
+		return errors.New("Dockerfile read is not bound to the approved consumed worker snapshot")
+	}
+	if !validIdentifier(r.Generation) || !validIdentifier(r.WorkerID) || !validIdentifier(r.SessionID) ||
+		!validIdentifier(r.ContextIdentity) || r.TreeDigestSchema != BuildKitContextTreeDigestSchema ||
+		!validIdentifier(r.SnapshotID) || !sha256Pattern.MatchString(r.TreeDigest) ||
+		!sha256Pattern.MatchString(r.SourceVertex) || r.SourceOutput < 0 ||
+		!sha256Pattern.MatchString(r.DockerfileSHA) || !sha256Pattern.MatchString(r.IgnoreSHA) {
+		return errors.New("incomplete Dockerfile source provenance")
+	}
+	if r.SelectedPath != captured.SelectedPath || r.DockerfileSHA != SHA256BytesV4(captured.DockerfileData) ||
+		r.IgnorePath != captured.IgnorePath || r.IgnoreSHA != SHA256BytesV4(captured.IgnoreData) ||
+		r.IgnorePresent != captured.IgnorePresent {
+		return errors.New("frontend claims do not match separately captured read bytes/paths")
+	}
+	if captured.ReadWorkerID != dockerfile.WorkerID || captured.ReadSessionID != dockerfile.SessionID ||
+		captured.ReadGeneration != dockerfile.Generation || captured.ReadSnapshotID != dockerfile.SnapshotID ||
+		captured.ReadSourceVertex != dockerfile.VertexDigest || captured.ReadSourceOutput != dockerfile.VertexOutputIndex {
+		return errors.New("separately captured read refers to a different worker solve or immutable snapshot")
+	}
+	// This first narrow v4 contract refuses custom, remote, or named Dockerfile
+	// paths rather than pretending those sources have a verified local proof.
+	if r.SelectedPath != "Dockerfile" && r.SelectedPath != "dockerfile" {
+		return fmt.Errorf("unproven Dockerfile source path %q", r.SelectedPath)
+	}
+	// An effective ignore file may come from either a Dockerfile-source solve
+	// or a separate main-context solve. Until both snapshots and precedence
+	// are independently captured, v4 must refuse present ignore files.
+	if r.IgnorePresent {
+		return errors.New("C1 v4 effective .dockerignore needs independently captured source snapshot")
+	}
+	if r.IgnorePath != "" || r.IgnoreSHA != SHA256BytesV4(nil) {
+		return errors.New("absent .dockerignore has inconsistent bytes/path")
+	}
+	if !captured.SpecificIgnoreObserved || captured.SpecificIgnorePresent ||
+		captured.SpecificIgnorePath != "Dockerfile.dockerignore" || captured.SpecificIgnoreSHA != SHA256BytesV4(nil) ||
+		!captured.MainIgnoreObserved || captured.MainIgnorePresent ||
+		captured.MainIgnorePath != ".dockerignore" || captured.MainIgnoreSHA != SHA256BytesV4(nil) {
+		return errors.New("C1 v4 cannot infer ignore absence without separate verified ENOENT reads on both source refs")
+	}
+	type outputKey struct {
+		worker, ref, vertex string
+		index               int
+	}
+	actualRoots := make(map[outputKey]struct{}, len(exported))
+	for _, root := range exported {
+		key := outputKey{root.WorkerID, root.RefID, root.VertexDigest, root.OutputIndex}
+		if _, exists := actualRoots[key]; exists {
+			return errors.New("actual exporter contains duplicated roots")
+		}
+		actualRoots[key] = struct{}{}
+	}
+	// Require an exact one-to-one platform mapping, not just a permutation of
+	// otherwise valid immutable roots (amd64<->arm64 is a real security bug).
+	selectedPlatformKeys := make(map[outputKey]struct{}, len(selectedPlatforms))
+	for platform, root := range selectedPlatforms {
+		key := outputKey{root.WorkerID, root.RefID, root.VertexDigest, root.OutputIndex}
+		parsedPlatform, parseErr := platforms.Parse(platform)
+		if parseErr != nil || platforms.FormatAll(platforms.Normalize(parsedPlatform)) != platform {
+			return errors.New("exporter selected an invalid platform ID")
+		}
+		if _, ok := actualRoots[key]; !ok {
+			return errors.New("platform maps to a root not selected for actual export")
+		}
+		if _, duplicated := selectedPlatformKeys[key]; duplicated {
+			return errors.New("two platform IDs mapped to one immutable exporter root")
+		}
+		selectedPlatformKeys[key] = struct{}{}
+	}
+	generatedByPlatform := make(map[string]FrontendGeneratedRootV4, len(captured.GeneratedRoots))
+	for _, root := range captured.GeneratedRoots {
+		if _, exists := generatedByPlatform[root.Platform]; exists {
+			return errors.New("frontend capture contains duplicate platforms")
+		}
+		generatedByPlatform[root.Platform] = root
+	}
+	seenPlatform := make(map[string]struct{}, len(proof.Roots))
+	previousPlatform := ""
+	for i, root := range proof.Roots {
+		generated, exists := generatedByPlatform[root.Platform]
+		selected := outputKey{root.WorkerID, root.RefID, root.RootVertex, root.OutputIndex}
+		_, selectedByExporter := actualRoots[selected]
+		selectedForPlatform, mapped := selectedPlatforms[root.Platform]
+		platformRoot := outputKey{selectedForPlatform.WorkerID, selectedForPlatform.RefID, selectedForPlatform.VertexDigest, selectedForPlatform.OutputIndex}
+		if root.Platform == "" || strings.TrimSpace(root.Platform) != root.Platform ||
+			strings.ContainsAny(root.Platform, "\x00\r\n") ||
+			!exists || !selectedByExporter || !mapped || platformRoot != selected ||
+			(i > 0 && root.Platform <= previousPlatform) ||
+			root.Platform != generated.Platform || root.RootVertex != generated.RootVertex || root.OutputIndex != generated.OutputIndex ||
+			root.WorkerID != generated.WorkerID || root.RefID != generated.RefID ||
+			!sha256Pattern.MatchString(root.RootVertex) || root.OutputIndex < 0 ||
+			root.WorkerID != dockerfile.WorkerID || !validIdentifier(root.RefID) {
+			return fmt.Errorf("Dockerfile output root %d differs from the actual exporter root", i)
+		}
+		previousPlatform = root.Platform
+		if _, exists := seenPlatform[root.Platform]; exists {
+			return errors.New("Dockerfile frontend recorded more than one root per platform")
+		}
+		seenPlatform[root.Platform] = struct{}{}
+		delete(actualRoots, selected)
+	}
+	// Ensure future custom-path enablement cannot silently accept ../ escapes.
+	if path.Clean(r.SelectedPath) != r.SelectedPath || path.IsAbs(r.SelectedPath) {
+		return errors.New("invalid Dockerfile read path")
+	}
+	return nil
+}
