+func newLocalContextObserver(cfg config.LocalContextObserverConfig) (*localcontext.Manager, error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+	if cfg.SocketPath == "" {
+		if cfg.Required {
+			return nil, errors.New("required owner local-context observer socket is missing")
+		}
+		return nil, nil
+	}
+	if cfg.SocketOwnerUID == nil {
+		return nil, errors.New("owner local-context observer socket UID is missing")
+	}
+	var service localcontext.Service
+	var err error
+	switch cfg.Protocol {
+	case "", "v1":
+		service, err = localcontext.NewUnixSocketService(cfg.SocketPath, *cfg.SocketOwnerUID)
+	case "vroa-v3":
+		approvalPub, loadErr := readEd25519PublicKeyFile(cfg.ApprovalPublicKeyFile)
+		if loadErr != nil {
+			return nil, loadErr
+		}
+		var receiptPub []byte
+		if cfg.ReceiptPublicKeyFile != "" {
+			receiptPub, loadErr = readEd25519PublicKeyFile(cfg.ReceiptPublicKeyFile)
+			if loadErr != nil {
+				return nil, loadErr
+			}
+		}
+		service, err = localcontext.NewVROAV3Service(cfg.SocketPath, *cfg.SocketOwnerUID, localcontext.VROAV3Options{
+			Epoch:             cfg.Epoch,
+			ApprovalPublicKey: approvalPub,
+			ApprovalKeyID:     cfg.ApprovalKeyID,
+			ApprovalPinSHA256: cfg.ApprovalPinSHA256,
+			ReceiptPublicKey:  receiptPub,
+			ReceiptKeyID:      cfg.ReceiptKeyID,
+			ExpectedImage: localcontext.ImageDescriptor{
+				MediaType: cfg.ExpectedImageMediaType,
+				Digest:    cfg.ExpectedImageDigest,
+				Size:      cfg.ExpectedImageSize,
+			},
+		})
+	default:
+		return nil, errors.New("unsupported local-context observer protocol")
+	}
+	if err != nil {
+		return nil, err
+	}
+	return localcontext.NewManager(service, cfg.Required)
+}
+
+func readEd25519PublicKeyFile(path string) ([]byte, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() || info.Size() != 32 {
+		return nil, errors.New("Ed25519 public key file must be a 32-byte regular non-symlink file")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	if len(raw) != 32 {
+		return nil, errors.New("Ed25519 public key file must be exactly 32 bytes")
+	}
+	return raw, nil
+}
+
+func configureWorkerContextObserver(opt *base.WorkerOpt, observer *localcontext.Manager, required bool) error {
+	if opt == nil {
+		return errors.New("worker options are missing")
+	}
+	if err := validateWorkerContextObserver(observer, required); err != nil {
+		return err
+	}
+	opt.LocalContextObserver = observer
+	opt.RequireLocalContextObserver = required
+	return nil
+}
+
+func validateWorkerContextObserver(observer *localcontext.Manager, required bool) error {
+	if required && observer == nil {
+		return errors.New("required local-context observer is missing from worker construction")
+	}
+	return nil
+}
+
 func resolverFunc(cfg *config.Config) docker.RegistryHosts {
 	return resolver.NewRegistryConfig(cfg.Registries)
 }
