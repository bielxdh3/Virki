+// PreferredDockerignoreProofV12 is a SAME-PROCESS diagnostic for the
+// canonical Dockerfile worker ref that supplied the successful preferred
+// ReadFile. The native independent C4 does NOT sign or acknowledge it.
+type PreferredDockerignoreProofV12 struct {
+	Path             string `json:"path"`
+	Present          bool   `json:"present"`
+	ContentSHA256    string `json:"contentSha256"`
+	WorkerID         string `json:"workerId"`
+	SessionID        string `json:"sessionId"`
+	DockerfileRefID  string `json:"dockerfileRefId"`
+	DockerfileVertex string `json:"dockerfileVertex"`
+}
+
+// ClaimPreferredDockerignoreReadV12 runs BEFORE the frontend ReadFile call.
+// Even if ReadFile or loaded-ref inspection fails, a retry in this generation
+// cannot launder that first attempt into a successful selection.
+func ClaimPreferredDockerignoreReadV12(ctx context.Context) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V12 preferred lookup lacks owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if !scope.auth.RequirePreferredMissingV12 && scope.auth.PreferredDockerignoreV12 == nil {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) ||
+		scope.preferredDockerignoreReadStartedV12 {
+		return errors.New("C1 V12 preferred lookup replay or terminated scope")
+	}
+	scope.preferredDockerignoreReadStartedV12 = true
+	return nil
+}
+
+// PreferredDockerignoreSelectedV12 indicates whether this private solve
+// explicitly chose the preferred file, without accepting frontend attributes
+// as proof of approval. A V10/V11 root choice remains a different branch.
+func PreferredDockerignoreSelectedV12(ctx context.Context) bool {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return false
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	return !scope.closed && !scope.completionAttempted && !scope.abortRequested &&
+		time.Now().Before(scope.auth.ExpiresAt) &&
+		(scope.auth.PreferredDockerignoreV12 != nil || scope.auth.RequirePreferredMissingV12)
+}
+
+// VerifyPreferredDockerignoreReadV12 must receive the ORIGINAL actual
+// ReadFile outcome before nil/empty normalization. For preferred policy, the
+// canonical Dockerfile worker record must already have been accepted and
+// match the immutable loaded ref, not an unverified caller-provided label.
+// For an opted-in root policy, a successful preferred read is a selection
+// mismatch and MUST be refused rather than skipping the required root proof.
+func VerifyPreferredDockerignoreReadV12(ctx context.Context, path string, data []byte, readErr error, loaded BuiltinLoadedRefV6) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	if ctx == nil || ctx.Err() != nil {
+		return errors.New("C1 V12 preferred ignore read has no active owner context")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V12 preferred ignore has no private owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V12 preferred ignore read belongs to a terminated generation")
+	}
+	approved := scope.auth.PreferredDockerignoreV12
+	strictRoot := scope.auth.RequirePreferredMissingV12
+	if approved == nil {
+		if strictRoot {
+			if !scope.preferredDockerignoreReadStartedV12 || scope.preferredDockerignoreReadAttemptedV12 {
+				return errors.New("C1 V12 strict root preferred lookup missing or replayed")
+			}
+			scope.preferredDockerignoreReadAttemptedV12 = true
+			if path != "Dockerfile.dockerignore" || readErr == nil || !IsMissingBuiltinFrontendFileV4(readErr) || len(data) != 0 {
+				return errors.New("C1 V12 selected root did not observe one canonical preferred ENOENT")
+			}
+			if err := scope.verifyCanonicalDockerfileLoadedV12(loaded); err != nil {
+				return err
+			}
+			scope.preferredDockerignoreMissingVerifiedV12 = true
+			scope.preferredDockerignoreProofV12 = &PreferredDockerignoreProofV12{
+				Path: path, Present: false, ContentSHA256: SHA256BytesV4(nil),
+				WorkerID: loaded.WorkerID, SessionID: loaded.SourceSessionID,
+				DockerfileRefID: loaded.RefID, DockerfileVertex: loaded.RootVertex,
+			}
+			return nil
+		}
+		if scope.auth.BindRootIgnoreExcludesV11 && scope.auth.RootDockerignoreV10 != nil && readErr == nil {
+			return errors.New("C1 V12 preferred ignore exists, but owner selected root .dockerignore")
+		}
+		return nil
+	}
+	if !scope.preferredDockerignoreReadStartedV12 || scope.preferredDockerignoreReadAttemptedV12 {
+		return errors.New("C1 V12 preferred ignore read already attempted")
+	}
+	scope.preferredDockerignoreReadAttemptedV12 = true
+	if readErr != nil {
+		return fmt.Errorf("C1 V12 owner-selected preferred ignore was not successfully read: %w", readErr)
+	}
+	if path != approved.Path || approved.Path != "Dockerfile.dockerignore" ||
+		SHA256BytesV4(data) != approved.ContentSHA256 {
+		return errors.New("C1 V12 preferred ignore selected path or bytes mismatch owner policy")
+	}
+	if err := scope.verifyCanonicalDockerfileLoadedV12(loaded); err != nil {
+		return err
+	}
+	scope.preferredDockerignoreReadVerifiedV12 = true
+	scope.preferredDockerignoreProofV12 = &PreferredDockerignoreProofV12{
+		Path: approved.Path, Present: true, ContentSHA256: approved.ContentSHA256,
+		WorkerID: loaded.WorkerID, SessionID: loaded.SourceSessionID,
+		DockerfileRefID: loaded.RefID, DockerfileVertex: loaded.RootVertex,
+	}
+	return nil
+}
+
+// Must be called while scope.mu is held; no frontend-controlled role string
+// substitutes for this previously accepted owner canonical worker record.
+func (scope *SolveScope) verifyCanonicalDockerfileLoadedV12(loaded BuiltinLoadedRefV6) error {
+	dockerfile, found := scope.records["dockerfile"]
+	if !found || !validLoadedRefV6(loaded) || loaded.SourceIdentifier != "local://dockerfile" ||
+		loaded.SourceSessionID != scope.auth.ContextSessionIDsV8["dockerfile"] ||
+		loaded.WorkerID != dockerfile.WorkerID || loaded.RefID != dockerfile.SnapshotID ||
+		loaded.RootVertex != dockerfile.VertexDigest || loaded.OutputIndex != dockerfile.VertexOutputIndex ||
+		dockerfile.TreeDigest != scope.auth.ContextTreeDigests["dockerfile"] {
+		return errors.New("C1 V12 preferred ignore lookup is not the owner-approved immutable Dockerfile worker snapshot")
+	}
+	if err := CheckBuiltinLocalReadShapeV7(loaded, "dockerfile"); err != nil {
+		return fmt.Errorf("C1 V12 preferred ignore loaded source is not canonical builtin Dockerfile: %w", err)
+	}
+	return nil
+}
