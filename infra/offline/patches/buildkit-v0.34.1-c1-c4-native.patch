+func TestCausalProofRejectsDisconnectedStaleAndNonCanonicalEvidence(t *testing.T) {
+	newCompletedScope := func(t *testing.T) (*fakeService, context.Context, *SolveScope) {
+		t.Helper()
+		service := &fakeService{}
+		manager, err := NewManager(service, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, scope, err := manager.BeginSolve(context.Background(), testBinding())
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, name := range RequiredContextNames() {
+			if err := manager.ContextConsumed(ctx, testConsumption(name)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return service, ctx, scope
+	}
+
+	t.Run("disconnected edge", func(t *testing.T) {
+		service, ctx, scope := newCompletedScope(t)
+		output := testOutput(scope)
+		output.Causality.Roots[0].ContextPaths[0].Edges[0].ParentVertexDigest = testVertexDigest("dockerfile")
+		output.Causality.ProofDigest, _ = CausalityProofDigest(output.Causality)
+		if err := scope.Complete(ctx, output); err == nil || !strings.Contains(err.Error(), "disconnected or invalid solver edge") {
+			t.Fatalf("disconnected solver edge was accepted: %v", err)
+		}
+		if service.completeCalls != 0 {
+			t.Fatal("disconnected proof reached owner completion")
+		}
+	})
+
+	t.Run("wrong selected parent output", func(t *testing.T) {
+		service, ctx, scope := newCompletedScope(t)
+		output := testOutput(scope)
+		output.Causality.Roots[0].ContextPaths[0].Edges[0].ParentOutputIndex = 1
+		output.Causality.ProofDigest, _ = CausalityProofDigest(output.Causality)
+		if err := scope.Complete(ctx, output); err == nil || !strings.Contains(err.Error(), "disconnected or invalid solver edge") {
+			t.Fatalf("path from an unselected parent output was accepted: %v", err)
+		}
+		if service.completeCalls != 0 {
+			t.Fatal("wrong parent output reached owner completion")
+		}
+	})
+
+	t.Run("stale proof digest", func(t *testing.T) {
+		service, ctx, scope := newCompletedScope(t)
+		output := testOutput(scope)
+		output.Causality.Roots[0].ContextPaths[0].TreeDigest = "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
+		if err := scope.Complete(ctx, output); err == nil || !strings.Contains(err.Error(), "proof digest does not match") {
+			t.Fatalf("mutated proof with stale digest was accepted: %v", err)
+		}
+		if service.completeCalls != 0 {
+			t.Fatal("stale proof digest reached owner completion")
+		}
+	})
+
+	t.Run("noncanonical path order", func(t *testing.T) {
+		service, ctx, scope := newCompletedScope(t)
+		output := testOutput(scope)
+		paths := output.Causality.Roots[0].ContextPaths
+		paths[0], paths[1] = paths[1], paths[0]
+		output.Causality.ProofDigest, _ = CausalityProofDigest(output.Causality)
+		if err := scope.Complete(ctx, output); err == nil || !strings.Contains(err.Error(), "context paths are not in canonical order") {
+			t.Fatalf("noncanonical causal paths were accepted: %v", err)
+		}
+		if service.completeCalls != 0 {
+			t.Fatal("noncanonical proof reached owner completion")
+		}
+	})
+}
