+package control
+
+import (
+	"errors"
+	"testing"
+
+	controlapi "github.com/moby/buildkit/api/services/control"
+	"github.com/moby/buildkit/util/localcontext"
+)
+
+func TestLocalContextBindingRequiresCompleteOwnerFields(t *testing.T) {
+	if _, enabled, err := localContextBindingFromRequest(&controlapi.SolveRequest{}); err != nil || enabled {
+		t.Fatalf("ordinary solve binding = enabled %v, err %v", enabled, err)
+	}
+	if _, _, err := localContextBindingFromRequest(&controlapi.SolveRequest{FrontendAttrs: map[string]string{
+		localcontext.FrontendAttrRole: "runtime",
+	}}); err == nil {
+		t.Fatal("partial owner local-context binding was accepted")
+	}
+	request := &controlapi.SolveRequest{
+		Ref: "job-c1-01",
+		FrontendAttrs: map[string]string{
+			localcontext.FrontendAttrApprovalID:       "approval-c1-01",
+			localcontext.FrontendAttrNonce:            "0123456789abcdef0123456789abcdef",
+			localcontext.FrontendAttrRole:             "runtime",
+			localcontext.FrontendAttrApprovalEnvelope: "c2lnbmVk",
+		},
+	}
+	binding, enabled, err := localContextBindingFromRequest(request)
+	if err != nil || !enabled {
+		t.Fatalf("valid binding enabled %v, err %v", enabled, err)
+	}
+	if binding.JobID != request.Ref || binding.Role != "runtime" || binding.ApprovalID != "approval-c1-01" {
+		t.Fatalf("unexpected owner binding: %+v", binding)
+	}
+}
+
+func TestLocalContextAbortFailureIsPreservedWithSolveError(t *testing.T) {
+	solveErr := errors.New("solve failed")
+	abortErr := errors.New("owner abort failed")
+	got := joinLocalContextAbortError(solveErr, abortErr)
+	if !errors.Is(got, solveErr) || !errors.Is(got, abortErr) {
+		t.Fatalf("joined solve and abort error = %v", got)
+	}
+}
+
+func TestLocalContextExporterIntentRequiresOneExplicitImageDestination(t *testing.T) {
+	for _, request := range []*controlapi.SolveRequest{
+		{},
+		{Exporters: []*controlapi.Exporter{{Type: "image", Attrs: map[string]string{"name": "c1.example/runtime:approved"}}, {Type: "image", Attrs: map[string]string{"name": "c1.example/extra:tag"}}}},
+		{Exporters: []*controlapi.Exporter{{Type: "oci", Attrs: map[string]string{"name": "c1.example/runtime:approved"}}}},
+		{Exporters: []*controlapi.Exporter{{Type: "image"}}},
+		{Exporters: []*controlapi.Exporter{{Type: "image", Attrs: map[string]string{"name": "*"}}}},
+	} {
+		if _, err := localContextExporterIntentFromRequest(request); err == nil {
+			t.Fatalf("accepted unsupported C1 exporter request: %+v", request)
+		}
+	}
+	request := &controlapi.SolveRequest{Exporters: []*controlapi.Exporter{{
+		Type: "image", Attrs: map[string]string{"name": "c1.example/runtime:approved", "push": "false"},
+	}}}
+	intent, err := localContextExporterIntentFromRequest(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if intent.SchemaVersion != 2 || intent.ID != 0 || intent.Type != "image" || intent.Destination != "c1.example/runtime:approved" || intent.AttributesDigest != localcontext.ExporterAttributesDigest(request.Exporters[0].Attrs) {
+		t.Fatalf("unexpected owner-bound exporter intent: %+v", intent)
+	}
+}
