@@ -0,0 +1,84 @@
+package control
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/stretchr/testify/require"
+)
+
+const causalTestWorker = "worker-causal-test"
+
+var causalTestDigests = map[string]string{
+	"source":                 "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+	"dockerfile":             "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+	"offline-npm-cacache":    "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
+	"offline-prisma-engines": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
+}
+
+type causalTestOwner struct{ completeCalls int }
+
+func (o *causalTestOwner) Begin(_ context.Context, binding localcontext.Binding) (localcontext.Authorization, error) {
+	identities := make(map[string]string)
+	for _, name := range localcontext.RequiredContextNames() {
+		identities[name] = "owner-context:" + name
+	}
+	return localcontext.Authorization{
+		Token: "owner-token-causal-test", Generation: binding.Nonce, WorkerID: causalTestWorker,
+		ContextIdentities: identities, ContextTreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+		ContextTreeDigests: causalTestDigests, ExporterPolicy: binding.Exporter,
+		ExpectedImage: localcontext.ImageDescriptor{
+			MediaType: "application/vnd.oci.image.manifest.v1+json",
+			Digest:    "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", Size: 1024,
+		},
+		ExpiresAt: time.Now().Add(time.Minute),
+	}, nil
+}
+
+func (o *causalTestOwner) Complete(context.Context, localcontext.Completion) error {
+	o.completeCalls++
+	return nil
+}
+
+func (o *causalTestOwner) Abort(context.Context, string, string) error { return nil }
+
+func causalTestExporterIntent() localcontext.ExporterIntent {
+	intent, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "c1.example/runtime:approved"})
+	if err != nil {
+		panic(err)
+	}
+	return intent
+}
+
+func TestC1CompletionRequiresTypedCausalityProof(t *testing.T) {
+	owner := &causalTestOwner{}
+	manager, err := localcontext.NewManager(owner, true)
+	require.NoError(t, err)
+	ctx, scope, err := manager.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-causal-test", Role: "runtime", Nonce: "0123456789abcdef0123456789abcdef",
+		ApprovalID: "approval-causal-test", ApprovalEnvelope: "c2lnbmVk", Exporter: causalTestExporterIntent(),
+	})
+	require.NoError(t, err)
+	for index, name := range localcontext.RequiredContextNames() {
+		record := localcontext.Consumption{
+			Name: name, WorkerID: causalTestWorker, SessionID: "session-causal-test",
+			VertexDigest: fmt.Sprintf("sha256:%064x", index+1), VertexOutputIndex: 0,
+			SnapshotID: "snapshot-" + name, TreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+			TreeDigest: causalTestDigests[name], RegularFileBytes: 10, EntryCount: 2,
+		}
+		require.NoError(t, manager.ContextConsumed(ctx, record))
+	}
+
+	err = scope.Complete(ctx, localcontext.Output{
+		WorkerID: causalTestWorker,
+		Image: localcontext.ImageDescriptor{
+			MediaType: "application/vnd.oci.image.manifest.v1+json",
+			Digest:    "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", Size: 1024,
+		},
+	})
+	require.ErrorContains(t, err, "proof version, exporter policy, or image root set is missing")
+	require.Zero(t, owner.completeCalls, "owner must not receive an output with no causal proof")
+}
diff --git a/control/local_context_observer.go b/control/local_context_observer.go
new file mode 100644
index 0000000..e3fc529
--- /dev/null
+++ b/control/local_context_observer.go
@@ -0,0 +1,61 @@
+package control
+
+import (
+	"errors"
+	"fmt"
+
+	controlapi "github.com/moby/buildkit/api/services/control"
+	"github.com/moby/buildkit/util/localcontext"
+)
+
+// localContextBindingFromRequest extracts the owner-approved workflow fields
+// from the Solve request. Their values are still untrusted until the configured
+// owner service verifies the signed approval.
+func localContextBindingFromRequest(req *controlapi.SolveRequest) (localcontext.Binding, bool, error) {
+	if req == nil {
+		return localcontext.Binding{}, false, errors.New("solve request is missing")
+	}
+	keys := []string{
+		localcontext.FrontendAttrApprovalID,
+		localcontext.FrontendAttrNonce,
+		localcontext.FrontendAttrRole,
+		localcontext.FrontendAttrApprovalEnvelope,
+	}
+	values := make([]string, len(keys))
+	provided := 0
+	for i, key := range keys {
+		values[i] = req.FrontendAttrs[key]
+		if values[i] != "" {
+			provided++
+		}
+	}
+	if provided == 0 {
+		return localcontext.Binding{}, false, nil
+	}
+	if provided != len(keys) {
+		return localcontext.Binding{}, false, errors.New("owner local-context solve binding is incomplete")
+	}
+	return localcontext.Binding{
+		JobID:            req.Ref,
+		ApprovalID:       values[0],
+		Nonce:            values[1],
+		Role:             values[2],
+		ApprovalEnvelope: values[3],
+	}, true, nil
+}
+
+// localContextExporterIntentFromRequest bounds C1 to one explicit image
+// exporter whose destination and full attributes are owner-authorized.
+func localContextExporterIntentFromRequest(req *controlapi.SolveRequest) (localcontext.ExporterIntent, error) {
+	if req == nil || len(req.Exporters) != 1 || req.Exporters[0] == nil {
+		return localcontext.ExporterIntent{}, errors.New("C1 requires exactly one explicit image exporter")
+	}
+	return localcontext.NewExporterIntent(req.Exporters[0].Type, 0, req.Exporters[0].Attrs)
+}
+
+func joinLocalContextAbortError(solveErr, abortErr error) error {
+	if abortErr == nil {
+		return solveErr
+	}
+	return errors.Join(solveErr, fmt.Errorf("owner local-context abort failed: %w", abortErr))
+}
