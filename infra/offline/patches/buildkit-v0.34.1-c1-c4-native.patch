@@ -0,0 +1,57 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestLocalContextObserverConfigRequiresCompleteOwnerSocketPolicy(t *testing.T) {
+	validV3 := LocalContextObserverConfig{
+		Required:               true,
+		SocketPath:             "/run/virki/observer.sock",
+		SocketOwnerUID:         uint32Pointer(1000),
+		Protocol:               "vroa-v3",
+		Epoch:                  1,
+		ApprovalPublicKeyFile:  "/etc/virki/approval.pub",
+		ApprovalKeyID:          "owner-key-1",
+		ApprovalPinSHA256:      strings.Repeat("a", 64),
+		ExpectedImageMediaType: "application/vnd.oci.image.manifest.v1+json",
+		ExpectedImageDigest:    "sha256:" + strings.Repeat("b", 64),
+		ExpectedImageSize:      2048,
+	}
+	v1WithV3Fields := validV3
+	v1WithV3Fields.Protocol = "v1"
+	missingImg := validV3
+	missingImg.ExpectedImageSize = 0
+	badProto := validV3
+	badProto.Protocol = "v99"
+
+	tests := []struct {
+		name    string
+		config  LocalContextObserverConfig
+		wantErr bool
+	}{
+		{name: "disabled", config: LocalContextObserverConfig{}},
+		{name: "required without socket", config: LocalContextObserverConfig{Required: true}, wantErr: true},
+		{name: "relative socket", config: LocalContextObserverConfig{SocketPath: "observer.sock", SocketOwnerUID: uint32Pointer(1000)}, wantErr: true},
+		{name: "noncanonical socket", config: LocalContextObserverConfig{SocketPath: "/run/../run/virki/observer.sock", SocketOwnerUID: uint32Pointer(1000)}, wantErr: true},
+		{name: "missing owner uid", config: LocalContextObserverConfig{SocketPath: "/run/virki/observer.sock"}, wantErr: true},
+		{name: "complete owner socket", config: LocalContextObserverConfig{Required: true, SocketPath: "/run/virki/observer.sock", SocketOwnerUID: uint32Pointer(1000)}},
+		{name: "complete vroa-v3 config", config: validV3},
+		{name: "v1 rejects vroa-v3 fields", config: v1WithV3Fields, wantErr: true},
+		{name: "vroa-v3 rejects missing expected image size", config: missingImg, wantErr: true},
+		{name: "unknown protocol rejected", config: badProto, wantErr: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.config.Validate()
+			if (err != nil) != test.wantErr {
+				t.Fatalf("Validate() error = %v, wantErr %v", err, test.wantErr)
+			}
+		})
+	}
+}
+
+func uint32Pointer(value uint32) *uint32 {
+	return &value
+}
