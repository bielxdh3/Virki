+	selectedPlatforms["linux/arm64"] = am64
+	if err := ValidateDockerfileTransformV4(p, observed, exported, selectedPlatforms, captured); err == nil {
+		t.Fatal("accepted identical root set with physically swapped amd64/arm64 exporter assignments")
+	}
+	delete(selectedPlatforms, "linux/arm64")
+	if err := ValidateDockerfileTransformV4(p, observed, exported, selectedPlatforms, captured); err == nil {
+		t.Fatal("accepted missing exporter platform")
+	}
+	selectedPlatforms["attacker"] = arm
+	if err := ValidateDockerfileTransformV4(p, observed, exported, selectedPlatforms, captured); err == nil {
+		t.Fatal("accepted foreign exporter platform")
+	}
+}
+
+func TestC1DockerfileTransformV4CannotFabricateAbsentIgnoreFromUnobservedReads(t *testing.T) {
+	p, consumed, exported, selected, capture := v4Fixture(t)
+	requireMissing := func(t *testing.T, mutated FrontendCaptureV4) {
+		t.Helper()
+		if err := ValidateDockerfileTransformV4(p, consumed, exported, selected, mutated); err == nil {
+			t.Fatal("accepted forged effective .dockerignore absence")
