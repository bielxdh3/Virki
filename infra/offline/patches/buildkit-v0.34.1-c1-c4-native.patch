+func TestC1V28AdversarialCustodyBoundaryRefusals(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("unprivileged custody boundary refusal test requires non-root euid")
+	}
+	base := t.TempDir()
+	require.NoError(t, os.Chmod(base, 0700))
+
+	realParent := filepath.Join(base, "real-parent")
+	require.NoError(t, os.Mkdir(realParent, 0700))
+	symParent := filepath.Join(base, "sym-parent")
+	require.NoError(t, os.Symlink(realParent, symParent))
+	err := validateV24CustodyDirs(filepath.Join(symParent, "published"), V24ReceiverCustodyPolicy{
+		RequirePrivateParent: true,
+	})
+	require.Error(t, err)
+
+	publicParent := filepath.Join(base, "public-parent")
+	require.NoError(t, os.Mkdir(publicParent, 0755))
+	err = validateV24CustodyDirs(filepath.Join(publicParent, "published"), V24ReceiverCustodyPolicy{
+		RequirePrivateParent: true,
+	})
+	require.ErrorContains(t, err, "must be 0700")
+
+	m := v15PacketManifest()
+	destSymlink := filepath.Join(realParent, "published-link")
+	require.NoError(t, os.Symlink(filepath.Join(base, "outside"), destSymlink))
+	called := false
+	err = receiveV24WithCustody(destSymlink, m, V24ReceiverCustodyPolicy{RequirePrivateParent: true}, func(stage string) error {
+		called = true
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	})
+	require.Error(t, err)
+	require.False(t, called, "stage callback must not run when destination custody fails or already exists")
+}
