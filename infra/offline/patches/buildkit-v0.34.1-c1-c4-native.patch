+}
+
+// VerifyRootDockerignoreReadV10 binds actual builtin ReadFile status and
+// bytes to the independently observed, immutable auxiliary snapshot. The
+// frontend MUST call this before normalizing nil read content to []byte{}.
+// This same-process comparison is not a native C4 signature or proof of
+// daemon-selected builtin frontend identity.
+func VerifyRootDockerignoreReadV10(ctx context.Context, readData []byte, readErr error, loaded BuiltinLoadedRefV6) error {
+	if ctx == nil || ctx.Err() != nil {
+		return errors.New("C1 V10 root ignore read has no active solve context")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V10 root ignore read has no private owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	a := scope.auth.RootDockerignoreV10
+	r := scope.auxiliaryRootIgnoreV10
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) ||
+		a == nil || r == nil || scope.auxiliaryRootIgnoreReadAttemptedV11 {
+		return errors.New("C1 V10 root ignore read has no approved current worker observation")
+	}
+	// A first failed read is terminal for this one-use frontend proof. A second
+	// corrected call must not erase an ambiguous I/O error or mismatched ref.
+	scope.auxiliaryRootIgnoreReadAttemptedV11 = true
+	present := readErr == nil
+	if readErr != nil && !IsMissingBuiltinFrontendFileV4(readErr) {
+		return fmt.Errorf("C1 V10 root ignore cannot attest an ambiguous read error: %w", readErr)
+	}
+	if !present && len(readData) != 0 {
+		return errors.New("C1 V10 missing root ignore read returned unexpected bytes")
+	}
+	if a.Present != present || a.ContentSHA256 != SHA256BytesV4(readData) ||
+		!validLoadedRefV6(loaded) || loaded.SourceIdentifier != "local://context" ||
+		loaded.SourceSessionID != a.SessionID || loaded.WorkerID != r.WorkerID ||
+		loaded.RefID != r.SnapshotID || loaded.RootVertex != r.VertexDigest ||
+		loaded.OutputIndex != r.VertexOutputIndex {
+		return errors.New("C1 V10 builtin root ignore read differs from approved immutable worker probe")
+	}
+	if err := CheckBuiltinLocalReadShapeV7(loaded, "auxiliary-ignore"); err != nil {
+		return fmt.Errorf("C1 V10 loaded root ignore source shape differs from verified probe: %w", err)
+	}
+	scope.auxiliaryRootIgnoreReadVerifiedV10 = true
+	return nil
+}
+
+// RootDockerignoreObservationV10 returns a COPY for diagnostic review, never
+// a permit or a fifth CausalInputs member. It cannot be used to SIGN_ACK.
+func (s *SolveScope) RootDockerignoreObservationV10() (Consumption, error) {
+	if s == nil || s.manager == nil {
+		return Consumption{}, errors.New("C1 V10 owner root ignore scope unavailable")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.completionAttempted || s.abortRequested || time.Now().After(s.auth.ExpiresAt) ||
+		s.auxiliaryRootIgnoreV10 == nil {
+		return Consumption{}, errors.New("C1 V10 approved root ignore observation is unavailable")
+	}
+	return *s.auxiliaryRootIgnoreV10, nil
+}
