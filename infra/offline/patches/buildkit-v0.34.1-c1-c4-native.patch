+func TestC1V22NestedRegularTreeAndExternalHardlinkAreSeparated(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	m.Files = []V15FilePin{{Path: "nested/app.js", SHA256: v15Hash([]byte("SAFE")), Size: 4}}
+	m.Digest = v15ManifestDigest(m)
+	parent := t.TempDir()
+	dest := filepath.Join(parent, "published")
+	require.NoError(t, receiveV19Quarantined(dest, m, func(stage string) error {
+		if err := os.Mkdir(filepath.Join(stage, "nested"), 0700); err != nil {
+			return err
+		}
+		return os.WriteFile(filepath.Join(stage, "nested", "app.js"), []byte("SAFE"), 0600)
+	}))
+	bytes, err := os.ReadFile(filepath.Join(dest, "nested", "app.js"))
+	require.NoError(t, err)
+	require.Equal(t, []byte("SAFE"), bytes)
+	require.Error(t, receiveV19Quarantined(dest, m, func(stage string) error { return nil }),
+		"a second valid sender cannot replace an already published verified tree")
+
+	// An attacker can create a hard link to a regular inode outside the
+	// quarantine without any symlink. The NOFOLLOW verifier alone does not
+	// detect this; the fstat link-count constraint must refuse publication.
+	outside := filepath.Join(t.TempDir(), "external-app.js")
+	require.NoError(t, os.WriteFile(outside, []byte("SAFE"), 0600))
+	hardlinkDest := filepath.Join(parent, "hardlink-refused")
+	err = receiveV19Quarantined(hardlinkDest, v15PacketManifest(), func(stage string) error {
+		return os.Link(outside, filepath.Join(stage, "app.js"))
+	})
+	require.ErrorContains(t, err, "hardlinked stage file")
+	_, err = os.Lstat(hardlinkDest)
+	require.ErrorIs(t, err, os.ErrNotExist)
+	got, err := os.ReadFile(outside)
+	require.NoError(t, err)
+	require.Equal(t, []byte("SAFE"), got)
+}
