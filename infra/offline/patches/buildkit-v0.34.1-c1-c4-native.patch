+func TestC1V12PreferredDockerfileSourceRejectsRawAttrForgingBeforeFileSync(t *testing.T) {
+	export, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "v12.example/dockerfile:dev"})
+	require.NoError(t, err)
+	m, err := localcontext.NewManager(v12DockerfileShapeOwnerService{}, false)
+	require.NoError(t, err)
+	ctx, scope, err := m.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-v12-dockerfile", Role: "runtime", Nonce: strings.Repeat("b", 32),
+		ApprovalID: "approval-v12", ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: export,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	valid := map[string]string{
+		pb.AttrLocalSessionID: "session-approved-v9",
+		pb.AttrSharedKeyHint:  "dockerfile",
+		pb.AttrFollowPaths:    `["Dockerfile","Dockerfile.dockerignore","dockerfile"]`,
+		pb.AttrLocalDiffer:    pb.AttrLocalDifferNone,
