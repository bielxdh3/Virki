@@ -0,0 +1,304 @@
+//go:build linux
+
+package filesync
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/rand"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/moby/buildkit/session"
+	"github.com/moby/buildkit/session/testutil"
+	"github.com/stretchr/testify/require"
+	"github.com/tonistiigi/fsutil"
+	"golang.org/x/sync/errgroup"
+)
+
+func v15Request(root string, files ...string) V15SnapshotRequest {
+	request := V15SnapshotRequest{Root: root, ContextName: "context", WorkerID: "worker-v15-dev",
+		SessionID: "session-v15-dev", Nonce: strings.Repeat("b", 32)}
+	for _, f := range files {
+		data, _ := os.ReadFile(filepath.Join(root, f))
+		request.Files = append(request.Files, V15FilePin{Path: f, SHA256: v15Hash(data), Size: int64(len(data))})
+	}
+	return request
+}
+
+func v15SignedPermitFixture(t *testing.T, m V15SealedManifest) (V15OwnerPermit, ed25519.PublicKey, *V15LocalReplayLedger) {
+	t.Helper()
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	p := V15OwnerPermit{Domain: V15OwnerDomain, ApprovalID: "owner-test-v15",
+		ManifestDigest: m.Digest, WorkerID: m.WorkerID, SessionID: m.SessionID,
+		ContextName: m.ContextName, Nonce: m.Nonce, Epoch: 7, ExpiresUnix: time.Now().Add(time.Minute).Unix()}
+	p.Signature = ed25519.Sign(priv, v15PermitBytes(p))
+	return p, pub, NewV15LocalReplayLedger(7)
+}
+
+func TestC1V15LinuxFrozenOpenat2SnapshotNoHostReopen(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "src"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "src", "app.js"), []byte("APPROVED"), 0600))
+	r := v15Request(root, "src/app.js")
+	snap, err := NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.NoError(t, err)
+	m := snap.Manifest()
+	require.Equal(t, "virki-c1-v15-memory-fs-1", m.Schema)
+	require.Equal(t, int64(8), m.Bytes)
+	require.Equal(t, v15ManifestDigest(m), m.Digest)
+	// Mutating, renaming or removing all original host files cannot change
+	// an async stream's later Open: this fsutil.FS holds frozen bytes only.
+	require.NoError(t, os.Remove(filepath.Join(root, "src", "app.js")))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "src", "app.js"), []byte("UNAPPROVED"), 0600))
+	for i := 0; i < 3; i++ {
+		rc, err := snap.Open("src/app.js")
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		require.Equal(t, []byte("APPROVED"), got)
+	}
+	m.Files[0].SHA256 = "tampered"
+	m.ExcludePatterns = []string{"*"}
+	require.Equal(t, r.Files[0].SHA256, snap.Manifest().Files[0].SHA256)
+	require.Empty(t, snap.Manifest().ExcludePatterns)
+	for _, p := range []string{"../secret", "/etc/passwd", "src/../src/app.js"} {
+		_, err := snap.Open(p)
+		require.Error(t, err)
+	}
+	paths := []string{}
+	require.NoError(t, snap.Walk(t.Context(), ".", func(p string, _ os.DirEntry, err error) error {
+		require.NoError(t, err)
+		paths = append(paths, p)
+		return nil
+	}))
+	require.Equal(t, []string{"src", "src/app.js"}, paths)
+}
+
+func TestC1V15LinuxRefusesSymlinksHardlinksEscapesAndInvalidHashes(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "sub"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "valid.txt"), []byte("good"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(outside, "secret"), []byte("secret"), 0600))
+	require.NoError(t, os.Symlink("valid.txt", filepath.Join(root, "linked.txt")))
+	require.NoError(t, os.Symlink(outside, filepath.Join(root, "dirlink")))
+	require.NoError(t, os.Link(filepath.Join(root, "valid.txt"), filepath.Join(root, "hard.txt")))
+	for _, p := range []string{"linked.txt", "dirlink/secret", "hard.txt"} {
+		r := v15Request(root)
+		r.Files = []V15FilePin{{Path: p, SHA256: v15Hash([]byte("good")), Size: int64(len("good"))}}
+		_, err := NewLinuxSealedSnapshotV15(t.Context(), r)
+		require.Error(t, err, p)
+	}
+	r := v15Request(root)
+	r.Files = []V15FilePin{{Path: "../secret", SHA256: v15Hash([]byte("secret")), Size: int64(len("secret"))}}
+	_, err := NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.Error(t, err)
+	r.Files = []V15FilePin{{Path: "valid.txt", SHA256: v15Hash([]byte("false")), Size: int64(len("good"))}}
+	_, err = NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.Error(t, err)
+	r.Files = []V15FilePin{{Path: "valid.txt", SHA256: "sha256:" + strings.Repeat("A", 64), Size: int64(len("good"))}}
+	_, err = NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.Error(t, err)
+	// A symlinked directory ROOT itself cannot be the trusted root FD.
+	alias := filepath.Join(t.TempDir(), "alias")
+	require.NoError(t, os.Symlink(root, alias))
+	r.Root = alias
+	r.Files = []V15FilePin{{Path: "valid.txt", SHA256: v15Hash([]byte("good")), Size: int64(len("good"))}}
+	_, err = NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.Error(t, err)
+}
+
+func TestC1V15PhysicalSessionOnlySealedProtocolAndFrozenBytes(t *testing.T) {
+	// Use the actual Linux filesystem for receiver ownership metadata. WSL
+	// DrvFs under E: cannot reliably implement chown despite valid stat bytes.
+	t.Setenv("TMPDIR", "/tmp")
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("APPROVED"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "secret.env"), []byte("SECRET"), 0600))
+	r := v15Request(root, "app.js")
+	snap, err := NewLinuxSealedSnapshotV15(t.Context(), r)
+	require.NoError(t, err)
+	manifest := snap.Manifest()
+	permit, pub, ledger := v15SignedPermitFixture(t, manifest)
+	// Mutate source before network session: sender must expose only frozen bytes.
+	require.NoError(t, os.Remove(filepath.Join(root, "app.js")))
+	require.NoError(t, os.Symlink("secret.env", filepath.Join(root, "app.js")))
+	ctx := t.Context()
+	s, err := session.NewSession(ctx, "sealed-v15-test")
+	require.NoError(t, err)
+	mgr, err := session.NewManager()
+	require.NoError(t, err)
+	s.Allow(NewSealedFSSyncProviderV15(snap))
+	dialer := session.Dialer(testutil.TestStream(testutil.Handler(mgr.HandleConn)))
+	g, ctx := errgroup.WithContext(ctx)
+	g.Go(func() error { return s.Run(ctx, dialer) })
+	g.Go(func() (retErr error) {
+		defer func() {
+			if err := s.Close(); retErr == nil {
+				retErr = err
+			}
+		}()
+		caller, err := mgr.Get(ctx, s.ID(), false)
+		if err != nil {
+			return err
+		}
+		parent := t.TempDir()
+		if err := os.Chmod(parent, 0700); err != nil {
+			return err
+		}
+		dest := filepath.Join(parent, "published-v22")
+		opt := FSSendRequestOpt{Name: "context", FollowPaths: []string{"app.js"}, DestDir: dest}
+		if err := FSSyncSealedV15(ctx, caller, opt, manifest, permit, pub, ledger); err != nil {
+			return err
+		}
+		got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+		if err != nil {
+			return err
+		}
+		if !bytes.Equal(got, []byte("APPROVED")) {
+			return errors.New("V15 sealed network sent mutable secret rather than approved bytes")
+		}
+		if _, err := os.Stat(filepath.Join(dest, "secret.env")); !errors.Is(err, os.ErrNotExist) {
+			return errors.New("V15 leaked unauthorized sibling")
+		}
+		if err := FSSyncSealedV15(ctx, caller, opt, manifest, permit, pub, ledger); err == nil {
+			return errors.New("V15 replayed snapshot streamed again")
+		}
+		bad := opt
+		bad.FollowPaths = []string{"secret.env"}
+		if err := FSSyncSealedV15(ctx, caller, bad, manifest, permit, pub, ledger); err == nil {
+			return errors.New("V15 altered filter accepted")
+		}
+		return nil
+	})
+	require.NoError(t, g.Wait())
+}
+
+func TestC1V15LegacyClientCannotDowngradeSealedRPC(t *testing.T) {
+	ctx := t.Context()
+	s, err := session.NewSession(ctx, "legacy-downgrade-v15")
+	require.NoError(t, err)
+	mgr, err := session.NewManager()
+	require.NoError(t, err)
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("APPROVED"), 0600))
+	fs, err := fsutil.NewFS(root)
+	require.NoError(t, err)
+	s.Allow(NewFSSyncProvider(StaticDirSource{"context": fs}))
+	r := v15Request(root, "app.js")
+	_, err = NewLinuxSealedSnapshotV15(ctx, r)
+	require.NoError(t, err)
+	m := V15SealedManifest{Schema: "virki-c1-v15-memory-fs-1", ContextName: r.ContextName,
+		WorkerID: r.WorkerID, SessionID: r.SessionID, Nonce: r.Nonce, Files: r.Files}
+	m.Bytes = int64(len("APPROVED"))
+	m.Digest = v15ManifestDigest(m)
+	permit, pub, ledger := v15SignedPermitFixture(t, m)
+	dialer := session.Dialer(testutil.TestStream(testutil.Handler(mgr.HandleConn)))
+	g, ctx := errgroup.WithContext(ctx)
+	g.Go(func() error { return s.Run(ctx, dialer) })
+	g.Go(func() (retErr error) {
+		defer func() {
+			if err := s.Close(); retErr == nil {
+				retErr = err
+			}
+		}()
+		caller, err := mgr.Get(ctx, s.ID(), false)
+		if err != nil {
+			return err
+		}
+		err = FSSyncSealedV15(ctx, caller, FSSendRequestOpt{Name: "context", FollowPaths: []string{"app.js"}, DestDir: filepath.Join(t.TempDir(), "published-v22")}, m, permit, pub, ledger)
+		if err == nil || !strings.Contains(err.Error(), "legacy diffcopy fallback forbidden") {
+			return errors.New("C1 V15 silently downgraded to legacy physical transfer")
+		}
+		return nil
+	})
+	require.NoError(t, g.Wait())
+}
+
+func TestC1V15Ed25519TamperingStaleEpochExpiryConcurrentReplay(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("APPROVED"), 0600))
+	snap, err := NewLinuxSealedSnapshotV15(t.Context(), v15Request(root, "app.js"))
+	require.NoError(t, err)
+	m := snap.Manifest()
+	p, pub, _ := v15SignedPermitFixture(t, m)
+	for _, tc := range []struct {
+		name   string
+		mutate func(*V15OwnerPermit)
+	}{
+		{"wrong worker", func(p *V15OwnerPermit) { p.WorkerID = "fake-worker" }},
+		{"wrong nonce", func(p *V15OwnerPermit) { p.Nonce = "wrong-nonce" }},
+		{"wrong session", func(p *V15OwnerPermit) { p.SessionID = "other-session" }},
+		{"wrong manifest", func(p *V15OwnerPermit) { p.ManifestDigest = "sha256:" + strings.Repeat("f", 64) }},
+		{"wrong role", func(p *V15OwnerPermit) { p.ContextName = "dockerfile" }},
+		{"expired", func(p *V15OwnerPermit) { p.ExpiresUnix = time.Now().Add(-time.Minute).Unix() }},
+		{"stale epoch", func(p *V15OwnerPermit) { p.Epoch = 6 }},
+		{"tampered approval", func(p *V15OwnerPermit) { p.ApprovalID = "fake" }},
+		{"invalid signature", func(p *V15OwnerPermit) { p.Signature[0] ^= 0xff }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			bad := p
+			bad.Signature = append([]byte(nil), p.Signature...)
+			tc.mutate(&bad)
+			if err := NewV15LocalReplayLedger(7).VerifyAndClaim(m, bad, pub); err == nil {
+				t.Fatal("tampered or stale permit claimed without independently pinned signature")
+			}
+		})
+	}
+	wrong := m
+	wrong.Files = append([]V15FilePin(nil), m.Files...)
+	wrong.Files[0].SHA256 = "sha256:" + strings.Repeat("a", 64)
+	require.Error(t, NewV15LocalReplayLedger(7).VerifyAndClaim(wrong, p, pub))
+	ledger := NewV15LocalReplayLedger(7)
+	var wg sync.WaitGroup
+	var accepted atomic.Int64
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if ledger.VerifyAndClaim(m, p, pub) == nil {
+				accepted.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	require.Equal(t, int64(1), accepted.Load(), "concurrent signed replay must reserve exactly one transfer")
+	require.Error(t, ledger.VerifyAndClaim(m, p, pub))
+}
+
+func TestC1V18VolatileLedgerFencesLowerEpochAfterHigherSignedPermit(t *testing.T) {
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("APPROVED"), 0600))
+	snapshot, err := NewLinuxSealedSnapshotV15(t.Context(), v15Request(root, "app.js"))
+	require.NoError(t, err)
+	m := snapshot.Manifest()
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	p := V15OwnerPermit{Domain: V15OwnerDomain, ApprovalID: "v18-high-epoch",
+		ManifestDigest: m.Digest, WorkerID: m.WorkerID, SessionID: m.SessionID,
+		ContextName: m.ContextName, Nonce: m.Nonce, Epoch: 12, ExpiresUnix: time.Now().Add(time.Minute).Unix()}
+	p.Signature = ed25519.Sign(priv, v15PermitBytes(p))
+	ledger := NewV15LocalReplayLedger(7)
+	require.NoError(t, ledger.VerifyAndClaim(m, p, pub))
+	lower := p
+	lower.ApprovalID = "v18-lower-epoch-with-valid-signature"
+	lower.Epoch = 11
+	lower.Signature = ed25519.Sign(priv, v15PermitBytes(lower))
+	require.ErrorContains(t, ledger.VerifyAndClaim(m, lower, pub), "stale")
+	newer := p
+	newer.ApprovalID = "v18-higher-epoch"
+	newer.Epoch = 13
+	newer.Signature = ed25519.Sign(priv, v15PermitBytes(newer))
+	require.NoError(t, ledger.VerifyAndClaim(m, newer, pub))
+	require.Error(t, ledger.VerifyAndClaim(m, p, pub))
+}
