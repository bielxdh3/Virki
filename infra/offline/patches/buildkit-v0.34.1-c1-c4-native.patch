+	captured.GeneratedRoots = append(captured.GeneratedRoots, FrontendGeneratedRootV4{Platform: "linux/arm64", RootVertex: r2.VertexDigest, OutputIndex: 0, WorkerID: r2.WorkerID, RefID: r2.RefID})
