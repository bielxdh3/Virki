+func TestLocalContextPathFollowsActualLoadedSolverInputEdges(t *testing.T) {
+	names := localcontext.RequiredContextNames()
+	root := loadCausalRoot(t, llbScratchCopyingLocals(names))
+	for _, name := range names {
+		source := findLoadedLocalSource(t, root.Vertex, name)
+		path, err := localContextPath(root, causalConsumption(name, source.Digest().String()))
+		require.NoError(t, err)
+		require.NotEmpty(t, path.Edges)
+		require.Equal(t, root.Vertex.Digest().String(), path.Edges[0].ParentVertexDigest)
+		require.Equal(t, int(root.Index), path.Edges[0].ParentOutputIndex)
+		require.Equal(t, source.Digest().String(), path.Edges[len(path.Edges)-1].ChildVertexDigest)
+		require.Equal(t, 0, path.Edges[len(path.Edges)-1].ChildOutputIndex)
+		for i := 1; i < len(path.Edges); i++ {
+			require.Equal(t, path.Edges[i-1].ChildOutputIndex, path.Edges[i].ParentOutputIndex)
+		}
+		firstEdge := path.Edges[0]
+		require.Less(t, firstEdge.ParentInputIndex, len(root.Vertex.Inputs()))
+		require.Equal(t, firstEdge.ChildVertexDigest, root.Vertex.Inputs()[firstEdge.ParentInputIndex].Vertex.Digest().String())
+		require.Equal(t, firstEdge.ChildOutputIndex, int(root.Vertex.Inputs()[firstEdge.ParentInputIndex].Index))
+	}
+}
