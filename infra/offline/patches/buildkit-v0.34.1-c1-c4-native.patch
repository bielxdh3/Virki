+		OutputIndex: record.VertexOutputIndex, SourceIdentifier: "local://context",
+		SourceSessionID: record.SessionID, SourceSharedKeyHint: "context-.dockerignore",
+		SourceFollowPaths: `[".dockerignore"]`, SourceDiffer: "none",
+	}
+	if err := VerifyRootDockerignoreReadV10(ctx, nil, fs.ErrNotExist, loaded); err != nil {
+		t.Fatal(err)
