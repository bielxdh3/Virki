+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+func TestC1V4SelectedPlatformRootsFromRealLoadedEdgesAndImmutableRefs(t *testing.T) {
+	w := &causalTestWorker{id: "worker-causal-test"}
+	makeResult := func(name string, data string) (solver.ResultProxy, solver.CachedResult, *causalTestImmutableRef) {
+		state := llb.Scratch().File(llb.Mkfile("/"+name, 0o644, []byte(data)))
+		root := loadCausalRoot(t, state)
+		ref := &causalTestImmutableRef{id: "immutable-" + name}
+		wref := &worker.WorkerRef{Worker: w, ImmutableRef: ref}
+		cached := &causalTestCachedResult{id: wref.ID(), sys: wref}
+		return &causalTestResultProxy{result: cached, edge: root}, cached, ref
+	}
+	amdProxy, amdCached, amdRef := makeResult("amd64", "amd64-root")
+	armProxy, armCached, armRef := makeResult("arm64", "arm64-root")
+	ps := exptypes.Platforms{Platforms: []exptypes.Platform{
+		{ID: "linux/amd64", Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}},
+		{ID: "linux/arm64", Platform: ocispecs.Platform{OS: "linux", Architecture: "arm64"}},
+	}}
+	bytes, err := json.Marshal(ps)
+	require.NoError(t, err)
+	meta := map[string][]byte{exptypes.ExporterPlatformsKey: bytes}
+	res := &frontend.Result{Refs: map[string]solver.ResultProxy{"linux/amd64": amdProxy, "linux/arm64": armProxy}}
+	cached := &solverresult.Result[solver.CachedResult]{Refs: map[string]solver.CachedResult{"linux/amd64": amdCached, "linux/arm64": armCached}}
+	src := &exporter.Source{Refs: map[string]cache.ImmutableRef{"linux/amd64": amdRef, "linux/arm64": armRef}, Metadata: meta}
+	selected, err := selectedLocalContextPlatformRootsV4(t.Context(), res, cached, src, w.id)
+	require.NoError(t, err)
+	require.Len(t, selected, 2)
+	require.Equal(t, amdRef.id, selected["linux/amd64"].RefID)
+	require.Equal(t, armRef.id, selected["linux/arm64"].RefID)
+	require.NotEqual(t, selected["linux/amd64"].VertexDigest, selected["linux/arm64"].VertexDigest)
+	require.NoError(t, AssertV4SelectedPlatformOutputIdentity(selected, src))
+
+	t.Run("swapping only exporter refs is denied", func(t *testing.T) {
+		bad := &exporter.Source{Refs: map[string]cache.ImmutableRef{"linux/amd64": armRef, "linux/arm64": amdRef}, Metadata: meta}
+		_, err := selectedLocalContextPlatformRootsV4(t.Context(), res, cached, bad, w.id)
+		require.ErrorContains(t, err, "immutable reference")
+		require.Error(t, AssertV4SelectedPlatformOutputIdentity(selected, bad))
+	})
+	t.Run("unknown ref ID cannot trigger FindRef single-key fallback", func(t *testing.T) {
+		onePlatform, err := json.Marshal(exptypes.Platforms{Platforms: ps.Platforms[:1]})
+		require.NoError(t, err)
+		wrong := &frontend.Result{Refs: map[string]solver.ResultProxy{"not-linux-amd64": amdProxy}}
+		wrongCache := &solverresult.Result[solver.CachedResult]{Refs: map[string]solver.CachedResult{"not-linux-amd64": amdCached}}
+		wrongInput := &exporter.Source{Refs: map[string]cache.ImmutableRef{"not-linux-amd64": amdRef}, Metadata: map[string][]byte{exptypes.ExporterPlatformsKey: onePlatform}}
+		_, err = selectedLocalContextPlatformRootsV4(t.Context(), wrong, wrongCache, wrongInput, w.id)
+		require.ErrorContains(t, err, "missing exact")
+	})
+	t.Run("missing and duplicated platform metadata is denied", func(t *testing.T) {
+		badMeta := &exporter.Source{Refs: src.Refs, Metadata: map[string][]byte{exptypes.ExporterPlatformsKey: []byte(`{"Platforms":[{"ID":"linux/amd64","Platform":{"os":"linux","architecture":"amd64"}}]}`)}}
+		_, err := selectedLocalContextPlatformRootsV4(t.Context(), res, cached, badMeta, w.id)
+		require.ErrorContains(t, err, "differ")
+		duplicated := exptypes.Platforms{Platforms: []exptypes.Platform{ps.Platforms[0], ps.Platforms[0]}}
+		duplicateBytes, err := json.Marshal(duplicated)
+		require.NoError(t, err)
+		badMeta.Metadata[exptypes.ExporterPlatformsKey] = duplicateBytes
+		_, err = selectedLocalContextPlatformRootsV4(t.Context(), res, cached, badMeta, w.id)
+		require.ErrorContains(t, err, "duplicate")
+	})
+}
