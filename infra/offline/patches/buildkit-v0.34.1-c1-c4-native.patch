+
+func TestC1DockerfileTransformV4RejectsSwappedExporterPlatformAssignments(t *testing.T) {
+	p, observed, exported, selectedPlatforms, captured := v4Fixture(t)
+	arm := CausalRoot{WorkerID: observed.WorkerID, RefID: "arm-output", VertexDigest: SHA256BytesV4([]byte("arm-root")), OutputIndex: 1}
+	exported = append(exported, arm)
+	p.Roots = append(p.Roots, FrontendRootV4{Platform: "linux/arm64", RootVertex: arm.VertexDigest, OutputIndex: 1, WorkerID: arm.WorkerID, RefID: arm.RefID})
+	captured.GeneratedRoots = append(captured.GeneratedRoots, FrontendGeneratedRootV4{Platform: "linux/arm64", RootVertex: arm.VertexDigest, OutputIndex: 1, WorkerID: arm.WorkerID, RefID: arm.RefID})
+	selectedPlatforms["linux/arm64"] = arm
+	p.ProofDigest, _ = DockerfileTransformDigestV4(p)
+	if err := ValidateDockerfileTransformV4(p, observed, exported, selectedPlatforms, captured); err != nil {
+		t.Fatalf("valid typed baseline: %v", err)
+	}
+	am64 := selectedPlatforms["linux/amd64"]
