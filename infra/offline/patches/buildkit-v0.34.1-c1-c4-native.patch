+func compileC4DaemonForBuildKitTest(t *testing.T, testBuild bool) string {
+	t.Helper()
+	// Locate native-owner-authority relative to this BuildKit worktree when present.
+	candidates := []string{
+		filepath.Join("..", "..", "..", "virki-c1-c4-native-bridge-20261119", "infra", "offline", "native-owner-authority"),
+		filepath.Join("..", "..", "infra", "offline", "native-owner-authority"),
+	}
+	var root string
+	for _, c := range candidates {
+		abs, err := filepath.Abs(c)
+		if err == nil {
+			if _, stErr := os.Stat(filepath.Join(abs, "native-owner-authority.c")); stErr == nil {
+				root = abs
+				break
+			}
+		}
+	}
+	if root == "" {
+		t.Skip("native-owner-authority C source not present adjacent to BuildKit worktree")
+	}
+	out := filepath.Join(t.TempDir(), "native-owner-authority-v3")
+	args := []string{"-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-D_FORTIFY_SOURCE=2", "-fstack-protector-strong", "-fPIE", "-pie", "-Wl,-z,relro,-z,now"}
+	if testBuild {
+		args = append(args, "-DVIRKI_OWNER_TEST_BUILD")
+	}
+	args = append(args, "-o", out, "native-owner-authority.c")
+	cmd := exec.Command("gcc", args...)
+	cmd.Dir = root
+	if raw, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("compile C4 daemon: %v\n%s", err, raw)
+	}
+	return out
+}
