+package local
+
+import (
+	"context"
+	"testing"
+
+	"github.com/moby/buildkit/session/filesync"
+)
+
+func TestNewSourceRequiresWorkerConsumptionObserverWhenConfigured(t *testing.T) {
+	if _, err := NewSource(Opt{RequireConsumptionObserver: true}); err == nil {
+		t.Fatal("expected missing worker consumption observer to refuse source startup")
+	}
+
+	observer := ConsumptionObserverFunc(func(context.Context, ContextConsumption) error {
+		return nil
+	})
+	if _, err := NewSource(Opt{
+		ConsumptionObserver:        observer,
+		RequireConsumptionObserver: true,
+	}); err != nil {
+		t.Fatalf("configured worker observer was refused: %v", err)
+	}
+}
+
+func TestCommittedSnapshotObservationMustMatchTransferredTree(t *testing.T) {
+	transferred := filesync.LocalContextObservation{
+		Name:             "source",
+		TreeDigestSchema: filesync.LocalContextTreeDigestSchema,
+		TreeDigest:       "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		RegularFileBytes: 4,
+		EntryCount:       2,
+	}
+	if err := verifyCommittedLocalContext(transferred, transferred); err != nil {
+		t.Fatal(err)
+	}
+	mutated := transferred
+	mutated.TreeDigest = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+	if err := verifyCommittedLocalContext(transferred, mutated); err == nil {
+		t.Fatal("a changed immutable snapshot digest was accepted")
+	}
+	mutated = transferred
+	mutated.TreeDigestSchema = "another-tree-schema-v1"
+	if err := verifyCommittedLocalContext(transferred, mutated); err == nil {
+		t.Fatal("a changed immutable snapshot digest schema was accepted")
+	}
+	mutated = transferred
+	mutated.RegularFileBytes++
+	if err := verifyCommittedLocalContext(transferred, mutated); err == nil {
+		t.Fatal("a changed immutable snapshot byte count was accepted")
+	}
+	mutated = transferred
+	mutated.EntryCount++
+	if err := verifyCommittedLocalContext(transferred, mutated); err == nil {
+		t.Fatal("a changed immutable snapshot entry count was accepted")
+	}
+}
