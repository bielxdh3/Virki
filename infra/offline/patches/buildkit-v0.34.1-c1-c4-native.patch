+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	_ = os.Chmod(dir, 0700)
+	ledgerDir := filepath.Join(dir, "ledger")
+	_ = os.Mkdir(ledgerDir, 0700)
+	appPubPath := filepath.Join(dir, "approval.pub")
+	_ = os.WriteFile(appPubPath, ownerPub, 0400)
+	_ = os.Chmod(appPubPath, 0400)
+
+	exporterIntent, err := NewExporterIntent("image", 0, map[string]string{"name": "127.0.0.1:5000/virki/test:dev"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	imageDesc := ImageDescriptor{
+		MediaType: "application/vnd.oci.image.manifest.v1+json",
+		Digest:    "sha256:" + strings.Repeat("2", 64),
+		Size:      2048,
+	}
+	var streams [4][]byte
+	var treeDigests [4]string
+	for i, ctxName := range requiredContexts {
+		streams[i] = []byte("stream-" + ctxName + "-abort")
+		sum := sha256.Sum256([]byte("tree-" + ctxName))
+		treeDigests[i] = "sha256:" + hex.EncodeToString(sum[:])
+	}
+	nonceRaw := make([]byte, 16)
+	_, _ = rand.Read(nonceRaw)
+	nonceHex := hex.EncodeToString(nonceRaw)
+	rawEnv, pinHex := buildSignedV3Approval(t, ownerPub, ownerPriv, nonceHex, streams, treeDigests, exporterIntent, imageDesc)
+
+	sockPath := filepath.Join(dir, "owner.sock")
+	cmd := exec.Command(bin,
+		"--socket", sockPath,
+		"--ledger-dir", ledgerDir,
+		"--dev-allow-same-uid",
+		"--approval-public-key-file", appPubPath,
+		"--approval-key-id", "owner-test-key",
+		"--approval-pin-sha256", pinHex,
+	)
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if cmd.Process != nil {
+			_ = cmd.Process.Signal(syscall.SIGTERM)
+			_ = cmd.Wait()
+		}
+	})
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(sockPath); err == nil {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	svc := &VROAV3Service{
+		socketChecker:   &UnixSocketService{path: sockPath, ownerUID: uint32(os.Getuid()), allowGroupSocketWrite: true},
+		socketPath:      sockPath,
+		devAllowSameUID: true,
+		scopes:          make(map[string]vroaV3ScopeState),
+		opt: VROAV3Options{
+			Epoch:             1,
+			ApprovalPublicKey: ownerPub,
+			ApprovalKeyID:     "owner-test-key",
+			ApprovalPinSHA256: pinHex,
+			ExporterPolicy:    exporterIntent,
+			ExpectedImage:     imageDesc,
+		},
+	}
+	auth, err := svc.Begin(context.Background(), Binding{
+		JobID:            "job-buildkit-v3",
+		Role:             "runtime",
+		Nonce:            nonceHex,
+		ApprovalID:       "apr-buildkit-v3",
+		ApprovalEnvelope: base64.StdEncoding.EncodeToString(rawEnv),
+		Exporter:         exporterIntent,
+	})
+	if err != nil {
+		t.Fatalf("Begin: %v", err)
+	}
+
+	// Simulate transient transport failure on first Abort; scope MUST be retained.
+	svc.socketPath = filepath.Join(dir, "missing.sock")
+	if err := svc.Abort(context.Background(), auth.Token, "transient"); err == nil {
+		t.Fatal("expected transient error on missing socket")
+	}
+	svc.mu.Lock()
+	savedScope, retained := svc.scopes[auth.Token]
+	svc.mu.Unlock()
+	if !retained {
+		t.Fatal("Abort discarded scope state on transient transport failure")
+	}
+
+	// Retry against live daemon succeeds.
+	svc.socketPath = sockPath
+	if err := svc.Abort(context.Background(), auth.Token, "retry"); err != nil {
+		t.Fatalf("Abort retry failed: %v", err)
+	}
+	svc.mu.Lock()
+	_, stillPresent := svc.scopes[auth.Token]
+	svc.mu.Unlock()
+	if stillPresent {
+		t.Fatal("Abort did not clear scope after acknowledged abort")
+	}
+
+	// Simulate lost ACK on an already-aborted scope (C4 returns ERR_SCOPE_ABORTED=21).
+	svc.mu.Lock()
+	svc.scopes[auth.Token] = savedScope
+	svc.mu.Unlock()
+	if err := svc.Abort(context.Background(), auth.Token, "lost-ack-retry"); err != nil {
+		t.Fatalf("Abort reconciliation on ERR_SCOPE_ABORTED failed: %v", err)
+	}
+}
+
+func TestVROAV3CrossUIDSocketModePolicy(t *testing.T) {
+	dir := t.TempDir()
+	sock := filepath.Join(dir, "cross.sock")
+	ln, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+
+	if err := os.Chmod(sock, 0660); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stat := info.Sys().(*syscall.Stat_t)
+	if !callerInGroup(stat.Gid) {
+		t.Fatalf("expected caller to be in socket gid %d", stat.Gid)
+	}
+	// v1 (allowGroupSocketWrite=false) must reject 0660; V3 (allowGroupSocketWrite=true) only fails on same-UID in dev.
+	v1Svc := &UnixSocketService{path: sock, ownerUID: stat.Uid, allowGroupSocketWrite: false}
+	if err := v1Svc.verifySocketPath(); err == nil || !strings.Contains(err.Error(), "same-UID") && !strings.Contains(err.Error(), "group-write") && !strings.Contains(err.Error(), "not trusted") {
+		t.Fatalf("unexpected v1 verifySocketPath result: %v", err)
+	}
+	// World-writable 0662 must always be rejected by verifySocketPath even when allowGroupSocketWrite=true.
+	if err := os.Chmod(sock, 0662); err != nil {
+		t.Fatal(err)
+	}
+	v3Svc := &UnixSocketService{path: sock, ownerUID: 0, allowGroupSocketWrite: true}
+	if err := v3Svc.verifySocketPath(); err == nil {
+		t.Fatal("verifySocketPath must reject world-writable 0662 socket")
+	}
+}
