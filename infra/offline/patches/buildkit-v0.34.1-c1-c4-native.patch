+package main
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/moby/buildkit/cmd/buildkitd/config"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/moby/buildkit/worker"
+	"github.com/moby/buildkit/worker/base"
+	"github.com/urfave/cli/v3"
+)
+
+type testLocalContextService struct{}
+
+func (testLocalContextService) Begin(context.Context, localcontext.Binding) (localcontext.Authorization, error) {
+	return localcontext.Authorization{}, nil
+}
+
+func (testLocalContextService) Complete(context.Context, localcontext.Completion) error { return nil }
+
+func (testLocalContextService) Abort(context.Context, string, string) error { return nil }
+
+func TestConfigureWorkerContextObserverRequiresAndInjectsObserver(t *testing.T) {
+	manager, err := localcontext.NewManager(testLocalContextService{}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var opt base.WorkerOpt
+	if err := configureWorkerContextObserver(&opt, nil, true); err == nil {
+		t.Fatal("required worker construction accepted a missing observer")
+	}
+	if err := configureWorkerContextObserver(&opt, manager, true); err != nil {
+		t.Fatal(err)
+	}
+	if opt.LocalContextObserver != manager || !opt.RequireLocalContextObserver {
+		t.Fatal("worker options did not retain the configured owner observer")
+	}
+}
+
+func TestOCIAndContainerdInitializersFailBeforeBackendSetupWithoutObserver(t *testing.T) {
+	enabled := true
+	initializers := []struct {
+		name string
+		fn   func(*cli.Command, workerInitializerOpt) ([]worker.Worker, error)
+		set  func(*config.Config)
+	}{
+		{
+			name: "oci",
+			fn:   ociWorkerInitializer,
+			set: func(cfg *config.Config) {
+				cfg.Workers.OCI.Enabled = &enabled
+			},
+		},
+		{
+			name: "containerd",
+			fn:   containerdWorkerInitializer,
+			set: func(cfg *config.Config) {
+				cfg.Workers.Containerd.Enabled = &enabled
+			},
+		},
+	}
+
+	for _, initializer := range initializers {
+		t.Run(initializer.name, func(t *testing.T) {
+			cfg := &config.Config{Root: t.TempDir()}
+			initializer.set(cfg)
+			cfg.Workers.Containerd.Address = filepath.Join(cfg.Root, "unavailable-containerd.sock")
+
+			_, err := initializer.fn(&cli.Command{Flags: appFlags}, workerInitializerOpt{
+				config:                      cfg,
+				requireLocalContextObserver: true,
+			})
+			if err == nil || !strings.Contains(err.Error(), "required local-context observer is missing") {
+				t.Fatalf("initializer error = %v, want required-observer failure before backend setup", err)
+			}
+		})
+	}
+}
