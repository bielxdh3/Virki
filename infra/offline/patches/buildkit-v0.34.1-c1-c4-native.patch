index 0000000..60cd226
--- /dev/null
+++ b/util/localcontext/filtered_transfer_gate_v14.go
@@ -0,0 +1,35 @@
+package localcontext
+
+import (
+	"context"
+	"errors"
+	"time"
+)
+
+// RequirePhysicalMainTransferV14 is a fail-closed pre-FileSync boundary for
+// ALL canonical local contexts in V13 owner-filtered C1 generations, including
+// dockerfile, auxiliary .dockerignore and offline inputs. The client FileSync
+// provider uses a live mutable filesystem: FollowLinks can expand symlinks,
+// while Walk and later Open can see different files. Therefore no client
+// preflight, gRPC header, fake Service OK, or LLB attribute constitutes an
+// independently authenticated immutable snapshot or safe-open capability.
+// V14 DENIES EVERY local FileSync inside the owner V13 generation, because
+// earlier Dockerfile and root-ignore probes can themselves follow symlinks.
+func RequirePhysicalMainTransferV14(ctx context.Context, canonicalRole string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V14 physical FileSync lacks owner solve scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || !time.Now().Before(scope.auth.ExpiresAt) {
+		return errors.New("C1 V14 physical FileSync belongs to expired or terminated owner generation")
+	}
+	if len(scope.auth.MainFollowPathsV13) != 0 {
+		return errors.New("C1 V14 PHYSICAL FILESYNC DENIED: owner-pinned V13 generation lacks an independently authenticated immutable client snapshot and nofollow content open for all local roles (including " + canonicalRole + ")")
+	}
+	return nil
+}
