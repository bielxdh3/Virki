+
+func TestC1DockerfileTransformV4RequiresExactObservedIdentityAndSelectedRoot(t *testing.T) {
+	good, context, roots, platformRoots, captured := v4Fixture(t)
+	if err := ValidateDockerfileTransformV4(good, context, roots, platformRoots, captured); err != nil {
+		t.Fatalf("expected exact trusted fixture to validate: %v", err)
+	}
+	for name, mutate := range map[string]func(*DockerfileTransformV4){
+		"untrusted frontend":      func(p *DockerfileTransformV4) { p.FrontendID = "gateway.v0" },
+		"old generation":          func(p *DockerfileTransformV4) { p.Read.Generation = "nonce-old" },
+		"other worker":            func(p *DockerfileTransformV4) { p.Read.WorkerID = "worker-2" },
+		"other session":           func(p *DockerfileTransformV4) { p.Read.SessionID = "session-2" },
