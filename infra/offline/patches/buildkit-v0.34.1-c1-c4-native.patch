diff --git a/util/localcontext/loaded_worker_source_v8.go b/util/localcontext/loaded_worker_source_v8.go
new file mode 100644
index 0000000..f0383be
--- /dev/null
+++ b/util/localcontext/loaded_worker_source_v8.go
@@ -0,0 +1,97 @@
+package localcontext
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// VerifyLoadedWorkerSourceV8 compares a concrete loaded local SourceOp against
+// the worker's immutable FileSync consumption stored in the SAME private
+// owner-reserved SolveScope. The owner MUST independently provide all four
+// ContextSessionIDsV8 in its Begin authorization; matching only request attrs
+// cannot satisfy this diagnostic. There is NO generic auxiliary-ignore alias:
+// that independent snapshot is NOT the canonical COPY source record.
+//
+// IMPORTANT: this is diagnostic only. It does not authenticate a generic Go
+// implementation of BuiltinLoadedRefV6, a remote owner key, physical FileSync
+// custody, actual OCI output or post-approval publication. It is intentionally
+// unused by protected C1 frontend admission while that mode remains denied.
+func (s *SolveScope) VerifyLoadedWorkerSourceV8(role string, loaded BuiltinLoadedRefV6) error {
+	if s == nil || s.manager == nil {
+		return errors.New("C1 V8 loaded worker source has no owner solve scope")
+	}
+	var name, sourceRole string
+	switch role {
+	case "dockerfile":
+		name, sourceRole = "dockerfile", "dockerfile"
+	case "main-context":
+		name, sourceRole = "source", "context"
+	default:
+		return errors.New("C1 V8 refuses auxiliary or unknown source as canonical worker consumption")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.completionAttempted || s.abortRequested || time.Now().After(s.auth.ExpiresAt) {
+		return errors.New("C1 V8 owner source scope is no longer active")
+	}
+	if len(s.auth.ContextSessionIDsV8) != len(requiredContexts) {
+		return errors.New("C1 V8 owner authorization lacks independently approved source sessions")
+	}
+	record, ok := s.records[name]
+	if !ok {
+		return fmt.Errorf("C1 V8 worker has not recorded the canonical %q source", name)
+	}
+	ownerSession := s.auth.ContextSessionIDsV8[name]
+	if err := CheckBuiltinLocalSessionV7(loaded, sourceRole, ownerSession); err != nil {
+		return err
+	}
+	if !validIdentifier(s.auth.WorkerID) || !validIdentifier(s.auth.ContextIdentities[name]) ||
+		!sha256Pattern.MatchString(s.auth.ContextTreeDigests[name]) ||
+		s.auth.ContextTreeDigestSchema != BuildKitContextTreeDigestSchema ||
+		s.auth.Generation != s.binding.Nonce ||
+		record.Name != name || record.Generation != s.auth.Generation ||
+		record.ContextIdentity != s.auth.ContextIdentities[name] ||
+		record.TreeDigestSchema != s.auth.ContextTreeDigestSchema ||
+		record.TreeDigest != s.auth.ContextTreeDigests[name] ||
+		record.SessionID != ownerSession ||
+		record.WorkerID != s.auth.WorkerID || loaded.WorkerID != record.WorkerID ||
+		loaded.RefID != record.SnapshotID || loaded.RootVertex != record.VertexDigest ||
+		loaded.OutputIndex != record.VertexOutputIndex || record.VertexOutputIndex != 0 ||
+		record.EntryCount < 1 || record.RegularFileBytes < 0 {
+		return errors.New("C1 V8 loaded local source differs from the owner-pinned worker FileSync snapshot")
+	}
+	if role == "dockerfile" {
+		if err := CheckBuiltinLocalReadShapeV7(loaded, "dockerfile"); err != nil {
+			return err
+		}
+	} else if loaded.SourceSharedKeyHint != "context" ||
+		loaded.SourceDiffer != "" ||
+		loaded.SourceIncludePatterns != "" || loaded.SourceMetadataTransfer != "" ||
+		loaded.SourceMetadataTransferExclude != "" ||
+		strings.Contains(loaded.SourceSessionID, ":") {
+		return errors.New("C1 V8 main COPY context was substituted with a filtered auxiliary or custom source")
+	}
+	if role == "main-context" {
+		if len(s.auth.MainFollowPathsV13) == 0 {
+			if loaded.SourceFollowPaths != "" {
+				return errors.New("C1 V8 main source carries unexpected loaded FollowPaths")
+			}
+		} else {
+			rawPaths, _ := json.Marshal(s.auth.MainFollowPathsV13)
+			rawExcludes := ""
+			if len(s.rootIgnoreExcludesV11) != 0 {
+				b, _ := json.Marshal(s.rootIgnoreExcludesV11)
+				rawExcludes = string(b)
+			}
+			if !s.mainFollowPathsMatchedV13 || s.mainFollowPathsVertexV13 != record.VertexDigest ||
+				loaded.SourceFollowPaths != string(rawPaths) || loaded.SourceExcludePatterns != rawExcludes {
+				return errors.New("C1 V13 loaded main SourceOp FollowPaths/excludes differ from owner-approved committed source")
+			}
+			s.mainLoadedRefVerifiedV13 = true
+		}
+	}
+	return nil
+}
diff --git a/util/localcontext/loaded_worker_source_v8_test.go b/util/localcontext/loaded_worker_source_v8_test.go
new file mode 100644
index 0000000..092f040
--- /dev/null
+++ b/util/localcontext/loaded_worker_source_v8_test.go
@@ -0,0 +1,170 @@
+package localcontext
+
+import (
+	"context"
+	"maps"
+	"strings"
+	"testing"
+)
+
+type v8OwnerSessionFixture struct {
+	fakeService
+	sessions map[string]string
+}
+
+func (f *v8OwnerSessionFixture) Begin(ctx context.Context, binding Binding) (Authorization, error) {
+	auth, err := f.fakeService.Begin(ctx, binding)
+	if err == nil {
+		auth.ContextSessionIDsV8 = f.sessions
+	}
+	return auth, err
+}
+
+func v8SessionPins() map[string]string {
+	pins := map[string]string{}
+	for _, name := range RequiredContextNames() {
+		pins[name] = "session-c1-01"
+	}
+	return pins
+}
+
+func v8LoadedFromRecord(record Consumption, role string) BuiltinLoadedRefV6 {
+	loaded := BuiltinLoadedRefV6{
+		WorkerID: record.WorkerID, RefID: record.SnapshotID,
+		RootVertex: record.VertexDigest, OutputIndex: record.VertexOutputIndex,
+		SourceIdentifier: "local://" + role, SourceSessionID: record.SessionID,
+	}
+	if role == "dockerfile" {
+		loaded.SourceFollowPaths = `["Dockerfile","Dockerfile.dockerignore","dockerfile"]`
+		loaded.SourceSharedKeyHint = "dockerfile"
+		loaded.SourceDiffer = "none"
+	} else {
+		loaded.SourceSharedKeyHint = "context"
+	}
+	return loaded
+}
+
+func TestC1V8WorkerSourceMustMatchOwnerApprovedPhysicalSessionAndRoot(t *testing.T) {
+	service := &v8OwnerSessionFixture{sessions: v8SessionPins()}
+	manager, err := NewManager(service, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := manager.BeginSolve(t.Context(), testBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if scope == nil {
+		t.Fatal("owner scope was not allocated")
+	}
+
+	for _, name := range []string{"dockerfile", "source"} {
+		if err := manager.ContextConsumed(ctx, testConsumption(name)); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+	}
+	dockerfile := v8LoadedFromRecord(testConsumption("dockerfile"), "dockerfile")
+	main := v8LoadedFromRecord(testConsumption("source"), "context")
+	for _, item := range []struct {
+		role string
+		ref  BuiltinLoadedRefV6
+	}{{"dockerfile", dockerfile}, {"main-context", main}} {
+		if err := scope.VerifyLoadedWorkerSourceV8(item.role, item.ref); err != nil {
+			t.Fatalf("valid diagnostic %s rejected: %v", item.role, err)
+		}
+	}
+	// Mutating a service-owned map AFTER BeginSolve must not alter the
+	// reserved per-solve approval (aliasing/TOCTOU regression).
+	service.sessions["source"] = "session-attacker"
+	if err := scope.VerifyLoadedWorkerSourceV8("main-context", main); err != nil {
+		t.Fatalf("later owner fixture map mutation changed reserved scope: %v", err)
+	}
+
+	badCases := []struct {
+		name, role string
+		mutate     func(*BuiltinLoadedRefV6)
+	}{
+		{"changed physical session", "dockerfile", func(v *BuiltinLoadedRefV6) { v.SourceSessionID = "session-attacker" }},
+		{"changed immutable snapshot", "dockerfile", func(v *BuiltinLoadedRefV6) { v.RefID = "snapshot-replaced" }},
+		{"changed worker", "dockerfile", func(v *BuiltinLoadedRefV6) { v.WorkerID = "worker-replaced" }},
+		{"changed loaded root", "dockerfile", func(v *BuiltinLoadedRefV6) { v.RootVertex = "sha256:" + strings.Repeat("c", 64) }},
+		{"changed output index", "dockerfile", func(v *BuiltinLoadedRefV6) { v.OutputIndex = 1 }},
+		{"wrong named local source", "dockerfile", func(v *BuiltinLoadedRefV6) { v.SourceIdentifier = "local://context" }},
+		{"changed Dockerfile read filters", "dockerfile", func(v *BuiltinLoadedRefV6) { v.SourceFollowPaths = `["Dockerfile"]` }},
+		{"auxiliary ignore as main COPY context", "main-context", func(v *BuiltinLoadedRefV6) {
+			v.SourceFollowPaths = `[".dockerignore"]`
+			v.SourceSharedKeyHint = "context-.dockerignore"
+		}},
+		{"missing main source session", "main-context", func(v *BuiltinLoadedRefV6) { v.SourceSessionID = "" }},
+		{"reassigned main immutable ref", "main-context", func(v *BuiltinLoadedRefV6) { v.RefID = "probe-only-ref" }},
+		{"metadata-only main context", "main-context", func(v *BuiltinLoadedRefV6) { v.SourceMetadataTransfer = "true" }},
+		{"changed main context differ", "main-context", func(v *BuiltinLoadedRefV6) { v.SourceDiffer = "none" }},
+	}
+	for _, tc := range badCases {
+		t.Run(tc.name, func(t *testing.T) {
+			candidate := dockerfile
+			if tc.role == "main-context" {
+				candidate = main
+			}
+			tc.mutate(&candidate)
+			if err := scope.VerifyLoadedWorkerSourceV8(tc.role, candidate); err == nil {
+				t.Fatal("substituted worker source admitted")
+			}
+		})
+	}
+	for _, forbidden := range []string{"auxiliary-ignore", "source", "context", ""} {
+		if err := scope.VerifyLoadedWorkerSourceV8(forbidden, main); err == nil {
+			t.Fatalf("role %q bypassed explicit main/aux classification", forbidden)
+		}
+	}
+
+	// A record for another generation or for an owner-unapproved actual
+	// FileSync session is refused by ContextConsumed BEFORE any V8 comparison.
+	stale := testConsumption("offline-npm-cacache")
+	stale.Generation = strings.Repeat("f", 32)
+	if err := manager.ContextConsumed(ctx, stale); err == nil {
+		t.Fatal("stale generation admitted")
+	}
+	foreign := testConsumption("offline-npm-cacache")
+	foreign.SessionID = "session-not-approved"
+	if err := manager.ContextConsumed(ctx, foreign); err == nil {
+		t.Fatal("foreign actual FileSync session admitted")
+	}
+}
+
+func TestC1V8RefusesAbsentOrPartialOwnerSessionAuthorization(t *testing.T) {
+	for _, bad := range []struct {
+		name            string
+		sessions        map[string]string
+		beginShouldFail bool
+	}{
+		{"missing legacy owner pins", nil, false},
+		{"partial owner pins", map[string]string{"dockerfile": "session-c1-01"}, true},
+		{"unknown owner name", map[string]string{"source": "session-c1-01", "dockerfile": "session-c1-01", "offline-npm-cacache": "session-c1-01", "intruder": "session-c1-01"}, true},
+		{"prefixed owner session", func() map[string]string { m := v8SessionPins(); m["source"] = "prefix:session-c1-01"; return m }(), true},
+	} {
+		t.Run(bad.name, func(t *testing.T) {
+			service := &v8OwnerSessionFixture{sessions: maps.Clone(bad.sessions)}
+			manager, err := NewManager(service, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, scope, err := manager.BeginSolve(t.Context(), testBinding())
+			if bad.beginShouldFail {
+				if err == nil {
+					t.Fatal("invalid owner session map accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := manager.ContextConsumed(ctx, testConsumption("dockerfile")); err != nil {
+				t.Fatal(err)
+			}
+			if err := scope.VerifyLoadedWorkerSourceV8("dockerfile", v8LoadedFromRecord(testConsumption("dockerfile"), "dockerfile")); err == nil {
+				t.Fatal("V8 diagnostic accepted absent owner session approval")
+			}
+		})
+	}
+}
diff --git a/util/localcontext/main_follow_paths_v13.go b/util/localcontext/main_follow_paths_v13.go
new file mode 100644
index 0000000..4bd39e7
--- /dev/null
+++ b/util/localcontext/main_follow_paths_v13.go
@@ -0,0 +1,244 @@
+package localcontext
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path"
+	"slices"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// MainFollowPathsProofV13 is only a same-process witness of the frozen
+// owner-selected filter and accepted worker snapshot. It is NOT a signed
+// owner receipt or proof the selected Dockerfile initiated this SourceOp.
+type MainFollowPathsProofV13 struct {
+	PathsSHA256      string `json:"pathsSha256"`
+	MainVertexDigest string `json:"mainVertexDigest"`
+}
+
+// ValidateMainFollowPathsV13 deliberately allows only simple, canonical,
+// sorted, unique, non-root POSIX relative literal paths. The genuine
+// Dockerfile2LLB normalizeContextPaths sorts its outputs. Wildcard/parent/
+// absolute patterns need a different authority contract and remain denied.
+func ValidateMainFollowPathsV13(paths []string) error {
+	if len(paths) == 0 || len(paths) > 128 {
+		return errors.New("C1 V13 owner FollowPaths requires 1..128 explicit literal paths")
+	}
+	sum := 0
+	for i, p := range paths {
+		sum += len(p)
+		if p == "" || p == "." || p == ".." || path.IsAbs(p) ||
+			path.Clean(p) != p || strings.HasPrefix(p, "../") ||
+			strings.ContainsAny(p, "\\*?[]:") || strings.IndexFunc(p, unicode.IsControl) >= 0 ||
+			(i != 0 && paths[i-1] >= p) {
+			return errors.New("C1 V13 owner FollowPaths contains a noncanonical, duplicate, reordered or unsafe path")
+		}
+		for _, previous := range paths[:i] {
+			if strings.HasPrefix(p, previous+"/") {
+				return errors.New("C1 V13 owner FollowPaths contains overlapping parent and child paths")
+			}
+		}
+	}
+	if sum > 8192 {
+		return errors.New("C1 V13 owner FollowPaths exceeds bounded byte budget")
+	}
+	return nil
+}
+
+func HashMainFollowPathsV13(paths []string) string {
+	b, _ := json.Marshal(paths)
+	h := sha256.Sum256(append([]byte("virki-c1-main-followpaths-v13\x00"), b...))
+	return fmt.Sprintf("sha256:%x", h)
+}
+
+// MainFollowPathsOwnerOptInV13 is a private-scope introspection helper for
+// Dockerfile2LLB source classification, not proof of frontend authenticity.
+func MainFollowPathsOwnerOptInV13(ctx context.Context) bool {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return false
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return false
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	return len(scope.auth.MainFollowPathsV13) > 0
+}
+
+// BindDerivedMainFollowPathsV13 must be called from the builtin
+// Dockerfile2LLB after dispatching reachable COPY/ADD paths and applying
+// normalizeContextPaths, immediately before building the final MainContext.
+// This does not independently attest the calling frontend, so it remains
+// nonauthorizing. Repeating the same derivation is permitted; a different
+// platform/target path set in one owner generation is refused.
+func BindDerivedMainFollowPathsV13(ctx context.Context, derived []string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 derived context paths lack owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	approved := scope.auth.MainFollowPathsV13
+	if len(approved) == 0 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested ||
+		time.Now().After(scope.auth.ExpiresAt) || !scope.rootIgnoreExcludesBoundV11 ||
+		!slices.Equal(approved, derived) {
+		return errors.New("C1 V13 Dockerfile2LLB derived context paths differ from owner-approved filter or ignore provenance")
+	}
+	scope.mainFollowPathsDerivedV13 = true
+	return nil
+}
+
+// VerifyOriginalCopyPathV13 is invoked for every local ADD/COPY SourcePaths
+// token AFTER Dockerfile shell-argument expansion but BEFORE path.Join cleans
+// traversal or absolute paths. It deliberately refuses glob and nonliteral
+// paths in the experimental filtered mode, while normal builds are unchanged.
+func VerifyOriginalCopyPathV13(ctx context.Context, original string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 raw local COPY path lacks private scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if len(scope.auth.MainFollowPathsV13) == 0 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V13 raw COPY path belongs to terminating solve")
+	}
+	if err := ValidateMainFollowPathsV13([]string{original}); err != nil {
+		return fmt.Errorf("C1 V13 original Dockerfile COPY/ADD path is unsafe before normalization: %w", err)
+	}
+	return nil
+}
+
+// RequireBuiltinMainContextOriginV13 refuses an upstream-provided/custom
+// main state which can bypass the freshly generated filtered llb.Local.
+func RequireBuiltinMainContextOriginV13(ctx context.Context, hasBuiltinClient, hasPrebuiltMain bool) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 main origin lacks owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if len(scope.auth.MainFollowPathsV13) != 0 && (!hasBuiltinClient || hasPrebuiltMain) {
+		return errors.New("C1 V13 filtered main needs a builtin dockerui Client and no prebuilt custom main state")
+	}
+	return nil
+}
+
+// MainContext must not return a preexisting context state in V13: that
+// bypasses all derived filterPaths LocalOptions.
+func RefuseCustomMainContextV13(ctx context.Context) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 custom context lacks owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if len(scope.auth.MainFollowPathsV13) != 0 {
+		return errors.New("C1 V13 custom frontend main context bypasses new filtered local SourceOp")
+	}
+	return nil
+}
+
+// An independent context main-origin resolve (e.g. SOURCE_DATE_EPOCH=context)
+// has no filtered FollowPaths provenance. Until it gets a separately approved
+// noncanonical role, refuse it before creating a second SourceOp in V13.
+func RefuseIndependentUnfilteredMainV13(ctx context.Context) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 unfiltered main origin lacks owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if len(scope.auth.MainFollowPathsV13) > 0 {
+		return errors.New("C1 V13 SOURCE_DATE_EPOCH=context unfiltered origin requires separate owner approval")
+	}
+	return nil
+}
+
+// RequireMainFollowPathsV13 is invoked by worker CacheKey, outer Snapshot,
+// and direct inner snapshot BEFORE a mutable cache or FileSync can be touched.
+// An unapproved FollowPaths attribute (including [] or null) always denies.
+func RequireMainFollowPathsV13(ctx context.Context, paths []string, raw string, rawPresent bool) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 main FollowPaths lacks private owner scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V13 main FollowPaths scope expired or terminating")
+	}
+	approved := scope.auth.MainFollowPathsV13
+	if len(approved) == 0 {
+		if len(paths) != 0 || rawPresent {
+			return errors.New("C1 V13 unapproved main FollowPaths filter or explicit empty attribute")
+		}
+		return nil
+	}
+	if !scope.rootIgnoreExcludesBoundV11 || !scope.mainFollowPathsDerivedV13 ||
+		!slices.Equal(approved, paths) || !rawPresent {
+		return errors.New("C1 V13 main FollowPaths differs from frozen owner path approval or parsed ignore lineage")
+	}
+	canonical, err := json.Marshal(approved)
+	if err != nil || raw != string(canonical) {
+		return errors.New("C1 V13 main FollowPaths SourceOp attr is not canonical owner-approved JSON")
+	}
+	return nil
+}
+
+// RecordMainFollowPathsV13 runs after the actual FileSync, committed immutable
+// tree remeasurement, and accepted four-context worker observation. V11's
+// excludes record must already have matched the SAME worker main vertex.
+func RecordMainFollowPathsV13(ctx context.Context, paths []string, vertex string) error {
+	if !OwnerScopedSolveActiveV7(ctx) {
+		return nil
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		return errors.New("C1 V13 committed FollowPaths lacks private scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	approved := scope.auth.MainFollowPathsV13
+	if len(approved) == 0 {
+		return nil
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) ||
+		scope.mainFollowPathsMatchedV13 || !scope.rootIgnoreMainMatchedV11 ||
+		!sha256Pattern.MatchString(vertex) || vertex != scope.rootIgnoreMainVertexV11 ||
+		!slices.Equal(approved, paths) || scope.records["source"].VertexDigest != vertex {
+		return errors.New("C1 V13 committed main FollowPaths lack one-use owner-approved worker causality")
+	}
+	scope.mainFollowPathsMatchedV13 = true
+	scope.mainFollowPathsVertexV13 = vertex
+	return nil
+}
diff --git a/util/localcontext/main_follow_paths_v13_test.go b/util/localcontext/main_follow_paths_v13_test.go
