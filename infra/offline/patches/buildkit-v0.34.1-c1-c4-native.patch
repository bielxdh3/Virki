+// Authorization is returned by the owner service after verifying the signed
+// approval and reserving its nonce. Context identities are service-owned.
+type Authorization struct {
+	Token                   string            `json:"token"`
+	Generation              string            `json:"generation"`
+	WorkerID                string            `json:"workerId"`
+	ContextIdentities       map[string]string `json:"contextIdentities"`
+	ContextTreeDigestSchema string            `json:"contextTreeDigestSchema"`
+	ContextTreeDigests      map[string]string `json:"contextTreeDigests"`
+	// ContextSessionIDsV8 is optional for legacy C1 v3 evidence but mandatory
+	// for V8 source-to-loaded-root diagnostics. It must be supplied by an
+	// independently controlled owner, NOT echoed from client frontend attrs.
+	// An absent map never proves an approved physical FileSync session.
+	ContextSessionIDsV8 map[string]string `json:"contextSessionIdsV8,omitempty"`
+	// RootDockerignoreV10 is a distinct, optional owner-policy approval for
+	// the filtered auxiliary root .dockerignore worker snapshot. It is NOT a
+	// fifth canonical C1 context nor the final main COPY context. No native C4
+	// signer issues this authorization today: V10 is nonauthorizing DEV only.
+	RootDockerignoreV10 *RootDockerignoreApprovalV10 `json:"rootDockerignoreV10,omitempty"`
+	// Experimental V11 opt-in: owner explicitly requests one-use effective
+	// root ignore parsing -> main COPY SourceOp exclusion lineage. Native C4
+	// cannot currently authorize it; never treat this as release evidence.
+	BindRootIgnoreExcludesV11 bool `json:"bindRootIgnoreExcludesV11,omitempty"`
+	// V12 DEV-only alternative to the root probe. The preferred ignore is
+	// already carried in the canonical Dockerfile worker snapshot.
+	PreferredDockerignoreV12 *PreferredDockerignoreApprovalV12 `json:"preferredDockerignoreV12,omitempty"`
+	// V12 strict root branch opt-in: prior owner-approved root FileSync requires
+	// a verified ENOENT from the same canonical Dockerfile worker snapshot.
+	RequirePreferredMissingV12 bool `json:"requirePreferredMissingV12,omitempty"`
+	// V13 explicitly owner-pins one nonempty canonical sorted path filter for
+	// the main local://context worker; ordinary V9/V12 full-root remains strict.
+	// This DEV-only field cannot authenticate the frontend that selected paths.
+	MainFollowPathsV13 []string        `json:"mainFollowPathsV13,omitempty"`
+	ExporterPolicy     ExporterIntent  `json:"exporterPolicy"`
