diff --git a/session/filesync/sealed_custody_v24_independent_linux_test.go b/session/filesync/sealed_custody_v24_independent_linux_test.go
new file mode 100644
index 0000000..876e649
--- /dev/null
+++ b/session/filesync/sealed_custody_v24_independent_linux_test.go
@@ -0,0 +1,436 @@
+//go:build linux
+
+package filesync
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"os/user"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/moby/buildkit/session"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// This is an opt-in, ordinary positive DEV integration fixture. It uses
+// synthetic content and temporary numeric identities, not host accounts,
+// persistent configuration or protected FileSync.
+const (
+	v24FixtureReceiverUID uint32 = 60001
+	v24FixtureSenderUID   uint32 = 60002
+)
+
+type v24IndependentFixture struct {
+	Manifest V15SealedManifest
+	Permit   V15OwnerPermit
+	Public   ed25519.PublicKey
+}
+
+func v24FixturePolicy(uid, peer uint32, privateTempDir string) V24ReceiverCustodyPolicy {
+	return V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &uid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		ExpectedSenderUID:           &peer,
+		ExpectedSenderGID:           &peer,
+		PrivateTempDir:              privateTempDir,
+	}
+}
+
+func TestC1V24IndependentReceiverProcess(t *testing.T) {
+	switch os.Getenv("VIRKI_V24_INDEPENDENT_ROLE") {
+	case "sender":
+		v24IndependentSender(t)
+		return
+	case "receiver":
+		v24IndependentReceiver(t)
+		return
+	case "adversarial-peer":
+		v28AdversarialPeerRacer(t)
+		return
+	}
+	if os.Getenv("VIRKI_V24_RUN_ROOT_FIXTURE") != "1" || os.Geteuid() != 0 {
+		t.Skip("opt-in synthetic multi-UID fixture requires a privileged DEV supervisor")
+	}
+	for _, uid := range []uint32{v24FixtureReceiverUID, v24FixtureSenderUID} {
+		id := strconv.FormatUint(uint64(uid), 10)
+		_, err := user.LookupId(id)
+		if err == nil {
+			t.Skipf("fixture UID %s is already assigned", id)
+		}
+		require.IsType(t, user.UnknownUserIdError(0), err)
+		_, err = user.LookupGroupId(id)
+		if err == nil {
+			t.Skipf("fixture GID %s is already assigned", id)
+		}
+		require.IsType(t, user.UnknownGroupIdError(""), err)
+	}
+	root, err := os.MkdirTemp("/tmp", "virki-v24-custody-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(root)) })
+	require.NoError(t, os.Chmod(root, 0711))
+	for name, uid := range map[string]uint32{"sender": v24FixtureSenderUID, "receiver": v24FixtureReceiverUID} {
+		dir := filepath.Join(root, name)
+		require.NoError(t, os.Mkdir(dir, 0700))
+		require.NoError(t, os.Chown(dir, int(uid), int(uid)))
+		tmp := filepath.Join(dir, "tmp")
+		require.NoError(t, os.Mkdir(tmp, 0700))
+		require.NoError(t, os.Chown(tmp, int(uid), int(uid)))
+	}
+	src := filepath.Join(root, "sender", "app.js")
+	require.NoError(t, os.WriteFile(src, []byte("SAFE"), 0600))
+	require.NoError(t, os.Chown(src, int(v24FixtureSenderUID), int(v24FixtureSenderUID)))
+	m := v15PacketManifest()
+	permit, pub, _ := v15SignedPermitFixture(t, m)
+	data, err := json.Marshal(v24IndependentFixture{Manifest: m, Permit: permit, Public: pub})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(root, "fixture.json"), data, 0444))
+
+	// Both children execute the same root-owned, read-only fixture binary.
+	self, err := os.Executable()
+	require.NoError(t, err)
+	input, err := os.Open(self)
+	require.NoError(t, err)
+	defer input.Close()
+	helper := filepath.Join(root, "fixture")
+	output, err := os.OpenFile(helper, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	require.NoError(t, err)
+	_, copyErr := io.Copy(output, input)
+	closeErr := output.Close()
+	require.NoError(t, copyErr)
+	require.NoError(t, closeErr)
+	require.NoError(t, os.Chmod(helper, 0555))
+
+	// The existing session runs over a private, inherited socketpair.
+	// No listening service or external network is involved.
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	require.NoError(t, err)
+	senderFD := os.NewFile(uintptr(fds[0]), "sender-session")
+	receiverFD := os.NewFile(uintptr(fds[1]), "receiver-session")
+	defer senderFD.Close()
+	defer receiverFD.Close()
+
+	ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+	defer cancel()
+	type result struct {
+		out []byte
+		err error
+	}
+	senderDone := make(chan result, 1)
+	receiverDone := make(chan result, 1)
+	launch := func(role string, fd *os.File, uid, peer uint32, done chan<- result) {
+		out, err := runV24IsolatedSubprocessWithFiles(ctx, helper,
+			[]string{"-test.run=^TestC1V24IndependentReceiverProcess$", "-test.v"},
+			v24FixturePolicy(uid, peer, filepath.Join(root, role, "tmp")), []*os.File{fd},
+			"VIRKI_V24_INDEPENDENT_ROLE="+role, "VIRKI_V24_FIXTURE_ROOT="+root)
+		done <- result{out, err}
+	}
+	go launch("sender", senderFD, v24FixtureSenderUID, v24FixtureReceiverUID, senderDone)
+	go launch("receiver", receiverFD, v24FixtureReceiverUID, v24FixtureSenderUID, receiverDone)
+	receiver := <-receiverDone
+	// Release the supervisor's copies only after the receiver has finished.
+	// This lets the sender observe EOF and terminate its existing session.
+	require.NoError(t, receiverFD.Close())
+	if receiver.err != nil {
+		cancel()
+	}
+	sender := <-senderDone
+	require.NoError(t, receiver.err, "receiver: %s", receiver.out)
+	require.NoError(t, sender.err, "sender: %s", sender.out)
+	published := filepath.Join(root, "receiver", "published", "app.js")
+	got, err := os.ReadFile(published)
+	require.NoError(t, err)
+	require.Equal(t, []byte("SAFE"), got)
+	var st unix.Stat_t
+	require.NoError(t, unix.Stat(published, &st))
+	require.Equal(t, v24FixtureReceiverUID, st.Uid)
+	t.Log("positive sealed FileSync completed across two unprivileged process identities")
+}
+
+func v24FixtureInputs(t *testing.T, uid uint32) (string, v24IndependentFixture, net.Conn) {
+	t.Helper()
+	ruid, euid, suid := unix.Getresuid()
+	rgid, egid, sgid := unix.Getresgid()
+	for _, id := range []int{ruid, euid, suid, rgid, egid, sgid} {
+		require.Equal(t, uid, uint32(id))
+	}
+	require.NoError(t, validateV24NoCapabilities())
+	groups, err := os.Getgroups()
+	require.NoError(t, err)
+	require.Empty(t, groups)
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, 1, nnp)
+	root := os.Getenv("VIRKI_V24_FIXTURE_ROOT")
+	require.NotEmpty(t, root)
+	data, err := os.ReadFile(filepath.Join(root, "fixture.json"))
+	require.NoError(t, err)
+	var fixture v24IndependentFixture
+	require.NoError(t, json.Unmarshal(data, &fixture))
+	fd := os.NewFile(3, "fixture-session")
+	require.NotNil(t, fd)
+	conn, err := net.FileConn(fd)
+	require.NoError(t, err)
+	require.NoError(t, fd.Close())
+	t.Cleanup(func() { _ = conn.Close() })
+	return root, fixture, conn
+}
+
+// Only fixture transport glue: existing session.Dialer metadata is carried
+// once over the inherited socket before passing it to Manager.HandleConn.
+func v24IndependentSender(t *testing.T) {
+	root, f, conn := v24FixtureInputs(t, v24FixtureSenderUID)
+	ctx, cancel := context.WithTimeout(t.Context(), 35*time.Second)
+	defer cancel()
+	m := f.Manifest
+	snapshot, err := NewLinuxSealedSnapshotV15(ctx, V15SnapshotRequest{
+		Root: filepath.Join(root, "sender"), ContextName: m.ContextName,
+		WorkerID: m.WorkerID, SessionID: m.SessionID, Nonce: m.Nonce, Files: m.Files,
+	})
+	require.NoError(t, err)
+	require.Equal(t, m.Digest, snapshot.Manifest().Digest)
+	s, err := session.NewSession(ctx, "v24-independent-fixture")
+	require.NoError(t, err)
+	s.Allow(NewSealedFSSyncProviderV15(snapshot))
+	require.NoError(t, s.Run(ctx, func(_ context.Context, _ string, meta map[string][]string) (net.Conn, error) {
+		header, err := json.Marshal(meta)
+		if err != nil {
+			return nil, err
+		}
+		if err := binary.Write(conn, binary.BigEndian, uint32(len(header))); err != nil {
+			return nil, err
+		}
+		if _, err := io.Copy(conn, bytes.NewReader(header)); err != nil {
+			return nil, err
+		}
+		return conn, nil
+	}))
+}
+
+func v24IndependentReceiver(t *testing.T) {
+	root, f, conn := v24FixtureInputs(t, v24FixtureReceiverUID)
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	require.NoError(t, conn.SetReadDeadline(time.Now().Add(10*time.Second)))
+	var length uint32
+	require.NoError(t, binary.Read(conn, binary.BigEndian, &length))
+	require.Positive(t, length)
+	require.LessOrEqual(t, length, uint32(65536))
+	header := make([]byte, length)
+	_, err := io.ReadFull(conn, header)
+	require.NoError(t, err)
+	require.NoError(t, conn.SetReadDeadline(time.Time{}))
+	var meta map[string][]string
+	require.NoError(t, json.Unmarshal(header, &meta))
+	ids := meta["X-Docker-Expose-Session-Uuid"]
+	require.Len(t, ids, 1)
+	manager, err := session.NewManager()
+	require.NoError(t, err)
+	done := make(chan error, 1)
+	go func() { done <- manager.HandleConn(ctx, conn, meta) }()
+	caller, err := manager.Get(ctx, ids[0], false)
+	require.NoError(t, err)
+	m := f.Manifest
+	dest := filepath.Join(root, "receiver", "published")
+	require.NoError(t, FSSyncSealedV24(ctx, caller, FSSendRequestOpt{
+		Name: m.ContextName, FollowPaths: []string{"app.js"}, DestDir: dest,
+	}, m, f.Permit, f.Public, NewV15LocalReplayLedger(f.Permit.Epoch), v24FixturePolicy(v24FixtureReceiverUID, v24FixtureSenderUID, filepath.Join(root, "receiver", "tmp"))))
+	cancel()
+	_ = conn.Close()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("session shutdown timed out")
+	}
+}
+
+const v28FixturePeerUID uint32 = 60003
+
+func TestC1V28AdversarialMultiProcessCustodyAndSwapRace(t *testing.T) {
+	if os.Getenv("VIRKI_V24_RUN_ROOT_FIXTURE") != "1" || os.Geteuid() != 0 {
+		t.Skip("adversarial multi-UID race fixture requires a privileged DEV supervisor")
+	}
+	for _, uid := range []uint32{v24FixtureReceiverUID, v24FixtureSenderUID, v28FixturePeerUID} {
+		id := strconv.FormatUint(uint64(uid), 10)
+		if _, err := user.LookupId(id); err == nil {
+			t.Skipf("fixture UID %s is already assigned", id)
+		}
+		if _, err := user.LookupGroupId(id); err == nil {
+			t.Skipf("fixture GID %s is already assigned", id)
+		}
+	}
+	root, err := os.MkdirTemp("/tmp", "virki-v28-adv-race-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(root)) })
+	require.NoError(t, os.Chmod(root, 0711))
+	for name, uid := range map[string]uint32{"sender": v24FixtureSenderUID, "receiver": v24FixtureReceiverUID, "peer": v28FixturePeerUID} {
+		dir := filepath.Join(root, name)
+		require.NoError(t, os.Mkdir(dir, 0700))
+		require.NoError(t, os.Chown(dir, int(uid), int(uid)))
+		tmp := filepath.Join(dir, "tmp")
+		require.NoError(t, os.Mkdir(tmp, 0700))
+		require.NoError(t, os.Chown(tmp, int(uid), int(uid)))
+	}
+	src := filepath.Join(root, "sender", "app.js")
+	require.NoError(t, os.WriteFile(src, []byte("SAFE"), 0600))
+	require.NoError(t, os.Chown(src, int(v24FixtureSenderUID), int(v24FixtureSenderUID)))
+	m := v15PacketManifest()
+	permit, pub, _ := v15SignedPermitFixture(t, m)
+	data, err := json.Marshal(v24IndependentFixture{Manifest: m, Permit: permit, Public: pub})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(root, "fixture.json"), data, 0444))
+
+	self, err := os.Executable()
+	require.NoError(t, err)
+	input, err := os.Open(self)
+	require.NoError(t, err)
+	defer input.Close()
+	helper := filepath.Join(root, "fixture")
+	output, err := os.OpenFile(helper, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	require.NoError(t, err)
+	_, copyErr := io.Copy(output, input)
+	closeErr := output.Close()
+	require.NoError(t, copyErr)
+	require.NoError(t, closeErr)
+	require.NoError(t, os.Chmod(helper, 0555))
+
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	require.NoError(t, err)
+	senderFD := os.NewFile(uintptr(fds[0]), "sender-session")
+	receiverFD := os.NewFile(uintptr(fds[1]), "receiver-session")
+	defer senderFD.Close()
+	defer receiverFD.Close()
+
+	ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+	defer cancel()
+	type procResult struct {
+		out []byte
+		err error
+	}
+	receiverDone := make(chan procResult, 1)
+	senderDone := make(chan procResult, 1)
+	peerDone := make(chan procResult, 1)
+	launch := func(role string, uid uint32, fd *os.File, ch chan<- procResult) {
+		u, g := uid, uid
+		var files []*os.File
+		if fd != nil {
+			files = []*os.File{fd}
+		}
+		out, err := runV24IsolatedSubprocessWithFiles(ctx, helper,
+			[]string{"-test.run=^TestC1V24IndependentReceiverProcess$", "-test.v"},
+			V24ReceiverCustodyPolicy{
+				RequireUnprivileged: true,
+				ExpectedReceiverUID: &u,
+				ExpectedReceiverGID: &g,
+				PrivateTempDir:      filepath.Join(root, roleName(role), "tmp"),
+			}, files, "VIRKI_V24_INDEPENDENT_ROLE="+role, "VIRKI_V24_FIXTURE_ROOT="+root)
+		ch <- procResult{out: out, err: err}
+	}
+	go launch("adversarial-peer", v28FixturePeerUID, nil, peerDone)
+	peerReady := filepath.Join(root, "peer", "ready")
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(peerReady); err == nil {
+			break
+		}
+		select {
+		case pRes := <-peerDone:
+			t.Fatalf("adversarial peer exited before ready: %v (%s)", pRes.err, pRes.out)
+		default:
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+	_, readyErr := os.Stat(peerReady)
+	require.NoError(t, readyErr, "adversarial peer did not signal readiness before receiver start")
+
+	go launch("receiver", v24FixtureReceiverUID, receiverFD, receiverDone)
+	go launch("sender", v24FixtureSenderUID, senderFD, senderDone)
+
+	receiver := <-receiverDone
+	_ = receiverFD.Close()
+	if receiver.err != nil {
+		cancel()
+	}
+	_ = os.WriteFile(filepath.Join(root, "peer", "stop"), []byte("1"), 0644)
+	sender := <-senderDone
+	_ = senderFD.Close()
+	peer := <-peerDone
+	require.NoError(t, receiver.err, "receiver: %s", receiver.out)
+	require.NoError(t, sender.err, "sender: %s", sender.out)
+	require.NoError(t, peer.err, "adversarial peer: %s", peer.out)
+	attemptsBytes, err := os.ReadFile(filepath.Join(root, "peer", "attempts"))
+	require.NoError(t, err)
+	attempts, err := strconv.Atoi(string(attemptsBytes))
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, attempts, 10, "expected peer to race during receiver publication window")
+
+	publishedDir := filepath.Join(root, "receiver", "published")
+	entries, err := os.ReadDir(publishedDir)
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	require.Equal(t, "app.js", entries[0].Name())
+	published := filepath.Join(publishedDir, "app.js")
+	got, err := os.ReadFile(published)
+	require.NoError(t, err)
+	require.Equal(t, []byte("SAFE"), got)
+	var st unix.Stat_t
+	require.NoError(t, unix.Lstat(published, &st))
+	require.Equal(t, v24FixtureReceiverUID, st.Uid)
+	require.Equal(t, uint32(unix.S_IFREG), st.Mode&unix.S_IFMT)
+}
+
+func roleName(role string) string {
+	if role == "adversarial-peer" {
+		return "peer"
+	}
+	return role
+}
+
+func v28AdversarialPeerRacer(t *testing.T) {
+	t.Helper()
+	ruid, euid, suid := unix.Getresuid()
+	for _, id := range []int{ruid, euid, suid} {
+		require.Equal(t, v28FixturePeerUID, uint32(id))
+	}
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, 1, nnp)
+	root := os.Getenv("VIRKI_V24_FIXTURE_ROOT")
+	require.NotEmpty(t, root)
+	receiverDir := filepath.Join(root, "receiver")
+	publishedDir := filepath.Join(receiverDir, "published")
+	evilTarget := filepath.Join(root, "peer", "evil")
+	require.NoError(t, os.WriteFile(evilTarget, []byte("EVIL"), 0644))
+	readyPath := filepath.Join(root, "peer", "ready")
+	stopPath := filepath.Join(root, "peer", "stop")
+	attemptsPath := filepath.Join(root, "peer", "attempts")
+	require.NoError(t, os.WriteFile(readyPath, []byte("1"), 0644))
+	attempts := 0
+	deadline := time.Now().Add(30 * time.Second)
+	for time.Now().Before(deadline) {
+		require.Error(t, os.Symlink(evilTarget, publishedDir))
+		require.Error(t, os.Mkdir(publishedDir, 0777))
+		require.Error(t, os.WriteFile(filepath.Join(publishedDir, "app.js"), []byte("EVIL"), 0644))
+		require.Error(t, os.Rename(evilTarget, publishedDir))
+		require.Error(t, os.Symlink(evilTarget, filepath.Join(receiverDir, "swap")))
+		attempts++
+		if _, err := os.Stat(stopPath); err == nil && attempts >= 10 {
+			break
+		}
+		time.Sleep(500 * time.Microsecond)
+	}
+	require.NoError(t, os.WriteFile(attemptsPath, []byte(strconv.Itoa(attempts)), 0644))
+}
diff --git a/session/filesync/sealed_custody_v24_linux.go b/session/filesync/sealed_custody_v24_linux.go
new file mode 100644
index 0000000..7dd01a6
--- /dev/null
+++ b/session/filesync/sealed_custody_v24_linux.go
@@ -0,0 +1,335 @@
+//go:build linux
+
+package filesync
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// V24ReceiverCustodyPolicy defines DEV-only defensive process and directory
+// custody invariants for the isolated BuildKit receiver. Passing these checks
+// establishes ordinary permission-contract conformance, NOT adversarial
+// same-UID race immunity or native C4 owner authorization.
+type V24ReceiverCustodyPolicy struct {
+	RequireUnprivileged         bool
+	RequirePrivateParent        bool
+	RequireImmutableGrandparent bool
+	ExpectedReceiverUID         *uint32
+	ExpectedReceiverGID         *uint32
+	ForbiddenPeerUIDs           []uint32
+	ExpectedSenderUID           *uint32
+	ExpectedSenderGID           *uint32
+	PrivateTempDir              string
+}
+
+func validateV24ProcessIdentity(policy V24ReceiverCustodyPolicy) error {
+	uid, euid, suid := unix.Getresuid()
+	gid, egid, sgid := unix.Getresgid()
+	if uid != euid || uid != suid || gid != egid || gid != sgid {
+		return errors.New("C1 V24 refuses setuid/setgid receiver process")
+	}
+	if policy.RequireUnprivileged && (euid == 0 || egid == 0) {
+		return errors.New("C1 V24 refuses root receiver identity")
+	}
+	if policy.ExpectedReceiverUID != nil && uint32(euid) != *policy.ExpectedReceiverUID {
+		return fmt.Errorf("C1 V24 receiver UID %d does not match expected %d", euid, *policy.ExpectedReceiverUID)
+	}
+	if policy.ExpectedReceiverGID != nil && uint32(egid) != *policy.ExpectedReceiverGID {
+		return fmt.Errorf("C1 V24 receiver GID %d does not match expected %d", egid, *policy.ExpectedReceiverGID)
+	}
+	for _, forbidden := range policy.ForbiddenPeerUIDs {
+		if uint32(euid) == forbidden {
+			return fmt.Errorf("C1 V24 receiver UID %d must be distinct from peer/observer UID", euid)
+		}
+	}
+	return nil
+}
+
+func validateV24CustodyDirs(dest string, policy V24ReceiverCustodyPolicy) error {
+	if !filepath.IsAbs(dest) || filepath.Clean(dest) != dest || dest == "/" {
+		return errors.New("C1 V24 destination must be canonical absolute non-root Linux pathname")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(rootFD)
+
+	parent := filepath.Dir(dest)
+	parentFD, err := unix.Openat2(rootFD, strings.TrimPrefix(parent, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return fmt.Errorf("C1 V24 unsafe custody parent: %w", err)
+	}
+	defer unix.Close(parentFD)
+
+	var st unix.Stat_t
+	if err := unix.Fstat(parentFD, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != uint32(os.Geteuid()) || st.Gid != uint32(os.Getegid()) {
+		return errors.New("C1 V24 custody parent must be real directory owned by receiver identity")
+	}
+	if policy.RequirePrivateParent {
+		if st.Mode&0777 != 0700 {
+			return fmt.Errorf("C1 V24 custody parent mode %04o must be 0700", st.Mode&0777)
+		}
+	} else if st.Mode&0022 != 0 {
+		return errors.New("C1 V24 custody parent must not be group/world writable")
+	}
+
+	if !policy.RequireImmutableGrandparent {
+		return nil
+	}
+	grandparent := filepath.Dir(parent)
+	var gpSt unix.Stat_t
+	if grandparent == "/" {
+		if err := unix.Fstat(rootFD, &gpSt); err != nil {
+			return err
+		}
+	} else {
+		gpFD, err := unix.Openat2(rootFD, strings.TrimPrefix(grandparent, "/"), &unix.OpenHow{
+			Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+		})
+		if err != nil {
+			return fmt.Errorf("C1 V24 unsafe custody grandparent: %w", err)
+		}
+		defer unix.Close(gpFD)
+		if err := unix.Fstat(gpFD, &gpSt); err != nil {
+			return err
+		}
+	}
+	if gpSt.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return errors.New("C1 V24 custody grandparent must be real directory")
+	}
+	if gpSt.Uid == uint32(os.Geteuid()) {
+		return errors.New("C1 V24 custody grandparent must not be owned by receiver UID")
+	}
+	if gpSt.Uid != 0 {
+		return errors.New("C1 V24 custody grandparent must be controlled by the trusted root supervisor")
+	}
+	if gpSt.Mode&0022 != 0 {
+		return errors.New("C1 V24 custody grandparent must not be group/world writable")
+	}
+	return nil
+}
+
+// validateV24IndependentCustody checks the explicit DEV supervisor contract.
+// The caller is responsible for independent trusted provisioning of identities
+// and the enclosing filesystem. Local checks are not an owner attestation.
+func validateV24NoCapabilities() error {
+	header := unix.CapUserHeader{Version: unix.LINUX_CAPABILITY_VERSION_3}
+	var caps [2]unix.CapUserData
+	if err := unix.Capget(&header, &caps[0]); err != nil {
+		return err
+	}
+	for _, c := range caps {
+		// Ambient capabilities are a subset of permitted and inheritable.
+		if c.Effective != 0 || c.Permitted != 0 || c.Inheritable != 0 {
+			return errors.New("C1 V24 independent receiver requires no process capabilities")
+		}
+	}
+	return nil
+}
+
+func validateV24IndependentCustody(dest string, policy V24ReceiverCustodyPolicy) error {
+	if !policy.RequireUnprivileged || !policy.RequirePrivateParent || !policy.RequireImmutableGrandparent ||
+		policy.ExpectedReceiverUID == nil || policy.ExpectedReceiverGID == nil || len(policy.ForbiddenPeerUIDs) == 0 {
+		return errors.New("C1 V24 independent receiver custody requires explicit supervisor identity and private namespace policy")
+	}
+	if policy.ExpectedSenderUID == nil || policy.ExpectedSenderGID == nil ||
+		*policy.ExpectedSenderUID == 0 || *policy.ExpectedSenderGID == 0 ||
+		*policy.ExpectedSenderUID == *policy.ExpectedReceiverUID ||
+		*policy.ExpectedSenderGID == *policy.ExpectedReceiverGID ||
+		!slices.Contains(policy.ForbiddenPeerUIDs, *policy.ExpectedSenderUID) {
+		return errors.New("C1 V24 independent receiver requires explicit distinct sender ownership")
+	}
+	cleanTmp := filepath.Clean(policy.PrivateTempDir)
+	cleanDest := filepath.Clean(dest)
+	cleanDestDir := filepath.Dir(cleanDest)
+	if policy.PrivateTempDir == "" || cleanTmp == cleanDestDir ||
+		strings.HasPrefix(cleanDestDir+"/", cleanTmp+"/") ||
+		cleanTmp == cleanDest ||
+		strings.HasPrefix(cleanTmp+"/", cleanDest+"/") {
+		return errors.New("C1 V24 independent receiver requires PrivateTempDir distinct from destination custody parent")
+	}
+	if err := validateV24ProcessIdentity(policy); err != nil {
+		return err
+	}
+	groups, err := os.Getgroups()
+	if err != nil {
+		return err
+	}
+	if len(groups) != 0 {
+		return errors.New("C1 V24 independent receiver refuses supplementary groups")
+	}
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	if err != nil {
+		return err
+	}
+	if nnp != 1 {
+		return errors.New("C1 V24 independent receiver requires NoNewPrivs")
+	}
+	if err := validateV24NoCapabilities(); err != nil {
+		return err
+	}
+	if policy.PrivateTempDir == "" || os.TempDir() != policy.PrivateTempDir {
+		return errors.New("C1 V24 independent receiver requires configured private TMPDIR")
+	}
+	if err := validateV24CustodyDirs(filepath.Join(policy.PrivateTempDir, "tmp-probe"), V24ReceiverCustodyPolicy{RequirePrivateParent: true}); err != nil {
+		return err
+	}
+	return validateV24CustodyDirs(dest, policy)
+}
+
+func defaultV24ReceiverCustodyPolicy() V24ReceiverCustodyPolicy {
+	return V24ReceiverCustodyPolicy{
+		RequirePrivateParent: true,
+	}
+}
+
+// receiveV24WithCustody enforces V24ReceiverCustodyPolicy before delegating to
+// the FD-pinned V23 quarantined receiver.
+func receiveV24WithCustody(dest string, manifest V15SealedManifest,
+	policy V24ReceiverCustodyPolicy, receive func(string) error) error {
+	if err := validateV24ProcessIdentity(policy); err != nil {
+		return err
+	}
+	if err := validateV24CustodyDirs(dest, policy); err != nil {
+		return err
+	}
+	return receiveV23QuarantinedWithParentSync(dest, manifest, receive, unix.Fsync)
+}
+
+// runV24IsolatedSubprocess executes a receiver helper in a separate Linux
+// process with a sanitized environment and Pdeathsig=SIGKILL. When
+// ExpectedReceiverUID differs from os.Geteuid(), it attaches explicit
+// Credential separation (which requires CAP_SETUID/CAP_SETGID in the caller).
+func runV24IsolatedSubprocess(ctx context.Context, exe string, args []string,
+	policy V24ReceiverCustodyPolicy, extraEnv ...string) ([]byte, error) {
+	return runV24IsolatedSubprocessWithFiles(ctx, exe, args, policy, nil, extraEnv...)
+}
+
+// Inherited files are supplied by the trusted DEV supervisor, not peer input.
+func runV24IsolatedSubprocessWithFiles(ctx context.Context, exe string, args []string,
+	policy V24ReceiverCustodyPolicy, files []*os.File, extraEnv ...string) ([]byte, error) {
+	if !filepath.IsAbs(exe) || filepath.Clean(exe) != exe {
+		return nil, errors.New("C1 V24 helper executable must be canonical absolute path")
+	}
+	exeInfo, err := os.Lstat(exe)
+	if err != nil {
+		return nil, fmt.Errorf("C1 V24 cannot stat helper executable: %w", err)
+	}
+	if !exeInfo.Mode().IsRegular() {
+		return nil, errors.New("C1 V24 helper executable must be non-symlink regular file")
+	}
+	if exeInfo.Mode().Perm()&0022 != 0 {
+		return nil, errors.New("C1 V24 helper executable must not be group/world writable")
+	}
+	for _, f := range files {
+		if f == nil {
+			return nil, errors.New("C1 V24 launcher refuses nil inherited file")
+		}
+	}
+	if policy.RequireUnprivileged && policy.ExpectedReceiverUID != nil && *policy.ExpectedReceiverUID == 0 {
+		return nil, errors.New("C1 V24 refuses root ExpectedReceiverUID")
+	}
+	if policy.ExpectedReceiverUID != nil && policy.ExpectedSenderUID != nil && *policy.ExpectedReceiverUID == *policy.ExpectedSenderUID {
+		return nil, errors.New("C1 V24 launcher refuses identical receiver and sender UID")
+	}
+	if policy.ExpectedReceiverUID != nil {
+		for _, forbidden := range policy.ForbiddenPeerUIDs {
+			if *policy.ExpectedReceiverUID == forbidden {
+				return nil, errors.New("C1 V24 ExpectedReceiverUID must be distinct from peer/observer UID")
+			}
+		}
+	}
+	attr := &syscall.SysProcAttr{
+		Pdeathsig: unix.SIGKILL,
+	}
+	if policy.RequireUnprivileged && os.Geteuid() == 0 && policy.ExpectedReceiverUID == nil {
+		return nil, errors.New("C1 V24 refuses unprivileged launch as root without ExpectedReceiverUID")
+	}
+	if policy.ExpectedReceiverUID != nil && uint32(os.Geteuid()) != *policy.ExpectedReceiverUID {
+		if os.Geteuid() != 0 {
+			return nil, errors.New("C1 V24 cross-UID credential separation requires privileged parent")
+		}
+		if policy.ExpectedReceiverGID == nil {
+			return nil, errors.New("C1 V24 cross-UID separation requires an explicit receiver GID")
+		}
+		gid := *policy.ExpectedReceiverGID
+		if policy.RequireUnprivileged && gid == 0 {
+			return nil, errors.New("C1 V24 refuses root receiver GID")
+		}
+		attr.Credential = &syscall.Credential{
+			Uid:    *policy.ExpectedReceiverUID,
+			Gid:    gid,
+			Groups: []uint32{},
+		}
+	} else if policy.ExpectedReceiverUID != nil && policy.ExpectedReceiverGID != nil && uint32(os.Getegid()) != *policy.ExpectedReceiverGID {
+		return nil, fmt.Errorf("C1 V24 receiver GID %d does not match expected %d", os.Getegid(), *policy.ExpectedReceiverGID)
+	}
+	if policy.PrivateTempDir == "" || !filepath.IsAbs(policy.PrivateTempDir) ||
+		filepath.Clean(policy.PrivateTempDir) != policy.PrivateTempDir || policy.PrivateTempDir == "/" {
+		return nil, errors.New("C1 V24 launcher requires an explicit private temporary directory")
+	}
+	tmpInfo, err := os.Lstat(policy.PrivateTempDir)
+	if err != nil {
+		return nil, fmt.Errorf("C1 V24 launcher cannot stat private temporary directory: %w", err)
+	}
+	if !tmpInfo.Mode().IsDir() || tmpInfo.Mode().Perm() != 0700 {
+		return nil, errors.New("C1 V24 launcher requires real 0700 private temporary directory")
+	}
+	expectedTmpUID := uint32(os.Geteuid())
+	if policy.ExpectedReceiverUID != nil {
+		expectedTmpUID = *policy.ExpectedReceiverUID
+	}
+	if tmpStat, ok := tmpInfo.Sys().(*syscall.Stat_t); !ok || tmpStat.Uid != expectedTmpUID {
+		return nil, errors.New("C1 V24 launcher requires PrivateTempDir owned by receiver identity")
+	}
+	for _, entry := range extraEnv {
+		key, _, ok := strings.Cut(entry, "=")
+		if !ok || strings.ContainsRune(entry, 0) || key == "" ||
+			key == "TMPDIR" || key == "PATH" || key == "HOME" || key == "LC_ALL" ||
+			strings.HasPrefix(key, "LD_") {
+			return nil, fmt.Errorf("C1 V24 launcher refuses unsafe env override %q", key)
+		}
+	}
+	env := append([]string{"PATH=/usr/bin:/bin", "LC_ALL=C", "HOME=/nonexistent", "TMPDIR=" + policy.PrivateTempDir}, extraEnv...)
+	type subprocResult struct {
+		out []byte
+		err error
+	}
+	ch := make(chan subprocResult, 1)
+	go func() {
+		runtime.LockOSThread()
+		// Intentionally omit UnlockOSThread so the Go runtime terminates this
+		// OS thread on exit rather than returning a NoNewPrivs-tainted thread.
+		if err := unix.Prctl(unix.PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0); err != nil {
+			ch <- subprocResult{err: fmt.Errorf("C1 V24 cannot enforce PR_SET_NO_NEW_PRIVS: %w", err)}
+			return
+		}
+		cmd := exec.CommandContext(ctx, exe, args...)
+		cmd.Env = env
+		cmd.SysProcAttr = attr
+		cmd.ExtraFiles = files
+		out, err := cmd.CombinedOutput()
+		ch <- subprocResult{out: out, err: err}
+	}()
+	res := <-ch
+	return res.out, res.err
+}
