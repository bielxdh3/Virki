+	}
+	// Empty snapshot is legitimate for an ABSENT root .dockerignore; an
+	// EXISTING empty file is a regular-file entry, even if it has zero bytes.
+	// Never infer absence only from nil bytes returned by a client frontend.
+	if a.Present && record.EntryCount == 0 {
+		return errors.New("C1 V10 owner approved present .dockerignore but snapshot is empty")
+	}
+	if !a.Present {
+		empty := sha256.Sum256([]byte(BuildKitContextTreeDigestSchema + "\x00"))
+		if record.EntryCount != 0 || record.RegularFileBytes != 0 ||
+			record.TreeDigest != fmt.Sprintf("sha256:%x", empty) ||
+			a.ContentSHA256 != SHA256BytesV4(nil) {
+			return errors.New("C1 V10 owner approved absent .dockerignore but worker saw a nonempty tree")
+		}
+	}
+	record.Generation = scope.auth.Generation
+	record.ContextIdentity = a.Identity
+	copyRecord := record
