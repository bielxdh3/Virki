+
+func (m *Manager) recordRootIgnoreV10(ctx context.Context, record Consumption) error {
+	if m == nil || ctx == nil {
+		return errors.New("C1 V10 root ignore observer is unavailable")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager != m {
+		return errors.New("C1 V10 root ignore observation has wrong solve scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V10 root ignore observation scope expired or closed")
+	}
+	a := scope.auth.RootDockerignoreV10
+	if a == nil {
+		return errors.New("C1 V10 root ignore observation was never owner approved")
+	}
+	if scope.auth.RequirePreferredMissingV12 && !scope.preferredDockerignoreMissingVerifiedV12 {
+		return errors.New("C1 V12 root worker observation lacks canonical preferred ENOENT")
+	}
+	if scope.auxiliaryRootIgnoreV10 != nil {
+		return errors.New("C1 V10 duplicate root ignore observation")
+	}
+	if record.Name != RootDockerignoreRoleV10 ||
+		(record.Generation != "" && record.Generation != scope.auth.Generation) ||
+		record.WorkerID != scope.auth.WorkerID ||
+		record.SessionID != a.SessionID ||
+		scope.auth.ContextSessionIDsV8["source"] != a.SessionID ||
+		!sha256Pattern.MatchString(record.VertexDigest) ||
+		record.VertexOutputIndex != 0 ||
+		!validIdentifier(record.SnapshotID) ||
+		record.TreeDigestSchema != BuildKitContextTreeDigestSchema ||
+		record.TreeDigest != a.TreeDigest || record.RegularFileBytes < 0 ||
+		record.EntryCount < 0 {
