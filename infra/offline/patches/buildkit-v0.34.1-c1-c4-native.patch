diff --git a/session/filesync/sealed_staging_v22_integration_test.go b/session/filesync/sealed_staging_v22_integration_test.go
new file mode 100644
index 0000000..698594c
--- /dev/null
+++ b/session/filesync/sealed_staging_v22_integration_test.go
@@ -0,0 +1,242 @@
+//go:build linux
+
+package filesync
+
+import (
+	"context"
+	"errors"
+	"fmt"
