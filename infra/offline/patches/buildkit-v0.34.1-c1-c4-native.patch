+	for _, tc := range []struct {
+		name   string
+		mutate func(*LocalIdentifier)
+	}{
+		{"missing owner-approved session", func(id *LocalIdentifier) { id.SessionID = "" }},
+		{"other session", func(id *LocalIdentifier) { id.SessionID = "foreign" }},
+		{"prefixed session", func(id *LocalIdentifier) { id.SessionID = "prefix:session-approved-v9" }},
