+				t.Fatal("invalid physical probe accepted")
+			}
+		})
+	}
+}
+
+func TestC1V10AuxiliaryOwnerApprovalIsMandatoryAndFrozen(t *testing.T) {
+	ctx, m, scope, service, record, _ := v10Fixture(t, false)
+	service.approval.SessionID = "client-rewrite"
+	service.approval.TreeDigest = "sha256:" + strings.Repeat("f", 64)
