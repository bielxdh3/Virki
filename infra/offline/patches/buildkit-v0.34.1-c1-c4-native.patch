 	Compaction CompactionConfig `toml:"compaction"`
 }
 
+// LocalContextObserverConfig points buildkitd at an owner-controlled verifier
+// over a private Unix socket. Owner keys and the replay ledger remain outside
+// buildkitd in that service.
+type LocalContextObserverConfig struct {
+	Required               bool    `toml:"required"`
+	SocketPath             string  `toml:"socketPath"`
+	SocketOwnerUID         *uint32 `toml:"socketOwnerUID"`
+	Protocol               string  `toml:"protocol"`
+	Epoch                  uint64  `toml:"epoch"`
+	ApprovalPublicKeyFile  string  `toml:"approvalPublicKeyFile"`
+	ApprovalKeyID          string  `toml:"approvalKeyID"`
+	ApprovalPinSHA256      string  `toml:"approvalPinSHA256"`
+	ReceiptPublicKeyFile   string  `toml:"receiptPublicKeyFile"`
+	ReceiptKeyID           string  `toml:"receiptKeyID"`
+	ExpectedImageMediaType string  `toml:"expectedImageMediaType"`
+	ExpectedImageDigest    string  `toml:"expectedImageDigest"`
+	ExpectedImageSize      int64   `toml:"expectedImageSize"`
+}
+
+// Validate rejects partial observer configuration instead of silently
+// allowing a required worker to run without the owner service.
+func (c LocalContextObserverConfig) Validate() error {
+	hasV3Fields := c.Epoch != 0 || c.ApprovalPublicKeyFile != "" || c.ApprovalKeyID != "" ||
+		c.ApprovalPinSHA256 != "" || c.ReceiptPublicKeyFile != "" || c.ReceiptKeyID != "" ||
+		c.ExpectedImageMediaType != "" || c.ExpectedImageDigest != "" || c.ExpectedImageSize != 0
+	configured := c.Required || c.SocketPath != "" || c.SocketOwnerUID != nil || c.Protocol != "" || hasV3Fields
+	if !configured {
+		return nil
+	}
+	if !filepath.IsAbs(c.SocketPath) || filepath.Clean(c.SocketPath) != c.SocketPath {
+		return errors.New("worker.localContextObserver.socketPath must be absolute and canonical")
+	}
+	if c.SocketOwnerUID == nil {
+		return errors.New("worker.localContextObserver.socketOwnerUID is required")
+	}
+	switch c.Protocol {
+	case "", "v1":
+		if hasV3Fields {
+			return errors.New("worker.localContextObserver V3 options require protocol = \"vroa-v3\"")
+		}
+		return nil
+	case "vroa-v3":
+		if c.Epoch == 0 {
+			return errors.New("worker.localContextObserver.epoch must be positive for vroa-v3")
+		}
+		if !filepath.IsAbs(c.ApprovalPublicKeyFile) || filepath.Clean(c.ApprovalPublicKeyFile) != c.ApprovalPublicKeyFile {
+			return errors.New("worker.localContextObserver.approvalPublicKeyFile must be absolute and canonical")
+		}
+		if c.ApprovalKeyID == "" || len(c.ApprovalPinSHA256) != 64 {
+			return errors.New("worker.localContextObserver.approvalKeyID and 64-hex approvalPinSHA256 are required for vroa-v3")
+		}
+		if c.ReceiptPublicKeyFile != "" && (!filepath.IsAbs(c.ReceiptPublicKeyFile) || filepath.Clean(c.ReceiptPublicKeyFile) != c.ReceiptPublicKeyFile) {
+			return errors.New("worker.localContextObserver.receiptPublicKeyFile must be absolute and canonical")
+		}
+		if c.ExpectedImageMediaType == "" || c.ExpectedImageDigest == "" || c.ExpectedImageSize <= 0 {
+			return errors.New("worker.localContextObserver expectedImageMediaType, expectedImageDigest and positive expectedImageSize are required for vroa-v3")
+		}
+		return nil
+	default:
+		return errors.New("worker.localContextObserver.protocol must be \"v1\" or \"vroa-v3\"")
+	}
+}
