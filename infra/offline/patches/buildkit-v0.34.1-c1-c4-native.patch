+
+// V7 uses the pinned BuildKit real protobuf marshaller AND real LLB loader.
+// It is not a fake SourceOp typed by the test and is not a physical snapshot,
+// worker Job.Build, real gRPC session or independent owner attestation.
+func TestC1V7RealLoaderLocalSourceSessionAndCanonicalRole(t *testing.T) {
+	const ownerExpectedSession = "session-approved-v7"
+	for _, tc := range []struct {
+		name    string
+		role    string
+		session string
+		paths   []string
+		allow   bool
+	}{
+		{name: "approved Dockerfile source", role: "dockerfile", session: ownerExpectedSession, paths: []string{"Dockerfile", "Dockerfile.dockerignore", "dockerfile"}, allow: true},
+		{name: "approved auxiliary ignore probe", role: "context", session: ownerExpectedSession, paths: []string{".dockerignore"}, allow: true},
+		{name: "foreign session but identical role", role: "dockerfile", session: "session-attacker-v7", paths: []string{"Dockerfile", "Dockerfile.dockerignore", "dockerfile"}},
+		{name: "prefix rewrites resolved source name", role: "dockerfile", session: "attacker:session-approved-v7", paths: []string{"Dockerfile", "Dockerfile.dockerignore", "dockerfile"}},
+		{name: "missing actual session attr", role: "dockerfile", session: "", paths: []string{"Dockerfile"}},
+		{name: "unauthorized source alias", role: "source", session: ownerExpectedSession, paths: []string{".dockerignore"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			sharedKey := "dockerfile"
+			if tc.role == "context" {
+				sharedKey = "context-.dockerignore"
+			}
+			dst := llb.Local(tc.role, llb.SessionID(tc.session), llb.FollowPaths(tc.paths),
+				llb.SharedKeyHint(sharedKey), llb.Differ(llb.DiffNone, false))
+			definition, err := dst.Marshal(t.Context())
+			require.NoError(t, err)
+			loaded, err := Load(t.Context(), definition.ToPB(), nil)
+			require.NoError(t, err)
+			require.NotNil(t, loaded.Vertex)
+			loadedOp, ok := loaded.Vertex.Sys().(*pb.Op)
+			require.True(t, ok)
+			require.NotNil(t, loadedOp.GetSource())
+			require.Equal(t, "local://"+tc.role, loadedOp.GetSource().Identifier)
+			require.Equal(t, tc.session, loadedOp.GetSource().Attrs[pb.AttrLocalSessionID])
+			require.NotEmpty(t, loadedOp.GetSource().Attrs[pb.AttrFollowPaths])
+			// This is the *loaded* vertex and actual SourceOp attrs, equivalent to
+			// what the concrete forwarder reads after Job.Build success.
+			observed := localcontext.BuiltinLoadedRefV6{
+				WorkerID: "worker-verified-v7", RefID: "snapshot-v7",
+				RootVertex: loaded.Vertex.Digest().String(), OutputIndex: int(loaded.Index),
+				SourceIdentifier:              loadedOp.GetSource().Identifier,
+				SourceSessionID:               loadedOp.GetSource().Attrs[pb.AttrLocalSessionID],
+				SourceFollowPaths:             loadedOp.GetSource().Attrs[pb.AttrFollowPaths],
+				SourceSharedKeyHint:           loadedOp.GetSource().Attrs[pb.AttrSharedKeyHint],
+				SourceDiffer:                  loadedOp.GetSource().Attrs[pb.AttrLocalDiffer],
+				SourceIncludePatterns:         loadedOp.GetSource().Attrs[pb.AttrIncludePatterns],
+				SourceExcludePatterns:         loadedOp.GetSource().Attrs[pb.AttrExcludePatterns],
+				SourceMetadataTransfer:        loadedOp.GetSource().Attrs[pb.AttrMetadataTransfer],
+				SourceMetadataTransferExclude: loadedOp.GetSource().Attrs[pb.AttrMetadataTransferExclude],
+			}
+			expectedRole := tc.role
+			if expectedRole == "source" {
+				expectedRole = "context"
+			}
+			err = localcontext.CheckBuiltinLocalSessionV7(observed, expectedRole, ownerExpectedSession)
+			shape := "dockerfile"
+			if expectedRole == "context" {
+				shape = "auxiliary-ignore"
+			}
+			shapeErr := localcontext.CheckBuiltinLocalReadShapeV7(observed, shape)
+			if tc.allow {
+				require.NoError(t, err)
+				require.NoError(t, shapeErr)
+			} else {
+				require.Error(t, err, "foreign or missing source session must independently fail")
+				if tc.role == "source" {
+					require.Error(t, shapeErr, "untrusted local source alias must not count as auxiliary ignore")
+				}
+			}
+		})
+	}
+}
+
+// The main `.dockerignore` probe is a DIFFERENT loaded local source vertex
+// from the actual final build context used for COPY, despite both being
+// local://context and sharing a session ID. A future owner receipt must not
+// silently equate their immutable snapshots or double-record them as one
+// canonical `source` context.
+func TestC1V7RealLoaderIgnoreProbeIsDistinctFromMainContext(t *testing.T) {
+	const session = "session-c1-v7"
+	for _, tc := range []struct {
+		name  string
+		state llb.State
+	}{
+		{name: "auxiliary ignore probe", state: llb.Local("context", llb.SessionID(session),
+			llb.FollowPaths([]string{".dockerignore"}), llb.SharedKeyHint("context-.dockerignore"),
+			llb.Differ(llb.DiffNone, false))},
+		{name: "actual main build context", state: llb.Local("context", llb.SessionID(session),
+			llb.ExcludePatterns([]string{"node_modules", "secrets"}),
+			llb.SharedKeyHint("context"), llb.Differ(llb.DiffNone, false))},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			def, err := tc.state.Marshal(t.Context())
+			require.NoError(t, err)
+			root, err := Load(t.Context(), def.ToPB(), nil)
+			require.NoError(t, err)
+			op, ok := root.Vertex.Sys().(*pb.Op)
+			require.True(t, ok)
+			require.Equal(t, "local://context", op.GetSource().Identifier)
+			require.Equal(t, session, op.GetSource().Attrs[pb.AttrLocalSessionID])
+			// A real loaded vertex has a unique graph digest for the supplied
+			// FollowPaths/ExcludePatterns material, not a shared session ID.
+			if tc.name == "auxiliary ignore probe" {
+				require.NotEmpty(t, op.GetSource().Attrs[pb.AttrFollowPaths])
+				require.Empty(t, op.GetSource().Attrs[pb.AttrExcludePatterns])
+			} else {
+				require.Empty(t, op.GetSource().Attrs[pb.AttrFollowPaths])
+				require.NotEmpty(t, op.GetSource().Attrs[pb.AttrExcludePatterns])
+			}
+		})
+	}
+	auxDef, err := llb.Local("context", llb.SessionID(session), llb.FollowPaths([]string{".dockerignore"}), llb.SharedKeyHint("context-.dockerignore")).Marshal(t.Context())
+	require.NoError(t, err)
+	mainDef, err := llb.Local("context", llb.SessionID(session), llb.SharedKeyHint("context")).Marshal(t.Context())
+	require.NoError(t, err)
+	aux, err := Load(t.Context(), auxDef.ToPB(), nil)
+	require.NoError(t, err)
+	main, err := Load(t.Context(), mainDef.ToPB(), nil)
+	require.NoError(t, err)
+	require.NotEqual(t, aux.Vertex.Digest(), main.Vertex.Digest(), "different context probes share session but must never be conflated")
+}
