+// This is a genuine in-process Linux gRPC session, NOT a native trusted C4
+// principal. The malicious sender emits bytes under a plausible versioned
+// handshake, so quarantine containment cannot be inferred from fake stubs.
+type v22MaliciousSealedProvider struct {
+	manifest V15SealedManifest
+	packets  []*types.Packet
+}
+
+func (p *v22MaliciousSealedProvider) Register(server *grpc.Server) {
+	server.RegisterService(&sealedServiceDescV15, p)
+}
+
+func (p *v22MaliciousSealedProvider) DiffCopySealedV15(stream grpc.ServerStream) error {
+	m := p.manifest
+	if err := stream.SendHeader(metadata.Pairs(v15MDManifest, m.Digest,
+		v15MDWorker, m.WorkerID, v15MDSession, m.SessionID, v15MDNonce, m.Nonce)); err != nil {
+		return err
+	}
+	gotRequest := false
+	for _, packet := range p.packets {
+		// A real fsutil receiver only creates the DATA pipe after sending
+		// PACKET_REQ for the file's exact STAT ID. Forged DATA before that
+		// event fails for protocol ordering, not for a SHA mismatch. Wait
+		// for the actual request to exercise the intended crypto negative.
+		if packet.Type == types.PACKET_DATA && !gotRequest {
+			var req types.Packet
+			if err := stream.RecvMsg(&req); err != nil {
+				return err
+			}
+			if req.Type != types.PACKET_REQ || req.ID != packet.ID {
+				return fmt.Errorf("C1 V22 malicious fixture got unexpected recv request %d/%d", req.Type, req.ID)
+			}
+			gotRequest = true
+		}
+		if err := stream.SendMsg(packet); err != nil {
+			return err
+		}
+	}
+	return nil
+}
