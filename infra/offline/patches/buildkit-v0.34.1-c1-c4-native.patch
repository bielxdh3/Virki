+func TestC1V24FSSyncSealedV15EnforcesCustodyPolicy(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("unprivileged gRPC custody integration test requires non-root euid")
+	}
+	t.Setenv("TMPDIR", "/tmp")
+	ctx, cancel := context.WithTimeout(t.Context(), 15*time.Second)
+	defer cancel()
+
+	root := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("SAFE"), 0600))
+	snapshot, err := NewLinuxSealedSnapshotV15(ctx, v15Request(root, "app.js"))
+	require.NoError(t, err)
+	m := snapshot.Manifest()
+	p, pub, ledger := v15SignedPermitFixture(t, m)
+
+	s, err := session.NewSession(ctx, "v24-custody-grpc")
+	require.NoError(t, err)
+	manager, err := session.NewManager()
+	require.NoError(t, err)
+	s.Allow(NewSealedFSSyncProviderV15(snapshot))
+
+	g, ctx := errgroup.WithContext(ctx)
+	g.Go(func() error {
+		return s.Run(ctx, session.Dialer(testutil.TestStream(testutil.Handler(manager.HandleConn))))
+	})
+	g.Go(func() (retErr error) {
+		defer func() {
+			if closeErr := s.Close(); retErr == nil {
+				retErr = closeErr
+			}
+		}()
+		caller, err := manager.Get(ctx, s.ID(), false)
+		if err != nil {
+			return err
+		}
+		nonPrivateParent := filepath.Join(t.TempDir(), "public-parent")
+		if err := os.Mkdir(nonPrivateParent, 0755); err != nil {
+			return err
+		}
+		dest := filepath.Join(nonPrivateParent, "published")
+		err = FSSyncSealedV15(ctx, caller, FSSendRequestOpt{
+			Name: "context", FollowPaths: []string{"app.js"}, DestDir: dest,
+		}, m, p, pub, ledger)
+		if err == nil || !strings.Contains(err.Error(), "must be 0700") {
+			return os.ErrInvalid
+		}
+		if _, statErr := os.Lstat(dest); !os.IsNotExist(statErr) {
+			return os.ErrExist
+		}
+		return nil
+	})
+	require.NoError(t, g.Wait())
+}
