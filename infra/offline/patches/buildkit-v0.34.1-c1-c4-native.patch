+package localcontext
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestC1V14HardDenyOwnerFilteredMainBeforePhysicalFileSync(t *testing.T) {
+	ctx, _, scope, _, _ := v13FollowFixture(t, []string{"app.js"})
+	// Valid owner approval and selected ignore are intentionally NOT enough:
+	// an in-process fixture can sign no trusted immutable client snapshot.
+	if err := BindDerivedMainFollowPathsV13(ctx, []string{"app.js"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := RequireMainFollowPathsV13(ctx, []string{"app.js"}, `["app.js"]`, true); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		err := RequirePhysicalMainTransferV14(ctx, "source")
+		if err == nil || !strings.Contains(err.Error(), "PHYSICAL FILESYNC DENIED") {
+			t.Fatalf("V13 worker main could transfer bytes before immutable capability: %v", err)
+		}
+	}
+	for _, role := range []string{"dockerfile", RootDockerignoreRoleV10, "offline-npm-cacache", "offline-prisma-engines"} {
+		if err := RequirePhysicalMainTransferV14(ctx, role); err == nil || !strings.Contains(err.Error(), "C1 V14 PHYSICAL FILESYNC DENIED") {
+			t.Fatalf("V13 prior source %q could leak bytes before main denial: %v", role, err)
+		}
+	}
+	if err := scope.Abort(ctx, errors.New("V14 deliberate gate")); err != nil {
+		t.Fatal(err)
+	}
+	if err := RequirePhysicalMainTransferV14(ctx, "source"); err == nil {
+		t.Fatal("closed owner generation could be re-used for physical transfer")
+	}
+}
+
+func TestC1V14UnfilteredLegacySourceUnchanged(t *testing.T) {
+	ctx, _, _, _, _ := v12PreferredFixture(t, []byte(""))
+	if err := RequirePhysicalMainTransferV14(ctx, "source"); err != nil {
+		t.Fatalf("V14 accidentally denied V12 unfiltered main source: %v", err)
+	}
+	if err := RequirePhysicalMainTransferV14(t.Context(), "source"); err != nil {
+		t.Fatalf("V14 accidentally changed owner-unscoped BuildKit: %v", err)
+	}
+}
diff --git a/util/localcontext/frontend_events_v4.go b/util/localcontext/frontend_events_v4.go
new file mode 100644
index 0000000..3b17f48
--- /dev/null
+++ b/util/localcontext/frontend_events_v4.go
@@ -0,0 +1,531 @@
+package localcontext
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io/fs"
+	"sync"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// BuiltinFrontendEventsV4 is a per-solve, non-authorizing event accumulator.
+// It is intended to be installed ONLY by a trusted daemon-selected builtin
+// Dockerfile frontend. Calling this API or providing the event log on its own
+// does NOT establish frontend identity, consumed immutable-ref provenance,
+// owner approval or permission to publish. Those checks are not implemented.
+type BuiltinFrontendEventsV4 struct {
+	mu                       sync.Mutex
+	read                     *BuiltinDockerfileReadEventV4
+	primaryDockerfileMissing *BuiltinLoadedRefV6
+	transforms               map[string]BuiltinDockerfileTransformEventV4
+	dockerfileIgnore         *BuiltinDockerfileIgnoreEventV4
+	mainIgnore               *BuiltinDockerfileIgnoreEventV4
+}
+
+// BuiltinDockerfileIgnoreEventV4 records the actual read *outcome* and bytes,
+// including an empty but successfully read file. Missing is only recognized
+// for an explicit ENOENT/NotFound result; permission and I/O errors fail closed.
+// This DOES NOT carry the immutable worker snapshot identity of either solve.
+type BuiltinDockerfileIgnoreEventV4 struct {
+	Source        string
+	Path          string
+	Present       bool
+	ContentSHA256 string
+	Loaded        *BuiltinLoadedRefV6
+}
+
+// BuiltinIgnoreTraceV4 preserves BOTH lookup outcomes. A complete trace still
+// is only evidence of frontend behavior, never authenticated physical custody.
+type BuiltinIgnoreTraceV4 struct {
+	Preferred *BuiltinDockerfileIgnoreEventV4
+	Main      *BuiltinDockerfileIgnoreEventV4
+	Complete  bool
+	Effective *BuiltinDockerfileIgnoreEventV4
+}
+
+func cloneLoadedRefV6(v *BuiltinLoadedRefV6) *BuiltinLoadedRefV6 {
+	if v == nil {
+		return nil
+	}
+	clone := *v
+	return &clone
+}
+
+func cloneIgnoreEventV6(value *BuiltinDockerfileIgnoreEventV4) *BuiltinDockerfileIgnoreEventV4 {
+	if value == nil {
+		return nil
+	}
+	clone := *value
+	clone.Loaded = cloneLoadedRefV6(value.Loaded)
+	return &clone
+}
+
+type BuiltinDockerfileReadEventV4 struct {
+	RequestedPath string
+	SelectedPath  string
+	ContentSHA256 string
+	Loaded        *BuiltinLoadedRefV6
+	// Populated only when the initial Dockerfile lookup positively returned
+	// ENOENT and a lowercase retry succeeded on the SAME loaded source.
+	PrimaryMissing *BuiltinLoadedRefV6
+}
+
+type BuiltinDockerfileTransformEventV4 struct {
+	Platform         string
+	DockerfileSHA256 string
+	// This is the PRE-LOADER definition head, NOT the solver RootEdge,
+	// output index, owner-certified worker ref or exporter-selected result.
+	DefinitionHead string
+	Loaded         *BuiltinLoadedRefV6
+}
+
+func sameLoadedRefV6(a, b BuiltinLoadedRefV6) bool {
+	return a.WorkerID == b.WorkerID && a.RefID == b.RefID &&
+		a.RootVertex == b.RootVertex && a.OutputIndex == b.OutputIndex &&
+		a.SourceIdentifier == b.SourceIdentifier
+}
+
+// ObserveBuiltinPrimaryDockerfileENOENTV6 records the failed `Dockerfile`
+// lookup on the same actual loaded local source used by the lowercase retry.
+// Only the surrounding successful concrete ReadFile result can classify
+// ENOENT: this event NEVER generates absence from missing data or metadata.
+func ObserveBuiltinPrimaryDockerfileENOENTV6(ctx context.Context, source BuiltinLoadedRefV6) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !validLoadedRefV6(source) || source.SourceIdentifier != "local://dockerfile" {
+		return errors.New("C1 V6 invalid loaded local Dockerfile source for primary ENOENT")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.primaryDockerfileMissing != nil || log.read != nil || len(log.transforms) != 0 {
+		return errors.New("C1 V6 repeated or late primary Dockerfile absence")
+	}
+	copy := source
+	log.primaryDockerfileMissing = &copy
+	return nil
+}
+
+// BindBuiltinDockerfileLoadedReadV6 accepts a separately inspected in-process
+// forwarder reference for the EXACT successful Dockerfile source solve. This
+// is still a same-process observation; the independent owner has not signed
+// it or checked its physical custody or context identity.
+func BindBuiltinDockerfileLoadedReadV6(ctx context.Context, source BuiltinLoadedRefV6) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !validLoadedRefV6(source) {
+		return errors.New("C1 V6 incomplete loaded Dockerfile source")
+	}
+	if source.SourceIdentifier != "local://dockerfile" {
+		return errors.New("C1 V6 read source is not concrete local://dockerfile")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil || log.read.Loaded != nil || log.dockerfileIgnore != nil || len(log.transforms) != 0 {
+		return errors.New("C1 V6 stale or duplicate loaded Dockerfile source bind")
+	}
+	if log.read.SelectedPath == "dockerfile" {
+		if log.primaryDockerfileMissing == nil || !sameLoadedRefV6(*log.primaryDockerfileMissing, source) {
+			return errors.New("C1 V6 lowercase Dockerfile fallback has no same-source primary ENOENT")
+		}
+	} else if log.primaryDockerfileMissing != nil {
+		return errors.New("C1 V6 normal Dockerfile successful read conflicts with primary ENOENT record")
+	}
+	copy := source
+	log.read.Loaded = &copy
+	if log.primaryDockerfileMissing != nil {
+		log.read.PrimaryMissing = cloneLoadedRefV6(log.primaryDockerfileMissing)
+	}
+	return nil
+}
+
+func BindBuiltinDockerfileLoadedIgnoreV6(ctx context.Context, sourceRole string, source BuiltinLoadedRefV6) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !validLoadedRefV6(source) {
+		return errors.New("C1 V6 incomplete loaded ignore source")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil || log.read.Loaded == nil {
+		return errors.New("C1 V6 ignore source cannot precede measured Dockerfile source")
+	}
+	var target *BuiltinDockerfileIgnoreEventV4
+	switch sourceRole {
+	case "dockerfile":
+		if source.SourceIdentifier != "local://dockerfile" {
+			return errors.New("C1 V6 preferred ignore is not the concrete Dockerfile local source")
+		}
+		target = log.dockerfileIgnore
+		if !sameLoadedRefV6(*log.read.Loaded, source) {
+			return errors.New("C1 V6 preferred Dockerfile ignore uses a different immutable Dockerfile read result")
+		}
+	case "context":
+		if source.SourceIdentifier != "local://context" {
+			return errors.New("C1 V6 main ignore is not the concrete main-context local source")
+		}
+		target = log.mainIgnore
+	default:
+		return errors.New("C1 V6 unknown ignore source role")
+	}
+	if target == nil || target.Loaded != nil {
+		return errors.New("C1 V6 absent, stale or duplicate ignore source bind")
+	}
+	copy := source
+	target.Loaded = &copy
+	return nil
+}
+
+func BindBuiltinDockerfileLoadedOutputV6(ctx context.Context, platform string, output BuiltinLoadedRefV6) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !validLoadedRefV6(output) {
+		return errors.New("C1 V6 incomplete loaded frontend output ref")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	event, exists := log.transforms[platform]
+	if !exists || event.Loaded != nil {
+		return errors.New("C1 V6 unknown or duplicate loaded frontend output bind")
+	}
+	copy := output
+	event.Loaded = &copy
+	log.transforms[platform] = event
+	return nil
+}
+
+type builtinFrontendEventsContextKeyV4 struct{}
+
+func NewBuiltinFrontendEventsV4() *BuiltinFrontendEventsV4 {
+	return &BuiltinFrontendEventsV4{transforms: make(map[string]BuiltinDockerfileTransformEventV4)}
+}
+
+// WithBuiltinFrontendEventsV4 is an internal integration hook; do not expose
+// its context or records to untrusted gateway frontends as authorization.
+func WithBuiltinFrontendEventsV4(ctx context.Context, events *BuiltinFrontendEventsV4) context.Context {
+	if events == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, builtinFrontendEventsContextKeyV4{}, events)
+}
+
+func activeBuiltinFrontendEventsV4(ctx context.Context) *BuiltinFrontendEventsV4 {
+	if ctx == nil {
+		return nil
+	}
+	log, _ := ctx.Value(builtinFrontendEventsContextKeyV4{}).(*BuiltinFrontendEventsV4)
+	return log
+}
+
+// BuiltinFrontendEventsEnabledV4 permits zero behavior change for ordinary
+// Dockerfile builds when this explicitly experimental capture is absent.
+func BuiltinFrontendEventsEnabledV4(ctx context.Context) bool {
+	return activeBuiltinFrontendEventsV4(ctx) != nil
+}
+
+// IsMissingBuiltinFrontendFileV4 accepts ONLY a positive OS/gRPC not-found
+// outcome, not a generic failure reported by the read transport.
+func IsMissingBuiltinFrontendFileV4(err error) bool {
+	return err != nil && (errors.Is(err, fs.ErrNotExist) || status.Code(err) == codes.NotFound)
+}
+
+// ObserveBuiltinDockerfileReadV4 must be invoked immediately after the
+// selected successful ReadFile returns. Failed attempts are not provenance.
+func ObserveBuiltinDockerfileReadV4(ctx context.Context, requestedPath, selectedPath string, content []byte) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if requestedPath != "Dockerfile" || (selectedPath != "Dockerfile" && selectedPath != "dockerfile") || len(content) == 0 || len(content) > 4<<20 {
+		return errors.New("v4 read event must be one supported, nonempty builtin Dockerfile")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read != nil || len(log.transforms) > 0 {
+		return errors.New("v4 builtin Dockerfile read was repeated or occurred after conversion")
+	}
+	log.read = &BuiltinDockerfileReadEventV4{
+		RequestedPath: requestedPath, SelectedPath: selectedPath, ContentSHA256: SHA256BytesV4(content),
+	}
+	return nil
+}
+
+// ObserveBuiltinDockerfileIgnoreV4 records the separate real ReadFile result
+// from either Dockerfile.dockerignore or the main-context .dockerignore solve.
+// Missing and empty content MUST NEVER be treated as the same observation.
+func ObserveBuiltinDockerfileIgnoreV4(ctx context.Context, source, filename string, data []byte, readErr error) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if (source != "dockerfile" || filename != "Dockerfile.dockerignore") &&
+		(source != "context" || filename != ".dockerignore") {
+		return errors.New("C1 v4 ignore read came from an unsupported source or path")
+	}
+	present := readErr == nil
+	if readErr != nil && !IsMissingBuiltinFrontendFileV4(readErr) {
+		return fmt.Errorf("C1 v4 cannot attest ignore absence from ambiguous failed read: %w", readErr)
+	}
+	if !present && len(data) != 0 {
+		return errors.New("C1 v4 missing ignore read unexpectedly returned content")
+	}
+	if len(data) > 4<<20 {
+		return errors.New("C1 v4 ignore data exceeds bounded capture size")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil {
+		return errors.New("C1 v4 ignore read arrived before Dockerfile was successfully read")
+	}
+	event := &BuiltinDockerfileIgnoreEventV4{
+		Source: source, Path: filename, Present: present, ContentSHA256: SHA256BytesV4(data),
+	}
+	if source == "dockerfile" {
+		if log.dockerfileIgnore != nil || log.mainIgnore != nil {
+			return errors.New("C1 v4 duplicate or out-of-order Dockerfile ignore result")
+		}
+		log.dockerfileIgnore = event
+		return nil
+	}
+	if log.dockerfileIgnore == nil || log.dockerfileIgnore.Present || log.mainIgnore != nil {
+		return errors.New("C1 v4 main-context ignore result is out of order or overrides a present Dockerfile-specific ignore")
+	}
+	log.mainIgnore = event
+	return nil
+}
+
+// SnapshotIgnoreV4 returns the selected effective ignore and its complete read
+// provenance *within the builtin frontend only*. Presence of the first read
+// has priority. This method intentionally refuses to infer absence when the
+// fallback main-context read did not happen.
+func (log *BuiltinFrontendEventsV4) SnapshotIgnoreV4() (BuiltinDockerfileIgnoreEventV4, bool) {
+	if log == nil {
+		return BuiltinDockerfileIgnoreEventV4{}, false
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.dockerfileIgnore == nil {
+		return BuiltinDockerfileIgnoreEventV4{}, false
+	}
+	if log.dockerfileIgnore.Present {
+		return *cloneIgnoreEventV6(log.dockerfileIgnore), true
+	}
+	if log.mainIgnore == nil {
+		return BuiltinDockerfileIgnoreEventV4{}, false
+	}
+	return *cloneIgnoreEventV6(log.mainIgnore), true
+}
+
+// SnapshotIgnoreTraceV4 avoids losing the preferred ENOENT when a main-context
+// fallback is selected; neither the zero SHA nor absence of the main event is
+// proof of actual lookup absence. An actual owner still needs independently
+// pinned immutable reference identities for BOTH source read solves.
+func (log *BuiltinFrontendEventsV4) SnapshotIgnoreTraceV4() BuiltinIgnoreTraceV4 {
+	if log == nil {
+		return BuiltinIgnoreTraceV4{}
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	trace := BuiltinIgnoreTraceV4{}
+	if log.dockerfileIgnore != nil {
+		preferred := *cloneIgnoreEventV6(log.dockerfileIgnore)
+		trace.Preferred = &preferred
+		if preferred.Present {
+			trace.Complete = true
+			trace.Effective = &preferred
+			return trace
+		}
+	}
+	if log.mainIgnore != nil {
+		main := *cloneIgnoreEventV6(log.mainIgnore)
+		trace.Main = &main
+		trace.Complete = trace.Preferred != nil && !trace.Preferred.Present
+		if trace.Complete {
+			trace.Effective = &main
+		}
+	}
+	return trace
+}
+
+// ReadyToBindV4 is a conservative *structural* state check, NOT approval.
+// Missing ignore probes, an unexecuted fallback or a definition with no head
+// can never be presented as a complete source-to-LLB event bundle. Even true
+// still lacks physical identity and the independently loaded RootEdge/ref.
+func (log *BuiltinFrontendEventsV4) ReadyToBindV4() bool {
+	if log == nil {
+		return false
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil || len(log.transforms) == 0 || log.dockerfileIgnore == nil {
+		return false
+	}
+	if !log.dockerfileIgnore.Present && log.mainIgnore == nil {
+		return false
+	}
+	for _, transform := range log.transforms {
+		if transform.DefinitionHead == "" || !sha256Pattern.MatchString(transform.DefinitionHead) {
+			return false
+		}
+	}
+	return true
+}
+
+// VerifyBuiltinFrontendLoadedOutputV6 makes a one-to-one independent
+// comparison between the concrete builtin Dockerfile per-platform Solve
+// outputs, as obtained by the in-process forwarder, and the separately
+// postprocessor-selected exporter platform map. It rejects a coordinated
+// res/cached/inp relabel when frontend observations retain original identity.
+// It NEVER substitutes for independent owner authorization or manifest
+// readback. The events must be installed only at daemon-selected builtin
+// dispatch, not from client-controlled gateway metadata.
+func (log *BuiltinFrontendEventsV4) VerifyBuiltinFrontendLoadedOutputV6(selected map[string]CausalRoot) error {
+	if log == nil {
+		return errors.New("C1 V6 no builtin event recorder")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if len(log.transforms) == 0 || len(log.transforms) > 32 || len(selected) != len(log.transforms) {
+		return errors.New("C1 V6 exporter root cardinality differs from frontend transforms")
+	}
+	if log.read == nil || log.read.Loaded == nil {
+		return errors.New("C1 V6 missing measured Dockerfile source identity")
+	}
+	for platform, recorded := range log.transforms {
+		root, exists := selected[platform]
+		if !exists || recorded.Loaded == nil {
+			return fmt.Errorf("C1 V6 missing exact loaded builtin root for platform %q", platform)
+		}
+		actual := *recorded.Loaded
+		if actual.WorkerID != log.read.Loaded.WorkerID {
+			return fmt.Errorf("C1 V6 platform %q executed on a replacement worker", platform)
+		}
+		if root.WorkerID != actual.WorkerID || root.RefID != actual.RefID ||
+			root.VertexDigest != actual.RootVertex || root.OutputIndex != actual.OutputIndex {
+			return fmt.Errorf("C1 V6 postprocessor/exporter replaced original builtin platform %q result", platform)
+		}
+	}
+	return nil
+}
+
+// ReadyToBindV6 is a stricter diagnostics-only completeness predicate. It
+// never proves externally installed ownership or physical custody. Missing
+// or changed source references, or absent loaded image roots, fail closed.
+func (log *BuiltinFrontendEventsV4) ReadyToBindV6() bool {
+	if log == nil {
+		return false
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil || log.read.Loaded == nil || len(log.transforms) == 0 ||
+		log.dockerfileIgnore == nil || log.dockerfileIgnore.Loaded == nil ||
+		!sameLoadedRefV6(*log.read.Loaded, *log.dockerfileIgnore.Loaded) {
+		return false
+	}
+	if !log.dockerfileIgnore.Present && (log.mainIgnore == nil || log.mainIgnore.Loaded == nil) {
+		return false
+	}
+	if log.read.Loaded.SourceIdentifier != "local://dockerfile" ||
+		log.dockerfileIgnore.Loaded.SourceIdentifier != "local://dockerfile" ||
+		(log.mainIgnore != nil && (log.mainIgnore.Loaded == nil ||
+			log.mainIgnore.Loaded.SourceIdentifier != "local://context" ||
+			log.mainIgnore.Loaded.WorkerID != log.read.Loaded.WorkerID)) {
+		return false
+	}
+	for _, converted := range log.transforms {
+		if converted.Loaded == nil || !validLoadedRefV6(*converted.Loaded) ||
+			converted.Loaded.WorkerID != log.read.Loaded.WorkerID ||
+			converted.DefinitionHead == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// ObserveBuiltinDockerfileTransformV4 is called after Dockerfile2LLB and a
+// successful final-LLB solve. It verifies the parser's exact input bytes match
+// the earlier selected ReadFile event. It still does not bind the worker ref.
+func ObserveBuiltinDockerfileTransformV4(ctx context.Context, platform string, content []byte, definitionHead string) error {
+	log := activeBuiltinFrontendEventsV4(ctx)
+	if log == nil {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	// A valid FROM scratch metadata-only transform may have an empty LLB
+	// definition. Record that fact, but NEVER invent a loaded solver RootEdge.
+	// An owner-enabled C1 must still deny promotion without an actual root.
+	if platform == "" || len(platform) > 128 || len(content) == 0 || len(content) > 4<<20 ||
+		(definitionHead != "" && !sha256Pattern.MatchString(definitionHead)) {
+		return errors.New("v4 transform event missing canonical platform, parser input or generated root")
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	if log.read == nil || log.read.ContentSHA256 != SHA256BytesV4(content) {
+		return errors.New("v4 frontend transformed bytes other than the selected successful Dockerfile read")
+	}
+	if len(log.transforms) >= 32 {
+		return errors.New("v4 builtin frontend platform count exceeds maximum")
+	}
+	if _, exists := log.transforms[platform]; exists {
+		return fmt.Errorf("v4 builtin frontend repeated platform %q", platform)
+	}
+	if log.transforms == nil {
+		log.transforms = make(map[string]BuiltinDockerfileTransformEventV4)
+	}
+	log.transforms[platform] = BuiltinDockerfileTransformEventV4{
+		Platform: platform, DockerfileSHA256: log.read.ContentSHA256, DefinitionHead: definitionHead,
+	}
+	return nil
+}
+
+// SnapshotV4 creates a defensive copy for subsequent typed comparison.
+func (log *BuiltinFrontendEventsV4) SnapshotV4() (*BuiltinDockerfileReadEventV4, map[string]BuiltinDockerfileTransformEventV4) {
+	if log == nil {
+		return nil, nil
+	}
+	log.mu.Lock()
+	defer log.mu.Unlock()
+	var read *BuiltinDockerfileReadEventV4
+	if log.read != nil {
+		copy := *log.read
+		copy.Loaded = cloneLoadedRefV6(log.read.Loaded)
+		copy.PrimaryMissing = cloneLoadedRefV6(log.read.PrimaryMissing)
+		read = &copy
+	}
+	transforms := make(map[string]BuiltinDockerfileTransformEventV4, len(log.transforms))
+	for platform, event := range log.transforms {
+		event.Loaded = cloneLoadedRefV6(event.Loaded)
+		transforms[platform] = event
+	}
+	return read, transforms
+}
