+			t.Fatal("duplicate auxiliary observation permitted")
+		}
+		if err := manager.ContextConsumed(ctx, record); err == nil {
+			t.Fatal("auxiliary incorrectly joined canonical records")
+		}
+		_, _, contexts, err := scope.CausalInputs()
+		if err == nil || len(contexts) != 0 {
+			t.Fatal("auxiliary must not satisfy four required causal inputs")
+		}
+		if service.approval.Present != present {
+			t.Fatal("fixture lost owner presence")
+		}
+	}
+}
+
+func TestC1V10AuxiliaryReadCannotBeReplayedOrMisclassified(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		data    []byte
+		readErr error
+		modify  func(*BuiltinLoadedRefV6)
+	}{
+		{"status flipped to present", nil, nil, nil},
+		{"absent but nonzero data", []byte("bad"), fs.ErrNotExist, nil},
+		{"bad worker", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.WorkerID = "attacker" }},
+		{"bad immutable ref", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.RefID = "other" }},
+		{"bad loaded root", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.RootVertex = "sha256:" + strings.Repeat("a", 64) }},
+		{"bad source role", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.SourceIdentifier = "local://dockerfile" }},
+		{"bad session", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.SourceSessionID = "foreign" }},
+		{"bad output index", nil, fs.ErrNotExist, func(v *BuiltinLoadedRefV6) { v.OutputIndex = 1 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, m, _, _, record, loaded := v10Fixture(t, false)
+			if err := ObserveRootDockerignoreV10(ctx, m, record); err != nil {
+				t.Fatal(err)
+			}
+			v := loaded
+			if tc.modify != nil {
+				tc.modify(&v)
+			}
+			if err := VerifyRootDockerignoreReadV10(ctx, tc.data, tc.readErr, v); err == nil {
+				t.Fatal("forged auxiliary read admitted")
+			}
+		})
+	}
+	ctx, _, _, _, record, _ := v10Fixture(t, false)
+	foreign, err := NewManager(&fakeService{}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ObserveRootDockerignoreV10(ctx, foreign, record); err == nil {
+		t.Fatal("foreign manager accepted")
+	}
+}
+
+func TestC1V10RootIgnoreRecordChecksOwnerSessionTreeAndPresence(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mutate func(*Consumption)
+	}{
