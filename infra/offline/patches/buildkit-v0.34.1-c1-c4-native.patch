diff --git a/session/filesync/sealed_stage_tree_v23_linux.go b/session/filesync/sealed_stage_tree_v23_linux.go
new file mode 100644
index 0000000..b213276
--- /dev/null
+++ b/session/filesync/sealed_stage_tree_v23_linux.go
@@ -0,0 +1,198 @@
+//go:build linux
+
+package filesync
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// verifyV23StageTreeFD inspects a quarantined receiver tree using ONLY
+// directory descriptors anchored to an already-open stage root. In V22 the
+// first metadata walk followed /proc/self/fd/<parent>/<stageName>, while the
+// second verifier used a separately-opened directory FD. A same-UID attacker
+// could swap the stage pathname between those passes. This v23 inventory
+// uses one pinned root FD for exact membership and refuses inode replacement
+// of every directory while enumerating. It is NOT a guarantee against a
+// same-UID process actively editing the tree after verification.
+func verifyV23StageTreeFD(stageFD int, m V15SealedManifest) error {
+	if stageFD < 0 || m.Digest == "" || v15ManifestDigest(m) != m.Digest {
+		return errors.New("C1 V23 missing bounded frozen stage manifest")
+	}
+	if err := validateV15Request(V15SnapshotRequest{
+		Root: "pinned-stage-fd", ContextName: m.ContextName, WorkerID: m.WorkerID,
+		SessionID: m.SessionID, Nonce: m.Nonce, Files: m.Files,
+	}); err != nil {
+		return fmt.Errorf("C1 V23 invalid expected path set: %w", err)
+	}
+	expected := make(map[string]bool, len(m.Files))
+	allowedDirs := make(map[string]bool)
+	for _, pin := range m.Files {
+		expected[pin.Path] = true
+		parts := strings.Split(pin.Path, "/")
+		for i := 1; i < len(parts); i++ {
+			allowedDirs[strings.Join(parts[:i], "/")] = true
+		}
+	}
+	seenFiles := make(map[string]bool, len(expected))
+	seenDirs := make(map[string]bool, len(allowedDirs))
+	budget := 1 + len(expected) + len(allowedDirs)
+	var walk func(string, int) error
+	walk = func(prefix string, dirFD int) error {
+		var before, after unix.Stat_t
+		if err := unix.Fstat(dirFD, &before); err != nil {
+			return err
+		}
+		if before.Mode&unix.S_IFMT != unix.S_IFDIR || before.Uid != uint32(os.Getuid()) ||
+			before.Mode&0022 != 0 {
+			return fmt.Errorf("C1 V23 untrusted stage directory %q", prefix)
+		}
+		// Dup shares the same directory stream cursor, so the second
+		// verification could mistakenly read EOF and report an empty tree.
+		// Opening "." relative to the pinned descriptor creates a distinct
+		// file description (cursor) without a mutable ancestor pathname.
+		dupFD, err := unix.Openat(dirFD, ".", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		var listed unix.Stat_t
+		if err := unix.Fstat(dupFD, &listed); err != nil {
+			_ = unix.Close(dupFD)
+			return err
+		}
+		if listed.Ino != before.Ino || listed.Dev != before.Dev {
+			_ = unix.Close(dupFD)
+			return fmt.Errorf("C1 V23 directory identity changed before inventory %q", prefix)
+		}
+		directory := os.NewFile(uintptr(dupFD), prefix)
+		// ReadDir(-1) eagerly materializes *all* entries before any budget
+		// enforcement, allowing a hostile or pathological tree to exhaust
+		// worker memory. At most one more than the remaining authorized
+		// global entry budget is ever enumerated into this allocation.
+		items, listErr := directory.ReadDir(budget + 1)
+		if len(items) > budget {
+			_ = directory.Close()
+			return errors.New("C1 V23 unapproved number of directory entries before allocation")
+		}
+		// Go's os.File.ReadDir(n) is permitted to return fewer than n
+		// entries with nil error. Probe a *single* additional entry to
+		// establish EOF rather than rejecting legitimate small trees or
+		// ever allocating an unbounded directory listing.
+		if listErr == nil {
+			additional, nextErr := directory.ReadDir(1)
+			if len(additional) != 0 || !errors.Is(nextErr, io.EOF) {
+				_ = directory.Close()
+				return errors.New("C1 V23 unapproved number of directory entries before allocation")
+			}
+		}
+		closeErr := directory.Close()
+		if listErr != nil && !errors.Is(listErr, io.EOF) {
+			return listErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		for _, item := range items {
+			budget--
+			if budget < 0 {
+				return errors.New("C1 V23 unapproved number of directory entries")
+			}
+			name := item.Name()
+			if name == "" || name == "." || name == ".." || strings.ContainsAny(name, "/\\") {
+				return errors.New("C1 V23 unsafe directory entry name")
+			}
+			rel := name
+			if prefix != "" {
+				rel = prefix + "/" + name
+			}
+			if path.Clean(rel) != rel {
+				return errors.New("C1 V23 noncanonical stage member")
+			}
+			var st unix.Stat_t
+			if err := unix.Fstatat(dirFD, name, &st, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+				return fmt.Errorf("C1 V23 cannot pin stage member %q: %w", rel, err)
+			}
+			if st.Uid != uint32(os.Getuid()) {
+				return fmt.Errorf("C1 V23 foreign-owner stage member %q", rel)
+			}
+			switch st.Mode & unix.S_IFMT {
+			case unix.S_IFDIR:
+				if !allowedDirs[rel] || seenDirs[rel] || st.Mode&0022 != 0 {
+					return fmt.Errorf("C1 V23 extra/unsafe stage directory %q", rel)
+				}
+				seenDirs[rel] = true
+				child, err := unix.Openat2(stageFD, rel, &unix.OpenHow{
+					Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+					Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+				})
+				if err != nil {
+					return fmt.Errorf("C1 V23 unsafe stage directory link %q: %w", rel, err)
+				}
+				var opened unix.Stat_t
+				statErr := unix.Fstat(child, &opened)
+				if statErr == nil && (opened.Ino != st.Ino || opened.Dev != st.Dev) {
+					statErr = fmt.Errorf("C1 V23 swapped stage directory %q", rel)
+				}
+				if statErr == nil {
+					statErr = walk(rel, child)
+				}
+				_ = unix.Close(child)
+				if statErr != nil {
+					return statErr
+				}
+			case unix.S_IFREG:
+				if !expected[rel] || seenFiles[rel] || st.Nlink != 1 {
+					return fmt.Errorf("C1 V23 unexpected/hardlinked stage file %q", rel)
+				}
+				seenFiles[rel] = true
+			default:
+				return fmt.Errorf("C1 V23 symlink/device/FIFO/socket denied %q", rel)
+			}
+		}
+		if err := unix.Fstat(dirFD, &after); err != nil {
+			return err
+		}
+		if before.Dev != after.Dev || before.Ino != after.Ino ||
+			before.Mtim != after.Mtim || before.Ctim != after.Ctim {
+			return fmt.Errorf("C1 V23 stage directory mutated during inventory %q", prefix)
+		}
+		return nil
+	}
+	if err := walk("", stageFD); err != nil {
+		return err
+	}
+	if len(seenFiles) != len(expected) || len(seenDirs) != len(allowedDirs) {
+		return errors.New("C1 V23 stage missing owner-approved file or ancestor")
+	}
+	return nil
+}
+
+// requireV23StageNameIdentity refuses a same-parent stage-name swap before
+// publication. A successful check cannot prevent subsequent same-UID
+// mutation; the owner/receiver must eventually have independent custody.
+func requireV23StageNameIdentity(parentFD, stageFD int, name string) error {
+	if parentFD < 0 || stageFD < 0 || name == "" || name == "." || name == ".." ||
+		strings.ContainsAny(name, "/\\") {
+		return errors.New("C1 V23 invalid pinned stage identity")
+	}
+	var byName, byFD unix.Stat_t
+	if err := unix.Fstatat(parentFD, name, &byName, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return fmt.Errorf("C1 V23 stage name no longer exists: %w", err)
+	}
+	if err := unix.Fstat(stageFD, &byFD); err != nil {
+		return err
+	}
+	if byName.Mode&unix.S_IFMT != unix.S_IFDIR || byFD.Mode&unix.S_IFMT != unix.S_IFDIR ||
+		byName.Ino != byFD.Ino || byName.Dev != byFD.Dev ||
+		byName.Uid != uint32(os.Getuid()) || byFD.Uid != uint32(os.Getuid()) ||
+		byName.Mode&0022 != 0 || byFD.Mode&0022 != 0 {
+		return errors.New("C1 V23 stage pathname no longer identifies verified directory")
+	}
+	return nil
+}
diff --git a/session/filesync/sealed_stage_tree_v23_linux_test.go b/session/filesync/sealed_stage_tree_v23_linux_test.go
new file mode 100644
index 0000000..148a1a7
--- /dev/null
+++ b/session/filesync/sealed_stage_tree_v23_linux_test.go
@@ -0,0 +1,167 @@
+//go:build linux
+
+package filesync
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func v23OpenDir(t *testing.T, name string) int {
+	t.Helper()
+	fd, err := unix.Open(name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = unix.Close(fd) })
+	return fd
+}
+
+func TestC1V23FDInventoryRepeatAndExtraEntryDenials(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	root := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "nested", "code"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "nested", "code", "app.js"), []byte("SAFE"), 0600))
+	m := v15PacketManifest()
+	m.Files = []V15FilePin{{Path: "nested/code/app.js", SHA256: v15Hash([]byte("SAFE")), Size: 4}}
+	m.Digest = v15ManifestDigest(m)
+	fd := v23OpenDir(t, root)
+	for i := 0; i < 3; i++ {
+		require.NoError(t, verifyV23StageTreeFD(fd, m), "repeated inventories must not share a directory cursor")
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(root, "nested", "code", "unapproved.env"), []byte("S"), 0600))
+	require.ErrorContains(t, verifyV23StageTreeFD(fd, m), "unexpected")
+	require.NoError(t, os.Remove(filepath.Join(root, "nested", "code", "unapproved.env")))
+	require.NoError(t, os.Symlink("app.js", filepath.Join(root, "nested", "code", "linked.js")))
+	require.ErrorContains(t, verifyV23StageTreeFD(fd, m), "symlink")
+	require.NoError(t, os.Remove(filepath.Join(root, "nested", "code", "linked.js")))
+	require.NoError(t, os.Mkdir(filepath.Join(root, "nested", "extra-dir"), 0700))
+	require.ErrorContains(t, verifyV23StageTreeFD(fd, m), "extra/unsafe")
+	require.NoError(t, os.Remove(filepath.Join(root, "nested", "extra-dir")))
+	require.NoError(t, verifyV23StageTreeFD(fd, m))
+}
+
+func TestC1V23HugeUnapprovedDirectoryIsBoundedBeforeEnumeration(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	root := t.TempDir()
+	m := v15PacketManifest()
+	require.NoError(t, os.WriteFile(filepath.Join(root, "app.js"), []byte("SAFE"), 0600))
+	for i := 0; i < 256; i++ {
+		require.NoError(t, os.WriteFile(filepath.Join(root, fmt.Sprintf("unapproved-%03d.env", i)), []byte("SECRET"), 0600))
+	}
+	fd := v23OpenDir(t, root)
+	require.ErrorContains(t, verifyV23StageTreeFD(fd, m), "unapproved number of directory entries before allocation")
+	// The same pinned FD must refuse again; no cursor-based false green.
+	require.ErrorContains(t, verifyV23StageTreeFD(fd, m), "unapproved number of directory entries before allocation")
+}
+
+func TestC1V23PinnedStageNameSwapRejectedBeforePublish(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	parent := t.TempDir()
+	stage := filepath.Join(parent, ".virki-v23-test-stage")
+	require.NoError(t, os.Mkdir(stage, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600))
+	parentFD := v23OpenDir(t, parent)
+	stageFD := v23OpenDir(t, stage)
+	m := v15PacketManifest()
+	require.NoError(t, verifyV23StageTreeFD(stageFD, m))
+	require.NoError(t, requireV23StageNameIdentity(parentFD, stageFD, filepath.Base(stage)))
+	// Swap the name AFTER the directory FD and contents were verified.
+	// The old pinned FD still reads the approved file; a pathname-only
+	// check would read the attacker replacement with an EXTRA secret.
+	require.NoError(t, os.Rename(stage, stage+"-old"))
+	require.NoError(t, os.Mkdir(stage, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(stage, "secret.env"), []byte("UNAPPROVED"), 0600))
+	require.NoError(t, verifyV23StageTreeFD(stageFD, m), "FD scan must remain on the originally pinned inode")
+	require.ErrorContains(t, requireV23StageNameIdentity(parentFD, stageFD, filepath.Base(stage)), "no longer identifies")
+}
+
+func TestC1V23NoFollowAndNonregularFileNeverPublish(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	parent := t.TempDir()
+	m := v15PacketManifest()
+	for _, tc := range []struct {
+		label string
+		write func(string) error
+		want  string
+	}{
+		{"symlink", func(stage string) error { return os.Symlink("/etc/passwd", filepath.Join(stage, "app.js")) }, "symlink"},
+		{"unapproved-dir", func(stage string) error { return os.Mkdir(filepath.Join(stage, "unknown"), 0700) }, "extra/unsafe"},
+		{"fifo", func(stage string) error { return unix.Mkfifo(filepath.Join(stage, "app.js"), 0600) }, "FIFO"},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			dest := filepath.Join(parent, tc.label)
+			err := receiveV19Quarantined(dest, m, tc.write)
+			require.ErrorContains(t, err, tc.want)
+			_, err = os.Lstat(dest)
+			require.ErrorIs(t, err, os.ErrNotExist)
+		})
+	}
+}
+
+func TestC1V23ParentFsyncFaultAfterRenameIsPublishedTerminal(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	dest := filepath.Join(t.TempDir(), "published")
+	var called int
+	err := receiveV23QuarantinedWithParentSync(dest, m, func(stage string) error {
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	}, func(fd int) error {
+		if fd < 0 {
+			return errors.New("bad fsync handle")
+		}
+		called++
+		return unix.EIO
+	})
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal,
+		"final parent fsync fails AFTER rename; never report a retryable pre-publish error")
+	require.ErrorIs(t, err, unix.EIO)
+	require.Equal(t, 1, called)
+	got, readErr := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, readErr, "the destination may already be visible after ambiguous fsync")
+	require.Equal(t, []byte("SAFE"), got)
+	require.Error(t, receiveV19Quarantined(dest, m, func(string) error { return nil }),
+		"an ambiguous published receiver must not be replayed over itself")
+}
+
+func TestC1V23PublishedNameReplacementAfterFsyncNeverReportsAdmission(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	dest := filepath.Join(t.TempDir(), "published")
+	called := 0
+	err := receiveV23QuarantinedWithParentSync(dest, m, func(stage string) error {
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	}, func(fd int) error {
+		called++
+		// This controlled same-UID attack happens AFTER the verified stage
+		// was renamed, but BEFORE the function reports success. We can
+		// detect a changed inode, not prevent all transient exposure.
+		if err := os.Rename(dest, dest+"-stolen"); err != nil {
+			return err
+		}
+		if err := os.Mkdir(dest, 0700); err != nil {
+			return err
+		}
+		if err := os.WriteFile(filepath.Join(dest, "app.js"), []byte("EVIL"), 0600); err != nil {
+			return err
+		}
+		return unix.Fsync(fd)
+	})
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal)
+	require.ErrorContains(t, err, "published unexpected directory inode")
+	require.Equal(t, 1, called)
+	approved, readErr := os.ReadFile(filepath.Join(dest+"-stolen", "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("SAFE"), approved)
+	unapproved, readErr := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("EVIL"), unapproved,
+		"same-UID attack may expose wrong bytes; detector must never claim GO")
+}
diff --git a/session/filesync/sealed_stage_verify_v22_linux.go b/session/filesync/sealed_stage_verify_v22_linux.go
new file mode 100644
index 0000000..b98fd93
--- /dev/null
+++ b/session/filesync/sealed_stage_verify_v22_linux.go
@@ -0,0 +1,167 @@
+//go:build linux
+
+package filesync
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// verifyV22StageNames inspects only names and metadata. Never use
+// os.ReadFile(path) here: a concurrent symlink replacement between a walk
+// and a pathname-based open could read outside the private quarantine.
+// File bytes are verified exclusively using pinned openat2 descriptors.
+func verifyV22StageNames(stage string, m V15SealedManifest) error {
+	if stage == "" || m.Digest == "" || v15ManifestDigest(m) != m.Digest {
+		return errors.New("C1 V22 unbound quarantine layout")
+	}
+	expected := make(map[string]bool, len(m.Files))
+	allowedDirs := make(map[string]bool)
+	for _, pin := range m.Files {
+		expected[pin.Path] = true
+		parts := strings.Split(pin.Path, "/")
+		for i := 1; i < len(parts); i++ {
+			allowedDirs[strings.Join(parts[:i], "/")] = true
+		}
+	}
+	seen := make(map[string]bool, len(expected))
+	err := filepath.WalkDir(stage, func(current string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if current == stage {
+			return nil
+		}
+		rel, err := filepath.Rel(stage, current)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		if path.Clean(rel) != rel || strings.HasPrefix(rel, "../") || entry.Type()&os.ModeSymlink != 0 {
+			return fmt.Errorf("C1 V22 unapproved symlink/traversal quarantine entry %q", rel)
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			if !allowedDirs[rel] {
+				return fmt.Errorf("C1 V22 extra quarantine directory %q", rel)
+			}
+			if info.Mode().Perm()&0022 != 0 {
+				return fmt.Errorf("C1 V22 writable quarantine directory %q", rel)
+			}
+			return nil
+		}
+		if !expected[rel] || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 || seen[rel] {
+			return fmt.Errorf("C1 V22 extra, duplicate or special quarantine file %q", rel)
+		}
+		seen[rel] = true
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if len(seen) != len(expected) {
+		return errors.New("C1 V22 incomplete quarantine file set")
+	}
+	return nil
+}
+
+// verifyAndSyncV22Stage reopens each manifest-approved file relative to the
+// PINNED quarantine directory FD with openat2 NO_SYMLINKS/NO_MAGICLINKS,
+// never through a mutable absolute pathname. Verification and fsync happen
+// before the RENAME_NOREPLACE publication point. This closes the path-based
+// verify/open race for the files being checked, but does NOT authenticate the
+// process/owner or protect against a malicious *same-UID* process mutating a
+// destination concurrently. Release remains NO-GO.
+func verifyAndSyncV22Stage(stageFD int, m V15SealedManifest) error {
+	if stageFD < 0 || m.Digest == "" || m.Digest != v15ManifestDigest(m) {
+		return errors.New("C1 V22 cannot verify a stage without a frozen manifest")
+	}
+	var total int64
+	for _, pin := range m.Files {
+		if pin.Size < 0 || pin.Size > 16<<20 || len(pin.Path) == 0 ||
+			path.Clean(pin.Path) != pin.Path || strings.HasPrefix(pin.Path, "/") || strings.Contains(pin.Path, "\\") {
+			return fmt.Errorf("C1 V22 invalid manifest file path %q", pin.Path)
+		}
+		fd, err := unix.Openat2(stageFD, pin.Path, &unix.OpenHow{
+			Flags:   uint64(unix.O_RDONLY | unix.O_CLOEXEC | unix.O_NONBLOCK | unix.O_NOFOLLOW),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+		})
+		if err != nil {
+			return fmt.Errorf("C1 V22 unsafe staged file %q: %w", pin.Path, err)
+		}
+		var before, after unix.Stat_t
+		if err := unix.Fstat(fd, &before); err != nil {
+			unix.Close(fd)
+			return err
+		}
+		if before.Mode&unix.S_IFMT != unix.S_IFREG || before.Nlink != 1 || before.Size != pin.Size ||
+			before.Size > 16<<20 || before.Uid != uint32(os.Getuid()) {
+			unix.Close(fd)
+			return fmt.Errorf("C1 V22 staged object %q is not an exact owned regular file", pin.Path)
+		}
+		f := os.NewFile(uintptr(fd), pin.Path)
+		h := sha256.New()
+		count, readErr := io.Copy(h, io.LimitReader(f, pin.Size+1))
+		if readErr == nil {
+			readErr = unix.Fstat(fd, &after)
+		}
+		if readErr == nil && (count != pin.Size ||
+			fmt.Sprintf("sha256:%x", h.Sum(nil)) != pin.SHA256 ||
+			before.Dev != after.Dev || before.Ino != after.Ino ||
+			before.Size != after.Size || before.Ctim != after.Ctim ||
+			before.Mtim != after.Mtim || before.Nlink != after.Nlink) {
+			readErr = fmt.Errorf("C1 V22 staged bytes changed or differ from signed manifest: %q", pin.Path)
+		}
+		if readErr == nil {
+			readErr = f.Sync()
+		}
+		closeErr := f.Close()
+		if readErr != nil {
+			return readErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		total += count
+		if total > 64<<20 {
+			return errors.New("C1 V22 staged file budget exceeded")
+		}
+		// Flush each nested directory containing a verified file, not just
+		// the root quarantine directory. These paths are pinned under stageFD.
+		parts := strings.Split(pin.Path, "/")
+		for i := len(parts) - 1; i > 0; i-- {
+			parent := strings.Join(parts[:i], "/")
+			dirFD, err := unix.Openat2(stageFD, parent, &unix.OpenHow{
+				Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+				Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+			})
+			if err != nil {
+				return fmt.Errorf("C1 V22 unsafe intermediate directory %q: %w", parent, err)
+			}
+			err = unix.Fsync(dirFD)
+			_ = unix.Close(dirFD)
+			if err != nil {
+				return fmt.Errorf("C1 V22 intermediate directory fsync failed: %w", err)
+			}
+		}
+	}
+	if total != m.Bytes {
+		return errors.New("C1 V22 staged total bytes differ from frozen manifest")
+	}
+	// The caller also verifies exact path membership/extra directory denial.
+	// fsync of the stage tree's directory entries prevents publishing a tree
+	// whose regular file payload was only in volatile writeback memory.
+	return unix.Fsync(stageFD)
+}
diff --git a/session/filesync/sealed_staging_v19_linux.go b/session/filesync/sealed_staging_v19_linux.go
new file mode 100644
index 0000000..12074e0
--- /dev/null
+++ b/session/filesync/sealed_staging_v19_linux.go
@@ -0,0 +1,175 @@
+//go:build linux
+
+package filesync
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// receiveV19Quarantined is a DEV-only worker-side receiver containment
+// experiment. A failed recvDiffCopy, packet hash, verification or commit may
+// only create bytes in a private, freshly allocated quarantine directory.
+// This is not an independent owner authentication or durable C4 receipt.
+//
+// The pinned parent descriptor, /proc/self/fd path to that descriptor and
+// RENAME_NOREPLACE are essential: pathname-only preflight and a rename by
+// mutable path would permit symlink replacement after the check.
+func receiveV19Quarantined(dest string, manifest V15SealedManifest, receive func(string) error) error {
+	return receiveV23QuarantinedWithParentSync(dest, manifest, receive, unix.Fsync)
+}
+
+// receiveV23QuarantinedWithParentSync isolates the final parent fsync in a
+// private dependency-injection seam for adversarial crash/error tests.
+// External callers only use receiveV19Quarantined with the real unix.Fsync;
+// this is NOT an exported release/owner authorization or retry override.
+func receiveV23QuarantinedWithParentSync(dest string, manifest V15SealedManifest,
+	receive func(string) error, syncParent func(int) error) error {
+	if receive == nil || syncParent == nil || manifest.Digest == "" || v15ManifestDigest(manifest) != manifest.Digest {
+		return errors.New("C1 V19 invalid isolated receive or manifest")
+	}
+	if !filepath.IsAbs(dest) || filepath.Clean(dest) != dest || dest == "/" {
+		return errors.New("C1 V19 destination must be canonical absolute non-root Linux pathname")
+	}
+	name := filepath.Base(dest)
+	if name == "." || name == ".." || name == "/" || name == "" || strings.HasPrefix(name, ".virki-v19-") {
+		return errors.New("C1 V19 reserved or invalid destination basename")
+	}
+	parent := filepath.Dir(dest)
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(rootFD)
+	parentFD, err := unix.Openat2(rootFD, strings.TrimPrefix(parent, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return fmt.Errorf("C1 V19 unsafe destination ancestor: %w", err)
+	}
+	defer unix.Close(parentFD)
+	var st unix.Stat_t
+	if err := unix.Fstat(parentFD, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != uint32(os.Getuid()) ||
+		st.Mode&0022 != 0 {
+		return errors.New("C1 V19 destination parent must be owned, non-group/world writable real directory")
+	}
+	// Nonexisting final destination is mandatory; refuse existing directories,
+	// symlinks, FIFOs and files, even if their contents look empty.
+	if err := unix.Fstatat(parentFD, name, &st, unix.AT_SYMLINK_NOFOLLOW); err == nil {
+		return errors.New("C1 V19 refuses preexisting destination")
+	} else if !errors.Is(err, unix.ENOENT) {
+		return fmt.Errorf("C1 V19 cannot securely probe destination: %w", err)
+	}
+	var stageName string
+	for attempts := 0; attempts < 4; attempts++ {
+		var nonce [16]byte
+		if _, err := rand.Read(nonce[:]); err != nil {
+			return err
+		}
+		candidate := ".virki-v19-" + hex.EncodeToString(nonce[:])
+		err = unix.Mkdirat(parentFD, candidate, 0700)
+		if errors.Is(err, unix.EEXIST) {
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("C1 V19 quarantine mkdir refused: %w", err)
+		}
+		stageName = candidate
+		break
+	}
+	if stageName == "" {
+		return errors.New("C1 V19 failed to reserve unique quarantine")
+	}
+	// The stable FD-backed pathname does not revisit mutable ancestor paths,
+	// unlike filepath.Join(parent, stageName).
+	stage := fmt.Sprintf("/proc/self/fd/%d/%s", parentFD, stageName)
+	defer func() { _ = os.RemoveAll(stage) }()
+	if err := receive(stage); err != nil {
+		return fmt.Errorf("C1 V19 quarantined stream rejected: %w", err)
+	}
+	// V23 anchors both membership and file-content verification to the
+	// SAME opened stage directory FD; a path-based WalkDir before opening
+	// the FD could inspect an entirely different swapped quarantine tree.
+	stageFD, err := unix.Openat(parentFD, stageName,
+		unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("C1 V22 cannot pin quarantined directory: %w", err)
+	}
+	defer unix.Close(stageFD)
+	if err := verifyV23StageTreeFD(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V23 untrusted pinned stage membership: %w", err)
+	}
+	if err := verifyAndSyncV22Stage(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V22 unsafe quarantined bytes: %w", err)
+	}
+	// Repeat the anchored inventory and hash check immediately before
+	// publication to reject changes observed between the two phases.
+	// This remains best-effort against a malicious *same-UID* adversary:
+	// only a separate immutable receiver authority can close that race.
+	if err := verifyV23StageTreeFD(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V23 stage changed after content seal: %w", err)
+	}
+	if err := verifyAndSyncV22Stage(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V23 stage content changed before commit: %w", err)
+	}
+	// Fsync a separate readable handle to the SAME pinned owner parent FD;
+	// the O_PATH reference alone cannot reliably be fsynced. Rename and sync
+	// are DEV durability diagnostics, not a crash/rollback proof of owner C4.
+	parentSyncFD, err := unix.Openat2(rootFD, strings.TrimPrefix(parent, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return fmt.Errorf("C1 V22 owner-parent fsync handle denied: %w", err)
+	}
+	defer unix.Close(parentSyncFD)
+	var parentBefore, parentAfter unix.Stat_t
+	if err := unix.Fstat(parentSyncFD, &parentBefore); err != nil {
+		return err
+	}
+	if err := unix.Fstat(parentFD, &parentAfter); err != nil {
+		return err
+	}
+	if parentBefore.Ino != parentAfter.Ino || parentBefore.Dev != parentAfter.Dev {
+		return errors.New("C1 V22 owner-parent identity changed before publication")
+	}
+	// Specifically fence swapping the randomly named stage directory for
+	// another directory after opening stageFD. This is a deterministic
+	// identity check against the pinned parent, not an atomic filesystem
+	// authorization of same-UID concurrent modifications.
+	if err := requireV23StageNameIdentity(parentFD, stageFD, stageName); err != nil {
+		return err
+	}
+	// The only path publication point is atomic and no-replace on the SAME
+	// pinned directory descriptor, after all bytes and metadata were verified.
+	if err := unix.Renameat2(parentFD, stageName, parentFD, name, unix.RENAME_NOREPLACE); err != nil {
+		return fmt.Errorf("C1 V19 sealed quarantine could not commit atomically: %w", err)
+	}
+	if err := syncParent(parentSyncFD); err != nil {
+		// The published tree MAY already exist after the successful rename.
+		// Return the same explicit terminal state as a rejected owner
+		// observer, not an ordinary retryable precommit failure.
+		return &V22PublishedButUnadmittedError{Destination: dest,
+			Cause: fmt.Errorf("C1 V23 ambiguous published rename: parent fsync failed: %w", err)}
+	}
+	// The pathname could have been swapped by an attacker with the SAME
+	// UID after the pre-rename identity check. A post-publication identity
+	// recheck cannot prevent brief exposure; it MUST however refuse a
+	// false success/owner admission if the destination inode differs.
+	if err := requireV23StageNameIdentity(parentFD, stageFD, name); err != nil {
+		return &V22PublishedButUnadmittedError{Destination: dest,
+			Cause: fmt.Errorf("C1 V23 published unexpected directory inode: %w", err)}
+	}
+	return nil
+}
diff --git a/session/filesync/sealed_staging_v19_linux_test.go b/session/filesync/sealed_staging_v19_linux_test.go
new file mode 100644
index 0000000..c6cd7a8
--- /dev/null
+++ b/session/filesync/sealed_staging_v19_linux_test.go
@@ -0,0 +1,113 @@
+//go:build linux
+
+package filesync
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func v19WriteExact(stage string, content []byte) error {
+	return os.WriteFile(filepath.Join(stage, "app.js"), content, 0644)
+}
+
+func TestC1V19QuarantineRejectsPartialAndWrongHashWithoutDestination(t *testing.T) {
+	m := v15PacketManifest()
+	for _, tc := range []struct {
+		label string
+		write func(string) error
+	}{
+		{"wrong-digest", func(s string) error { return v19WriteExact(s, []byte("EVIL")) }},
+		{"partial-then-error", func(s string) error {
+			if err := v19WriteExact(s, []byte("SA")); err != nil {
+				return err
+			}
+			return errors.New("fake interrupted diffcopy")
+		}},
+		{"extra-secret", func(s string) error {
+			if err := v19WriteExact(s, []byte("SAFE")); err != nil {
+				return err
+			}
+			return os.WriteFile(filepath.Join(s, "secret.env"), []byte("SECRET"), 0600)
+		}},
+		{"symlink-payload", func(s string) error { return os.Symlink("/etc/passwd", filepath.Join(s, "app.js")) }},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			parent := t.TempDir()
+			dest := filepath.Join(parent, "published")
+			err := receiveV19Quarantined(dest, m, tc.write)
+			require.Error(t, err)
+			_, err = os.Lstat(dest)
+			require.ErrorIs(t, err, os.ErrNotExist, "failure must never expose even a partial destination")
+			remaining, err := os.ReadDir(parent)
+			require.NoError(t, err)
+			require.Empty(t, remaining, "failed staging directories must be removed")
+		})
+	}
+}
+
+func TestC1V19QuarantineAtomicNoreplaceAndNoSymlinkParent(t *testing.T) {
+	m := v15PacketManifest()
+	private := t.TempDir()
+	dest := filepath.Join(private, "publish")
+	require.NoError(t, receiveV19Quarantined(dest, m, func(s string) error { return v19WriteExact(s, []byte("SAFE")) }))
+	got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, err)
+	require.Equal(t, "SAFE", string(got))
+	err = receiveV19Quarantined(dest, m, func(s string) error { return v19WriteExact(s, []byte("EVIL")) })
+	require.Error(t, err, "even a validly shaped existing directory cannot be replaced")
+	got, err = os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, err)
+	require.Equal(t, "SAFE", string(got))
+
+	outside := t.TempDir()
+	alias := filepath.Join(private, "parent-link")
+	require.NoError(t, os.Symlink(outside, alias))
+	require.Error(t, receiveV19Quarantined(filepath.Join(alias, "escaped"), m, func(s string) error { return v19WriteExact(s, []byte("SAFE")) }))
+	_, err = os.Stat(filepath.Join(outside, "escaped"))
+	require.ErrorIs(t, err, os.ErrNotExist)
+	require.Error(t, receiveV19Quarantined("relative-dest", m, func(s string) error { return nil }))
+	require.Error(t, receiveV19Quarantined(filepath.Join(private, "..", "noncanonical"), m, func(s string) error { return nil }))
+
+	symlinkDest := filepath.Join(private, "dest-link")
+	require.NoError(t, os.Symlink(outside, symlinkDest))
+	require.Error(t, receiveV19Quarantined(symlinkDest, m, func(s string) error { return nil }))
+	entries, err := os.ReadDir(private)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		require.False(t, strings.HasPrefix(entry.Name(), ".virki-v19-"), "stranded quarantine after a refusal")
+	}
+}
+
+func TestC1V19AtomicConcurrentPublishOneWinner(t *testing.T) {
+	m := v15PacketManifest()
+	parent := t.TempDir()
+	dest := filepath.Join(parent, "race-publish")
+	var accepted atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 24; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if receiveV19Quarantined(dest, m, func(s string) error { return v19WriteExact(s, []byte("SAFE")) }) == nil {
+				accepted.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	require.Equal(t, int32(1), accepted.Load(), "only a single atomic no-replace publication allowed")
+	got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, err)
+	require.Equal(t, "SAFE", string(got))
+	entries, err := os.ReadDir(parent)
+	require.NoError(t, err)
+	require.Len(t, entries, 1, "concurrent failures must not strand quarantine directories")
+	require.Equal(t, "race-publish", entries[0].Name())
+}
