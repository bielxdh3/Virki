+	t.Helper()
+	exporter, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "v9.example/test:image"})
+	require.NoError(t, err)
+	mgr, err := localcontext.NewManager(v9OwnerSessionService{}, false)
+	require.NoError(t, err)
+	ctx, scope, err := mgr.BeginSolve(t.Context(), localcontext.Binding{
+		JobID: "job-v9", Role: "runtime", Nonce: strings.Repeat("c", 32),
+		ApprovalID: "approval-v9", ApprovalEnvelope: "b3duZXItc2lnbmVkLWVudmVsb3BlLWZpeHR1cmU=", Exporter: exporter,
+	})
+	require.NoError(t, err)
+	require.NotNil(t, scope)
+	h := &localSourceHandler{
+		localSource: &localSource{consumptionObserver: mgr, requireConsumptionObserver: false},
+		src: LocalIdentifier{
+			Name: "context", SharedKeyHint: "context", SessionID: "session-approved-v9",
+			Differ: fsutil.DiffMetadata, ExcludePatterns: []string{"node_modules"},
+			rawAttributesV9: map[string]string{
+				pb.AttrLocalSessionID:  "session-approved-v9",
+				pb.AttrSharedKeyHint:   "context",
+				pb.AttrExcludePatterns: `["node_modules"]`,
+			},
+		},
+	}
+	return ctx, mgr, h
+}
+
+func TestC1V9MainContextCanonicalAliasPreservesPhysicalSourceAndOwnerSession(t *testing.T) {
+	ctx, mgr, source := v9ScopedSource(t)
+	canonical, err := source.canonicalOwnerContextNameV9(ctx)
+	require.NoError(t, err)
+	require.Equal(t, "source", canonical)
+	require.Equal(t, "context", source.src.Name, "must not rewrite actual local source")
+	key, _, _, _, err := source.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.NoError(t, err)
+	require.Contains(t, key, "session:context:", "must retain real cache source identity")
+
+	// A final immutable snapshot is recorded as canonical source only AFTER
+	// physical raw-context FileSync and remeasurement. This synthetic sample
+	// deliberately does not represent a real FileSync or native owner signer.
+	record := localcontext.Consumption{
+		Name: canonical, WorkerID: "worker-v7", SessionID: "session-approved-v9",
+		VertexDigest: "sha256:" + strings.Repeat("1", 64), VertexOutputIndex: 0,
+		SnapshotID: "immutable-v9", TreeDigestSchema: localcontext.BuildKitContextTreeDigestSchema,
+		TreeDigest: "sha256:" + strings.Repeat("a", 64), EntryCount: 2, RegularFileBytes: 10,
+	}
+	require.NoError(t, mgr.ContextConsumed(ctx, record))
+	// Duplicate protection fires before the session check. Use a NEW
+	// independently reserved scope for the negative effective-session case.
+	record.SessionID = "foreign-worker-session"
+	otherCtx, otherManager, _ := v9ScopedSource(t)
+	require.ErrorContains(t, otherManager.ContextConsumed(otherCtx, record), "worker consumed a session other than")
+}
+
+func TestC1V9MainAuxiliaryAndArbitraryLocalSourcesFailBeforeFileSync(t *testing.T) {
+	ctx, _, source := v9ScopedSource(t)
+	badCases := []struct {
+		name   string
+		mutate func(*LocalIdentifier)
+	}{
+		{"auxiliary ignore probe", func(id *LocalIdentifier) {
+			id.SharedKeyHint = "context-.dockerignore"
+			id.FollowPaths = []string{".dockerignore"}
+			id.Differ = fsutil.DiffNone
+		}},
+		{"same session but auxiliary key", func(id *LocalIdentifier) { id.SharedKeyHint = "context-.dockerignore" }},
+		{"same session but filtered file", func(id *LocalIdentifier) { id.FollowPaths = []string{".dockerignore"} }},
+		{"local include pattern", func(id *LocalIdentifier) { id.IncludePatterns = []string{"only-allowed"} }},
+		{"metadata-only", func(id *LocalIdentifier) { id.MetadataOnly = true }},
+		{"metadata exception", func(id *LocalIdentifier) { id.MetadataExceptions = []string{"Dockerfile"} }},
+		{"custom diff mode", func(id *LocalIdentifier) { id.Differ = fsutil.DiffNone }},
+		{"raw context wrong source cache key", func(id *LocalIdentifier) { id.SharedKeyHint = "source" }},
+		{"foreign session", func(id *LocalIdentifier) { id.SessionID = "session-foreign" }},
+		{"no session", func(id *LocalIdentifier) { id.SessionID = "" }},
+		{"prefixed session masquerade", func(id *LocalIdentifier) { id.SessionID = "prefix:session-approved-v9" }},
+		{"unexpected local source", func(id *LocalIdentifier) { id.Name = "context-attacker" }},
+		{"raw attr unexpected even if parsed ignored", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrLocalUniqueID] = "attacker" }},
+		{"empty followpaths attr must not disappear", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrFollowPaths] = "[]" }},
+		{"nil followpaths attr must not disappear", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrFollowPaths] = "null" }},
+		{"loaded unknown attr", func(id *LocalIdentifier) { id.rawAttributesV9["custom.owner-claim"] = "ok" }},
+		{"loaded exclude mismatches parsed paths", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrExcludePatterns] = `["secret"]` }},
+		{"loaded session different from typed session", func(id *LocalIdentifier) { id.rawAttributesV9[pb.AttrLocalSessionID] = "session-foreign" }},
+		{"loaded attrs absent", func(id *LocalIdentifier) { id.rawAttributesV9 = nil }},
+	}
+	for _, tc := range badCases {
+		t.Run(tc.name, func(t *testing.T) {
+			broken := *source
+			id := source.src
+			id.rawAttributesV9 = map[string]string{}
+			for key, value := range source.src.rawAttributesV9 {
+				id.rawAttributesV9[key] = value
+			}
+			tc.mutate(&id)
+			broken.src = id
+			_, err := broken.canonicalOwnerContextNameV9(ctx)
+			require.Error(t, err)
+			_, _, _, _, err = broken.CacheKey(ctx, v7SessionJobContext{}, 0)
+			require.Error(t, err, "bad context must not get a cache key")
+			ref, err := broken.Snapshot(ctx, v7SessionJobContext{})
+			require.Nil(t, ref)
+			require.Error(t, err, "bad context must fail before source session lookup")
+			// Direct inner snapshot rejects before caller.SharedKey or worker
+			// allocation. This is only a no-transfer negative fixture.
+			ref, err = broken.snapshot(ctx, "session-approved-v9", nil)
+			require.Nil(t, ref)
+			require.Error(t, err, "bad source must fail before inner FileSync")
+		})
+	}
+	// Existing canonical raw LLB naming still works without implied approval.
+	raw := *source
+	raw.src = LocalIdentifier{Name: "source", SessionID: "session-approved-v9"}
+	canonical, err := raw.canonicalOwnerContextNameV9(ctx)
+	require.NoError(t, err)
+	require.Equal(t, "source", canonical)
+
+	// Ordinary unscoped optional mode keeps upstream auxiliary behavior.
+	probe := *source
+	probe.src.SharedKeyHint = "context-.dockerignore"
+	probe.src.FollowPaths = []string{".dockerignore"}
+	canonical, err = probe.canonicalOwnerContextNameV9(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, "context", canonical)
+}
+
+func TestC1V9OwnerPinnedSessionCannotBeInferredFromFrontendOptions(t *testing.T) {
+	ctx, manager := v8OptionalOwnerWithManager(t)
+	probe := &localSourceHandler{
+		localSource: &localSource{consumptionObserver: manager},
+		src: LocalIdentifier{Name: "context", SessionID: "session-approved-v9", SharedKeyHint: "context",
+			rawAttributesV9: map[string]string{
+				pb.AttrLocalSessionID: "session-approved-v9", pb.AttrSharedKeyHint: "context",
+			},
+		},
+	}
+	_, err := probe.canonicalOwnerContextNameV9(ctx)
+	require.ErrorContains(t, err, "not independently pinned")
+	_, _, _, _, err = probe.CacheKey(ctx, v7SessionJobContext{}, 0)
+	require.Error(t, err)
+	ref, err := probe.Snapshot(ctx, v7SessionJobContext{})
+	require.Nil(t, ref)
+	require.Error(t, err)
+}
+
+func TestC1V9DirectInnerSnapshotCannotBypassOwnerObserverPreflight(t *testing.T) {
+	ctx, _, source := v9ScopedSource(t)
+	wrongRef, wrongErr := source.snapshot(ctx, "foreign-worker-session", nil)
+	require.Nil(t, wrongRef)
+	require.ErrorContains(t, wrongErr, "FileSync session differs")
+	for _, tc := range []struct {
+		name     string
+		observer localcontext.ContextObserver
+	}{
+		{"missing observer", nil},
+		{"noop observer", v8NoopObserver{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			candidate := *source
+			candidate.localSource = &localSource{consumptionObserver: tc.observer}
+			ref, err := candidate.snapshot(ctx, "session-approved-v9", nil)
+			require.Nil(t, ref)
+			require.Error(t, err, "inner snapshot must reject before caller or cache access")
+		})
+	}
+	foreign, err := localcontext.NewManager(v9OwnerSessionService{}, false)
+	require.NoError(t, err)
+	candidate := *source
+	candidate.localSource = &localSource{consumptionObserver: foreign}
+	ref, err := candidate.snapshot(ctx, "session-approved-v9", nil)
+	require.Nil(t, ref)
+	require.ErrorContains(t, err, "does not match owner-reserved")
+}
+
+func TestC1V9ActualWorkerLocalIdentifierRetainsAdversarialRawAttributePresence(t *testing.T) {
+	ctx, mgr, _ := v9ScopedSource(t)
+	base := map[string]string{
+		pb.AttrLocalSessionID:  "session-approved-v9",
+		pb.AttrSharedKeyHint:   "context",
+		pb.AttrExcludePatterns: `["node_modules"]`,
+	}
+	for _, tc := range []struct {
+		name                 string
+		extraKey, extraValue string
+		accepted             bool
+	}{
+		{"default main attrs", "", "", true},
+		{"explicit empty followpaths", pb.AttrFollowPaths, "[]", false},
+		{"explicit null followpaths", pb.AttrFollowPaths, "null", false},
+		{"implicit new source alias", pb.AttrLocalUniqueID, "client-generated", false},
+		{"unknown attr", "local.experimental", "anything", false},
+		{"explicit metadata mode", pb.AttrLocalDiffer, pb.AttrLocalDifferMetadata, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			attrs := map[string]string{}
+			for k, v := range base {
+				attrs[k] = v
+			}
+			if tc.extraKey != "" {
+				attrs[tc.extraKey] = tc.extraValue
+			}
+			identifier, err := (&localSource{}).Identifier("local", "context", attrs, nil)
+			require.NoError(t, err)
+			local, ok := identifier.(*LocalIdentifier)
+			require.True(t, ok)
+			// Source.Identifier genuinely unmarshals [] and null to length zero.
+			// The newer raw attribute map must survive this information loss.
+			h := &localSourceHandler{
+				localSource: &localSource{consumptionObserver: mgr},
+				src:         *local,
+			}
+			name, err := h.canonicalOwnerContextNameV9(ctx)
+			if tc.accepted {
+				require.NoError(t, err)
+				require.Equal(t, "source", name)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
