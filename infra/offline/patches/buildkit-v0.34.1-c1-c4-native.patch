+	}
+	for name, mutate := range map[string]func(*FrontendCaptureV4){
+		"specific read never happened":   func(c *FrontendCaptureV4) { c.SpecificIgnoreObserved = false },
+		"main read never happened":       func(c *FrontendCaptureV4) { c.MainIgnoreObserved = false },
+		"specific file actually present": func(c *FrontendCaptureV4) { c.SpecificIgnorePresent = true },
+		"main file actually present":     func(c *FrontendCaptureV4) { c.MainIgnorePresent = true },
+		"wrong specific path":            func(c *FrontendCaptureV4) { c.SpecificIgnorePath = "dockerfile.dockerignore" },
+		"wrong main path":                func(c *FrontendCaptureV4) { c.MainIgnorePath = "Dockerfile.dockerignore" },
+		"specific file bytes claimed":    func(c *FrontendCaptureV4) { c.SpecificIgnoreSHA = SHA256BytesV4([]byte("forged")) },
+		"main file bytes claimed":        func(c *FrontendCaptureV4) { c.MainIgnoreSHA = SHA256BytesV4([]byte("forged")) },
+	} {
+		t.Run(name, func(t *testing.T) { bad := capture; mutate(&bad); requireMissing(t, bad) })
