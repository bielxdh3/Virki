+func testOutput(scope *SolveScope) Output {
+	rootDigest := "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
+	root := CausalRoot{WorkerID: testWorker, RefID: "image-ref-c1-test", VertexDigest: rootDigest, OutputIndex: 0}
+	for i, name := range RequiredContextNames() {
+		record, ok := scope.records[name]
+		if !ok {
+			continue
+		}
+		root.ContextPaths = append(root.ContextPaths, ContextPath{
+			Name: name, Generation: record.Generation, ContextIdentity: record.ContextIdentity,
+			SnapshotID: record.SnapshotID, TreeDigest: record.TreeDigest,
+			SourceVertexDigest: record.VertexDigest, SourceOutputIndex: record.VertexOutputIndex,
+			Edges: []CausalEdge{{
+				ParentVertexDigest: rootDigest, ParentOutputIndex: 0, ParentInputIndex: i,
+				ChildVertexDigest: record.VertexDigest, ChildOutputIndex: record.VertexOutputIndex,
+			}},
+		})
+	}
+	proof := CausalityProof{SchemaVersion: 3, Exporter: scope.auth.ExporterPolicy, Roots: []CausalRoot{root}}
+	proof.ProofDigest, _ = CausalityProofDigest(proof)
+	return Output{WorkerID: testWorker, Image: scope.auth.ExpectedImage, Causality: proof}
+}
