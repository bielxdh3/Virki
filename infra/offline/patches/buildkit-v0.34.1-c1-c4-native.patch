+		pb.AttrSharedKeyHint:  "context-.dockerignore",
+		pb.AttrFollowPaths:    `[".dockerignore"]`,
+		pb.AttrLocalDiffer:    pb.AttrLocalDifferNone,
+	}
+	src := &localSource{}
+	idValue, err := src.Identifier("local", "context", attrs, nil)
+	require.NoError(t, err)
+	id := idValue.(*LocalIdentifier)
+	resolved, err := src.Resolve(t.Context(), id, nil, nil)
+	require.NoError(t, err)
+	handler, ok := resolved.(*localSourceHandler)
+	require.True(t, ok)
+	id.SessionID = "session-attacker"
+	id.FollowPaths[0] = "secret"
+	id.rawAttributesV9[pb.AttrLocalSessionID] = "session-attacker"
