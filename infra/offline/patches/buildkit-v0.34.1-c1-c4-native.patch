+// BuiltinLoadedRefV6 reads the ACTUAL loaded solver edge and immutable
+// WorkerRef of this concrete forwarder ref. Unlike frontend metadata or raw
+// Definition.Head(), neither field is copied from a request attribute.
+// The result is still not physical owner attestation or signed provenance.
+func (r *ref) BuiltinLoadedRefV6(ctx context.Context) (localcontext.BuiltinLoadedRefV6, error) {
+	if r == nil || r.resultProxy == nil {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 forwarder result reference is missing")
+	}
+	res, err := r.resultProxy.Result(ctx)
+	if err != nil {
+		return localcontext.BuiltinLoadedRefV6{}, r.c.wrapSolveError(err)
+	}
+	if res == nil {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 loaded result returned nil")
+	}
+	workerRef, ok := res.Sys().(*worker.WorkerRef)
+	if !ok || workerRef == nil || workerRef.Worker == nil || workerRef.ImmutableRef == nil {
+		return localcontext.BuiltinLoadedRefV6{}, errors.Errorf("C1 V6 invalid worker immutable result: %T", res.Sys())
+	}
+	rooted, ok := r.resultProxy.(solver.RootedResultProxy)
+	if !ok {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 result proxy has no loaded RootEdge interface")
+	}
+	root, ok := rooted.RootEdge()
+	if !ok || root.Vertex == nil || root.Index < 0 {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 result has no loaded solver RootEdge")
+	}
+	if res.ID() != workerRef.ID() {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 loaded result identity differs from immutable worker ref")
+	}
+	sourceID := ""
+	sessionID, followPaths, sharedKeyHint, differ := "", "", "", ""
+	includePatterns, excludePatterns, metadataTransfer, metadataTransferExclude := "", "", "", ""
+	if op, ok := root.Vertex.Sys().(*opspb.Op); ok && op.GetSource() != nil {
+		sourceID = op.GetSource().Identifier
+		attrs := op.GetSource().Attrs
+		sessionID = attrs[opspb.AttrLocalSessionID]
+		followPaths = attrs[opspb.AttrFollowPaths]
+		sharedKeyHint = attrs[opspb.AttrSharedKeyHint]
+		differ = attrs[opspb.AttrLocalDiffer]
+		includePatterns = attrs[opspb.AttrIncludePatterns]
+		excludePatterns = attrs[opspb.AttrExcludePatterns]
+		metadataTransfer = attrs[opspb.AttrMetadataTransfer]
+		metadataTransferExclude = attrs[opspb.AttrMetadataTransferExclude]
+	}
+	return localcontext.BuiltinLoadedRefV6{
+		WorkerID: workerRef.Worker.ID(), RefID: workerRef.ImmutableRef.ID(),
+		RootVertex: root.Vertex.Digest().String(), OutputIndex: int(root.Index),
+		SourceIdentifier: sourceID,
+		SourceSessionID:  sessionID, SourceFollowPaths: followPaths,
+		SourceSharedKeyHint: sharedKeyHint, SourceDiffer: differ,
+		SourceIncludePatterns: includePatterns, SourceExcludePatterns: excludePatterns,
+		SourceMetadataTransfer: metadataTransfer, SourceMetadataTransferExclude: metadataTransferExclude,
+	}, nil
+}
+
+func (r *ref) BuiltinLoadedDefinitionV6(ctx context.Context, expected *opspb.Definition) (localcontext.BuiltinLoadedRefV6, error) {
+	if r == nil || r.resultProxy == nil || expected == nil {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 absent actual definition-bound forwarder result")
+	}
+	actual := r.resultProxy.Definition()
+	if actual == nil || !actual.EqualVT(expected) {
+		return localcontext.BuiltinLoadedRefV6{}, errors.New("C1 V6 loaded result proxy definition differs from Dockerfile2LLB output")
+	}
+	return r.BuiltinLoadedRefV6(ctx)
+}
+
 func (r *ref) acquireResultProxy() solver.ResultProxy {
 	s1, s2 := solver.SplitResultProxy(r.resultProxy)
 	r.resultProxy = s1
