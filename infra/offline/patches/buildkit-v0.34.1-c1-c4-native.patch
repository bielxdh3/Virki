+//go:build !linux
+
+package filesync
+
+import (
+	"context"
+	"errors"
+)
+
+// Non-Linux kernels (including Windows junctions/reparse points) are DENIED.
+// They require their own handle-based proof; POSIX behavior is not assumed.
+func NewLinuxSealedSnapshotV15(_ context.Context, _ V15SnapshotRequest) (*V15SealedSnapshot, error) {
+	return nil, errors.New("C1 V15 secure openat2 snapshot is Linux-only; Windows/non-Linux denied")
