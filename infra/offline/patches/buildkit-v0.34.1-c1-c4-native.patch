--- /dev/null
+++ b/session/filesync/sealed_guard_v15.go
@@ -0,0 +1,159 @@
+package filesync
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"hash"
+	"os"
+	"path"
+	"slices"
+	"strings"
+	"sync"
+
+	"github.com/tonistiigi/fsutil/types"
+	"google.golang.org/grpc"
+)
+
+// v15PacketGuard validates source STAT shape and DATA hash/bytes BEFORE
+// forwarding each packet to the existing fsutil.Receive disk writer. This
+// is a DEV-only defense; packet filter alone does not grant independent
+// sender authenticity or prevent a malicious remote agent from disclosing
+// unapproved bytes to the worker's network stack before it can reject them.
+type v15PacketGuard struct {
+	grpc.ClientStream
+	mu          sync.Mutex
+	expected    []v15ExpectedStat
+	files       map[uint32]*v15PendingFile
+	statCount   uint32
+	endStats    bool
+	finished    bool
+	total       int64
+	maximum     int64
+	senderUID   uint32
+	senderGID   uint32
+	receiverUID uint32
+	receiverGID uint32
+}
+
+type v15ExpectedStat struct {
+	path string
+	mode uint32
+	size int64
+	sha  string
+}
+type v15PendingFile struct {
+	path   string
+	max    int64
+	sum    hash.Hash
+	read   int64
+	closed bool
+	sha    string
+}
+
+// The legacy DEV path retains its same-identity metadata contract.
+func newV15PacketGuard(stream grpc.ClientStream, m V15SealedManifest) *v15PacketGuard {
+	return newV15PacketGuardWithOwner(stream, m, uint32(os.Getuid()), uint32(os.Getgid()))
+}
+
+// The independently supervised DEV path validates the configured sender's
+// exact wire ownership before mapping it to the receiver's own identity.
+// Wire UID/GID values alone are not sender authentication.
+func newV15PacketGuardWithOwner(stream grpc.ClientStream, m V15SealedManifest, senderUID, senderGID uint32) *v15PacketGuard {
+	nodes := make(map[string]v15ExpectedStat)
+	for _, pin := range m.Files {
+		parts := strings.Split(pin.Path, "/")
+		for i := 1; i < len(parts); i++ {
+			p := strings.Join(parts[:i], "/")
+			nodes[p] = v15ExpectedStat{path: p, mode: uint32(os.ModeDir | 0755)}
+		}
+		nodes[pin.Path] = v15ExpectedStat{path: pin.Path, mode: 0644, size: pin.Size, sha: pin.SHA256}
+	}
+	g := &v15PacketGuard{ClientStream: stream, files: make(map[uint32]*v15PendingFile), maximum: m.Bytes,
+		senderUID: senderUID, senderGID: senderGID, receiverUID: uint32(os.Getuid()), receiverGID: uint32(os.Getgid())}
+	for _, node := range nodes {
+		g.expected = append(g.expected, node)
+	}
+	slices.SortFunc(g.expected, func(a, b v15ExpectedStat) int { return strings.Compare(a.path, b.path) })
+	return g
+}
+
+func (g *v15PacketGuard) RecvMsg(dst any) error {
+	if err := g.ClientStream.RecvMsg(dst); err != nil {
+		return err
+	}
+	p, ok := dst.(*types.Packet)
+	if !ok {
+		return errors.New("C1 V15 receiver got unexpected wire object")
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.finished {
+		return errors.New("C1 V15 sender emitted packets after FIN")
+	}
+	switch p.Type {
+	case types.PACKET_STAT:
+		if p.Stat == nil {
+			if g.endStats || int(g.statCount) != len(g.expected) {
+				return errors.New("C1 V15 missing/repeated STAT terminator or unapproved path set")
+			}
+			g.endStats = true
+			return nil
+		}
+		if g.endStats || int(g.statCount) >= len(g.expected) {
+			return errors.New("C1 V15 unexpected extra STAT before file bytes")
+		}
+		want := g.expected[g.statCount]
+		st := p.Stat
+		if st.Path != want.path || path.Clean(st.Path) != st.Path ||
+			st.Mode != want.mode || st.Size != want.size || st.Linkname != "" ||
+			len(st.Xattrs) != 0 || st.Devmajor != 0 || st.Devminor != 0 ||
+			st.Uid != g.senderUID || st.Gid != g.senderGID || st.ModTime != 0 {
+			return fmt.Errorf("C1 V15 unapproved sender STAT path/mode/owner/size: %q", st.Path)
+		}
+		// The disk writer receives only receiver-owned metadata. The sender
+		// ownership was checked above against trusted DEV configuration.
+		st.Uid = g.receiverUID
+		st.Gid = g.receiverGID
+		if want.sha != "" {
+			g.files[g.statCount] = &v15PendingFile{path: want.path, max: want.size, sum: sha256.New(), sha: want.sha}
+		}
+		g.statCount++
+	case types.PACKET_DATA:
+		if !g.endStats {
+			return errors.New("C1 V18 DATA before complete owner-approved STAT manifest")
+		}
+		file, ok := g.files[p.ID]
+		if !ok || file.closed {
+			return errors.New("C1 V15 DATA id was not approved by frozen STAT")
+		}
+		if len(p.Data) == 0 {
+			file.closed = true
+			if file.read != file.max || fmt.Sprintf("sha256:%x", file.sum.Sum(nil)) != file.sha {
+				return fmt.Errorf("C1 V15 DATA digest/size mismatch before commit for %q", file.path)
+			}
+			return nil
+		}
+		file.read += int64(len(p.Data))
+		g.total += int64(len(p.Data))
+		if file.read > file.max || g.total > g.maximum {
+			return errors.New("C1 V15 stream exceeded signed per-file or total byte budget")
+		}
+		_, _ = file.sum.Write(p.Data)
+	case types.PACKET_FIN:
+		if !g.endStats || g.total != g.maximum {
+			return errors.New("C1 V15 premature FIN or missing pinned bytes")
+		}
+		for _, file := range g.files {
+			if !file.closed {
+				return errors.New("C1 V15 incomplete file before FIN")
+			}
+		}
+		g.finished = true
+	case types.PACKET_ERR:
+		return errors.New("C1 V15 sender sent error packet")
+	default:
+		return errors.New("C1 V15 sender emitted unexpected packet type")
+	}
+	return nil
+}
diff --git a/session/filesync/sealed_guard_v15_test.go b/session/filesync/sealed_guard_v15_test.go
