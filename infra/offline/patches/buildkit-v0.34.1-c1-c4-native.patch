+func (f *fakeService) Complete(_ context.Context, completion Completion) error {
+	f.completeCalls++
+	f.completed = completion
+	if f.expectedOutput != (ImageDescriptor{}) && completion.Output.Image != f.expectedOutput {
+		return errors.New("owner policy refused an image descriptor not bound to the approval")
+	}
+	return f.completeErr
+}
