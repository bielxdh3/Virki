+
+// Service is an owner-controlled verifier and replay ledger. A local fixture
+// implementing this interface does not establish installed authority.
+type Service interface {
+	Begin(context.Context, Binding) (Authorization, error)
+	Complete(context.Context, Completion) error
+	Abort(context.Context, string, string) error
+}
+
+// ContextObserver is injected into each local source worker. The observer
+// refuses a missing solve scope whenever policy requires observation.
+type ContextObserver interface {
+	ContextConsumed(context.Context, Consumption) error
+}
+
+// ServiceRequest and ServiceResponse are the bounded local observer transport
+// envelope. The owner service remains responsible for signature and replay
+// verification; the BuildKit client never treats an OK response as authority.
+type ServiceRequest struct {
+	Version            int         `json:"version"`
+	Operation          string      `json:"operation"`
+	Binding            *Binding    `json:"binding,omitempty"`
+	AuthorizationToken string      `json:"authorizationToken,omitempty"`
+	Completion         *Completion `json:"completion,omitempty"`
+	Reason             string      `json:"reason,omitempty"`
+}
+
+type ServiceResponse struct {
+	Version       int            `json:"version"`
+	OK            bool           `json:"ok"`
+	Error         string         `json:"error,omitempty"`
+	Authorization *Authorization `json:"authorization,omitempty"`
+}
+
+// Manager binds local-source callbacks to the BuildKit Solve context.
+type Manager struct {
+	service       Service
+	required      bool
+	lifecycleMu   sync.Mutex
+	pendingMu     sync.Mutex
+	pendingAborts map[*SolveScope]error
+}
+
+type scopeKey struct{}
+
+// OwnerScopedSolveActiveV7 identifies an actual private C1 owner-authorized
+// solve context created by Manager.BeginSolve, even if daemon-wide observer
+// policy is optional. It is a fail-closed mode discriminator, NOT an owner
+// approval token or evidence for receipt signing.
+func OwnerScopedSolveActiveV7(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	return ok && scope != nil && scope.manager != nil
+}
+
+// RequireExactScopedSourceObserverV8 ensures a protected worker source can
+// report immutable FileSync observations ONLY to the same manager that
+// reserved this private owner scope. A noop/wrapper/foreign observer must not
+// pass an existence-only check before transferring local bytes. This method
+// is not a standalone credential or native owner signature.
+func RequireExactScopedSourceObserverV8(ctx context.Context, observer ContextObserver) error {
+	if ctx == nil {
+		return errors.New("C1 V8 protected worker source has no context")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V8 protected worker source has no live owner scope")
+	}
+	manager, ok := observer.(*Manager)
+	if !ok || manager != scope.manager {
+		return errors.New("C1 V8 worker observer does not match owner-reserved scope manager")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V8 owner observation scope has expired or terminated")
+	}
+	return nil
+}
+
+// RequireOwnerPinnedMainSessionV9 is a narrowly scoped pre-FileSync check for
+// the builtin main COPY context's raw local://context -> canonical source
+// mapping. The expected session comes from the owner Service.Begin result
+// retained in the private SolveScope, never from a client-supplied SourceOp.
+// This does not itself authenticate the remote owner's approval or authorize
+// a real Dockerfile frontend; both remain outside this DEV experiment.
+func RequireOwnerPinnedMainSessionV9(ctx context.Context, sessionID string) error {
+	if ctx == nil {
+		return errors.New("C1 V9 main local source has no owner solve context")
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager == nil {
+		return errors.New("C1 V9 main local source has no owner-reserved scope")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if scope.closed || scope.completionAttempted || scope.abortRequested || time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("C1 V9 main context scope has expired or terminated")
+	}
+	expected := scope.auth.ContextSessionIDsV8["source"]
+	if len(scope.auth.ContextSessionIDsV8) != len(requiredContexts) ||
+		expected == "" || !validIdentifier(expected) || strings.Contains(expected, ":") ||
+		sessionID != expected {
+		return errors.New("C1 V9 main context session is not independently pinned by owner service")
+	}
+	return nil
+}
+
+// SolveScope collects each approved local context exactly once and submits a
+// single canonical completion only after the caller reports solve success.
+type SolveScope struct {
+	manager *Manager
+	binding Binding
+	auth    Authorization
+
+	mu                                      sync.Mutex
+	records                                 map[string]Consumption
+	auxiliaryRootIgnoreV10                  *Consumption
+	auxiliaryRootIgnoreReadVerifiedV10      bool
+	auxiliaryRootIgnoreReadAttemptedV11     bool
+	auxiliaryRootIgnoreTransferClaimedV11   bool
+	rootIgnoreExcludesV11                   []string
+	rootIgnoreExcludesBoundV11              bool
+	rootIgnoreMainMatchedV11                bool
+	rootIgnoreMainVertexV11                 string
+	preferredDockerignoreReadAttemptedV12   bool
+	preferredDockerignoreReadStartedV12     bool
+	preferredDockerignoreReadVerifiedV12    bool
+	preferredDockerignoreMissingVerifiedV12 bool
+	preferredDockerignoreProofV12           *PreferredDockerignoreProofV12
+	mainFollowPathsMatchedV13               bool
+	mainLoadedRefVerifiedV13                bool
+	mainFollowPathsDerivedV13               bool
+	mainFollowPathsVertexV13                string
+	closed                                  bool
+	completionAttempted                     bool
+	abortRequested                          bool
+}
+
+// NewManager refuses required operation without an owner-controlled service.
+func NewManager(service Service, required bool) (*Manager, error) {
+	if required && service == nil {
+		return nil, errors.New("required local-context observer service is missing")
+	}
+	return &Manager{
+		service:       service,
+		required:      required,
+		pendingAborts: make(map[*SolveScope]error),
+	}, nil
+}
+
+// BeginSolve obtains a one-use authorization and places its private scope in
+// the derived context used by solver vertices and local-source callbacks.
+func (m *Manager) BeginSolve(ctx context.Context, binding Binding) (context.Context, *SolveScope, error) {
+	if m == nil || m.service == nil {
+		if m != nil && m.required {
+			return nil, nil, errors.New("required local-context observer service is missing")
+		}
+		return ctx, nil, nil
+	}
+	if err := validateBinding(binding); err != nil {
+		return nil, nil, err
+	}
+	m.lifecycleMu.Lock()
+	defer m.lifecycleMu.Unlock()
+	if err := m.retryPendingAborts(ctx); err != nil {
+		return nil, nil, fmt.Errorf("unresolved owner local-context abort blocks new solve authorization: %w", err)
+	}
+	auth, err := m.service.Begin(ctx, binding)
+	if err != nil {
+		return nil, nil, fmt.Errorf("owner local-context authorization refused: %w", err)
+	}
+	if err := validateAuthorization(auth); err != nil {
+		return nil, nil, fmt.Errorf("owner local-context authorization is incomplete: %w", err)
+	}
+	if auth.Generation != binding.Nonce {
+		return nil, nil, errors.New("owner local-context authorization generation does not match the one-use solve nonce")
+	}
+	if auth.ExporterPolicy != binding.Exporter {
+		return nil, nil, errors.New("owner local-context exporter policy does not match the requested exporter")
+	}
+	// Freeze service-owned maps before they become per-solve authority. A
+	// simulated/in-process service may retain mutable map references; changing
+	// them after BeginSolve must not rewrite the already reserved generation.
+	auth.ContextIdentities = maps.Clone(auth.ContextIdentities)
+	auth.ContextTreeDigests = maps.Clone(auth.ContextTreeDigests)
+	auth.ContextSessionIDsV8 = maps.Clone(auth.ContextSessionIDsV8)
+	auth.MainFollowPathsV13 = slices.Clone(auth.MainFollowPathsV13)
+	if auth.RootDockerignoreV10 != nil {
+		approvedCopy := *auth.RootDockerignoreV10
+		auth.RootDockerignoreV10 = &approvedCopy
+	}
+	if auth.PreferredDockerignoreV12 != nil {
+		approvedCopy := *auth.PreferredDockerignoreV12
+		auth.PreferredDockerignoreV12 = &approvedCopy
+	}
+	scope := &SolveScope{
+		manager: m,
+		binding: binding,
+		auth:    auth,
+		records: make(map[string]Consumption, len(requiredContexts)),
+	}
+	return context.WithValue(ctx, scopeKey{}, scope), scope, nil
+}
+
+func (m *Manager) retryPendingAborts(ctx context.Context) error {
+	type pendingAbort struct {
+		scope *SolveScope
+		cause error
+	}
+	m.pendingMu.Lock()
+	pending := make([]pendingAbort, 0, len(m.pendingAborts))
+	for scope, cause := range m.pendingAborts {
+		pending = append(pending, pendingAbort{scope: scope, cause: cause})
+	}
+	m.pendingMu.Unlock()
+
+	var retryErrors []error
+	for _, item := range pending {
+		baseCtx := context.WithValue(context.WithoutCancel(ctx), scopeKey{}, item.scope)
+		abortCtx, cancel := context.WithTimeout(baseCtx, 5*time.Second)
+		err := item.scope.abort(abortCtx, item.cause)
+		cancel()
+		if err != nil {
+			retryErrors = append(retryErrors, err)
+		}
+	}
+	return errors.Join(retryErrors...)
+}
+
+func (m *Manager) rememberPendingAbort(scope *SolveScope, cause error) {
+	m.pendingMu.Lock()
+	m.pendingAborts[scope] = cause
+	m.pendingMu.Unlock()
+}
+
+func (m *Manager) forgetPendingAbort(scope *SolveScope) {
+	m.pendingMu.Lock()
+	delete(m.pendingAborts, scope)
+	m.pendingMu.Unlock()
+}
+
+// ContextConsumed records only worker observations associated with the active
+// solve scope. The owner service supplies the authenticated context identity.
+func (m *Manager) ContextConsumed(ctx context.Context, record Consumption) error {
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil {
+		if m != nil && m.required {
+			return errors.New("local-context observation has no authorized solve scope")
+		}
+		return nil
+	}
+	if scope.manager != m {
+		return errors.New("local-context observation belongs to another observer")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if time.Now().After(scope.auth.ExpiresAt) {
+		return errors.New("owner local-context authorization expired during solve")
+	}
+	if scope.closed {
+		return errors.New("local-context solve scope is already closed")
+	}
+	if scope.completionAttempted || scope.abortRequested {
+		return errors.New("local-context solve scope is terminating")
+	}
+	if !isRequiredContext(record.Name) {
+		return fmt.Errorf("unexpected local context %q", record.Name)
+	}
+	if record.Generation != "" && record.Generation != scope.auth.Generation {
+		return errors.New("local-context observation belongs to a stale authorization generation")
+	}
+	if _, exists := scope.records[record.Name]; exists {
+		return fmt.Errorf("duplicate local context %q", record.Name)
+	}
+	if record.WorkerID != scope.auth.WorkerID {
+		return errors.New("local-context worker identity does not match owner authorization")
+	}
+	if !validIdentifier(record.SessionID) || !sha256Pattern.MatchString(record.VertexDigest) ||
+		!validIdentifier(record.SnapshotID) || record.TreeDigestSchema != scope.auth.ContextTreeDigestSchema ||
+		!sha256Pattern.MatchString(record.TreeDigest) ||
+		record.VertexOutputIndex < 0 || record.RegularFileBytes < 0 || record.EntryCount < 1 {
+		return fmt.Errorf("incomplete local-context observation for %q", record.Name)
+	}
+	if scope.auth.ContextSessionIDsV8 != nil && scope.auth.ContextSessionIDsV8[record.Name] != record.SessionID {
+		return fmt.Errorf("worker consumed a session other than the owner-approved V8 source session for %q", record.Name)
+	}
+	record.ContextIdentity = scope.auth.ContextIdentities[record.Name]
+	if record.ContextIdentity == "" {
+		return fmt.Errorf("owner authorization has no identity for local context %q", record.Name)
+	}
+	if record.TreeDigest != scope.auth.ContextTreeDigests[record.Name] {
+		return fmt.Errorf("worker local-context tree digest does not match owner approval for %q", record.Name)
+	}
+	record.Generation = scope.auth.Generation
+	scope.records[record.Name] = record
+	return nil
+}
+
+// CausalInputs returns an immutable, canonical snapshot of the current owner
+// generation, exporter policy, and four observed contexts for the solver.
+func (s *SolveScope) CausalInputs() (string, ExporterIntent, []Consumption, error) {
+	if s == nil || s.manager == nil {
+		return "", ExporterIntent{}, nil, errors.New("local-context solve scope is unavailable")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.completionAttempted || s.abortRequested {
+		return "", ExporterIntent{}, nil, errors.New("local-context solve scope is terminating")
+	}
+	if time.Now().After(s.auth.ExpiresAt) {
+		return "", ExporterIntent{}, nil, errors.New("owner local-context authorization expired during solve")
+	}
+	if len(s.records) != len(requiredContexts) {
+		return "", ExporterIntent{}, nil, errors.New("local-context causal proof is missing one or more approved contexts")
+	}
+	contexts := make([]Consumption, 0, len(requiredContexts))
+	for _, name := range requiredContexts {
+		record, ok := s.records[name]
+		if !ok {
+			return "", ExporterIntent{}, nil, fmt.Errorf("local-context causal proof is missing approved context %q", name)
+		}
+		contexts = append(contexts, record)
+	}
+	return s.auth.WorkerID, s.auth.ExporterPolicy, contexts, nil
+}
+
+// ExporterPolicy returns the current scope's worker and exact approved
+// exporter intent before graph evaluation starts.
+func (s *SolveScope) ExporterPolicy() (string, ExporterIntent, error) {
+	if s == nil || s.manager == nil {
+		return "", ExporterIntent{}, errors.New("local-context solve scope is unavailable")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.completionAttempted || s.abortRequested {
+		return "", ExporterIntent{}, errors.New("local-context solve scope is terminating")
+	}
+	if time.Now().After(s.auth.ExpiresAt) {
+		return "", ExporterIntent{}, errors.New("owner local-context authorization expired during solve")
+	}
+	return s.auth.WorkerID, s.auth.ExporterPolicy, nil
+}
+
+// Complete sends the canonically ordered four-context set and output digest to
+// the owner service. The service must independently bind the digest to policy.
+func (s *SolveScope) Complete(ctx context.Context, output Output) error {
+	if s == nil || s.manager == nil || s.manager.service == nil {
+		return errors.New("local-context solve scope is unavailable")
+	}
+	s.manager.lifecycleMu.Lock()
+	defer s.manager.lifecycleMu.Unlock()
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return errors.New("local-context solve scope is already closed")
+	}
+	if s.completionAttempted {
+		s.mu.Unlock()
+		return errors.New("local-context completion was already attempted")
+	}
+	if s.abortRequested {
+		s.mu.Unlock()
+		return errors.New("local-context solve scope is aborting")
+	}
+	if bound, ok := ctx.Value(scopeKey{}).(*SolveScope); !ok || bound != s {
+		s.mu.Unlock()
+		return errors.New("local-context completion belongs to another solve scope")
+	}
+	if time.Now().After(s.auth.ExpiresAt) {
+		s.mu.Unlock()
+		return errors.New("owner local-context authorization expired before output completion")
+	}
+	if output.WorkerID != s.auth.WorkerID {
+		s.mu.Unlock()
+		return errors.New("successful role output belongs to another worker")
+	}
+	if len(s.records) != len(requiredContexts) {
+		s.mu.Unlock()
+		return errors.New("successful role output is missing one or more approved local contexts")
+	}
+	if s.auth.RootDockerignoreV10 != nil &&
+		(s.auxiliaryRootIgnoreV10 == nil || !s.auxiliaryRootIgnoreReadVerifiedV10) {
+		s.mu.Unlock()
+		return errors.New("C1 V10 owner-approved root ignore worker/read evidence is incomplete")
+	}
+	if s.auth.BindRootIgnoreExcludesV11 && (!s.rootIgnoreExcludesBoundV11 || !s.rootIgnoreMainMatchedV11 ||
+		!sha256Pattern.MatchString(s.rootIgnoreMainVertexV11)) {
+		s.mu.Unlock()
+		return errors.New("C1 V11 owner-requested root ignore to main COPY excludes lineage is incomplete")
+	}
+	if s.auth.PreferredDockerignoreV12 != nil && (!s.preferredDockerignoreReadVerifiedV12 ||
+		s.preferredDockerignoreProofV12 == nil || s.auxiliaryRootIgnoreV10 != nil) {
+		s.mu.Unlock()
+		return errors.New("C1 V12 preferred Dockerfile ignore read/worker proof is incomplete")
+	}
+	if s.auth.RequirePreferredMissingV12 && (!s.preferredDockerignoreMissingVerifiedV12 ||
+		s.preferredDockerignoreProofV12 == nil || s.preferredDockerignoreProofV12.Present) {
+		s.mu.Unlock()
+		return errors.New("C1 V12 selected root ignore lacks verified canonical preferred ENOENT")
+	}
+	if len(s.auth.MainFollowPathsV13) != 0 && (!s.mainFollowPathsMatchedV13 || !s.mainLoadedRefVerifiedV13 ||
+		!sha256Pattern.MatchString(s.mainFollowPathsVertexV13)) {
+		s.mu.Unlock()
+		return errors.New("C1 V13 owner-selected FollowPaths missing verified committed main source")
+	}
+	contexts := make([]Consumption, 0, len(requiredContexts))
+	for _, name := range requiredContexts {
+		record, ok := s.records[name]
+		if !ok {
+			s.mu.Unlock()
+			return fmt.Errorf("successful role output is missing approved local context %q", name)
+		}
+		contexts = append(contexts, record)
+	}
+	if output.Image != s.auth.ExpectedImage {
+		s.mu.Unlock()
+		return errors.New("actual image descriptor does not match the owner-authorized output")
+	}
+	if err := validateCausalityProof(output.Causality, s.auth.ExporterPolicy, s.auth.WorkerID, s.records); err != nil {
+		s.mu.Unlock()
+		return fmt.Errorf("BuildKit export causality proof refused: %w", err)
+	}
+	for i, name := range requiredContexts {
+		if contexts[i].Name != name {
+			s.mu.Unlock()
+			return errors.New("local-context observations are not in canonical protocol order")
+		}
+	}
+	schemaVersion := 2
+	var excludesProofV11 *RootIgnoreExcludesProofV11
+	if s.auth.RootDockerignoreV10 != nil {
+		// A legacy owner that understands only completion v2 must reject this
+		// new auxiliary sidecar rather than silently treating it as approved.
+		schemaVersion = 10
+	}
+	if s.auth.BindRootIgnoreExcludesV11 {
+		if s.records["source"].VertexDigest != s.rootIgnoreMainVertexV11 {
+			s.mu.Unlock()
+			return errors.New("C1 V11 main source record vertex differs from verified exclusions")
+		}
+		schemaVersion = 11 // A schema-10 C4 owner must NOT silently accept V11.
+		contentSHA := ""
+		if s.auth.RootDockerignoreV10 != nil {
+			contentSHA = s.auth.RootDockerignoreV10.ContentSHA256
+		} else if s.auth.PreferredDockerignoreV12 != nil {
+			contentSHA = s.auth.PreferredDockerignoreV12.ContentSHA256
+		}
+		excludesProofV11 = &RootIgnoreExcludesProofV11{ContentSHA256: contentSHA,
+			PatternsSHA256: HashRootIgnorePatternsV11(s.rootIgnoreExcludesV11), MainVertexDigest: s.rootIgnoreMainVertexV11}
+	}
+	var preferredProofV12 *PreferredDockerignoreProofV12
+	if s.auth.PreferredDockerignoreV12 != nil || s.auth.RequirePreferredMissingV12 {
+		schemaVersion = 12
+		copyPreferred := *s.preferredDockerignoreProofV12
+		preferredProofV12 = &copyPreferred
+	}
+	var followProofV13 *MainFollowPathsProofV13
+	if len(s.auth.MainFollowPathsV13) != 0 {
+		if s.records["source"].VertexDigest != s.mainFollowPathsVertexV13 ||
+			s.mainFollowPathsVertexV13 != s.rootIgnoreMainVertexV11 {
+			s.mu.Unlock()
+			return errors.New("C1 V13 main FollowPaths vertex mismatches excludes or canonical source record")
+		}
+		schemaVersion = 13
+		followProofV13 = &MainFollowPathsProofV13{
+			PathsSHA256:      HashMainFollowPathsV13(s.auth.MainFollowPathsV13),
+			MainVertexDigest: s.mainFollowPathsVertexV13,
+		}
+	}
+	s.completionAttempted = true
+	completion := Completion{SchemaVersion: schemaVersion, Binding: s.binding, Authorization: s.auth, Contexts: contexts, RootDockerignoreV10: s.auxiliaryRootIgnoreV10, RootIgnoreExcludesV11: excludesProofV11, PreferredDockerignoreV12: preferredProofV12, MainFollowPathsV13: followProofV13, Output: output}
+	// A failed response may follow a committed request, so keep the scope locked
+	// through the one-shot call and allow only an abort after an error.
+	if err := s.manager.service.Complete(ctx, completion); err != nil {
+		completionErr := fmt.Errorf("owner local-context completion failed: %w", err)
+		s.manager.rememberPendingAbort(s, completionErr)
+		s.mu.Unlock()
+		return completionErr
+	}
+	s.closed = true
+	s.records = nil
+	s.auxiliaryRootIgnoreV10 = nil
+	s.auxiliaryRootIgnoreReadVerifiedV10 = false
+	s.auxiliaryRootIgnoreReadAttemptedV11 = false
+	s.auxiliaryRootIgnoreTransferClaimedV11 = false
+	s.rootIgnoreExcludesV11 = nil
+	s.rootIgnoreExcludesBoundV11 = false
+	s.rootIgnoreMainMatchedV11 = false
+	s.rootIgnoreMainVertexV11 = ""
+	s.preferredDockerignoreReadAttemptedV12 = false
+	s.preferredDockerignoreReadStartedV12 = false
+	s.preferredDockerignoreReadVerifiedV12 = false
+	s.preferredDockerignoreMissingVerifiedV12 = false
+	s.preferredDockerignoreProofV12 = nil
+	s.mainFollowPathsMatchedV13 = false
+	s.mainLoadedRefVerifiedV13 = false
+	s.mainFollowPathsDerivedV13 = false
+	s.mainFollowPathsVertexV13 = ""
+	s.manager.forgetPendingAbort(s)
+	s.mu.Unlock()
+	return nil
+}
+
+// Abort closes the scope without submitting an output claim.
+func (s *SolveScope) Abort(ctx context.Context, cause error) error {
+	if s == nil || s.manager == nil || s.manager.service == nil {
+		return nil
+	}
+	s.manager.lifecycleMu.Lock()
+	defer s.manager.lifecycleMu.Unlock()
+	return s.abort(ctx, cause)
+}
+
+func (s *SolveScope) abort(ctx context.Context, cause error) error {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return nil
+	}
+	if bound, ok := ctx.Value(scopeKey{}).(*SolveScope); !ok || bound != s {
+		s.mu.Unlock()
+		return errors.New("local-context abort belongs to another solve scope")
+	}
+	s.abortRequested = true
+	token := s.auth.Token
+	if err := s.manager.service.Abort(ctx, token, "solve failed"); err != nil {
+		s.manager.rememberPendingAbort(s, cause)
+		s.mu.Unlock()
+		return fmt.Errorf("owner local-context abort failed: %w", err)
+	}
+	s.closed = true
+	s.records = nil
+	s.auxiliaryRootIgnoreV10 = nil
+	s.auxiliaryRootIgnoreReadVerifiedV10 = false
+	s.auxiliaryRootIgnoreReadAttemptedV11 = false
+	s.auxiliaryRootIgnoreTransferClaimedV11 = false
+	s.rootIgnoreExcludesV11 = nil
+	s.rootIgnoreExcludesBoundV11 = false
+	s.rootIgnoreMainMatchedV11 = false
+	s.rootIgnoreMainVertexV11 = ""
+	s.preferredDockerignoreReadAttemptedV12 = false
+	s.preferredDockerignoreReadStartedV12 = false
+	s.preferredDockerignoreReadVerifiedV12 = false
+	s.preferredDockerignoreMissingVerifiedV12 = false
+	s.preferredDockerignoreProofV12 = nil
+	s.mainFollowPathsMatchedV13 = false
+	s.mainLoadedRefVerifiedV13 = false
+	s.mainFollowPathsDerivedV13 = false
+	s.mainFollowPathsVertexV13 = ""
+	s.manager.forgetPendingAbort(s)
+	s.mu.Unlock()
+	return nil
+}
+
+func validateBinding(binding Binding) error {
+	if !validIdentifier(binding.JobID) || !validIdentifier(binding.ApprovalID) ||
+		(binding.Role != "runtime" && binding.Role != "migrator") || !noncePattern.MatchString(binding.Nonce) {
+		return errors.New("invalid owner-approved local-context solve binding")
+	}
+	if binding.ApprovalEnvelope == "" || len(binding.ApprovalEnvelope) > 48*1024 {
+		return errors.New("owner approval envelope is missing or oversized")
+	}
+	if err := validateExporterIntent(binding.Exporter); err != nil {
+		return fmt.Errorf("invalid owner-approved image exporter intent: %w", err)
+	}
+	decoded, err := base64.StdEncoding.DecodeString(binding.ApprovalEnvelope)
+	if err != nil || len(decoded) == 0 || base64.StdEncoding.EncodeToString(decoded) != binding.ApprovalEnvelope {
+		return errors.New("owner approval envelope is not canonical base64")
+	}
+	return nil
+}
+
+func validateAuthorization(auth Authorization) error {
+	if !validIdentifier(auth.Token) || !validIdentifier(auth.Generation) || !validIdentifier(auth.WorkerID) ||
+		len(auth.ContextIdentities) != len(requiredContexts) || len(auth.ContextTreeDigests) != len(requiredContexts) ||
+		auth.ContextTreeDigestSchema != BuildKitContextTreeDigestSchema {
+		return errors.New("owner service returned an incomplete authorization")
+	}
+	if auth.ExpiresAt.IsZero() || !auth.ExpiresAt.After(time.Now()) {
+		return errors.New("owner service returned a stale authorization")
+	}
+	for _, name := range requiredContexts {
+		identity, ok := auth.ContextIdentities[name]
+		if !ok || !validIdentifier(identity) {
+			return fmt.Errorf("owner service returned no authenticated identity for %q", name)
+		}
+		digest, ok := auth.ContextTreeDigests[name]
+		if !ok || !sha256Pattern.MatchString(digest) {
+			return fmt.Errorf("owner service returned no approved BuildKit tree digest for %q", name)
+		}
+	}
+	for name := range auth.ContextIdentities {
+		if !isRequiredContext(name) {
+			return fmt.Errorf("owner service authorized unexpected context %q", name)
+		}
+	}
+	for name := range auth.ContextTreeDigests {
+		if !isRequiredContext(name) {
+			return fmt.Errorf("owner service approved unexpected context %q", name)
+		}
+	}
+	if auth.ContextSessionIDsV8 != nil {
+		if len(auth.ContextSessionIDsV8) != len(requiredContexts) {
+			return errors.New("owner V8 approved session set is incomplete")
+		}
+		for name, sessionID := range auth.ContextSessionIDsV8 {
+			if !isRequiredContext(name) || !validIdentifier(sessionID) || strings.Contains(sessionID, ":") {
+				return fmt.Errorf("owner V8 approved session is invalid for context %q", name)
+			}
+		}
+	}
+	if auth.RootDockerignoreV10 != nil {
+		aux := auth.RootDockerignoreV10
+		if len(auth.ContextSessionIDsV8) != len(requiredContexts) ||
+			!validIdentifier(aux.SessionID) || strings.Contains(aux.SessionID, ":") ||
+			!validIdentifier(aux.Identity) || !sha256Pattern.MatchString(aux.TreeDigest) ||
+			!sha256Pattern.MatchString(aux.ContentSHA256) {
+			return errors.New("C1 V10 owner root ignore approval lacks a pinned source session, identity or tree digest")
+		}
+	}
+	if auth.BindRootIgnoreExcludesV11 && auth.RootDockerignoreV10 == nil && auth.PreferredDockerignoreV12 == nil {
+		return errors.New("C1 V11 parsed root ignore binding requires separate owner-approved V10 auxiliary snapshot")
+	}
+	if auth.PreferredDockerignoreV12 != nil {
+		preferred := auth.PreferredDockerignoreV12
+		if auth.RootDockerignoreV10 != nil || auth.RequirePreferredMissingV12 || !auth.BindRootIgnoreExcludesV11 ||
+			len(auth.ContextSessionIDsV8) != len(requiredContexts) ||
+			preferred.Path != "Dockerfile.dockerignore" || !sha256Pattern.MatchString(preferred.ContentSHA256) {
+			return errors.New("C1 V12 preferred ignore requires an exclusive canonical Dockerfile policy and parsed-excludes opt-in")
+		}
+	}
+	if auth.RequirePreferredMissingV12 && (auth.RootDockerignoreV10 == nil ||
+		auth.PreferredDockerignoreV12 != nil || !auth.BindRootIgnoreExcludesV11 ||
+		len(auth.ContextSessionIDsV8) != len(requiredContexts)) {
+		return errors.New("C1 V12 strict root fallback requires exclusive owner-approved root probe and canonical sessions")
+	}
+	if auth.MainFollowPathsV13 != nil {
+		if !auth.BindRootIgnoreExcludesV11 ||
+			(auth.PreferredDockerignoreV12 == nil && !auth.RequirePreferredMissingV12) ||
+			len(auth.ContextSessionIDsV8) != len(requiredContexts) {
+			return errors.New("C1 V13 FollowPaths requires a verified V12 selected ignore and owner-pinned main session")
+		}
+		if err := ValidateMainFollowPathsV13(auth.MainFollowPathsV13); err != nil {
+			return err
+		}
+	}
+	if err := validateExporterIntent(auth.ExporterPolicy); err != nil {
+		return fmt.Errorf("owner service returned an invalid exporter policy: %w", err)
+	}
+	if err := validateImageDescriptor(auth.ExpectedImage); err != nil {
+		return fmt.Errorf("owner service returned an invalid expected image descriptor: %w", err)
+	}
+	return nil
+}
+
+// NewExporterIntent creates the canonical C1 policy value from a resolved
+// BuildKit exporter instance.
+func NewExporterIntent(exporterType string, exporterID int, attrs map[string]string) (ExporterIntent, error) {
+	if exporterType != "image" || exporterID != 0 {
+		return ExporterIntent{}, errors.New("C1 requires the single resolved image exporter at index zero")
+	}
+	destination, ok := attrs["name"]
+	if !ok || destination == "" || destination != strings.TrimSpace(destination) || destination == "*" {
+		return ExporterIntent{}, errors.New("C1 image exporter requires one explicit non-wildcard name destination")
+	}
+	return ExporterIntent{
+		SchemaVersion:    2,
+		ID:               exporterID,
+		Type:             exporterType,
+		Destination:      destination,
+		AttributesDigest: ExporterAttributesDigest(attrs),
+	}, nil
+}
+
+// ExporterAttributesDigest hashes every resolved exporter attribute in sorted
+// key order with 32-bit big-endian lengths and a versioned domain prefix.
+func ExporterAttributesDigest(attrs map[string]string) string {
+	keys := make([]string, 0, len(attrs))
+	for key := range attrs {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	h := sha256.New()
+	_, _ = h.Write([]byte("virki-c1-exporter-attrs-v1\x00"))
+	var length [4]byte
+	for _, key := range keys {
+		binary.BigEndian.PutUint32(length[:], uint32(len([]byte(key))))
+		_, _ = h.Write(length[:])
+		_, _ = h.Write([]byte(key))
+		value := attrs[key]
+		binary.BigEndian.PutUint32(length[:], uint32(len([]byte(value))))
+		_, _ = h.Write(length[:])
+		_, _ = h.Write([]byte(value))
+	}
+	return "sha256:" + hex.EncodeToString(h.Sum(nil))
+}
+
+// CausalityProofDigest returns the domain-separated digest for the typed proof
+// object. The owner must still validate each field against its own policy.
+func CausalityProofDigest(proof CausalityProof) (string, error) {
+	proof.ProofDigest = ""
+	encoded, err := json.Marshal(proof)
+	if err != nil {
+		return "", err
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte("virki-c1-export-causality-v3\x00"))
+	_, _ = h.Write(encoded)
+	return "sha256:" + hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func validateExporterIntent(intent ExporterIntent) error {
+	if intent.SchemaVersion != 2 || intent.ID != 0 || intent.Type != "image" ||
+		intent.Destination == "" || intent.Destination != strings.TrimSpace(intent.Destination) || intent.Destination == "*" ||
+		!sha256Pattern.MatchString(intent.AttributesDigest) {
+		return errors.New("unsupported or incomplete C1 exporter intent")
+	}
+	return nil
+}
+
+func validateImageDescriptor(desc ImageDescriptor) error {
+	switch desc.MediaType {
+	case "application/vnd.oci.image.manifest.v1+json", "application/vnd.oci.image.index.v1+json",
+		"application/vnd.docker.distribution.manifest.v2+json", "application/vnd.docker.distribution.manifest.list.v2+json":
+	default:
+		return fmt.Errorf("unsupported image descriptor media type %q", desc.MediaType)
+	}
+	if !sha256Pattern.MatchString(desc.Digest) || desc.Size <= 0 {
+		return errors.New("image descriptor is missing a valid SHA-256 digest or positive size")
+	}
+	return nil
+}
+
+func validateCausalityProof(proof CausalityProof, policy ExporterIntent, workerID string, records map[string]Consumption) error {
+	if proof.SchemaVersion != 3 || proof.Exporter != policy || len(proof.Roots) == 0 {
+		return errors.New("proof version, exporter policy, or image root set is missing")
+	}
+	expectedDigest, err := CausalityProofDigest(proof)
+	if err != nil || proof.ProofDigest != expectedDigest {
+		return errors.New("proof digest does not match the typed causal evidence")
+	}
+	seenRoots := make(map[string]struct{}, len(proof.Roots))
+	var previousRoot *CausalRoot
+	for rootIndex := range proof.Roots {
+		root := proof.Roots[rootIndex]
+		if root.WorkerID != workerID || !validIdentifier(root.RefID) || !sha256Pattern.MatchString(root.VertexDigest) ||
+			root.OutputIndex < 0 || len(root.ContextPaths) != len(requiredContexts) {
+			return errors.New("image root is incomplete or belongs to another worker")
+		}
+		if previousRoot != nil && !causalRootLess(*previousRoot, root) {
+			return errors.New("image roots are not in canonical order")
+		}
+		previousRoot = &proof.Roots[rootIndex]
+		rootKey := fmt.Sprintf("%s\x00%s\x00%s\x00%d", root.WorkerID, root.RefID, root.VertexDigest, root.OutputIndex)
+		if _, exists := seenRoots[rootKey]; exists {
+			return errors.New("exporter returned a duplicate image root")
+		}
+		seenRoots[rootKey] = struct{}{}
+		seenContexts := make(map[string]struct{}, len(requiredContexts))
+		for pathIndex, path := range root.ContextPaths {
+			if path.Name != requiredContexts[pathIndex] {
+				return errors.New("image root context paths are not in canonical order")
+			}
+			record, exists := records[path.Name]
+			if !exists || path.Generation != record.Generation || path.ContextIdentity != record.ContextIdentity ||
+				path.SnapshotID != record.SnapshotID || path.TreeDigest != record.TreeDigest ||
+				path.SourceVertexDigest != record.VertexDigest || path.SourceOutputIndex != record.VertexOutputIndex {
+				return fmt.Errorf("image root has stale or mismatched proof for context %q", path.Name)
+			}
+			if _, duplicate := seenContexts[path.Name]; duplicate {
+				return fmt.Errorf("image root repeats context path %q", path.Name)
+			}
+			seenContexts[path.Name] = struct{}{}
+			parent := root.VertexDigest
+			outputIndex := root.OutputIndex
+			visited := map[string]struct{}{parent: {}}
+			for _, edge := range path.Edges {
+				if edge.ParentVertexDigest != parent || edge.ParentOutputIndex != outputIndex ||
+					edge.ParentInputIndex < 0 || edge.ChildOutputIndex < 0 ||
+					!sha256Pattern.MatchString(edge.ChildVertexDigest) {
+					return fmt.Errorf("context %q path contains a disconnected or invalid solver edge", path.Name)
+				}
+				if _, cycle := visited[edge.ChildVertexDigest]; cycle {
+					return fmt.Errorf("context %q path contains a repeated solver vertex", path.Name)
+				}
+				visited[edge.ChildVertexDigest] = struct{}{}
+				parent = edge.ChildVertexDigest
+				outputIndex = edge.ChildOutputIndex
+			}
+			if parent != path.SourceVertexDigest || outputIndex != path.SourceOutputIndex {
+				return fmt.Errorf("context %q is not connected to the image root at its observed source output", path.Name)
+			}
+		}
+		for _, name := range requiredContexts {
+			if _, ok := seenContexts[name]; !ok {
+				return fmt.Errorf("image root is missing a causal path to approved context %q", name)
+			}
+		}
+	}
+	return nil
+}
+
+func causalRootLess(left, right CausalRoot) bool {
+	if left.RefID != right.RefID {
+		return left.RefID < right.RefID
+	}
+	if left.VertexDigest != right.VertexDigest {
+		return left.VertexDigest < right.VertexDigest
+	}
+	return left.OutputIndex < right.OutputIndex
+}
+
+func validIdentifier(value string) bool {
+	return identifierPattern.MatchString(value) && !strings.ContainsAny(value, "\r\n\x00")
+}
+
+func isRequiredContext(name string) bool {
+	for _, required := range requiredContexts {
+		if name == required {
+			return true
+		}
+	}
+	return false
+}
+
+// OCIDAGProofDigest computes the canonical SHA-256 digest of an OCIDAGProof.
+func OCIDAGProofDigest(dag OCIDAGProof) (string, error) {
+	if dag.SchemaVersion != 1 {
+		return "", errors.New("unsupported OCI DAG proof schema version")
+	}
+	if err := validateImageDescriptor(dag.Root); err != nil {
+		return "", err
+	}
+	if len(dag.Nodes) == 0 {
+		return "", errors.New("OCI DAG proof requires at least one node")
+	}
+	dag.ProofDigest = ""
+	raw, err := json.Marshal(dag)
+	if err != nil {
+		return "", err
+	}
+	h := sha256.New()
+	_, _ = h.Write([]byte("virki-c1-oci-dag-v1\x00"))
+	_, _ = h.Write(raw)
+	return "sha256:" + hex.EncodeToString(h.Sum(nil)), nil
+}
