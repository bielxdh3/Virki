+				if err := m.ContextConsumed(ctx, testConsumption(name)); err != nil {
+					return err
+				}
+			}
+			return nil
+		}},
+		{name: "substituted", mutate: func(m *Manager, ctx context.Context, _ *SolveScope) error {
+			bad := testConsumption("source")
+			bad.Name = "unapproved-context"
+			return m.ContextConsumed(ctx, bad)
+		}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
