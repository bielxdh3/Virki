+	if err := scope.Complete(ctx, testOutput(scope)); err == nil || !strings.Contains(err.Error(), "worker/read evidence is incomplete") {
+		t.Fatalf("missing successful frontend read not required: %v", err)
+	}
+	loaded := BuiltinLoadedRefV6{
