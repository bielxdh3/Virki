+		Token: "dev-v51-test-scope", Generation: manifest.Nonce, WorkerID: manifest.WorkerID,
+		ContextIdentities: identities, ContextTreeDigestSchema: expected.TreeDigestSchema,
+		ContextTreeDigests: treeDigests, ContextSessionIDsV8: sessions,
+		ExporterPolicy: intent, ExpectedImage: localcontext.ImageDescriptor{
+			MediaType: "application/vnd.oci.image.manifest.v1+json",
+			Digest:    "sha256:" + strings.Repeat("b", 64), Size: 100,
+		}, ExpiresAt: time.Now().Add(30 * time.Minute),
+	}
+	manager, err := localcontext.NewManager(&v51DEVScope{auth: auth}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := manager.BeginSolve(context.Background(), localcontext.Binding{
+		JobID: "job-v51-dev", Role: "runtime", Nonce: manifest.Nonce,
+		ApprovalID: "dev-v51-test", ApprovalEnvelope: base64.StdEncoding.EncodeToString([]byte("DEV nonauthorizing fixture")),
+		Exporter: intent,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Start a real distinct-UID sender, with the actual Go test executable
+	// copied into a root-owned executable path and no root keys in the child.
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	input, err := os.Open(self)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer input.Close()
+	helper := filepath.Join(base, "v51-child")
+	output, err := os.OpenFile(helper, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(output, input); err != nil {
+		t.Fatal(err)
+	}
+	if err := output.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(helper, 0555); err != nil {
+		t.Fatal(err)
+	}
+	socket := filepath.Join(base, "v51.sock")
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: socket, Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	if err := v50ArmPasscredBeforeAccept(listener); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(socket, 0, int(uid)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(socket, 0660); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(helper, "-test.run=^TestC1V51RRefusesOptionalManagerWithoutScope$")
+	cmd.Env = append(os.Environ(), "VIRKI_V51_TEST_CHILD=sender", "VIRKI_V51_SOURCE="+source, "VIRKI_V51_SOCKET="+socket)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: uid, Gid: uid, Groups: []uint32{}}}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if cmd.ProcessState == nil {
+			_ = cmd.Process.Kill()
+			_ = cmd.Wait()
+		}
+	})
+	if err := listener.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	conn, err := listener.AcceptUnix()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	record := localcontext.Consumption{
+		Name: "source", WorkerID: manifest.WorkerID, SessionID: manifest.SessionID,
+		VertexDigest: "sha256:" + strings.Repeat("c", 64),
+		SnapshotID:   "snap-v51", VertexOutputIndex: 0,
+	}
+	dest := filepath.Join(protected, "candidate-v51")
+	// A forged V3 worker identity must be refused BEFORE V40 spends the
+	// one-use V15 test permit and before V36 publishes anything.
+	hostileRecord := record
+	hostileRecord.WorkerID = "untrusted-worker"
+	if err := PublishV51DevContextToV3(ctx, manager, ledger, conn, cmd.Process.Pid, uid, uid,
+		dest, manifest, permit, pub, 7, 8, hostileRecord); err == nil ||
+		!strings.Contains(err.Error(), "differs from frozen") {
+		t.Fatalf("V51 must refuse hostile worker before durable permit use: %v", err)
+	}
+	claims, err := os.ReadFile(filepath.Join(ledger, v40LogName))
+	if err != nil || len(claims) != 0 {
+		t.Fatalf("hostile V51 worker burned a V40 permit: len=%d err=%v", len(claims), err)
+	}
+	if _, err := os.Lstat(dest); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("hostile V51 worker published without authority: %v", err)
+	}
+	if err := PublishV51DevContextToV3(context.Background(), manager, ledger, conn, cmd.Process.Pid, uid, uid,
+        dest, manifest, permit, pub, 7, 8, record); err == nil {
+        t.Error("V51R must reject absent V3 scope even with optional Manager")
+    }
+    if err := cmd.Wait(); err != nil { t.Fatal(err) }
+    claims, err = os.ReadFile(filepath.Join(ledger, v40LogName))
+    if err != nil || len(claims) != 0 { t.Errorf("V51R must leave V40 claim ledger unmodified without V3 authorization: bytes=%d err=%v", len(claims), err) }
+    if _, err := os.Lstat(dest); !errors.Is(err, os.ErrNotExist) { t.Errorf("V51R must not publish destination before V3 authorization: %v", err) }
+    if _, _, _, err := scope.CausalInputs(); err == nil { t.Error("V51R optional unscoped attempt was admitted as four-context proof") }
+    _ = expectedStream
+}
