+	cmd.Env = append(os.Environ(), "VIRKI_V51_TEST_CHILD=sender", "VIRKI_V51_SOURCE="+source, "VIRKI_V51_SOCKET="+socket)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: uid, Gid: uid, Groups: []uint32{}}}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if cmd.ProcessState == nil {
+			_ = cmd.Process.Kill()
+			_ = cmd.Wait()
+		}
+	})
+	if err := listener.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	conn, err := listener.AcceptUnix()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	record := localcontext.Consumption{
+		Name: "source", WorkerID: manifest.WorkerID, SessionID: manifest.SessionID,
+		VertexDigest: "sha256:" + strings.Repeat("c", 64),
+		SnapshotID:   "snap-v51", VertexOutputIndex: 0,
+	}
+	dest := filepath.Join(protected, "candidate-v51")
+	// A forged V3 worker identity must be refused BEFORE V40 spends the
+	// one-use V15 test permit and before V36 publishes anything.
+	hostileRecord := record
+	hostileRecord.WorkerID = "untrusted-worker"
+	if err := PublishV51DevContextToV3(ctx, manager, ledger, conn, cmd.Process.Pid, uid, uid,
+		dest, manifest, permit, pub, 7, 8, hostileRecord); err == nil ||
+		!strings.Contains(err.Error(), "differs from frozen") {
+		t.Fatalf("V51 must refuse hostile worker before durable permit use: %v", err)
+	}
+	claims, err := os.ReadFile(filepath.Join(ledger, v40LogName))
+	if err != nil || len(claims) != 0 {
+		t.Fatalf("hostile V51 worker burned a V40 permit: len=%d err=%v", len(claims), err)
+	}
+	if _, err := os.Lstat(dest); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("hostile V51 worker published without authority: %v", err)
+	}
+	if err := PublishV51DevContextToV3(context.Background(), manager, ledger, conn, cmd.Process.Pid, uid, uid,
+        dest, manifest, permit, pub, 7, 8, record); err == nil || !strings.Contains(err.Error(), "no authorized solve scope") {
+        t.Fatalf("expected unauthorized V3 context refusal, got %v", err)
+    }
+    if err := cmd.Wait(); err != nil { t.Fatal(err) }
+    // Security acceptance: an unscoped V3 context must be rejected BEFORE a one-use V40 claim and root publication.
+    claims, err = os.ReadFile(filepath.Join(ledger, v40LogName))
+    if err != nil { t.Fatal(err) }
+    if len(claims) != 0 { t.Errorf("P2: V40 one-time permit irreversibly consumed without any authorized V3 context: %d ledger bytes", len(claims)) }
+    if _, err := os.Stat(dest); err == nil { t.Errorf("P2: root-owned destination was published before V3 authorization was checked") } else if !errors.Is(err, os.ErrNotExist) { t.Fatal(err) }
+    _ = scope
+    _ = expectedStream
+}
diff --git a/util/localcontext/dev_v51_preflight_linux.go b/util/localcontext/dev_v51_preflight_linux.go
new file mode 100644
index 0000000..ef06fb5
--- /dev/null
+++ b/util/localcontext/dev_v51_preflight_linux.go
@@ -0,0 +1,70 @@
+//go:build linux && virki_c1c4_dev
+
+package localcontext
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+)
+
+// DevV51Preflight is a side-effect-free gate for the DEV V51 root publisher.
+// Unlike ContextConsumed, it never permits absent scope for an optional
+// Manager. All checks happen BEFORE the caller spends its durable V40 permit.
+// Only BeginSolve may create the private scope; this does not sign C4 evidence.
+//
+// A concurrent abort/expiry can still invalidate the scope after this return:
+// ContextConsumed MUST independently recheck after the protected copy.
+func (m *Manager) DevV51Preflight(ctx context.Context, manifestNonce string, record Consumption) error {
+	if m == nil || !m.required || m.service == nil {
+		return errors.New("V51R DEV protected publication requires a mandatory owner-scoped Manager")
+	}
+	if ctx == nil {
+		return errors.New("V51R DEV protected publication has no authorized solve context")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	scope, ok := ctx.Value(scopeKey{}).(*SolveScope)
+	if !ok || scope == nil || scope.manager != m {
+		return errors.New("V51R DEV protected publication has no authorized solve scope on this Manager")
+	}
+	scope.mu.Lock()
+	defer scope.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if scope.closed || scope.completionAttempted || scope.abortRequested ||
+		!time.Now().Before(scope.auth.ExpiresAt) {
+		return errors.New("V51R DEV protected publication has expired or terminating owner scope")
+	}
+	if manifestNonce == "" || manifestNonce != scope.auth.Generation ||
+		manifestNonce != scope.binding.Nonce ||
+		(record.Generation != "" && record.Generation != manifestNonce) {
+		return errors.New("V51R DEV protected publication generation differs from approved owner scope")
+	}
+	if !isRequiredContext(record.Name) || record.WorkerID != scope.auth.WorkerID ||
+		!validIdentifier(record.SessionID) {
+		return errors.New("V51R DEV protected publication context, worker or session is not owner approved")
+	}
+	if _, exists := scope.records[record.Name]; exists {
+		return fmt.Errorf("V51R DEV duplicate local context %q before durable claim", record.Name)
+	}
+	if len(scope.auth.ContextSessionIDsV8) != len(requiredContexts) ||
+		scope.auth.ContextSessionIDsV8[record.Name] != record.SessionID ||
+		!validIdentifier(scope.auth.ContextIdentities[record.Name]) ||
+		!sha256Pattern.MatchString(scope.auth.ContextTreeDigests[record.Name]) {
+		return errors.New("V51R DEV owner scope lacks exact session and tree binding")
+	}
+	if record.ContextIdentity != "" && record.ContextIdentity != scope.auth.ContextIdentities[record.Name] ||
+		record.TreeDigestSchema != "" && record.TreeDigestSchema != scope.auth.ContextTreeDigestSchema ||
+		record.TreeDigest != "" && record.TreeDigest != scope.auth.ContextTreeDigests[record.Name] {
+		return errors.New("V51R DEV caller-provided context identity or tree differs from owner scope")
+	}
+	if !sha256Pattern.MatchString(record.VertexDigest) ||
+		!validIdentifier(record.SnapshotID) || record.VertexOutputIndex < 0 {
+		return errors.New("V51R DEV solver source metadata is incomplete before durable claim")
+	}
+	return nil
+}
diff --git a/util/localcontext/dev_v51_preflight_linux_test.go b/util/localcontext/dev_v51_preflight_linux_test.go
new file mode 100644
index 0000000..1460c03
--- /dev/null
+++ b/util/localcontext/dev_v51_preflight_linux_test.go
@@ -0,0 +1,117 @@
+//go:build linux && virki_c1c4_dev
+
+package localcontext
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDevV51PreflightAuthorizesWithoutConsumingScope(t *testing.T) {
+	service := &v8OwnerSessionFixture{sessions: v8SessionPins()}
+	manager, err := NewManager(service, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := manager.BeginSolve(context.Background(), testBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	record := testConsumption("source")
+	for i := 0; i < 2; i++ {
+		if err := manager.DevV51Preflight(ctx, testNonce, record); err != nil {
+			t.Fatalf("valid V3-scoped DEV preflight #%d refused: %v", i, err)
+		}
+	}
+	if len(scope.records) != 0 || scope.completionAttempted || scope.abortRequested ||
+		service.completeCalls != 0 || service.abortCalls != 0 || service.beginCalls != 1 {
+		t.Fatal("DEV preflight mutated owner scope or invoked owner service")
+	}
+	if err := manager.ContextConsumed(ctx, record); err != nil {
+		t.Fatalf("real later admission must remain available: %v", err)
+	}
+	if err := manager.DevV51Preflight(ctx, testNonce, record); err == nil ||
+		!strings.Contains(err.Error(), "duplicate") {
+		t.Fatalf("duplicate V3 context could burn another permit: %v", err)
+	}
+}
+
+func TestDevV51PreflightRefusesUnboundOrTerminatingScopesWithoutSideEffects(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*Manager, *SolveScope, *Consumption, *context.Context, *string)
+	}{
+		{"missing scope", func(_ *Manager, _ *SolveScope, _ *Consumption, ctx *context.Context, _ *string) {
+			*ctx = context.Background()
+		}},
+		{"optional Manager", func(m *Manager, _ *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			m.required = false
+		}},
+		{"wrong scope manager", func(m *Manager, scope *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			scope.manager = &Manager{required: true}
+		}},
+		{"wrong frozen nonce", func(_ *Manager, _ *SolveScope, _ *Consumption, _ *context.Context, nonce *string) {
+			*nonce = strings.Repeat("f", 32)
+		}},
+		{"record generation mismatch", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.Generation = strings.Repeat("e", 32)
+		}},
+		{"wrong worker", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.WorkerID = "another-worker"
+		}},
+		{"wrong required context", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.Name = "not-approved"
+		}},
+		{"wrong session", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.SessionID = "session-other"
+		}},
+		{"wrong tree", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.TreeDigest = "sha256:" + strings.Repeat("f", 64)
+		}},
+		{"wrong context identity", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.ContextIdentity = "forged-identity"
+		}},
+		{"invalid vertex", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.VertexDigest = "not-a-vertex"
+		}},
+		{"invalid snapshot", func(_ *Manager, _ *SolveScope, r *Consumption, _ *context.Context, _ *string) {
+			r.SnapshotID = ""
+		}},
+		{"expired", func(_ *Manager, scope *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			scope.auth.ExpiresAt = time.Now().Add(-time.Second)
+		}},
+		{"closing", func(_ *Manager, scope *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			scope.completionAttempted = true
+		}},
+		{"aborting", func(_ *Manager, scope *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			scope.abortRequested = true
+		}},
+		{"no owner-pinned session", func(_ *Manager, scope *SolveScope, _ *Consumption, _ *context.Context, _ *string) {
+			scope.auth.ContextSessionIDsV8 = nil
+		}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			service := &v8OwnerSessionFixture{sessions: v8SessionPins()}
+			manager, err := NewManager(service, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, scope, err := manager.BeginSolve(context.Background(), testBinding())
+			if err != nil {
+				t.Fatal(err)
+			}
+			record, nonce := testConsumption("source"), testNonce
+			tc.mutate(manager, scope, &record, &ctx, &nonce)
+			if err := manager.DevV51Preflight(ctx, nonce, record); err == nil {
+				t.Fatal("unbound/terminating DEV scope passed preclaim authorization")
+			}
+			if len(scope.records) != 0 || service.completeCalls != 0 ||
+				service.abortCalls != 0 || service.beginCalls != 1 {
+				t.Fatal("failed preflight mutated scope or invoked owner service")
+			}
+		})
+	}
+}
