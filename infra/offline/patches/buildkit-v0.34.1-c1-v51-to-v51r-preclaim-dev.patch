+func TestC1V51RRefusesOptionalManagerWithoutScope(t *testing.T) {
+	const uid uint32 = 60018
+	const content = "V51-PHYSICAL-PROTECTED-BYTES"
+	if os.Getenv("VIRKI_V51_TEST_CHILD") == "sender" {
+		if os.Getuid() != int(uid) {
+			t.Fatal("V51 sender not launched with the independently pinned UID")
+		}
+		source, err := os.Open(os.Getenv("VIRKI_V51_SOURCE"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer source.Close()
+		conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: os.Getenv("VIRKI_V51_SOCKET"), Net: "unix"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		if _, _, err := conn.WriteMsgUnix([]byte{'V'}, unix.UnixRights(int(source.Fd())), nil); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	if os.Getenv("VIRKI_V51_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("requires explicitly opted-in disposable Linux root V51 publication")
+	}
+	if _, err := user.LookupId(strconv.FormatUint(uint64(uid), 10)); err == nil {
+		t.Skip("V51 synthetic sender UID already belongs to an actual user")
+	}
+	base, err := os.MkdirTemp("/var/tmp", "virki-v51-dev-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(base) })
+	if err := os.Chmod(base, 0711); err != nil {
+		t.Fatal(err)
+	}
+	protected := filepath.Join(base, "protected")
+	source := filepath.Join(base, "sender-source")
+	ledger := filepath.Join(base, "ledger")
+	for _, dir := range []string{protected, source, ledger, v40TrustDir(ledger)} {
+		if err := os.Mkdir(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(source, "app.js"), []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(filepath.Join(source, "app.js"), int(uid), int(uid)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(source, int(uid), int(uid)); err != nil {
+		t.Fatal(err)
+	}
+	manifest := V15SealedManifest{
+		Schema: "virki-c1-v15-memory-fs-1", ContextName: "source",
+		WorkerID: "worker-v51", SessionID: "sess-source",
+		Nonce: strings.Repeat("a", 32),
+		Files: []V15FilePin{{Path: "app.js", SHA256: v15Hash([]byte(content)), Size: int64(len(content))}},
+		Bytes: int64(len(content)),
+	}
+	manifest.Digest = v15ManifestDigest(manifest)
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	macKey := make([]byte, 32)
+	if _, err := rand.Read(macKey); err != nil {
+		t.Fatal(err)
+	}
+	trust := v40TrustDir(ledger)
+	for path, data := range map[string][]byte{
+		filepath.Join(ledger, v40LogName):       nil,
+		filepath.Join(trust, v40KeyName):        macKey,
+		filepath.Join(trust, v40CheckpointName): v40InitialCheckpoint(ledger, pub, macKey),
+	} {
+		mode := os.FileMode(0600)
+		if filepath.Base(path) == v40KeyName {
+			mode = 0400
+		}
+		if err := os.WriteFile(path, data, mode); err != nil {
+			t.Fatal(err)
+		}
+		f, err := os.Open(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Sync(); err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, dir := range []string{trust, ledger} {
+		fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Fsync(fd); err != nil {
+			t.Fatal(err)
+		}
+		_ = unix.Close(fd)
+	}
+	permit := V15OwnerPermit{
+		Domain: V15OwnerDomain, ApprovalID: "v51-test-only",
+		ManifestDigest: manifest.Digest, WorkerID: manifest.WorkerID,
+		SessionID: manifest.SessionID, ContextName: manifest.ContextName,
+		Nonce: manifest.Nonce, Epoch: 7, ExpiresUnix: time.Now().Add(time.Hour).Unix(),
+	}
+	permit.Signature = ed25519.Sign(priv, v15PermitBytes(permit))
+
+	// Expected owner tree is measured INDEPENDENTLY before receiving a sender
+	// FD; the actual source of data for the V3 record remains the V36 copy.
+	reference := filepath.Join(protected, "owner-expected")
+	if err := os.Mkdir(reference, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(reference, "app.js"), []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	expected, expectedStream, err := BuildLocalContextStream(reference, "source", MaxLocalContextStreamBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intent, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "127.0.0.1:5000/virki/v51:dev"})
