+	}
+	if os.Getenv("VIRKI_V53_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("V53 DEV requires explicit disposable root supervisor and real nonroot processes")
+	}
+	for _, uid := range []uint32{v53ReceiverUID, v53SenderUID} {
+		if _, err := user.LookupId(strconv.Itoa(int(uid))); err == nil {
+			t.Skipf("V53 synthetic UID %d is already assigned", uid)
+		}
+	}
+	for _, attack := range []string{"during-receive", "after-receive", "during-publication"} {
+		t.Run(attack, func(t *testing.T) { v53RunRootCase(t, attack) })
+	}
+}
