+func v53WaitForMarker(path string, timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if _, err := os.Stat(path); err == nil {
+			return nil
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	return fmt.Errorf("V53 marker %s timed out", filepath.Base(path))
+}
+
+func v53WaitForFile(t *testing.T, path string, timeout time.Duration) []byte {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if data, err := os.ReadFile(path); err == nil {
+			return data
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if t != nil {
+		t.Fatalf("timed out waiting for %s", path)
+	}
+	return nil
+}
