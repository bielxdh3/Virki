@@ -0,0 +1,524 @@
+//go:build linux && virki_c1c4_dev
+
+package filesync
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/moby/buildkit/session"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/tonistiigi/fsutil"
+	"golang.org/x/sys/unix"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/metadata"
+)
+
+// V53SupervisorStage is allocated by the trusted root supervisor beneath a
+// root:root 0700 parent. The stage directory itself is receiver-owned 0700,
+// but its pathname is unreachable to the receiver UID and every same-UID
+// process. The supervisor retains both handles; only Stage is inherited by
+// the unprivileged receiver. No receiver-side pathname rename is involved.
+type V53SupervisorStage struct {
+	Parent     *os.File
+	Stage      *os.File
+	Name       string
+	ParentPath string
+}
+
+// CreateV53SupervisorStage creates an empty, receiver-writable directory under
+// an independently root-controlled parent and returns the pinned descriptors.
+// The caller must pass Stage to the receiver with ExtraFiles/SCM_RIGHTS and
+// retain its own copy until the receiver exits and the broker finishes.
+func CreateV53SupervisorStage(parentPath string, receiverUID, receiverGID uint32) (*V53SupervisorStage, error) {
+	if os.Getuid() != 0 || os.Geteuid() != 0 || receiverUID == 0 || receiverGID == 0 ||
+		!filepath.IsAbs(parentPath) || filepath.Clean(parentPath) != parentPath || parentPath == "/" {
+		return nil, errors.New("C1 V53 stage creation requires root supervisor, nonroot receiver and canonical protected parent")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(rootFD)
+	if err := validateV24TrustedSupervisorAncestors(rootFD, parentPath); err != nil {
+		return nil, fmt.Errorf("C1 V53 stage parent ancestry is not root-supervised: %w", err)
+	}
+	parentFD, err := unix.Openat2(rootFD, strings.TrimPrefix(parentPath, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("C1 V53 root supervisor cannot pin stage parent: %w", err)
+	}
+	var parentStat unix.Stat_t
+	if err := unix.Fstat(parentFD, &parentStat); err != nil || parentStat.Mode&unix.S_IFMT != unix.S_IFDIR ||
+		parentStat.Uid != 0 || parentStat.Gid != 0 || parentStat.Mode&07777 != 0700 {
+		_ = unix.Close(parentFD)
+		return nil, fmt.Errorf("C1 V53 stage parent must be root:root 0700: %w", err)
+	}
+	var name string
+	for attempt := 0; attempt < 8; attempt++ {
+		var nonce [16]byte
+		if _, err := rand.Read(nonce[:]); err != nil {
+			_ = unix.Close(parentFD)
+			return nil, err
+		}
+		candidate := ".virki-v53-" + hex.EncodeToString(nonce[:])
+		if err := unix.Mkdirat(parentFD, candidate, 0700); err == nil {
+			name = candidate
+			break
+		} else if !errors.Is(err, unix.EEXIST) {
+			_ = unix.Close(parentFD)
+			return nil, err
+		}
+	}
+	if name == "" {
+		_ = unix.Close(parentFD)
+		return nil, errors.New("C1 V53 could not allocate unique supervisor stage")
+	}
+	stageFD, err := unix.Openat(parentFD, name,
+		unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		_ = unix.Unlinkat(parentFD, name, unix.AT_REMOVEDIR)
+		_ = unix.Close(parentFD)
+		return nil, err
+	}
+	if err := unix.Fchown(stageFD, int(receiverUID), int(receiverGID)); err != nil {
+		_ = unix.Close(stageFD)
+		_ = unix.Unlinkat(parentFD, name, unix.AT_REMOVEDIR)
+		_ = unix.Close(parentFD)
+		return nil, err
+	}
+	if err := unix.Fchmod(stageFD, 0700); err != nil {
+		_ = unix.Close(stageFD)
+		_ = unix.Unlinkat(parentFD, name, unix.AT_REMOVEDIR)
+		_ = unix.Close(parentFD)
+		return nil, err
+	}
+	if err := unix.Fsync(parentFD); err != nil {
+		_ = unix.Close(stageFD)
+		_ = unix.Unlinkat(parentFD, name, unix.AT_REMOVEDIR)
+		_ = unix.Close(parentFD)
+		return nil, err
+	}
+	stage := &V53SupervisorStage{
+		Parent: os.NewFile(uintptr(parentFD), "v53-root-stage-parent"),
+		Stage:  os.NewFile(uintptr(stageFD), "v53-receiver-stage"),
+		Name:   name, ParentPath: parentPath,
+	}
+	if err := stage.Verify(receiverUID, receiverGID); err != nil {
+		_ = stage.Cleanup()
+		_ = stage.Close()
+		return nil, err
+	}
+	return stage, nil
+}
+
+// Verify binds the retained directory descriptor to the root-only parent name.
+// This check is performed by the supervisor, which owns the parent FD; the
+// unprivileged receiver never needs pathname access to that parent.
+func (s *V53SupervisorStage) Verify(receiverUID, receiverGID uint32) error {
+	if s == nil || s.Parent == nil || s.Stage == nil || s.Name == "" ||
+		s.Name == "." || s.Name == ".." || strings.ContainsAny(s.Name, "/\\") {
+		return errors.New("C1 V53 supervisor stage handle is incomplete")
+	}
+	var parent, byName, byFD unix.Stat_t
+	if err := unix.Fstat(int(s.Parent.Fd()), &parent); err != nil {
+		return err
+	}
+	if parent.Mode&unix.S_IFMT != unix.S_IFDIR || parent.Uid != 0 || parent.Gid != 0 || parent.Mode&07777 != 0700 {
+		return errors.New("C1 V53 supervisor stage parent lost root-only custody")
+	}
+	if err := unix.Fstat(int(s.Stage.Fd()), &byFD); err != nil {
+		return err
+	}
+	if byFD.Mode&unix.S_IFMT != unix.S_IFDIR || byFD.Uid != receiverUID || byFD.Gid != receiverGID || byFD.Mode&07777 != 0700 {
+		return errors.New("C1 V53 pinned stage FD is not receiver-owned 0700")
+	}
+	if err := unix.Fstatat(int(s.Parent.Fd()), s.Name, &byName, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if byName.Mode&unix.S_IFMT != unix.S_IFDIR || byName.Dev != byFD.Dev || byName.Ino != byFD.Ino ||
+		byName.Uid != receiverUID || byName.Gid != receiverGID || byName.Mode&07777 != 0700 {
+		return errors.New("C1 V53 supervisor stage pathname no longer identifies pinned receiver directory")
+	}
+	return nil
+}
+
+// Cleanup is only safe after the receiver child has exited. The parent is
+// root-owned 0700, so no untrusted same-UID process can substitute the name.
+func (s *V53SupervisorStage) Cleanup() error {
+	if s == nil || s.Parent == nil || s.Stage == nil {
+		return nil
+	}
+	var byName, byFD unix.Stat_t
+	if err := unix.Fstat(int(s.Stage.Fd()), &byFD); err != nil {
+		return err
+	}
+	if err := unix.Fstatat(int(s.Parent.Fd()), s.Name, &byName, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		}
+		return err
+	}
+	if byName.Dev != byFD.Dev || byName.Ino != byFD.Ino || byName.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return errors.New("C1 V53 cleanup refuses a replaced supervisor stage name")
+	}
+	path := fmt.Sprintf("/proc/self/fd/%d/%s", s.Parent.Fd(), s.Name)
+	if err := os.RemoveAll(path); err != nil {
+		return err
+	}
+	return unix.Fsync(int(s.Parent.Fd()))
+}
+
+func (s *V53SupervisorStage) Close() error {
+	if s == nil {
+		return nil
+	}
+	var stageErr, parentErr error
+	if s.Stage != nil {
+		stageErr = s.Stage.Close()
+	}
+	if s.Parent != nil {
+		parentErr = s.Parent.Close()
+	}
+	return errors.Join(stageErr, parentErr)
+}
+
+// FSSyncSealedV53Dev receives the actual sealed gRPC FileSync stream directly
+// into a stage FD pre-created by the root supervisor. It NEVER publishes or
+// renames the stage by pathname. The same pinned FD is handed to the V51R/V52
+// root broker, which authenticates the receiver and copies only manifest-exact
+// bytes into fresh root-owned inodes before the protected atomic publication.
+//
+// This remains DEV-only; it does not enable production C1, C4 signing or deploy.
+func FSSyncSealedV53Dev(ctx context.Context, caller session.Caller, opt FSSendRequestOpt,
+	manifest V15SealedManifest, permit V15OwnerPermit, trustedOwnerPub ed25519.PublicKey,
+	ledger *V15LocalReplayLedger, stageFD int, brokerSocket string,
+	policy V24ReceiverCustodyPolicy) error {
+	return fssyncSealedV53DevWithHooks(ctx, caller, opt, manifest, permit,
+		trustedOwnerPub, ledger, stageFD, brokerSocket, policy, nil, nil)
+}
+
+// afterReceive is an unexported deterministic test seam. It runs after the
+// gRPC stream is sealed in the supervisor-provided inode and before the FD is
+// handed to the broker. It cannot change the inherited FD or supervisor policy.
+func fssyncSealedV53DevWithHooks(ctx context.Context, caller session.Caller,
+	opt FSSendRequestOpt, manifest V15SealedManifest, permit V15OwnerPermit,
+	trustedOwnerPub ed25519.PublicKey, ledger *V15LocalReplayLedger,
+	stageFD int, brokerSocket string, policy V24ReceiverCustodyPolicy,
+	beforeReceive, afterReceive func() error) error {
+	if ctx == nil || caller == nil || ledger == nil || stageFD < 0 || len(trustedOwnerPub) != ed25519.PublicKeySize ||
+		opt.OnConsumed != nil || opt.DestDir != "" || opt.Name != manifest.ContextName ||
+		len(opt.IncludePatterns) != 0 || len(opt.ExcludePatterns) != 0 || len(manifest.ExcludePatterns) != 0 ||
+		opt.MetadataOnly || opt.CacheUpdater != nil || opt.ProgressCb != nil ||
+		opt.Filter != nil || opt.MetadataOnlyFilter != nil {
+		return errors.New("C1 V53 requires sealed FileSync inputs, supervisor stage FD, TEST ledger and no receiver pathname publication")
+	}
+	if err := validateV53ReceiverPolicy(policy); err != nil {
+		return err
+	}
+	if err := validateV53ReceiverStageFD(stageFD, *policy.ExpectedReceiverUID, *policy.ExpectedReceiverGID, true); err != nil {
+		return err
+	}
+	paths := make([]string, 0, len(manifest.Files))
+	var pinBytes int64
+	for _, file := range manifest.Files {
+		paths = append(paths, file.Path)
+		pinBytes += file.Size
+	}
+	if manifest.Schema != "virki-c1-v15-memory-fs-1" || manifest.Digest == "" || v15ManifestDigest(manifest) != manifest.Digest ||
+		pinBytes != manifest.Bytes || manifest.Bytes < 0 || manifest.Bytes > 64<<20 || !slices.Equal(paths, opt.FollowPaths) {
+		return errors.New("C1 V53 sealed manifest, file budget or exact FollowPaths mismatch")
+	}
+	if err := validateV15Request(V15SnapshotRequest{Root: "v53-supervisor-pinned-fd", ContextName: manifest.ContextName,
+		WorkerID: manifest.WorkerID, SessionID: manifest.SessionID, Nonce: manifest.Nonce, Files: manifest.Files}); err != nil {
+		return err
+	}
+	if err := ledger.VerifyAndClaim(manifest, permit, trustedOwnerPub); err != nil {
+		return err
+	}
+	if !caller.Supports(session.MethodURL(sealedServiceNameV15, sealedMethodV15)) {
+		return errors.New("C1 V53 sealed FileSync capability absent: legacy diffcopy fallback forbidden")
+	}
+	ctx = caller.Context(ctx)
+	ctx = metadata.NewOutgoingContext(ctx, metadata.Pairs(v15MDManifest, manifest.Digest, v15MDWorker, manifest.WorkerID,
+		v15MDSession, manifest.SessionID, v15MDNonce, manifest.Nonce, v15MDRole, manifest.ContextName))
+	stream, err := caller.Conn().NewStream(ctx, &grpc.StreamDesc{StreamName: sealedMethodV15,
+		ServerStreams: true, ClientStreams: true}, sealedRPCV15)
+	if err != nil {
+		return err
+	}
+	hdr, err := stream.Header()
+	if err != nil {
+		return fmt.Errorf("C1 V53 sealed sender handshake denied: %w", err)
+	}
+	if !v15One(hdr, v15MDManifest, manifest.Digest) || !v15One(hdr, v15MDWorker, manifest.WorkerID) ||
+		!v15One(hdr, v15MDSession, manifest.SessionID) || !v15One(hdr, v15MDNonce, manifest.Nonce) {
+		return errors.New("C1 V53 sealed sender gave wrong or missing versioned manifest header")
+	}
+	if beforeReceive != nil {
+		if err := beforeReceive(); err != nil {
+			return fmt.Errorf("C1 V53 pre-receive test barrier: %w", err)
+		}
+	}
+	stagePath := fmt.Sprintf("/proc/self/fd/%d", stageFD)
+	// ReceiveRoot anchors ALL FileSync disk operations to a directory handle
+	// rather than walking the supervisor-owned parent path. Plain Receive()
+	// uses path based lstat and cannot traverse a protected root 0700 parent.
+	stageRoot, err := os.OpenRoot(stagePath)
+	if err != nil {
+		return fmt.Errorf("C1 V53 cannot open inherited stage as rooted FS: %w", err)
+	}
+	guard := newV15PacketGuardWithOwner(stream, manifest, *policy.ExpectedSenderUID, *policy.ExpectedSenderGID)
+	err = fsutil.ReceiveRoot(ctx, guard, fsutil.NewRoot(stageRoot), fsutil.ReceiveOpt{Differ: opt.Differ})
+	closeErr := stageRoot.Close()
+	if err == nil {
+		_ = stream.CloseSend()
+	}
+	if err != nil || closeErr != nil {
+		return fmt.Errorf("C1 V53 gRPC stream into supervisor-pinned stage failed: %w", errors.Join(err, closeErr))
+	}
+	if err := verifyV23StageTreeFD(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V53 pinned stage membership refused: %w", err)
+	}
+	if err := verifyAndSyncV22Stage(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V53 pinned stage bytes/fsync refused: %w", err)
+	}
+	if err := verifyV23StageTreeFD(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V53 pinned stage changed after seal: %w", err)
+	}
+	if err := verifyAndSyncV22Stage(stageFD, manifest); err != nil {
+		return fmt.Errorf("C1 V53 pinned stage changed before handoff: %w", err)
+	}
+	if afterReceive != nil {
+		if err := afterReceive(); err != nil {
+			return fmt.Errorf("C1 V53 post-receive test barrier: %w", err)
+		}
+	}
+	if err := validateV53ReceiverStageFD(stageFD, *policy.ExpectedReceiverUID, *policy.ExpectedReceiverGID, false); err != nil {
+		return fmt.Errorf("C1 V53 supervisor stage handle changed before handoff: %w", err)
+	}
+	if err := validateV53BrokerSocket(brokerSocket, *policy.ExpectedReceiverGID); err != nil {
+		return err
+	}
+	conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: brokerSocket, Net: "unix"})
+	if err != nil {
+		return fmt.Errorf("C1 V53 root publication broker connection refused: %w", err)
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(time.Now().Add(30 * time.Second)); err != nil {
+		return err
+	}
+	n, oobn, err := conn.WriteMsgUnix([]byte{'V'}, unix.UnixRights(stageFD), nil)
+	if err != nil {
+		return fmt.Errorf("C1 V53 supervisor-pinned stage FD handoff failed: %w", err)
+	}
+	if n != 1 || oobn == 0 {
+		return errors.New("C1 V53 broker handoff did not send exactly one marker and SCM_RIGHTS FD")
+	}
+	var ack [1]byte
+	if _, err := io.ReadFull(conn, ack[:]); err != nil {
+		return fmt.Errorf("C1 V53 root broker did not return terminal publication result: %w", err)
+	}
+	if ack[0] != 'O' {
+		return errors.New("C1 V53 root broker refused protected publication; TEST permit is not retryable")
+	}
+	return nil
+}
+
+func validateV53ReceiverPolicy(policy V24ReceiverCustodyPolicy) error {
+	if !policy.RequireUnprivileged || policy.ExpectedReceiverUID == nil || policy.ExpectedReceiverGID == nil ||
+		policy.ExpectedSenderUID == nil || policy.ExpectedSenderGID == nil ||
+		*policy.ExpectedReceiverUID == 0 || *policy.ExpectedReceiverGID == 0 ||
+		*policy.ExpectedSenderUID == 0 || *policy.ExpectedSenderGID == 0 ||
+		*policy.ExpectedReceiverUID == *policy.ExpectedSenderUID ||
+		*policy.ExpectedReceiverGID == *policy.ExpectedSenderGID ||
+		!slices.Contains(policy.ForbiddenPeerUIDs, *policy.ExpectedSenderUID) ||
+		policy.PrivateTempDir == "" || os.TempDir() != policy.PrivateTempDir {
+		return errors.New("C1 V53 requires independently provisioned distinct nonroot receiver/sender identities and private TMPDIR")
+	}
+	if os.Getuid() == 0 || os.Geteuid() == 0 || os.Getuid() != os.Geteuid() ||
+		os.Getgid() != os.Getegid() || uint32(os.Geteuid()) != *policy.ExpectedReceiverUID ||
+		uint32(os.Getegid()) != *policy.ExpectedReceiverGID {
+		return errors.New("C1 V53 receiver process identity differs from supervisor policy")
+	}
+	if err := unix.Prctl(unix.PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0); err != nil {
+		return fmt.Errorf("C1 V53 receiver cannot set NoNewPrivs: %w", err)
+	}
+	if groups, err := os.Getgroups(); err != nil {
+		return err
+	} else if len(groups) != 0 {
+		return errors.New("C1 V53 receiver refuses supplementary groups")
+	}
+	if err := validateV24NoCapabilities(); err != nil {
+		return fmt.Errorf("C1 V53 receiver capabilities: %w", err)
+	}
+	if err := enforceV32NonDumpableReceiver(); err != nil {
+		return fmt.Errorf("C1 V53 receiver dumpability: %w", err)
+	}
+	if err := validateV24CustodyDirs(filepath.Join(policy.PrivateTempDir, "tmp-probe"), V24ReceiverCustodyPolicy{RequirePrivateParent: true}); err != nil {
+		return fmt.Errorf("C1 V53 private temporary directory: %w", err)
+	}
+	return nil
+}
+
+func validateV53ReceiverStageFD(stageFD int, expectedUID, expectedGID uint32, requireEmpty bool) error {
+	if stageFD < 0 || expectedUID == 0 || expectedGID == 0 {
+		return errors.New("C1 V53 supervisor stage descriptor/receiver identity is invalid")
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(stageFD, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != expectedUID || st.Gid != expectedGID || st.Mode&07777 != 0700 {
+		return errors.New("C1 V53 inherited stage FD must be receiver-owned private directory")
+	}
+	flags, err := unix.FcntlInt(uintptr(stageFD), unix.F_GETFL, 0)
+	if err != nil || flags&unix.O_PATH != 0 || flags&unix.O_DIRECTORY == 0 || flags&unix.O_ACCMODE != unix.O_RDONLY {
+		return fmt.Errorf("C1 V53 inherited stage FD must be a readable directory handle: %w", err)
+	}
+	if !requireEmpty {
+		unix.CloseOnExec(stageFD)
+		return nil
+	}
+	dup, err := unix.Openat(stageFD, ".", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(dup), "v53-stage-empty-check")
+	entries, readErr := file.ReadDir(1)
+	closeErr := file.Close()
+	if readErr != nil && !errors.Is(readErr, io.EOF) {
+		return errors.Join(readErr, closeErr)
+	}
+	if len(entries) != 0 || !errors.Is(readErr, io.EOF) || closeErr != nil {
+		return errors.Join(errors.New("C1 V53 supervisor stage must be empty before FileSync"), closeErr)
+	}
+	unix.CloseOnExec(stageFD)
+	return nil
+}
+
+func validateV53BrokerSocket(socketPath string, expectedGroup uint32) error {
+	if !filepath.IsAbs(socketPath) || filepath.Clean(socketPath) != socketPath || socketPath == "/" {
+		return errors.New("C1 V53 broker socket must be canonical absolute path")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(rootFD)
+	parent := filepath.Dir(socketPath)
+	if err := validateV24TrustedSupervisorAncestors(rootFD, parent); err != nil {
+		return fmt.Errorf("C1 V53 broker socket ancestry is not root-supervised: %w", err)
+	}
+	parentFD, err := unix.Openat2(rootFD, strings.TrimPrefix(parent, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS,
+	})
+	if err != nil {
+		return fmt.Errorf("C1 V53 broker parent cannot be pinned: %w", err)
+	}
+	defer unix.Close(parentFD)
+	var parentStat, socketStat unix.Stat_t
+	if err := unix.Fstat(parentFD, &parentStat); err != nil {
+		return err
+	}
+	if parentStat.Mode&unix.S_IFMT != unix.S_IFDIR || parentStat.Uid != 0 || parentStat.Mode&0022 != 0 {
+		return errors.New("C1 V53 broker parent must be root-owned and not group/world writable")
+	}
+	if err := unix.Fstatat(parentFD, filepath.Base(socketPath), &socketStat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if socketStat.Mode&unix.S_IFMT != unix.S_IFSOCK || socketStat.Uid != 0 ||
+		socketStat.Gid != expectedGroup || socketStat.Mode&0777 != 0660 {
+		return errors.New("C1 V53 broker socket must be a root-owned 0660 socket for receiver primary GID")
+	}
+	return nil
+}
+
+// PublishV53DevContextToV3 is the V51R/V36 publication path with one stronger
+// source contract: the SCM_RIGHTS descriptor must be the exact inode retained
+// by the root supervisor before the receiver started. The receiver never
+// chooses a stage pathname and cannot substitute another same-UID directory.
+func PublishV53DevContextToV3(ctx context.Context, manager *localcontext.Manager,
+	ledgerDir string, conn *net.UnixConn, expectedPID int, expectedUID, expectedGID uint32,
+	supervisorStageFD int, dest string, manifest V15SealedManifest, permit V15OwnerPermit,
+	trustedV15Public ed25519.PublicKey, minimumEpoch, maximumEpoch uint64,
+	record localcontext.Consumption) error {
+	if ctx == nil || manager == nil || conn == nil || supervisorStageFD < 0 ||
+		os.Getuid() != 0 || os.Geteuid() != 0 {
+		return errors.New("V53 DEV requires root supervisor, Manager, accepted peer and retained stage FD")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if record.Name != manifest.ContextName || record.WorkerID != manifest.WorkerID ||
+		record.SessionID != manifest.SessionID || record.Name == "" {
+		return errors.New("V53 DEV worker/context/session differs from frozen V15 manifest")
+	}
+	// V51R preflight is deliberately before peer data, V40 claim or V36 publish.
+	if err := manager.DevV51Preflight(ctx, manifest.Nonce, record); err != nil {
+		return fmt.Errorf("V51R DEV preclaim owner-scope authorization refused: %w", err)
+	}
+	if err := v41AuthenticatePeerBeforeClaim(conn, expectedPID, expectedUID, expectedGID); err != nil {
+		return fmt.Errorf("V53 DEV refused receiver identity before permit claim: %w", err)
+	}
+	fd, err := receiveV37AuthenticatedStageFD(conn, expectedPID, expectedUID, expectedGID)
+	if err != nil {
+		return fmt.Errorf("V53 DEV refused receiver stage handoff before permit claim: %w", err)
+	}
+	defer unix.Close(fd)
+	var received, retained unix.Stat_t
+	if err := unix.Fstat(fd, &received); err != nil {
+		return err
+	}
+	if err := unix.Fstat(supervisorStageFD, &retained); err != nil {
+		return err
+	}
+	if received.Mode&unix.S_IFMT != unix.S_IFDIR || retained.Mode&unix.S_IFMT != unix.S_IFDIR ||
+		received.Dev != retained.Dev || received.Ino != retained.Ino ||
+		received.Uid != expectedUID || received.Gid != expectedGID || received.Mode&07777 != 0700 ||
+		retained.Uid != expectedUID || retained.Gid != expectedGID || retained.Mode&07777 != 0700 {
+		return errors.New("V53 DEV received FD is not the exact root-supervisor-retained receiver stage inode")
+	}
+	if err := claimV39DurableTestOwnerPermit(ledgerDir, manifest, permit, trustedV15Public, minimumEpoch, maximumEpoch); err != nil {
+		return fmt.Errorf("V53 DEV refused publication before durable V40 permit claim: %w", err)
+	}
+	if err := publishV36RootOwnedSnapshot(fd, expectedUID, expectedGID, dest, manifest); err != nil {
+		return fmt.Errorf("V53 DEV root-owned manifest copy/publication failed after one-time permit claim: %w", err)
+	}
+	observation, stream, err := v51MeasureProtectedPublication(dest, manifest)
+	if err != nil {
+		return fmt.Errorf("V53 DEV published but not V3-admitted; new authorization required: %w", err)
+	}
+	if record.TreeDigest != "" && record.TreeDigest != observation.TreeDigest ||
+		record.StreamDigest != "" && record.StreamDigest != observation.StreamDigest ||
+		record.StreamLength != 0 && record.StreamLength != observation.StreamLength ||
+		record.RegularFileBytes != 0 && record.RegularFileBytes != observation.RegularFileBytes ||
+		record.EntryCount != 0 && record.EntryCount != observation.EntryCount {
+		return errors.New("V53 DEV caller metadata differs from measured root-owned publication")
+	}
+	record.TreeDigestSchema = observation.TreeDigestSchema
+	record.TreeDigest = observation.TreeDigest
+	record.StreamDigest = observation.StreamDigest
+	record.StreamLength = observation.StreamLength
+	record.StreamBytes = stream
+	record.RegularFileBytes = observation.RegularFileBytes
+	record.EntryCount = observation.EntryCount
+	if err := manager.ContextConsumed(ctx, record); err != nil {
+		return fmt.Errorf("V53 DEV published bytes refused by independently authorized V3 scope: %w", err)
+	}
+	return nil
+}
