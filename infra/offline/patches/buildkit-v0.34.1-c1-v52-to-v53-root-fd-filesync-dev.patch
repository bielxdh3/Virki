+func v53RunRootCase(t *testing.T, attack string) {
+	t.Helper()
+	base, err := os.MkdirTemp("/var/tmp", "virki-v53-root-broker-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stage *V53SupervisorStage
+	var receiver, attacker, server *exec.Cmd
+	var listener *net.UnixListener
+	var conn *net.UnixConn
+	t.Cleanup(func() {
+		if conn != nil {
+			_ = conn.Close()
+		}
+		if listener != nil {
+			_ = listener.Close()
+		}
+		for _, cmd := range []*exec.Cmd{receiver, attacker, server} {
+			if cmd != nil && cmd.ProcessState == nil {
+				_ = cmd.Process.Kill()
+				_ = cmd.Wait()
+			}
+		}
+		if stage != nil {
+			_ = stage.Cleanup()
+			_ = stage.Close()
+		}
+		_ = os.RemoveAll(base)
+	})
+	if err := os.Chmod(base, 0711); err != nil {
+		t.Fatal(err)
+	}
+	paths := map[string]string{}
+	for _, name := range []string{"protected", "stage-parent", "broker-dir", "source", "server-dir", "ledger", "private-tmp", "race-signals"} {
+		paths[name] = filepath.Join(base, name)
+		if err := os.Mkdir(paths[name], 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.Mkdir(v40TrustDir(paths["ledger"]), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(paths["broker-dir"], 0711); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(paths["source"], int(v53SenderUID), int(v53SenderUID)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(paths["server-dir"], int(v53SenderUID), int(v53SenderUID)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(paths["private-tmp"], int(v53ReceiverUID), int(v53ReceiverUID)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(paths["race-signals"], int(v53ReceiverUID), int(v53ReceiverUID)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(paths["private-tmp"], 0700); err != nil {
+		t.Fatal(err)
+	}
+	const content = "V53 physical sealed FileSync bytes; no receiver pathname publication\n"
+	if err := os.WriteFile(filepath.Join(paths["source"], "app.js"), []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(filepath.Join(paths["source"], "app.js"), int(v53SenderUID), int(v53SenderUID)); err != nil {
+		t.Fatal(err)
+	}
+	request := v15Request(paths["source"], "app.js")
+	request.ContextName, request.WorkerID, request.SessionID, request.Nonce = "source", "worker-v53", "sess-source", strings.Repeat("b", 32)
+	snapshot, err := NewLinuxSealedSnapshotV15(context.Background(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest := snapshot.Manifest()
+	permitPub, permitPriv, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	permit := V15OwnerPermit{Domain: V15OwnerDomain, ApprovalID: "v53-test-only", ManifestDigest: manifest.Digest,
+		WorkerID: manifest.WorkerID, SessionID: manifest.SessionID, ContextName: manifest.ContextName,
+		Nonce: manifest.Nonce, Epoch: 7, ExpiresUnix: time.Now().Add(time.Hour).Unix()}
+	permit.Signature = ed25519.Sign(permitPriv, v15PermitBytes(permit))
+	macKey := make([]byte, 32)
+	if _, err := rand.Read(macKey); err != nil {
+		t.Fatal(err)
+	}
+	for path, data := range map[string][]byte{
+		filepath.Join(paths["ledger"], v40LogName):                     nil,
+		filepath.Join(v40TrustDir(paths["ledger"]), v40KeyName):        macKey,
+		filepath.Join(v40TrustDir(paths["ledger"]), v40CheckpointName): v40InitialCheckpoint(paths["ledger"], permitPub, macKey),
+	} {
+		mode := os.FileMode(0600)
+		if filepath.Base(path) == v40KeyName {
+			mode = 0400
+		}
+		if err := os.WriteFile(path, data, mode); err != nil {
+			t.Fatal(err)
+		}
+		f, err := os.Open(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Sync(); err != nil {
+			t.Fatal(err)
+		}
+		_ = f.Close()
+	}
+	for _, dir := range []string{paths["ledger"], v40TrustDir(paths["ledger"])} {
+		fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := unix.Fsync(fd); err != nil {
+			t.Fatal(err)
+		}
+		_ = unix.Close(fd)
+	}
+	stage, err = CreateV53SupervisorStage(paths["stage-parent"], v53ReceiverUID, v53ReceiverUID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := stage.Verify(v53ReceiverUID, v53ReceiverUID); err != nil {
+		t.Fatal(err)
+	}
+	stagePath := filepath.Join(paths["stage-parent"], stage.Name)
+	dest := filepath.Join(paths["protected"], "published-source")
+	// Independently measure the expected owner context before any sender data.
+	reference := filepath.Join(paths["protected"], "reference")
+	if err := os.Mkdir(reference, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(reference, "app.js"), []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	expected, _, err := BuildLocalContextStream(reference, "source", MaxLocalContextStreamBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intent, err := localcontext.NewExporterIntent("image", 0, map[string]string{"name": "127.0.0.1:5000/virki/v53:dev"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	identities, trees, sessions := map[string]string{}, map[string]string{}, map[string]string{}
+	for _, name := range localcontext.RequiredContextNames() {
+		identities[name], trees[name], sessions[name] = "ctxid-"+name, expected.TreeDigest, "sess-"+name
+	}
+	auth := localcontext.Authorization{Token: "v53-test-scope", Generation: manifest.Nonce, WorkerID: manifest.WorkerID,
+		ContextIdentities: identities, ContextTreeDigestSchema: expected.TreeDigestSchema,
+		ContextTreeDigests: trees, ContextSessionIDsV8: sessions, ExporterPolicy: intent,
+		ExpectedImage: localcontext.ImageDescriptor{MediaType: "application/vnd.oci.image.manifest.v1+json", Digest: "sha256:" + strings.Repeat("b", 64), Size: 100},
+		ExpiresAt:     time.Now().Add(time.Hour)}
+	owner := &v51DEVScope{auth: auth}
+	manager, err := localcontext.NewManager(owner, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, scope, err := manager.BeginSolve(context.Background(), localcontext.Binding{JobID: "job-v53", Role: "runtime", Nonce: manifest.Nonce,
+		ApprovalID: "v53-test-scope", ApprovalEnvelope: base64.StdEncoding.EncodeToString([]byte("TEST ONLY; NO C4 AUTHORITY")), Exporter: intent})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = scope
+
+	// Real gRPC FileSync sender runs under a distinct nonroot UID.
+	helper, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	helperCopy := filepath.Join(base, "v53-helper")
+	in, err := os.Open(helper)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := os.OpenFile(helperCopy, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	if err != nil {
+		_ = in.Close()
+		t.Fatal(err)
+	}
+	if _, err := io.Copy(out, in); err != nil {
+		t.Fatal(err)
+	}
+	_ = in.Close()
+	if err := out.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(helperCopy, 0555); err != nil {
+		t.Fatal(err)
+	}
+	serverReady := filepath.Join(paths["server-dir"], "ready")
+	serverStop := filepath.Join(paths["server-dir"], "stop")
+	server = exec.Command(helperCopy, "-test.run=^TestC1V53FileSyncToRootBrokerSameUIDStageRace$")
+	server.Env = []string{"PATH=/usr/bin:/bin", "VIRKI_V53_CHILD=grpc-server", "VIRKI_V53_SOURCE=" + paths["source"],
+		"VIRKI_V53_EXPECTED_MANIFEST=" + manifest.Digest, "VIRKI_V53_SERVER_READY=" + serverReady, "VIRKI_V53_SERVER_STOP=" + serverStop}
+	server.Stdout, server.Stderr = os.Stdout, os.Stderr
+	server.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: v53SenderUID, Gid: v53SenderUID, Groups: []uint32{}}, Pdeathsig: syscall.SIGKILL}
+	if err := server.Start(); err != nil {
+		t.Fatal(err)
+	}
+	grpcAddr := string(v53WaitForFile(t, serverReady, 10*time.Second))
+
+	// Root broker socket is group-accessible only to the receiver primary GID.
+	socket := filepath.Join(paths["broker-dir"], "v53.sock")
+	listener, err = net.ListenUnix("unix", &net.UnixAddr{Name: socket, Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := v50ArmPasscredBeforeAccept(listener); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(socket, 0, int(v53ReceiverUID)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(socket, 0660); err != nil {
+		t.Fatal(err)
+	}
+
+	ready := filepath.Join(paths["race-signals"], "ready")
+	cont := filepath.Join(paths["race-signals"], "continue")
+	afterReady := filepath.Join(paths["race-signals"], "after-ready")
+	afterContinue := filepath.Join(paths["race-signals"], "after-continue")
+	stop := filepath.Join(paths["race-signals"], "stop")
+	seen := filepath.Join(paths["race-signals"], "attacker-seen")
+	manifestJSON, _ := json.Marshal(manifest)
+	permitJSON, _ := json.Marshal(permit)
+	receiver = exec.Command(helperCopy, "-test.run=^TestC1V53FileSyncToRootBrokerSameUIDStageRace$")
+	receiver.Env = []string{"PATH=/usr/bin:/bin", "TMPDIR=" + paths["private-tmp"], "VIRKI_V53_CHILD=receiver",
+		"VIRKI_V53_MANIFEST=" + base64.StdEncoding.EncodeToString(manifestJSON),
+		"VIRKI_V53_PERMIT=" + base64.StdEncoding.EncodeToString(permitJSON),
+		"VIRKI_V53_PUBLIC=" + base64.StdEncoding.EncodeToString(permitPub),
+		"VIRKI_V53_GRPC_ADDR=" + grpcAddr, "VIRKI_V53_BROKER_SOCKET=" + socket,
+		"VIRKI_V53_ATTACK=" + attack, "VIRKI_V53_READY=" + ready, "VIRKI_V53_CONTINUE=" + cont,
+		"VIRKI_V53_AFTER_READY=" + afterReady, "VIRKI_V53_AFTER_CONTINUE=" + afterContinue}
+	receiver.Stdout, receiver.Stderr = os.Stdout, os.Stderr
+	receiver.ExtraFiles = []*os.File{stage.Stage}
+	receiver.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: v53ReceiverUID, Gid: v53ReceiverUID, Groups: []uint32{}}, Pdeathsig: syscall.SIGKILL}
+	if err := receiver.Start(); err != nil {
+		t.Fatal(err)
+	}
+
+	attacker = exec.Command(helperCopy, "-test.run=^TestC1V53FileSyncToRootBrokerSameUIDStageRace$")
+	attacker.Env = []string{"PATH=/usr/bin:/bin", "VIRKI_V53_CHILD=attacker", "VIRKI_V53_ATTACK=" + attack,
+		"VIRKI_V53_STAGE_PATH=" + stagePath, "VIRKI_V53_PROC_FD=/proc/" + strconv.Itoa(receiver.Process.Pid) + "/fd/3",
+		"VIRKI_V53_DEST_PATH=" + dest, "VIRKI_V53_SEEN=" + seen, "VIRKI_V53_READY=" + ready,
+		"VIRKI_V53_CONTINUE=" + cont, "VIRKI_V53_AFTER_READY=" + afterReady,
+		"VIRKI_V53_AFTER_CONTINUE=" + afterContinue, "VIRKI_V53_STOP=" + stop}
+	attacker.Stdout, attacker.Stderr = os.Stdout, os.Stderr
+	attacker.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: v53ReceiverUID, Gid: v53ReceiverUID, Groups: []uint32{}}, Pdeathsig: syscall.SIGKILL}
+	if err := attacker.Start(); err != nil {
+		t.Fatal(err)
+	}
+
+	brokerResult := make(chan error, 1)
+	go func() {
+		c, err := listener.AcceptUnix()
+		if err != nil {
+			brokerResult <- err
+			return
+		}
+		conn = c
+		record := localcontext.Consumption{Name: manifest.ContextName, WorkerID: manifest.WorkerID,
+			SessionID: manifest.SessionID, Generation: manifest.Nonce,
+			VertexDigest: "sha256:" + strings.Repeat("c", 64), SnapshotID: "snap-v53", VertexOutputIndex: 0}
+		err = PublishV53DevContextToV3(ctx, manager, paths["ledger"], c, receiver.Process.Pid,
+			v53ReceiverUID, v53ReceiverUID, int(stage.Stage.Fd()), dest, manifest, permit, permitPub, 7, 8, record)
+		ack := byte('O')
+		if err != nil {
+			ack = 'E'
+		}
+		_, ackErr := c.Write([]byte{ack})
+		brokerResult <- errors.Join(err, ackErr)
+	}()
+
+	if err := receiver.Wait(); err != nil {
+		t.Fatalf("V53 receiver/FileSync child failed: %v", err)
+	}
+	if err := <-brokerResult; err != nil {
+		t.Fatalf("V53 root broker rejected physical FileSync stage: %v", err)
+	}
+	if err := os.WriteFile(stop, []byte("stop"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := attacker.Wait(); err != nil {
+		t.Fatalf("V53 same-UID attacker child failed: %v", err)
+	}
+	if err := os.WriteFile(serverStop, []byte("stop"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.Wait(); err != nil {
+		t.Fatalf("V53 physical gRPC sender child failed: %v", err)
+	}
+	if _, err := os.Stat(seen); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("same-UID attacker accessed or changed stage/publication: %v", err)
+	}
+	if err := stage.Verify(v53ReceiverUID, v53ReceiverUID); err != nil {
+		t.Fatalf("root supervisor stage identity changed: %v", err)
+	}
+	got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != content {
+		t.Fatalf("published content differs from manifest: %q", got)
+	}
+	if _, _, _, err := scope.CausalInputs(); err == nil {
+		t.Fatal("one V53 context unexpectedly completed a four-context TEST scope")
+	}
+	log, err := os.ReadFile(filepath.Join(paths["ledger"], v40LogName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes := strings.Count(string(log), "\n"); bytes != 1 {
+		t.Fatalf("V53 durable V40 claims=%d want=1", bytes)
+	}
+}
