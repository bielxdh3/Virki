+func v53RunChild(t *testing.T, mode string) {
+	t.Helper()
+	switch mode {
+	case "grpc-server":
+		if os.Getuid() != int(v53SenderUID) || os.Geteuid() != int(v53SenderUID) {
+			t.Fatal("V53 gRPC sender is not running as the supervisor-pinned sender UID")
+		}
+		req := v15Request(os.Getenv("VIRKI_V53_SOURCE"), "app.js")
+		req.ContextName, req.WorkerID, req.SessionID, req.Nonce = "source", "worker-v53", "sess-source", strings.Repeat("b", 32)
+		snapshot, err := NewLinuxSealedSnapshotV15(context.Background(), req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := snapshot.Manifest(); got.Digest != os.Getenv("VIRKI_V53_EXPECTED_MANIFEST") {
+			t.Fatalf("V53 sender snapshot differs from root-pinned manifest: got=%s want=%s manifest=%+v", got.Digest, os.Getenv("VIRKI_V53_EXPECTED_MANIFEST"), got)
+		}
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		server := grpc.NewServer()
+		provider := NewSealedFSSyncProviderV15(snapshot)
+		provider.Register(server)
+		go func() { _ = server.Serve(listener) }()
+		if err := os.WriteFile(os.Getenv("VIRKI_V53_SERVER_READY"), []byte(listener.Addr().String()), 0600); err != nil {
+			t.Fatal(err)
+		}
+		v53WaitForFile(t, os.Getenv("VIRKI_V53_SERVER_STOP"), 30*time.Second)
+		server.GracefulStop()
+		_ = listener.Close()
+	case "receiver":
+		if os.Getuid() != int(v53ReceiverUID) || os.Geteuid() != int(v53ReceiverUID) {
+			t.Fatal("V53 receiver is not running as the supervisor-pinned receiver UID")
+		}
+		var manifest V15SealedManifest
+		var permit V15OwnerPermit
+		v53DecodeEnv(t, "VIRKI_V53_MANIFEST", &manifest)
+		v53DecodeEnv(t, "VIRKI_V53_PERMIT", &permit)
+		public, err := base64.StdEncoding.DecodeString(os.Getenv("VIRKI_V53_PUBLIC"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+		defer cancel()
+		cc, err := grpc.DialContext(ctx, os.Getenv("VIRKI_V53_GRPC_ADDR"),
+			grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithBlock())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer cc.Close()
+		caller := &v53DirectCaller{conn: cc}
+		policy := V24ReceiverCustodyPolicy{
+			RequireUnprivileged: true,
+			ExpectedReceiverUID: v53UintPtr(v53ReceiverUID), ExpectedReceiverGID: v53UintPtr(v53ReceiverUID),
+			ExpectedSenderUID: v53UintPtr(v53SenderUID), ExpectedSenderGID: v53UintPtr(v53SenderUID),
+			ForbiddenPeerUIDs: []uint32{v53SenderUID}, PrivateTempDir: os.Getenv("TMPDIR"),
+		}
+		barrier := func(ready, release string) func() error {
+			return func() error {
+				if err := os.WriteFile(ready, []byte("ready"), 0600); err != nil {
+					return err
+				}
+				return v53WaitForMarker(release, 10*time.Second)
+			}
+		}
+		var before, after func() error
+		switch os.Getenv("VIRKI_V53_ATTACK") {
+		case "during-receive":
+			before = barrier(os.Getenv("VIRKI_V53_READY"), os.Getenv("VIRKI_V53_CONTINUE"))
+		case "after-receive":
+			after = barrier(os.Getenv("VIRKI_V53_AFTER_READY"), os.Getenv("VIRKI_V53_AFTER_CONTINUE"))
+		case "during-publication":
+			before = barrier(os.Getenv("VIRKI_V53_READY"), os.Getenv("VIRKI_V53_CONTINUE"))
+		}
+		ledger := NewV15LocalReplayLedger(7)
+		opt := FSSendRequestOpt{Name: manifest.ContextName, FollowPaths: []string{"app.js"}}
+		if err := fssyncSealedV53DevWithHooks(ctx, caller, opt, manifest, permit,
+			ed25519.PublicKey(public), ledger, 3, os.Getenv("VIRKI_V53_BROKER_SOCKET"), policy, before, after); err != nil {
+			t.Fatal(err)
+		}
+	case "attacker":
+		stagePath := os.Getenv("VIRKI_V53_STAGE_PATH")
+		procFD := os.Getenv("VIRKI_V53_PROC_FD")
+		destPath := os.Getenv("VIRKI_V53_DEST_PATH")
+		seen := os.Getenv("VIRKI_V53_SEEN")
+		attack := os.Getenv("VIRKI_V53_ATTACK")
+		ready := os.Getenv("VIRKI_V53_READY")
+		if attack == "after-receive" {
+			ready = os.Getenv("VIRKI_V53_AFTER_READY")
+		}
+		v53WaitForFile(t, ready, 10*time.Second)
+		attempt := func() bool {
+			// Same-UID attacker tries to replace the supervisor stage pathname.
+			if err := os.Rename(stagePath, stagePath+"-attacker-moved"); err == nil {
+				_ = os.Mkdir(stagePath, 0700)
+				_ = os.WriteFile(filepath.Join(stagePath, "app.js"), []byte("EVIL"), 0600)
+				_ = os.WriteFile(seen, []byte("stage pathname replaced"), 0600)
+				return true
+			}
+			if err := os.WriteFile(filepath.Join(stagePath, "app.js"), []byte("EVIL"), 0600); err == nil {
+				_ = os.WriteFile(seen, []byte("stage content modified"), 0600)
+				return true
+			}
+			// Same-UID procfs descriptor theft must fail after PR_SET_DUMPABLE=0.
+			if f, err := os.Open(procFD); err == nil {
+				_ = f.Close()
+				_ = os.WriteFile(seen, []byte("receiver FD stolen through procfs"), 0600)
+				return true
+			}
+			// The final root-only publication must never be readable/writable by this UID.
+			if f, err := os.Open(filepath.Join(destPath, "app.js")); err == nil {
+				_ = f.Close()
+				_ = os.WriteFile(seen, []byte("protected publication visible"), 0600)
+				return true
+			}
+			if err := os.WriteFile(filepath.Join(destPath, "app.js"), []byte("EVIL"), 0600); err == nil {
+				_ = os.WriteFile(seen, []byte("protected publication modified"), 0600)
+				return true
+			}
+			return false
+		}
+		if attack != "during-publication" {
+			if attempt() {
+				return
+			}
+			if attack == "during-receive" {
+				_ = os.WriteFile(os.Getenv("VIRKI_V53_CONTINUE"), []byte("continue"), 0600)
+			}
+			if attack == "after-receive" {
+				_ = os.WriteFile(os.Getenv("VIRKI_V53_AFTER_CONTINUE"), []byte("continue"), 0600)
+			}
+			return
+		}
+		_ = os.WriteFile(os.Getenv("VIRKI_V53_CONTINUE"), []byte("continue"), 0600)
+		for {
+			if _, err := os.Stat(os.Getenv("VIRKI_V53_STOP")); err == nil {
+				return
+			}
+			if attempt() {
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+	default:
+		t.Fatalf("unknown V53 child mode %q", mode)
+	}
+}
