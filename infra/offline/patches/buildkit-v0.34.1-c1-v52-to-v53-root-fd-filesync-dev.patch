+func v53DecodeEnv(t *testing.T, name string, target any) {
+	t.Helper()
+	data, err := base64.StdEncoding.DecodeString(os.Getenv(name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, target); err != nil {
+		t.Fatal(err)
+	}
+}
