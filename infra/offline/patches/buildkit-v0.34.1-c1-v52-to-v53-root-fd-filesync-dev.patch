+// Negative control: the old V23/V24 check-then-rename-by-path algorithm
+// deterministically exposes an unverified replacement between the final
+// identity check and RENAME_NOREPLACE. This test records the vulnerable RED
+// outcome without weakening the positive V53 supervisor-FD security gates.
+func TestC1V53LegacySameUIDCheckRenameNegativeControl(t *testing.T) {
+	parent := t.TempDir()
+	stagePath := filepath.Join(parent, "stage")
+	if err := os.Mkdir(stagePath, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(stagePath, "app.js"), []byte("SAFE"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	parentFD, err := unix.Open(parent, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(parentFD)
+	stageFD, err := unix.Open(stagePath, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(stageFD)
+	m := v15PacketManifest()
+	m.Files = []V15FilePin{{Path: "app.js", SHA256: v15Hash([]byte("SAFE")), Size: 4}}
+	m.Bytes = 4
+	m.Digest = v15ManifestDigest(m)
+	if err := verifyV23StageTreeFD(stageFD, m); err != nil {
+		t.Fatal(err)
+	}
+	if err := verifyAndSyncV22Stage(stageFD, m); err != nil {
+		t.Fatal(err)
+	}
+	if err := requireV23StageNameIdentity(parentFD, stageFD, "stage"); err != nil {
+		t.Fatal(err)
+	}
+	// The attacker is a SEPARATE process sharing the test receiver's UID.
+	attack := exec.Command("/bin/sh", "-c",
+		`mv -- "$1" "$1-pinned" && mkdir -m 700 -- "$1" && printf EVIL > "$1/app.js"`,
+		"v53-same-uid-negative-control", stagePath)
+	if out, err := attack.CombinedOutput(); err != nil {
+		t.Fatalf("controlled same-UID rename attack: %v (%s)", err, out)
+	}
+	if err := unix.Renameat2(parentFD, "stage", parentFD, "published", unix.RENAME_NOREPLACE); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(filepath.Join(parent, "published", "app.js"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "EVIL" {
+		t.Fatalf("negative control did not trigger transient unsafe publication: %q", got)
+	}
+	if err := verifyV23StageTreeFD(stageFD, m); err != nil {
+		t.Fatalf("verified FD changed unexpectedly: %v", err)
+	}
+	if err := requireV23StageNameIdentity(parentFD, stageFD, "published"); err == nil {
+		t.Fatal("legacy post-publication check did not detect wrong inode")
+	}
+}
