+++ b/solver/llbsolver/local_context_oci_dag_test.go
@@ -0,0 +1,63 @@
+package llbsolver
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/opencontainers/go-digest"
+	specs "github.com/opencontainers/image-spec/specs-go"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+func TestLocalContextOCIDAGReadsStoredContent(t *testing.T) {
+	ctx := context.Background()
+	store, err := local.NewStore(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stored = map[digest.Digest][]byte{}
+	put := func(media string, raw []byte) ocispec.Descriptor {
+		d := ocispec.Descriptor{MediaType: media, Digest: digest.FromBytes(raw), Size: int64(len(raw))}
+		if err := content.WriteBlob(ctx, store, d.Digest.String(), bytes.NewReader(raw), d); err != nil {
+			t.Fatal(err)
+		}
+		stored[d.Digest] = raw
+		return d
+	}
+	encode := func(value any) []byte {
+		raw, err := json.Marshal(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return raw
+	}
+	layer := put(ocispec.MediaTypeImageLayer, make([]byte, 1024))
+	config := put(ocispec.MediaTypeImageConfig, []byte(`{"architecture":"amd64","os":"linux","rootfs":{"type":"layers","diff_ids":["`+layer.Digest.String()+`"]}}`))
+	manifest := put(ocispec.MediaTypeImageManifest, encode(ocispec.Manifest{Versioned: specs.Versioned{SchemaVersion: 2}, MediaType: ocispec.MediaTypeImageManifest, Config: config, Layers: []ocispec.Descriptor{layer}}))
+	index := put(ocispec.MediaTypeImageIndex, encode(ocispec.Index{Versioned: specs.Versioned{SchemaVersion: 2}, MediaType: ocispec.MediaTypeImageIndex, Manifests: []ocispec.Descriptor{manifest, manifest}}))
+	proof, err := localContextOCIDAGProof(ctx, store, index)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(proof.Nodes) != 4 || proof.Root.Digest != index.Digest.String() || proof.SchemaVersion != 2 || proof.ProofDigest == "" {
+		t.Fatal("incomplete OCI content graph")
+	}
+	var expected []byte
+	for _, node := range proof.Nodes {
+		expected = append(expected, stored[digest.Digest(node.Digest)]...)
+	}
+	if !bytes.Equal(expected, proof.BlobBytes) {
+		t.Fatal("OCI evidence does not contain the exact stored content")
+	}
+	// Normal content-store failure must not produce partial proof.
+	if err := store.Delete(ctx, layer.Digest); err != nil {
+		t.Fatal(err)
+	}
+	if incomplete, err := localContextOCIDAGProof(ctx, store, index); err == nil || incomplete != nil {
+		t.Fatal("missing stored content did not fail closed")
+	}
+}
