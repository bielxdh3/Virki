+	if err := manager.ContextConsumed(ctx, record); err == nil || !strings.Contains(err.Error(), "duplicate local context") {
+		t.Fatalf("V3 Manager did not retain the real published context: %v", err)
+	}
+	if _, _, _, err := scope.CausalInputs(); err == nil {
