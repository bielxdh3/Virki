+const (
+	vroaProtocolVersionV3 = uint32(3)
+	vroaMagicV3           = "VROA_V3\x00"
+	vroaApprovalMagicV3   = "VROA_AP3"
+	vroaEvidenceMagicV3   = "VROA_EV3"
+	vroaApprovalDomainV3  = "VIRKI_OFFLINE_OWNER_APPROVAL_V3\x00"
+	vroaReceiptDomainV3   = "VIRKI_C4_CANDIDATE_RECEIPT_V3\x00"
+	vroaMaxEvidenceBytes  = 4 * 1024 * 1024
+
+	vroaCmdV3Begin           = uint32(0x11)
+	vroaCmdV3VerifyCandidate = uint32(0x12)
+	vroaCmdV3Abort           = uint32(0x13)
+
+	vroaStatusOK                 = uint32(0)
+	vroaStatusErrStaleEpoch      = uint32(16)
+	vroaStatusErrScopeAborted    = uint32(21)
+	vroaStatusErrSigningDisabled = uint32(22)
+)
+
+// VROAV3SigningDisabledError indicates that C4 verified the approval, sealed
+// context streams, and evidence bundle, then denied receipt/release signing.
+type VROAV3SigningDisabledError struct {
+	Status uint32
+	Epoch  uint64
+}
+
+func (e *VROAV3SigningDisabledError) Error() string {
+	return fmt.Sprintf("C4 VROA_V3 verified candidate bytes but signing is disabled (status=%d, epoch=%d)", e.Status, e.Epoch)
+}
+
+// VROAV3Options configures the BuildKit-to-C4 VROA_V3 native client.
+type VROAV3Options struct {
+	Epoch             uint64
+	ApprovalPublicKey ed25519.PublicKey
+	ApprovalKeyID     string
+	ApprovalPinSHA256 string
+	ReceiptPublicKey  ed25519.PublicKey
+	ReceiptKeyID      string
+	ExporterPolicy    ExporterIntent
+	ExpectedImage     ImageDescriptor
+}
+
+type vroaV3ContextClaim struct {
+	Name         [32]byte
+	SessionID    [65]byte
+	Identity     [65]byte
+	TreeDigest   [73]byte
+	StreamDigest [73]byte
