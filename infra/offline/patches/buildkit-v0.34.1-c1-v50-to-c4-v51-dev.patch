+				if err := os.WriteFile(recKeyPath, receiptPriv, 0400); err != nil {
+					t.Fatal(err)
+				}
+				_ = os.Chmod(recKeyPath, 0400)
+				args = append(args, "--key-file", recKeyPath, "--key-id", "c4-test-receipt")
+			}
+
+			cmd := exec.Command(bin, args...)
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if cmd.Process != nil {
+					_ = cmd.Process.Signal(syscall.SIGTERM)
+					_ = cmd.Wait()
+				}
+			})
+			deadline := time.Now().Add(5 * time.Second)
+			for time.Now().Before(deadline) {
+				if _, err := os.Stat(sockPath); err == nil {
+					break
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+
+			// Production constructor must refuse same-UID socket and missing/identical keys.
+			if _, sameUIDErr := NewVROAV3Service(sockPath, uint32(os.Getuid()), VROAV3Options{
+				Epoch:             1,
+				ApprovalPublicKey: ownerPub,
+			}); sameUIDErr == nil {
+				t.Fatal("NewVROAV3Service must refuse same-UID socket")
+			}
+			if _, missingKeyErr := NewVROAV3Service(sockPath, 0, VROAV3Options{
+				Epoch:             1,
+				ApprovalKeyID:     "owner-test-key",
+				ApprovalPinSHA256: pinHex,
+				ExpectedImage:     imageDesc,
+			}); missingKeyErr == nil {
+				t.Fatal("NewVROAV3Service must fail closed when ApprovalPublicKey is missing")
+			}
+			if _, missingImgErr := NewVROAV3Service(sockPath, 0, VROAV3Options{
+				Epoch:             1,
+				ApprovalPublicKey: ownerPub,
+				ApprovalKeyID:     "owner-test-key",
+				ApprovalPinSHA256: pinHex,
+			}); missingImgErr == nil {
+				t.Fatal("NewVROAV3Service must fail closed when ExpectedImage is missing")
+			}
+			svc := &VROAV3Service{
+				socketChecker:   &UnixSocketService{path: sockPath, ownerUID: uint32(os.Getuid())},
+				socketPath:      sockPath,
+				devAllowSameUID: true,
+				scopes:          make(map[string]vroaV3ScopeState),
+				opt: VROAV3Options{
+					Epoch:             1,
+					ApprovalPublicKey: ownerPub,
+					ApprovalKeyID:     "owner-test-key",
+					ApprovalPinSHA256: pinHex,
+					ReceiptPublicKey:  receiptPub,
+					ReceiptKeyID:      "c4-test-receipt",
+					ExporterPolicy:    exporterIntent,
+					ExpectedImage:     imageDesc,
+				},
+			}
+
+			mgr, err := NewManager(svc, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, scope, err := mgr.BeginSolve(context.Background(), Binding{
+				JobID:            "job-buildkit-v3",
+				Role:             "runtime",
+				Nonce:            nonceHex,
+				ApprovalID:       "apr-buildkit-v3",
+				ApprovalEnvelope: base64.StdEncoding.EncodeToString(rawEnv),
+				Exporter:         exporterIntent,
+			})
+			if err != nil {
+				t.Fatalf("BeginSolve: %v", err)
+			}
+
+			for i, ctxName := range requiredContexts {
+				sum := sha256.Sum256(streams[i])
+				vSum := sha256.Sum256([]byte("vertex-" + ctxName))
+				vDigest := "sha256:" + hex.EncodeToString(vSum[:])
+				if err := mgr.ContextConsumed(ctx, Consumption{
+					Name:              ctxName,
+					WorkerID:          "worker-buildkit-1",
+					SessionID:         "sess-" + ctxName,
+					VertexDigest:      vDigest,
+					VertexOutputIndex: 0,
+					SnapshotID:        "snap-" + ctxName,
+					TreeDigestSchema:  LocalContextTreeDigestSchemaV2,
+					TreeDigest:        treeDigests[i],
+					StreamDigest:      "sha256:" + hex.EncodeToString(sum[:]),
+					StreamLength:      int64(len(streams[i])),
+					StreamBytes:       streams[i],
+					RegularFileBytes:  regularBytes[i],
+					EntryCount:        entryCounts[i],
+				}); err != nil {
+					t.Fatalf("ContextConsumed(%s): %v", ctxName, err)
+				}
+			}
+
+			var causalPaths []ContextPath
+			for i, ctxName := range requiredContexts {
+				vSum := sha256.Sum256([]byte("vertex-" + ctxName))
+				vDigest := "sha256:" + hex.EncodeToString(vSum[:])
+				causalPaths = append(causalPaths, ContextPath{
+					Name:               ctxName,
+					Generation:         nonceHex,
+					ContextIdentity:    "ctxid-" + ctxName,
+					SnapshotID:         "snap-" + ctxName,
+					TreeDigest:         treeDigests[i],
+					SourceVertexDigest: vDigest,
+					SourceOutputIndex:  0,
+					Edges: []CausalEdge{
+						{
+							ParentVertexDigest: "sha256:" + strings.Repeat("9", 64),
+							ParentOutputIndex:  0,
+							ParentInputIndex:   i,
+							ChildVertexDigest:  vDigest,
+							ChildOutputIndex:   0,
+						},
+					},
+				})
+			}
+			proof := CausalityProof{
+				SchemaVersion: 3,
+				Exporter:      exporterIntent,
+				Roots: []CausalRoot{
+					{
+						WorkerID:     "worker-buildkit-1",
+						RefID:        "ref-root-1",
+						VertexDigest: "sha256:" + strings.Repeat("9", 64),
+						OutputIndex:  0,
+						ContextPaths: causalPaths,
+					},
+				},
+			}
+			proof.ProofDigest, err = CausalityProofDigest(proof)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ociDAG.ProofDigest, err = OCIDAGProofDigest(*ociDAG)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			completeErr := scope.Complete(ctx, Output{
+				WorkerID:  "worker-buildkit-1",
+				Image:     imageDesc,
+				Causality: proof,
+				OCIDAG:    ociDAG,
+			})
+			if testBuild {
+				if completeErr != nil {
+					t.Fatalf("Complete in test build failed: %v", completeErr)
+				}
+				receipt, ok := svc.LastReceipt()
+				if !ok {
+					t.Fatal("expected verified DEV receipt")
+				}
+				if receipt.DeployAuthorized || receipt.WorkerReceiptPairAdmitted || receipt.ReleaseSignature {
+					t.Fatalf("receipt invariants violated: %+v", receipt)
+				}
+				if binary.Size(vroaV3ApprovalEnvelope{}) != 2669 {
+					t.Fatalf("unexpected approval envelope size: %d", binary.Size(vroaV3ApprovalEnvelope{}))
+				}
+			} else {
+				var disabledErr *VROAV3SigningDisabledError
+				if !errors.As(completeErr, &disabledErr) || disabledErr.Status != 22 {
+					t.Fatalf("expected VROAV3SigningDisabledError(22) in production build, got %v", completeErr)
+				}
+				if err := scope.Abort(ctx, errors.New("cleanup after production verification")); err != nil {
+					t.Fatalf("Abort after production verification: %v", err)
+				}
+			}
+		})
+	}
+}
