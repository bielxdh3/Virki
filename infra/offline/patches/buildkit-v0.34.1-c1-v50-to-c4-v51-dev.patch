--- /dev/null
+++ b/cmd/virki-c1-dev-stream/main.go
@@ -0,0 +1,44 @@
+// A DEV-only read-only bridge from BuildKit's actual worker-side context
+// stream producer to the isolated C4 test. It never authorizes FileSync,
+// publishes an image, issues a receipt, or runs a daemon.
+package main
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/moby/buildkit/session/filesync"
+)
+
+func main() {
+	if len(os.Args) != 3 {
+		fmt.Fprintln(os.Stderr, "usage: virki-c1-dev-stream <physical-directory> <canonical-context-name>")
+		os.Exit(2)
+	}
+	observation, stream, err := filesync.BuildLocalContextStream(os.Args[1], os.Args[2], filesync.MaxLocalContextStreamBytes)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "BuildKit C1 physical stream:", err)
+		os.Exit(1)
+	}
+	proof := struct {
+		Name             string
+		TreeDigest       string
+		StreamDigest     string
+		StreamBase64     string
+		RegularFileBytes int64
+		EntryCount       int
+	}{
+		Name:             observation.Name,
+		TreeDigest:       observation.TreeDigest,
+		StreamDigest:     observation.StreamDigest,
+		StreamBase64:     base64.StdEncoding.EncodeToString(stream),
+		RegularFileBytes: observation.RegularFileBytes,
+		EntryCount:       observation.EntryCount,
+	}
+	if err := json.NewEncoder(os.Stdout).Encode(proof); err != nil {
+		fmt.Fprintln(os.Stderr, "encode DEV C1 stream:", err)
+		os.Exit(1)
+	}
+}
