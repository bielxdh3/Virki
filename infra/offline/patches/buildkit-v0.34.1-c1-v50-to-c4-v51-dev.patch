+func testVROAV3OCIProof() *OCIDAGProof {
+	desc := func(media string, blob []byte) ImageDescriptor {
+		sum := sha256.Sum256(blob)
+		return ImageDescriptor{MediaType: media, Digest: "sha256:" + hex.EncodeToString(sum[:]), Size: int64(len(blob))}
+	}
+	layer := make([]byte, 1024)
+	ld := desc("application/vnd.oci.image.layer.v1.tar", layer)
+	config := []byte(fmt.Sprintf(`{"architecture":"amd64","os":"linux","rootfs":{"type":"layers","diff_ids":["%s"]}}`, ld.Digest))
+	cd := desc("application/vnd.oci.image.config.v1+json", config)
+	manifest := []byte(fmt.Sprintf(`{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","config":{"mediaType":"%s","digest":"%s","size":%d},"layers":[{"mediaType":"%s","digest":"%s","size":%d}]}`, cd.MediaType, cd.Digest, cd.Size, ld.MediaType, ld.Digest, ld.Size))
+	md := desc("application/vnd.oci.image.manifest.v1+json", manifest)
+	proof := &OCIDAGProof{SchemaVersion: 2, Root: md}
+	for i, blob := range [][]byte{manifest, config, layer} {
+		d := []ImageDescriptor{md, cd, ld}[i]
+		node := OCIDAGNode{MediaType: d.MediaType, Digest: d.Digest, Size: d.Size}
+		if i == 0 {
+			node.Role = "root"
+		}
+		proof.Nodes = append(proof.Nodes, node)
+		proof.BlobBytes = append(proof.BlobBytes, blob...)
+	}
+	return proof
+}
