+}
+
+type vroaV3ApprovalEnvelope struct {
+	Magic                  [8]byte
+	Version                uint32
+	Epoch                  uint64
+	ExpiresUnix            uint64
+	KeyID                  [65]byte
+	PublicKeyPinSHA256     [65]byte
+	ApprovalID             [65]byte
