+	return errors.New("V51 fixture deliberately forbids C4 candidate completion")
+}
+func (s *v51DEVScope) Abort(_ context.Context, _, _ string) error { return nil }
+
+func TestC1V51RealProtectedPublisherFeedsV3Manager(t *testing.T) {
+	const uid uint32 = 60018
+	const content = "V51-PHYSICAL-PROTECTED-BYTES"
+	if os.Getenv("VIRKI_V51_TEST_CHILD") == "sender" {
+		if os.Getuid() != int(uid) {
