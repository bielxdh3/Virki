diff --git a/solver/llbsolver/local_context_oci_dag.go b/solver/llbsolver/local_context_oci_dag.go
new file mode 100644
index 0000000..25beff5
--- /dev/null
+++ b/solver/llbsolver/local_context_oci_dag.go
@@ -0,0 +1,150 @@
+package llbsolver
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/moby/buildkit/util/localcontext"
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// Only ordinary OCI/Docker image descriptor graphs are admitted by V3 DEV.
+// Unknown artifact/subject graphs must not be silently treated as leaves.
+func localContextOCIKind(media string) string {
+	switch media {
+	case ocispec.MediaTypeImageManifest, "application/vnd.docker.distribution.manifest.v2+json":
+		return "manifest"
+	case ocispec.MediaTypeImageIndex, "application/vnd.docker.distribution.manifest.list.v2+json":
+		return "index"
+	case ocispec.MediaTypeImageConfig, "application/vnd.docker.container.image.v1+json":
+		return "config"
+	case "application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip", "application/vnd.oci.image.layer.v1.tar+zstd",
+		"application/vnd.oci.image.layer.nondistributable.v1.tar", "application/vnd.oci.image.layer.nondistributable.v1.tar+gzip", "application/vnd.oci.image.layer.nondistributable.v1.tar+zstd",
+		"application/vnd.docker.image.rootfs.diff.tar", "application/vnd.docker.image.rootfs.diff.tar.gzip", "application/vnd.docker.image.rootfs.diff.tar.zstd",
+		"application/vnd.docker.image.rootfs.foreign.diff.tar", "application/vnd.docker.image.rootfs.foreign.diff.tar.gzip":
+		return "layer"
+	default:
+		return ""
+	}
+}
+
+func localContextOCIDAGProof(ctx context.Context, provider content.Provider, root ocispec.Descriptor) (*localcontext.OCIDAGProof, error) {
+	dag := &localcontext.OCIDAGProof{SchemaVersion: 2, Root: localcontext.ImageDescriptor{MediaType: root.MediaType, Digest: root.Digest.String(), Size: root.Size}}
+	seen := make(map[digest.Digest]localcontext.OCIDAGNode)
+	active := make(map[digest.Digest]bool)
+	edges := 0
+	var visit func(ocispec.Descriptor, int) error
+	visit = func(desc ocispec.Descriptor, depth int) error {
+		if depth > 0 {
+			edges++
+			if edges > localcontext.OCIDAGMaxEdges {
+				return fmt.Errorf("OCI DEV evidence exceeds edge budget")
+			}
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		kind := localContextOCIKind(desc.MediaType)
+		if depth > 64 || kind == "" || desc.Size <= 0 || desc.Digest.Validate() != nil || desc.Digest.Algorithm() != digest.SHA256 || active[desc.Digest] {
+			return fmt.Errorf("invalid or unsupported OCI descriptor %s", desc.Digest)
+		}
+		if previous, ok := seen[desc.Digest]; ok {
+			if previous.Size != desc.Size || previous.MediaType != desc.MediaType {
+				return fmt.Errorf("conflicting OCI descriptor %s", desc.Digest)
+			}
+			return nil
+		}
+		if len(dag.Nodes) >= localcontext.OCIDAGMaxNodes || desc.Size > int64(localcontext.OCIDAGArchiveMaxBytes-len(dag.BlobBytes)) ||
+			((kind == "manifest" || kind == "index") && (desc.Size == 0 || desc.Size > 4*1024*1024)) {
+			return fmt.Errorf("OCI DEV evidence exceeds bounded archive limits")
+		}
+		reader, err := provider.ReaderAt(ctx, desc)
+		if err != nil {
+			return err
+		}
+		if reader.Size() != desc.Size {
+			_ = reader.Close()
+			return fmt.Errorf("OCI stored size differs for %s", desc.Digest)
+		}
+		start := len(dag.BlobBytes)
+		dag.BlobBytes = append(dag.BlobBytes, make([]byte, int(desc.Size))...)
+		blob := dag.BlobBytes[start:]
+		_, err = io.ReadFull(io.NewSectionReader(reader, 0, desc.Size), blob)
+		closeErr := reader.Close()
+		if err != nil {
+			return err
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if digest.FromBytes(blob) != desc.Digest {
+			return fmt.Errorf("OCI stored digest differs for %s", desc.Digest)
+		}
+		node := localcontext.OCIDAGNode{MediaType: desc.MediaType, Digest: desc.Digest.String(), Size: desc.Size}
+		if depth == 0 {
+			node.Role = "root"
+		}
+		dag.Nodes = append(dag.Nodes, node)
+		seen[desc.Digest] = node
+		active[desc.Digest] = true
+		defer delete(active, desc.Digest)
+		switch kind {
+		case "manifest":
+			var manifest ocispec.Manifest
+			if err := json.Unmarshal(blob, &manifest); err != nil {
+				return err
+			}
+			if manifest.SchemaVersion != 2 || (manifest.MediaType != "" && manifest.MediaType != desc.MediaType) || manifest.Subject != nil || manifest.ArtifactType != "" || manifest.Layers == nil || localContextOCIKind(manifest.Config.MediaType) != "config" {
+				return fmt.Errorf("unsupported OCI image manifest")
+			}
+			if len(manifest.Layers) > localcontext.OCIDAGMaxNodes {
+				return fmt.Errorf("OCI manifest has too many layers")
+			}
+			if err := visit(manifest.Config, depth+1); err != nil {
+				return err
+			}
+			for _, layer := range manifest.Layers {
+				if localContextOCIKind(layer.MediaType) != "layer" {
+					return fmt.Errorf("unsupported OCI image layer")
+				}
+				if err := visit(layer, depth+1); err != nil {
+					return err
+				}
+			}
+		case "index":
+			var index ocispec.Index
+			if err := json.Unmarshal(blob, &index); err != nil {
+				return err
+			}
+			if index.SchemaVersion != 2 || (index.MediaType != "" && index.MediaType != desc.MediaType) || index.Subject != nil || index.ArtifactType != "" || len(index.Manifests) == 0 {
+				return fmt.Errorf("unsupported OCI image index")
+			}
+			if len(index.Manifests) > localcontext.OCIDAGMaxNodes {
+				return fmt.Errorf("OCI index has too many manifests")
+			}
+			for _, child := range index.Manifests {
+				kind := localContextOCIKind(child.MediaType)
+				if kind != "index" && kind != "manifest" {
+					return fmt.Errorf("unsupported OCI index member")
+				}
+				if err := visit(child, depth+1); err != nil {
+					return err
+				}
+			}
+		}
+		return nil
+	}
+	if provider == nil || (localContextOCIKind(root.MediaType) != "index" && localContextOCIKind(root.MediaType) != "manifest") {
+		return nil, fmt.Errorf("missing OCI image root or content provider")
+	}
+	if err := visit(root, 0); err != nil {
+		return nil, err
+	}
+	var err error
+	dag.ProofDigest, err = localcontext.OCIDAGProofDigest(*dag)
+	return dag, err
+}
