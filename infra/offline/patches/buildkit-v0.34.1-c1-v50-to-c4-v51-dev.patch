+// Match the deterministic FileSync stream and tree encodings used by the
+// immutable worker observation; this fixture does not use a real build worker.
+func testVROAV3ContextStream(name string) ([]byte, string, int64) {
+	var stream, tree bytes.Buffer
+	stream.WriteString("virki-context-stream-v1\x00")
+	tree.WriteString("buildkit-worker-local-context-v2\x00")
+	writeUint := func(b *bytes.Buffer, value uint64) {
+		var encoded [8]byte
+		binary.BigEndian.PutUint64(encoded[:], value)
+		b.Write(encoded[:])
+	}
+	writeSized := func(b *bytes.Buffer, value string) {
+		writeUint(b, uint64(len(value)))
+		b.WriteString(value)
+	}
+	writeSized(&stream, name)
+	data := []byte("DEV fixture for " + name + "\n")
+	for _, b := range []*bytes.Buffer{&stream, &tree} {
+		b.WriteByte('F')
+		writeSized(b, "evidence.txt")
+		writeUint(b, 0644)
+		writeUint(b, uint64(len(data)))
+	}
+	stream.Write(data)
+	sum := sha256.Sum256(data)
+	tree.Write(sum[:])
+	treeSum := sha256.Sum256(tree.Bytes())
+	return stream.Bytes(), "sha256:" + hex.EncodeToString(treeSum[:]), int64(len(data))
+}
