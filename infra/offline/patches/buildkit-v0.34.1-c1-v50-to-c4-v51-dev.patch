+//go:build linux
+
+package localcontext
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+// Run the real BuildKit C1 filesystem producer in a separate process so that
+// the localcontext package does not import filesync and create an import cycle.
+// The generated bytes are used by the existing manager -> native C4 test.
+func testVROAV3PhysicalContextStream(t *testing.T, name string) ([]byte, string, int64, int) {
+	t.Helper()
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, "sub"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	data := []byte("DEV BuildKit physical context " + name + "\n")
+	if err := os.WriteFile(filepath.Join(root, "sub", "evidence.txt"), data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("sub/evidence.txt", filepath.Join(root, "zz-link")); err != nil {
+		t.Fatal(err)
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	repoRoot := filepath.Clean(filepath.Join(cwd, "..", ".."))
+	binary := filepath.Join(runtime.GOROOT(), "bin", "go")
+	cmd := exec.Command(binary, "run", "-mod=vendor", "./cmd/virki-c1-dev-stream", root, name)
+	cmd.Dir = repoRoot
+	cmd.Env = append(os.Environ(), "GOPROXY=off", "GOSUMDB=off", "GOTOOLCHAIN=local")
+	raw, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("real BuildKit C1 producer failed: %v: %s", err, raw)
+	}
+	var proof struct {
+		Name             string
+		TreeDigest       string
+		StreamDigest     string
+		StreamBase64     string
+		RegularFileBytes int64
+		EntryCount       int
+	}
+	if err := json.Unmarshal(raw, &proof); err != nil {
+		t.Fatalf("real BuildKit C1 producer emitted invalid JSON: %v", err)
+	}
+	stream, err := base64.StdEncoding.DecodeString(proof.StreamBase64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if proof.Name != name || proof.EntryCount != 3 || proof.RegularFileBytes != int64(len(data)) {
+		t.Fatal(fmt.Sprintf("real BuildKit C1 producer returned inconsistent physical records: %+v", proof))
+	}
+	return stream, proof.TreeDigest, proof.RegularFileBytes, proof.EntryCount
+}
