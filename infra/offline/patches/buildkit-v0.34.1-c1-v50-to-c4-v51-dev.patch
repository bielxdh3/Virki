+			t.Fatal(err)
+		}
+		defer source.Close()
+		conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: os.Getenv("VIRKI_V51_SOCKET"), Net: "unix"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		if _, _, err := conn.WriteMsgUnix([]byte{'V'}, unix.UnixRights(int(source.Fd())), nil); err != nil {
+			t.Fatal(err)
+		}
