+++ b/session/filesync/sealed_publication_v51_v3_linux.go
@@ -0,0 +1,150 @@
+//go:build linux && virki_c1c4_dev
+
+package filesync
+
+import (
+	"context"
+	"crypto/ed25519"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+
+	"github.com/moby/buildkit/util/localcontext"
+	"golang.org/x/sys/unix"
+)
+
+// PublishV51DevContextToV3 is a deliberately DEV-build-tagged composition of
+// the REAL V50 authenticated-SCM_RIGHTS/V40 durable-claim/V36 root publisher
+// and the REAL V3 Manager.ContextConsumed admission point.
+//
+// The V15 permit remains a synthetic C1 test-domain permit: it is NOT a C4
+// owner approval. The caller MUST independently BeginSolve with the V3
+// service and an actual V3-domain approval before calling this function.
+// This function never signs, exports an image, completes a solve, deploys, or
+// returns an owner authorization. Production builds do not contain it.
+//
+// The solver-provided vertex/snapshot metadata is not independently proven
+// here. A later actual solver/OCI proof is still mandatory for C4 completion.
+func PublishV51DevContextToV3(ctx context.Context, manager *localcontext.Manager,
+	ledgerDir string, conn *net.UnixConn, expectedPID int,
+	expectedUID, expectedGID uint32, dest string, manifest V15SealedManifest,
+	permit V15OwnerPermit, trustedV15Public ed25519.PublicKey,
+	minimumEpoch, maximumEpoch uint64, record localcontext.Consumption) error {
+	if ctx == nil || manager == nil || conn == nil || os.Getuid() != 0 || os.Geteuid() != 0 {
+		return errors.New("V51 DEV requires an authorized solve context, Manager, accepted peer and root broker")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if record.Name != manifest.ContextName || record.WorkerID != manifest.WorkerID ||
+		record.SessionID != manifest.SessionID || record.Name == "" {
+		return errors.New("V51 DEV worker/context/session differs from frozen V15 manifest")
+	}
+	// No bytes from the receiver and no user-controlled FD are passed to V3
+	// directly. V39 first consumes the V40 permit and V36 publishes a fresh
+	// root-owned verified copy in a separately protected directory.
+	if err := publishV39FromAuthorizedTestPeer(ledgerDir, conn, expectedPID, expectedUID,
+		expectedGID, dest, manifest, permit, trustedV15Public, minimumEpoch, maximumEpoch); err != nil {
+		return fmt.Errorf("V51 DEV protected V50 publication refused: %w", err)
+	}
+	observation, stream, err := v51MeasureProtectedPublication(dest, manifest)
+	if err != nil {
+		// The V40 permit is already consumed: never retry automatically.
+		return fmt.Errorf("V51 DEV published but not V3-admitted, new authorization required: %w", err)
+	}
+	if record.TreeDigest != "" && record.TreeDigest != observation.TreeDigest ||
+		record.StreamDigest != "" && record.StreamDigest != observation.StreamDigest ||
+		record.StreamLength != 0 && record.StreamLength != observation.StreamLength ||
+		record.RegularFileBytes != 0 && record.RegularFileBytes != observation.RegularFileBytes ||
+		record.EntryCount != 0 && record.EntryCount != observation.EntryCount {
+		return errors.New("V51 DEV caller metadata differs from measured root-owned publication")
+	}
+	record.TreeDigestSchema = observation.TreeDigestSchema
+	record.TreeDigest = observation.TreeDigest
+	record.StreamDigest = observation.StreamDigest
+	record.StreamLength = observation.StreamLength
+	record.StreamBytes = stream
+	record.RegularFileBytes = observation.RegularFileBytes
+	record.EntryCount = observation.EntryCount
+	if err := manager.ContextConsumed(ctx, record); err != nil {
+		// On V3 rejection the V40 claim remains consumed and the protected
+		// destination remains inert; we do not try to undo durable authority.
+		return fmt.Errorf("V51 DEV published bytes refused by independently authorized V3 scope: %w", err)
+	}
+	return nil
+}
+
+// v51MeasureProtectedPublication pins the exact V36 output after the final
+// durable commit and checks exact manifest membership before and after the
+// physical stream read. Every ancestor and the immediate parent are protected
+// from nonroot rename; the source FD never enters this call. The root owner
+// itself is trusted only within the explicitly isolated DEV threat model.
+func v51MeasureProtectedPublication(dest string, manifest V15SealedManifest) (LocalContextObservation, []byte, error) {
+	if os.Getuid() != 0 || os.Geteuid() != 0 || !filepath.IsAbs(dest) ||
+		filepath.Clean(dest) != dest || dest == "/" ||
+		manifest.Digest == "" || manifest.Digest != v15ManifestDigest(manifest) {
+		return LocalContextObservation{}, nil, errors.New("V51 DEV requires root, canonical destination and frozen V15 manifest")
+	}
+	parent, name := filepath.Dir(dest), filepath.Base(dest)
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	defer unix.Close(rootFD)
+	if err := validateV24TrustedSupervisorAncestors(rootFD, parent); err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	parentFD, err := v38OpenRootRecoveryDirectory(rootFD, parent)
+	if err != nil {
+		return LocalContextObservation{}, nil, fmt.Errorf("V51 DEV publication parent not pinned: %w", err)
+	}
+	defer unix.Close(parentFD)
+	var parentStat unix.Stat_t
+	if err := unix.Fstat(parentFD, &parentStat); err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	if parentStat.Mode&unix.S_IFMT != unix.S_IFDIR || parentStat.Uid != 0 ||
+		parentStat.Mode&07777 != 0700 {
+		return LocalContextObservation{}, nil, errors.New("V51 DEV publication parent is not root-only")
+	}
+	fd, err := v38OpenRootRecoveryDirectory(parentFD, name)
+	if err != nil {
+		return LocalContextObservation{}, nil, fmt.Errorf("V51 DEV published root is not a pinned protected directory: %w", err)
+	}
+	defer unix.Close(fd)
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != 0 || st.Mode&07777 != 0700 {
+		return LocalContextObservation{}, nil, errors.New("V51 DEV published directory is not root-owned 0700")
+	}
+	verify := func() error {
+		if err := requireV23StageNameIdentity(parentFD, fd, name); err != nil {
+			return err
+		}
+		if err := verifyV23StageTreeFD(fd, manifest); err != nil {
+			return err
+		}
+		return verifyAndSyncV22Stage(fd, manifest)
+	}
+	if err := verify(); err != nil {
+		return LocalContextObservation{}, nil, fmt.Errorf("V51 DEV protected publication prestream verification refused: %w", err)
+	}
+	// This pathname is in a verified root-only parent, with a pinned root FD.
+	// The stream never comes from the mutable receiver's original source.
+	observation, stream, err := BuildLocalContextStream(dest, manifest.ContextName, MaxLocalContextStreamBytes)
+	if err != nil {
+		return LocalContextObservation{}, nil, err
+	}
+	if err := verify(); err != nil {
+		return LocalContextObservation{}, nil, fmt.Errorf("V51 DEV protected publication poststream verification refused: %w", err)
+	}
+	if observation.RegularFileBytes != manifest.Bytes || observation.EntryCount < len(manifest.Files) ||
+		int64(len(stream)) != observation.StreamLength || len(stream) == 0 {
+		return LocalContextObservation{}, nil, errors.New("V51 DEV published context stream does not match V15 file budget")
+	}
+	return observation, stream, nil
+}
