+	Role                      string   `json:"role"`
+	Nonce                     string   `json:"nonce"`
+	SourceCommit              string   `json:"sourceCommit,omitempty"`
+	BuildPlanSHA256           string   `json:"buildPlanSha256,omitempty"`
+	ExecutablePolicySHA256    string   `json:"executablePolicySha256,omitempty"`
+	ExporterIntentSHA256      string   `json:"exporterIntentSha256,omitempty"`
+	FileSyncManifestSHA256    string   `json:"fileSyncManifestSha256,omitempty"`
+	WorkerID                  string   `json:"workerId"`
+	OutputImageID             string   `json:"outputImageId"`
+	ContextTreeDigests        []string `json:"contextTreeDigests,omitempty"`
+	ContextStreamDigests      []string `json:"contextStreamDigests,omitempty"`
+	ContextStreamLengths      []uint64 `json:"contextStreamLengths,omitempty"`
+	SequenceNumber            uint64   `json:"sequenceNumber"`
+	Epoch                     uint64   `json:"epoch"`
+	DeployAuthorized          bool     `json:"deployAuthorized"`
+	WorkerReceiptPairAdmitted bool     `json:"workerReceiptPairAdmitted"`
+	ReleaseSignature          bool     `json:"releaseSignature"`
+}
+
+type vroaV3ScopeState struct {
+	nonce    string
+	epoch    uint64
+	envelope vroaV3ApprovalEnvelope
+	rawEnv   []byte
+	envSHA   string
+}
+
+// VROAV3Service implements Service over the native C4 VROA_V3 SCM_RIGHTS wire protocol.
+type VROAV3Service struct {
+	socketChecker   *UnixSocketService
+	socketPath      string
+	opt             VROAV3Options
+	devAllowSameUID bool
+
+	mu          sync.Mutex
+	scopes      map[string]vroaV3ScopeState
+	lastReceipt *VROAV3CandidateReceipt
+}
+
+// NewVROAV3Service creates a VROA_V3 native C4 client bound to socketPath and ownerUID.
+func NewVROAV3Service(socketPath string, ownerUID uint32, opt VROAV3Options) (*VROAV3Service, error) {
+	checker := &UnixSocketService{
+		path:                  socketPath,
+		ownerUID:              ownerUID,
+		allowGroupSocketWrite: true,
+	}
+	if err := checker.verifySocketPath(); err != nil {
+		return nil, err
+	}
+	if opt.Epoch == 0 {
+		return nil, errors.New("VROA_V3 requires a positive active epoch")
+	}
+	if len(opt.ApprovalPublicKey) != ed25519.PublicKeySize {
+		return nil, errors.New("VROA_V3 requires a 32-byte Ed25519 approval public key")
+	}
+	if opt.ApprovalKeyID == "" || opt.ApprovalPinSHA256 == "" {
+		return nil, errors.New("VROA_V3 requires approvalKeyID and approvalPinSHA256")
+	}
+	if err := validateImageDescriptor(opt.ExpectedImage); err != nil {
+		return nil, fmt.Errorf("VROA_V3 requires a complete expected image descriptor: %w", err)
+	}
+	if len(opt.ReceiptPublicKey) != 0 {
+		if len(opt.ReceiptPublicKey) != ed25519.PublicKeySize {
+			return nil, errors.New("VROA_V3 receipt public key must be 32 bytes when set")
+		}
+		if bytes.Equal(opt.ReceiptPublicKey, opt.ApprovalPublicKey) ||
+			opt.ReceiptKeyID == opt.ApprovalKeyID {
+			return nil, errors.New("VROA_V3 receipt key and approval key must be distinct")
+		}
+	}
+	return &VROAV3Service{
+		socketChecker: checker,
+		socketPath:    socketPath,
+		opt:           opt,
+		scopes:        make(map[string]vroaV3ScopeState),
+	}, nil
+}
+
+// LastReceipt returns a copy of the most recently verified DEV receipt, if any.
+func (s *VROAV3Service) LastReceipt() (VROAV3CandidateReceipt, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.lastReceipt == nil {
+		return VROAV3CandidateReceipt{}, false
+	}
+	return *s.lastReceipt, true
+}
+
+func (s *VROAV3Service) Begin(ctx context.Context, binding Binding) (Authorization, error) {
+	rawEnv, err := base64.StdEncoding.DecodeString(binding.ApprovalEnvelope)
+	if err != nil {
+		return Authorization{}, fmt.Errorf("decode VROA_V3 approval envelope: %w", err)
+	}
+	env, err := s.decodeAndVerifyApproval(rawEnv, binding)
+	if err != nil {
+		return Authorization{}, err
+	}
+	if err := validateImageDescriptor(s.opt.ExpectedImage); err != nil {
+		return Authorization{}, fmt.Errorf("VROA_V3 requires a complete expected image descriptor: %w", err)
+	}
+	if s.opt.ExpectedImage.Digest != vroaCString(env.OutputImageID[:]) {
+		return Authorization{}, errors.New("VROA_V3 expected image digest does not match signed approval")
+	}
+	envSum := sha256.Sum256(rawEnv)
+	envSHA := hex.EncodeToString(envSum[:])
+
+	approvalFD, err := createSealedMemfdV3("virki-v3-approval", rawEnv)
+	if err != nil {
+		return Authorization{}, err
+	}
+	defer func() { _ = syscall.Close(approvalFD) }()
+
+	var req vroaV3RequestFrame
+	copy(req.Magic[:], vroaMagicV3)
+	req.Version = vroaProtocolVersionV3
+	req.Cmd = vroaCmdV3Begin
+	req.Epoch = s.opt.Epoch
+	req.SessionID = env.WorkerID
+	req.JobID = env.JobID
+	req.Role = env.Role
+	req.Nonce = env.Nonce
+	req.SourceCommit = env.SourceCommit
+	req.BuildPlanSHA256 = env.BuildPlanSHA256
+	req.ExecutablePolicySHA256 = env.ExecutablePolicySHA256
+	req.OutputImageID = env.OutputImageID
+	req.ApprovalKeyID = env.KeyID
+	req.ApprovalID = env.ApprovalID
+	req.ApprovalSerial = env.ApprovalSerial
+	req.ArchiveSHA256 = env.FileSyncManifestSHA256
+	if err := vroaSetFixedString(req.ApprovalEnvelopeSHA256[:], envSHA); err != nil {
+		return Authorization{}, err
+	}
+	var totalBytes uint64
+	for i := range 4 {
+		req.ExpectedTreeDigests[i] = env.Contexts[i].TreeDigest
+		req.ExpectedStreamDigests[i] = env.Contexts[i].StreamDigest
+		req.ExpectedStreamLengths[i] = env.Contexts[i].StreamLength
+		if env.Contexts[i].StreamLength > math.MaxUint64-totalBytes {
+			return Authorization{}, errors.New("VROA_V3 archive byte count overflow")
+		}
+		totalBytes += env.Contexts[i].StreamLength
+	}
+	req.ArchiveBytes = totalBytes
+
+	resp, err := s.sendV3Request(ctx, req, []int{approvalFD})
+	if err != nil {
+		return Authorization{}, err
+	}
+	if resp.Status != vroaStatusOK {
+		return Authorization{}, fmt.Errorf("C4 V3_BEGIN refused request with status %d", resp.Status)
+	}
+	scopeToken := vroaCString(resp.ScopeToken[:])
+	if len(scopeToken) != 64 {
+		return Authorization{}, errors.New("C4 V3_BEGIN returned invalid scope token")
+	}
+
+	s.mu.Lock()
+	s.scopes[scopeToken] = vroaV3ScopeState{
+		nonce:    vroaCString(env.Nonce[:]),
+		epoch:    resp.Epoch,
+		envelope: env,
+		rawEnv:   append([]byte(nil), rawEnv...),
+		envSHA:   envSHA,
+	}
+	s.mu.Unlock()
+
+	identities := make(map[string]string, 4)
+	treeDigests := make(map[string]string, 4)
+	sessionIDs := make(map[string]string, 4)
+	for i := range 4 {
+		name := vroaCString(env.Contexts[i].Name[:])
+		identities[name] = vroaCString(env.Contexts[i].Identity[:])
+		treeDigests[name] = vroaCString(env.Contexts[i].TreeDigest[:])
+		sessionIDs[name] = vroaCString(env.Contexts[i].SessionID[:])
+	}
+	exporterPolicy := s.opt.ExporterPolicy
+	if exporterPolicy.Type == "" {
+		exporterPolicy = binding.Exporter
+	}
+	return Authorization{
+		Token:                   scopeToken,
+		Generation:              vroaCString(env.Nonce[:]),
+		WorkerID:                vroaCString(env.WorkerID[:]),
+		ContextIdentities:       identities,
+		ContextTreeDigestSchema: LocalContextTreeDigestSchemaV2,
+		ContextTreeDigests:      treeDigests,
+		ContextSessionIDsV8:     sessionIDs,
+		ExporterPolicy:          exporterPolicy,
+		ExpectedImage:           s.opt.ExpectedImage,
+		ExpiresAt:               time.Unix(int64(env.ExpiresUnix), 0).UTC(),
+	}, nil
+}
+
+const LocalContextTreeDigestSchemaV2 = "buildkit-worker-local-context-v2"
+
+func (s *VROAV3Service) Complete(ctx context.Context, completion Completion) error {
+	s.mu.Lock()
+	scopeState, ok := s.scopes[completion.Authorization.Token]
+	s.mu.Unlock()
+	if !ok {
+		return errors.New("C4 VROA_V3 scope token not found in active service state")
+	}
+
+	byName := make(map[string]Consumption, len(completion.Contexts))
+	for _, item := range completion.Contexts {
+		byName[item.Name] = item
+	}
+
+	var fds [7]int
+	for i := range fds {
+		fds[i] = -1
+	}
+	defer func() {
+		for _, fd := range fds {
+			if fd >= 0 {
+				_ = syscall.Close(fd)
+			}
+		}
+	}()
+
+	var header vroaV3EvidenceHeader
+	copy(header.Magic[:], vroaEvidenceMagicV3)
+	header.Version = vroaProtocolVersionV3
+	if err := vroaSetFixedString(header.ApprovalEnvelopeSHA256[:], scopeState.envSHA); err != nil {
+		return err
+	}
+	header.JobID = scopeState.envelope.JobID
+	header.Role = scopeState.envelope.Role
+	header.Nonce = scopeState.envelope.Nonce
+	header.WorkerID = scopeState.envelope.WorkerID
+	if err := vroaSetFixedString(header.OutputImageID[:], completion.Output.Image.Digest); err != nil {
+		return err
+	}
+	header.ExporterIntentSHA256 = scopeState.envelope.ExporterIntentSHA256
+	header.FileSyncManifestSHA256 = scopeState.envelope.FileSyncManifestSHA256
+
+	causalityHex := strings.TrimPrefix(completion.Output.Causality.ProofDigest, "sha256:")
+	if err := vroaSetFixedString(header.CausalityProofSHA256[:], causalityHex); err != nil {
+		return err
+	}
+	dag := completion.Output.OCIDAG
+	if dag == nil || dag.SchemaVersion != 2 || len(dag.BlobBytes) == 0 || len(dag.BlobBytes) > OCIDAGArchiveMaxBytes || dag.Root != completion.Output.Image {
+		return errors.New("VROA_V3 requires bounded OCI content bytes and matching root")
+	}
+	expectedOCIDigest, err := OCIDAGProofDigest(*dag)
+	if err != nil || dag.ProofDigest != expectedOCIDigest {
+		return errors.New("VROA_V3 OCI DAG proof digest mismatch")
+	}
+	ociHex := strings.TrimPrefix(dag.ProofDigest, "sha256:")
+	if err := vroaSetFixedString(header.OCIDAGSHA256[:], ociHex); err != nil {
+		return err
+	}
+
+	for i, name := range requiredContexts {
+		rec, exists := byName[name]
+		if !exists {
+			return fmt.Errorf("missing required context %q for VROA_V3", name)
+		}
+		if len(rec.StreamBytes) == 0 || int64(len(rec.StreamBytes)) != rec.StreamLength {
+			return fmt.Errorf("context %q missing sealed stream bytes", name)
+		}
+		sum := sha256.Sum256(rec.StreamBytes)
+		expectedStreamDigest := "sha256:" + hex.EncodeToString(sum[:])
+		if rec.StreamDigest != expectedStreamDigest {
+			return fmt.Errorf("context %q stream digest mismatch", name)
+		}
+		if err := vroaSetFixedString(header.ContextTreeDigests[i][:], rec.TreeDigest); err != nil {
+			return err
+		}
+		if err := vroaSetFixedString(header.ContextStreamDigests[i][:], rec.StreamDigest); err != nil {
+			return err
+		}
+		header.ContextStreamLengths[i] = uint64(rec.StreamLength)
+		fd, err := createSealedMemfdV3("virki-v3-ctx-"+name, rec.StreamBytes)
+		if err != nil {
+			return err
+		}
+		fds[i] = fd
+	}
+
+	approvalFD, err := createSealedMemfdV3("virki-v3-approval", scopeState.rawEnv)
+	if err != nil {
+		return err
+	}
+	fds[4] = approvalFD
+
+	payloadJSON, err := json.Marshal(struct {
+		SchemaVersion int           `json:"schemaVersion"`
+		Binding       Binding       `json:"binding"`
+		Contexts      []Consumption `json:"contexts"`
+		Output        Output        `json:"output"`
+		Epoch         uint64        `json:"epoch"`
+	}{
+		SchemaVersion: completion.SchemaVersion,
+		Binding:       completion.Binding,
+		Contexts:      completion.Contexts,
+		Output:        completion.Output,
+		Epoch:         scopeState.epoch,
+	})
+	if err != nil {
+		return err
+	}
+	if len(payloadJSON) == 0 || len(payloadJSON) > vroaMaxEvidenceBytes-binary.Size(header) {
+		return errors.New("VROA_V3 evidence payload exceeds bounds")
+	}
+	payloadSum := sha256.Sum256(payloadJSON)
+	header.EvidencePayloadBytes = uint32(len(payloadJSON))
+	if err := vroaSetFixedString(header.EvidencePayloadSHA256[:], hex.EncodeToString(payloadSum[:])); err != nil {
+		return err
+	}
+
+	headerBytes, err := vroaEncodeBinary(header)
+	if err != nil {
+		return err
+	}
+	evidenceBytes := append(headerBytes, payloadJSON...)
+	evidenceFD, err := createSealedMemfdV3("virki-v3-evidence", evidenceBytes)
+	if err != nil {
+		return err
+	}
+	fds[5] = evidenceFD
+	ociFD, err := createSealedMemfdV3("virki-v3-oci-content", dag.BlobBytes)
+	if err != nil {
+		return err
+	}
+	fds[6] = ociFD
+
+	var totalBytes uint64
+	for _, l := range header.ContextStreamLengths {
+		if l > math.MaxUint64-totalBytes {
+			return errors.New("VROA_V3 archive byte count overflow")
+		}
+		totalBytes += l
+	}
+	var req vroaV3RequestFrame
+	copy(req.Magic[:], vroaMagicV3)
+	req.Version = vroaProtocolVersionV3
+	req.Cmd = vroaCmdV3VerifyCandidate
+	req.Epoch = scopeState.epoch
+	if err := vroaSetFixedString(req.ScopeToken[:], completion.Authorization.Token); err != nil {
+		return err
+	}
+	req.SessionID = scopeState.envelope.WorkerID
+	req.JobID = scopeState.envelope.JobID
+	req.Role = scopeState.envelope.Role
+	req.Nonce = scopeState.envelope.Nonce
+	req.SourceCommit = scopeState.envelope.SourceCommit
+	req.BuildPlanSHA256 = scopeState.envelope.BuildPlanSHA256
+	req.ExecutablePolicySHA256 = scopeState.envelope.ExecutablePolicySHA256
+	req.OutputImageID = header.OutputImageID
+	req.ExpectedTreeDigests = header.ContextTreeDigests
+	req.ExpectedStreamDigests = header.ContextStreamDigests
+	req.ExpectedStreamLengths = header.ContextStreamLengths
+	req.ArchiveSHA256 = header.FileSyncManifestSHA256
+	req.ArchiveBytes = totalBytes
+	req.ApprovalKeyID = scopeState.envelope.KeyID
+	req.ApprovalID = scopeState.envelope.ApprovalID
+	req.ApprovalSerial = scopeState.envelope.ApprovalSerial
+	req.ApprovalEnvelopeSHA256 = header.ApprovalEnvelopeSHA256
+
+	transcriptSum := sha256.Sum256(evidenceBytes)
+	evidenceSHA := hex.EncodeToString(transcriptSum[:])
+	if err := vroaSetFixedString(req.TranscriptSHA256[:], evidenceSHA); err != nil {
+		return err
+	}
+
+	resp, err := s.sendV3Request(ctx, req, fds[:])
+	if err != nil {
+		return err
+	}
+	if resp.Status == vroaStatusErrSigningDisabled {
+		return &VROAV3SigningDisabledError{Status: resp.Status, Epoch: resp.Epoch}
+	}
+	if resp.Status != vroaStatusOK {
+		return fmt.Errorf("C4 V3_VERIFY_CANDIDATE refused request with status %d", resp.Status)
+	}
+	receipt, err := s.verifyReceipt(resp, req)
+	if err != nil {
+		return err
+	}
+	s.mu.Lock()
+	s.lastReceipt = &receipt
+	delete(s.scopes, completion.Authorization.Token)
+	s.mu.Unlock()
+	return nil
+}
+
+func (s *VROAV3Service) Abort(ctx context.Context, token, reason string) error {
+	s.mu.Lock()
+	scopeState, ok := s.scopes[token]
+	s.mu.Unlock()
+	if !ok {
+		return errors.New("C4 VROA_V3 abort scope token not found")
+	}
+	var req vroaV3RequestFrame
+	copy(req.Magic[:], vroaMagicV3)
+	req.Version = vroaProtocolVersionV3
+	req.Cmd = vroaCmdV3Abort
+	req.Epoch = scopeState.epoch
+	if err := vroaSetFixedString(req.ScopeToken[:], token); err != nil {
+		return err
+	}
+	if err := vroaSetFixedString(req.Nonce[:], scopeState.nonce); err != nil {
+		return err
+	}
+	resp, err := s.sendV3Request(ctx, req, nil)
+	if err != nil {
+		// Retain scopeState so Manager.retryPendingAborts can retry after transient failure.
+		return err
+	}
+	switch resp.Status {
+	case vroaStatusOK, vroaStatusErrScopeAborted, vroaStatusErrStaleEpoch:
+		// Scope is terminally closed on C4 (acknowledged abort, prior abort, or epoch advance).
+		s.mu.Lock()
+		delete(s.scopes, token)
+		s.mu.Unlock()
+		return nil
+	default:
+		return fmt.Errorf("C4 V3_ABORT refused request with status %d", resp.Status)
+	}
+}
+
+func (s *VROAV3Service) decodeAndVerifyApproval(raw []byte, binding Binding) (vroaV3ApprovalEnvelope, error) {
+	var env vroaV3ApprovalEnvelope
+	if len(raw) != binary.Size(env) {
+		return env, fmt.Errorf("VROA_AP3 envelope size mismatch: got %d, want %d", len(raw), binary.Size(env))
+	}
+	if err := binary.Read(bytes.NewReader(raw), binary.LittleEndian, &env); err != nil {
+		return env, err
+	}
+	if string(env.Magic[:]) != vroaApprovalMagicV3 || env.Version != vroaProtocolVersionV3 || env.ContextCount != 4 {
+		return env, errors.New("invalid VROA_AP3 magic, version or context count")
+	}
+	if env.ExpiresUnix == 0 || env.ExpiresUnix > math.MaxInt64 || time.Now().Unix() >= int64(env.ExpiresUnix) {
+		return env, errors.New("VROA_AP3 approval has expired or invalid expiry")
+	}
+	if len(s.opt.ApprovalPublicKey) != ed25519.PublicKeySize {
+		return env, errors.New("VROA_V3 approval public key is required")
+	}
+	if s.opt.ApprovalKeyID != "" && vroaCString(env.KeyID[:]) != s.opt.ApprovalKeyID {
+		return env, errors.New("VROA_AP3 keyId mismatch")
+	}
+	if s.opt.ApprovalPinSHA256 != "" && vroaCString(env.PublicKeyPinSHA256[:]) != s.opt.ApprovalPinSHA256 {
+		return env, errors.New("VROA_AP3 pin mismatch")
+	}
+	bodyLen := len(raw) - ed25519.SignatureSize
+	msg := append([]byte(vroaApprovalDomainV3), raw[:bodyLen]...)
+	if !ed25519.Verify(s.opt.ApprovalPublicKey, msg, env.Signature[:]) {
+		return env, errors.New("invalid VROA_AP3 Ed25519 signature")
+	}
+	if vroaCString(env.JobID[:]) != binding.JobID || vroaCString(env.Role[:]) != binding.Role ||
+		vroaCString(env.Nonce[:]) != binding.Nonce || vroaCString(env.ApprovalID[:]) != binding.ApprovalID {
+		return env, errors.New("VROA_AP3 envelope does not match solve binding")
+	}
+	if err := validateExporterIntent(binding.Exporter); err != nil {
+		return env, fmt.Errorf("VROA_AP3 solve binding has an invalid exporter intent: %w", err)
+	}
+	expectedExporterIntent := strings.TrimPrefix(binding.Exporter.AttributesDigest, "sha256:")
+	if vroaCString(env.ExporterIntentSHA256[:]) != expectedExporterIntent {
+		return env, errors.New("VROA_AP3 exporter intent does not match solve binding")
+	}
+	if s.opt.ExporterPolicy.Type != "" {
+		if err := validateExporterIntent(s.opt.ExporterPolicy); err != nil {
+			return env, fmt.Errorf("VROA_V3 configured exporter policy is invalid: %w", err)
+		}
+		if s.opt.ExporterPolicy != binding.Exporter {
+			return env, errors.New("VROA_V3 configured exporter policy does not match solve binding")
+		}
+	}
+	return env, nil
+}
+
+func (s *VROAV3Service) verifyReceipt(resp vroaV3ResponseFrame, expected vroaV3RequestFrame) (VROAV3CandidateReceipt, error) {
+	var receipt VROAV3CandidateReceipt
+	// A genuine C4 DEV receipt from another job remains correctly signed. Its
+	// signature alone must not authorize this BuildKit solve's local candidate.
+	if expected.Version != vroaProtocolVersionV3 || expected.Cmd != vroaCmdV3VerifyCandidate ||
+		expected.Epoch == 0 || vroaCString(expected.ScopeToken[:]) == "" ||
+		vroaCString(expected.ApprovalEnvelopeSHA256[:]) == "" ||
+		vroaCString(expected.TranscriptSHA256[:]) == "" {
+		return receipt, errors.New("incomplete expected VROA_V3 verification request")
+	}
+	if resp.AckJSONLen == 0 || resp.AckJSONLen > uint32(len(resp.AckJSON)) {
+		return receipt, errors.New("invalid C4 receipt ackJsonLen")
+	}
+	ackBytes := resp.AckJSON[:resp.AckJSONLen]
+	sum := sha256.Sum256(ackBytes)
+	if hex.EncodeToString(sum[:]) != vroaCString(resp.CanonicalAckSHA256[:]) {
+		return receipt, errors.New("C4 receipt canonicalAckSha256 mismatch")
+	}
+	if err := json.Unmarshal(ackBytes, &receipt); err != nil {
+		return receipt, err
+	}
+	if receipt.Version != vroaProtocolVersionV3 || receipt.Status != "CANDIDATE_VERIFIED" ||
+		receipt.ApprovalEnvelopeSHA256 != vroaCString(expected.ApprovalEnvelopeSHA256[:]) ||
+		receipt.EvidenceSHA256 != vroaCString(expected.TranscriptSHA256[:]) ||
+		receipt.DeployAuthorized || receipt.WorkerReceiptPairAdmitted || receipt.ReleaseSignature {
+		return receipt, errors.New("C4 receipt invariant violation")
+	}
+	if len(s.opt.ReceiptPublicKey) != ed25519.PublicKeySize {
+		return receipt, errors.New("VROA_V3 receipt public key is required to verify signed DEV receipt")
+	}
+	if s.opt.ReceiptKeyID != "" && vroaCString(resp.OwnerKeyID[:]) != s.opt.ReceiptKeyID {
+		return receipt, errors.New("C4 receipt ownerKeyId mismatch")
+	}
+	sig, err := base64.StdEncoding.DecodeString(vroaCString(resp.SignatureBase64[:]))
+	if err != nil || len(sig) != ed25519.SignatureSize {
+		return receipt, errors.New("invalid C4 receipt signature base64")
+	}
+	msg := append([]byte(vroaReceiptDomainV3), ackBytes...)
+	if !ed25519.Verify(s.opt.ReceiptPublicKey, msg, sig) {
+		return receipt, errors.New("invalid C4 receipt Ed25519 signature")
+	}
+	if resp.Epoch != expected.Epoch || receipt.Epoch != expected.Epoch ||
+		resp.SequenceNumber == 0 || receipt.SequenceNumber != resp.SequenceNumber {
+		return receipt, errors.New("signed C4 candidate receipt epoch/sequence differs from BuildKit request")
+	}
+	// Native C4 returns the verification scope in the SIGNED ack, not the
+	// response-frame ScopeToken field (that field is populated by V3_BEGIN).
+	// Refuse unexpected metadata instead of treating an unsigned response
+	// field as proof of scope ownership.
+	if vroaCString(resp.ScopeToken[:]) != "" {
+		return receipt, errors.New("signed C4 candidate receipt has unexpected unsigned response scope")
+	}
+	for _, field := range []struct{ name, signed, expected string }{
+		{"scope", receipt.ScopeToken, vroaCString(expected.ScopeToken[:])},
+		{"receipt signer", receipt.OwnerKeyID, vroaCString(resp.OwnerKeyID[:])},
+		{"approval key", receipt.ApprovalKeyID, vroaCString(expected.ApprovalKeyID[:])},
+		{"approval ID", receipt.ApprovalID, vroaCString(expected.ApprovalID[:])},
+		{"approval serial", receipt.ApprovalSerial, vroaCString(expected.ApprovalSerial[:])},
+		{"job", receipt.JobID, vroaCString(expected.JobID[:])},
+		{"role", receipt.Role, vroaCString(expected.Role[:])},
+		{"nonce", receipt.Nonce, vroaCString(expected.Nonce[:])},
+		{"worker", receipt.WorkerID, vroaCString(expected.SessionID[:])},
+		{"source commit", receipt.SourceCommit, vroaCString(expected.SourceCommit[:])},
+		{"build plan", receipt.BuildPlanSHA256, vroaCString(expected.BuildPlanSHA256[:])},
+		{"executable policy", receipt.ExecutablePolicySHA256, vroaCString(expected.ExecutablePolicySHA256[:])},
+		{"filesync manifest", receipt.FileSyncManifestSHA256, vroaCString(expected.ArchiveSHA256[:])},
+		{"output image", receipt.OutputImageID, vroaCString(expected.OutputImageID[:])},
+	} {
+		if field.signed != field.expected {
+			// Field names are safe diagnostics; never log signed contents or keys.
+			return receipt, fmt.Errorf("signed C4 candidate receipt %s differs from BuildKit VROA_V3 request", field.name)
+		}
+	}
+	if len(receipt.ContextTreeDigests) != len(expected.ExpectedTreeDigests) ||
+		len(receipt.ContextStreamDigests) != len(expected.ExpectedStreamDigests) ||
+		len(receipt.ContextStreamLengths) != len(expected.ExpectedStreamLengths) {
+		return receipt, errors.New("signed C4 candidate receipt context count mismatch")
+	}
+	for i := range expected.ExpectedTreeDigests {
+		if receipt.ContextTreeDigests[i] != vroaCString(expected.ExpectedTreeDigests[i][:]) ||
+			receipt.ContextStreamDigests[i] != strings.TrimPrefix(vroaCString(expected.ExpectedStreamDigests[i][:]), "sha256:") ||
+			receipt.ContextStreamLengths[i] != expected.ExpectedStreamLengths[i] {
+			return receipt, fmt.Errorf("signed C4 candidate receipt context %d differs from BuildKit request", i)
+		}
+	}
+	return receipt, nil
+}
+
+func (s *VROAV3Service) sendV3Request(ctx context.Context, req vroaV3RequestFrame, fds []int) (vroaV3ResponseFrame, error) {
+	var resp vroaV3ResponseFrame
+	if !s.devAllowSameUID {
+		if err := s.socketChecker.verifySocketPath(); err != nil {
+			return resp, err
+		}
+	}
+	payload, err := vroaEncodeBinary(req)
+	if err != nil {
+		return resp, err
+	}
+	dialer := net.Dialer{Timeout: 4 * time.Second}
+	conn, err := dialer.DialContext(ctx, "unix", s.socketPath)
+	if err != nil {
+		return resp, err
+	}
+	defer conn.Close()
+	if err := s.socketChecker.verifyConnectedPeer(conn); err != nil {
+		return resp, err
+	}
+	if err := conn.SetDeadline(time.Now().Add(4 * time.Second)); err != nil {
+		return resp, err
+	}
+
+	unixConn := conn.(*net.UnixConn)
+	rawConn, err := unixConn.SyscallConn()
+	if err != nil {
+		return resp, err
+	}
+	var oob []byte
+	if len(fds) > 0 {
+		oob = syscall.UnixRights(fds...)
+	}
+	var sendErr error
+	ctrlErr := rawConn.Write(func(sockFD uintptr) bool {
+		for len(payload) > 0 {
+			n, err := syscall.SendmsgN(int(sockFD), payload, oob, nil, 0)
+			if n > 0 {
+				payload = payload[n:]
+				oob = nil
+			}
+			if err == syscall.EINTR {
+				continue
+			}
+			if err == syscall.EAGAIN || err == syscall.EWOULDBLOCK {
+				return false
+			}
+			if err != nil {
+				sendErr = err
+				return true
+			}
+			if n == 0 {
+				sendErr = errors.New("zero-byte sendmsg progress")
+				return true
+			}
+		}
+		return true
+	})
+	if ctrlErr != nil {
+		return resp, ctrlErr
+	}
+	earlyPeerClose := sendErr == syscall.EPIPE || sendErr == syscall.ECONNRESET
+	if sendErr != nil && !earlyPeerClose {
+		return resp, sendErr
+	}
+	if !earlyPeerClose {
+		if err := unixConn.CloseWrite(); err != nil && !errors.Is(err, syscall.ENOTCONN) && !errors.Is(err, syscall.EPIPE) {
+			return resp, err
+		}
+	}
+
+	respBuf := make([]byte, binary.Size(resp))
+	if _, err := io.ReadFull(conn, respBuf); err != nil {
+		return resp, err
+	}
+	if err := binary.Read(bytes.NewReader(respBuf), binary.LittleEndian, &resp); err != nil {
+		return resp, err
+	}
+	if string(resp.Magic[:]) != vroaMagicV3 || resp.Version != vroaProtocolVersionV3 {
+		return resp, errors.New("invalid VROA_V3 response magic or version")
+	}
+	return resp, nil
+}
+
+func createSealedMemfdV3(name string, data []byte) (int, error) {
+	rwFD, err := unix.MemfdCreate(name, unix.MFD_CLOEXEC|unix.MFD_ALLOW_SEALING)
+	if err != nil {
+		return -1, fmt.Errorf("memfd_create(%s): %w", name, err)
+	}
+	defer func() { _ = syscall.Close(rwFD) }()
+
+	for off := 0; off < len(data); {
+		n, err := syscall.Write(rwFD, data[off:])
+		if err != nil {
+			if err == syscall.EINTR {
+				continue
+			}
+			return -1, err
+		}
+		if n <= 0 {
+			return -1, errors.New("short write to sealed memfd")
+		}
+		off += n
+	}
+	const sealAll = unix.F_SEAL_WRITE | unix.F_SEAL_GROW | unix.F_SEAL_SHRINK | unix.F_SEAL_SEAL
+	if _, err := unix.FcntlInt(uintptr(rwFD), unix.F_ADD_SEALS, sealAll); err != nil {
+		return -1, fmt.Errorf("F_ADD_SEALS(%s): %w", name, err)
+	}
+	roFD, err := syscall.Open(fmt.Sprintf("/proc/self/fd/%d", rwFD), syscall.O_RDONLY|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return -1, err
+	}
+	if _, err := syscall.Seek(roFD, 0, io.SeekStart); err != nil {
+		_ = syscall.Close(roFD)
+		return -1, err
+	}
+	return roFD, nil
+}
+
+func vroaSetFixedString(dst []byte, value string) error {
+	if len(value) >= len(dst) || strings.IndexByte(value, 0) >= 0 {
+		return fmt.Errorf("fixed field length/NUL violation (%d >= %d)", len(value), len(dst))
+	}
+	clear(dst)
+	copy(dst, value)
+	return nil
+}
+
+func vroaCString(src []byte) string {
+	if idx := bytes.IndexByte(src, 0); idx >= 0 {
+		return string(src[:idx])
+	}
+	return string(src)
+}
+
+func vroaEncodeBinary(value any) ([]byte, error) {
+	var buf bytes.Buffer
+	if err := binary.Write(&buf, binary.LittleEndian, value); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
