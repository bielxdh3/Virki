+	pinSum := sha256.Sum256(append(spkiPrefix, ownerPub...))
+	pinHex := hex.EncodeToString(pinSum[:])
+
+	var env vroaV3ApprovalEnvelope
+	copy(env.Magic[:], vroaApprovalMagicV3)
+	env.Version = vroaProtocolVersionV3
+	env.Epoch = 1
+	env.ExpiresUnix = uint64(time.Now().Add(10 * time.Minute).Unix())
+	env.WorkerUID = 10001
+	env.WorkerGID = 10001
+	env.ContextCount = 4
+	_ = vroaSetFixedString(env.KeyID[:], "owner-test-key")
+	_ = vroaSetFixedString(env.PublicKeyPinSHA256[:], pinHex)
+	_ = vroaSetFixedString(env.ApprovalID[:], "apr-buildkit-v3")
+	_ = vroaSetFixedString(env.ApprovalSerial[:], "ser-buildkit-01")
+	_ = vroaSetFixedString(env.JobID[:], "job-buildkit-v3")
+	_ = vroaSetFixedString(env.Role[:], "runtime")
+	_ = vroaSetFixedString(env.Nonce[:], nonceHex)
+	_ = vroaSetFixedString(env.SourceCommit[:], strings.Repeat("a", 40))
+	_ = vroaSetFixedString(env.BuildPlanSHA256[:], strings.Repeat("b", 64))
+	_ = vroaSetFixedString(env.ExecutablePolicySHA256[:], strings.Repeat("c", 64))
+	_ = vroaSetFixedString(env.ExporterIntentSHA256[:], strings.TrimPrefix(exporter.AttributesDigest, "sha256:"))
+	_ = vroaSetFixedString(env.OutputImageID[:], image.Digest)
+	_ = vroaSetFixedString(env.FileSyncManifestSHA256[:], strings.Repeat("d", 64))
+	_ = vroaSetFixedString(env.IgnorePolicySHA256[:], strings.Repeat("e", 64))
+	_ = vroaSetFixedString(env.WorkerID[:], "worker-buildkit-1")
+	_ = vroaSetFixedString(env.DockerfileSHA256[:], strings.Repeat("f", 64))
+	_ = vroaSetFixedString(env.IgnorePath[:], ".dockerignore")
+	_ = vroaSetFixedString(env.IgnoreSHA256[:], strings.Repeat("1", 64))
+	env.IgnorePresent = 1
+	_ = vroaSetFixedString(env.IgnoreSource[:], "preferred")
+
+	for i, name := range requiredContexts {
+		sum := sha256.Sum256(streams[i])
+		_ = vroaSetFixedString(env.Contexts[i].Name[:], name)
+		_ = vroaSetFixedString(env.Contexts[i].SessionID[:], "sess-"+name)
+		_ = vroaSetFixedString(env.Contexts[i].Identity[:], "ctxid-"+name)
+		_ = vroaSetFixedString(env.Contexts[i].TreeDigest[:], treeDigests[i])
+		_ = vroaSetFixedString(env.Contexts[i].StreamDigest[:], "sha256:"+hex.EncodeToString(sum[:]))
+		env.Contexts[i].StreamLength = uint64(len(streams[i]))
+	}
+	unsigned, err := vroaEncodeBinary(env)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bodyLen := len(unsigned) - ed25519.SignatureSize
+	msg := append([]byte(vroaApprovalDomainV3), unsigned[:bodyLen]...)
+	copy(env.Signature[:], ed25519.Sign(ownerPriv, msg))
+	raw, err := vroaEncodeBinary(env)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return raw, pinHex
+}
