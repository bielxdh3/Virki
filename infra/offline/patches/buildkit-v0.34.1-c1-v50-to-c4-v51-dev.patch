+func buildSignedV3Approval(t *testing.T, ownerPub ed25519.PublicKey, ownerPriv ed25519.PrivateKey, nonceHex string, streams [4][]byte, treeDigests [4]string, exporter ExporterIntent, image ImageDescriptor) ([]byte, string) {
