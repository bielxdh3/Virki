diff --git a/util/localcontext/observer_v52_dev_linux.go b/util/localcontext/observer_v52_dev_linux.go
new file mode 100644
index 0000000..2ee061f
--- /dev/null
+++ b/util/localcontext/observer_v52_dev_linux.go
@@ -0,0 +1,140 @@
+//go:build linux && virki_c1c4_dev
+
+package localcontext
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"maps"
+	"time"
+)
+
+// DevV52ScopeExpectations is only an inspectable copy of an ALREADY admitted
+// scope's context commitments. It does not create, sign or authorize owner
+// approval, and is absent from normal BuildKit/production builds.
+type DevV52ScopeExpectations struct {
+	Nonce       string
+	WorkerID    string
+	TreeSchema  string
+	TreeDigests map[string]string
+	SessionIDs  map[string]string
+}
+
+// DevV52GroupCapability is a nonzero-sized, opaque in-process capability.
+// Only the coordinator that first transitions this scope to PENDING receives
+// the live pointer. Another holder of ctx/scope/Manager cannot forge or
+// reacquire it while the group is pending. This is a Go ownership boundary
+// between trusted DEV callers, not a sandbox against arbitrary same-process
+// unsafe memory access, and grants NO C4 signing authority.
+type DevV52GroupCapability struct{ private byte }
+
+// DevV52ExpectedFour requires a fresh, correctly bound Manager/SolveScope
+// before the broker spends the first synthetic V15 permit.
+func (s *SolveScope) DevV52ExpectedFour(ctx context.Context, manager *Manager) (DevV52ScopeExpectations, error) {
+	if ctx == nil || manager == nil || s == nil || s.manager != manager {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV missing or mismatched Manager scope")
+	}
+	if !manager.required || manager.service == nil {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV requires fail-closed Manager with an independently provisioned TEST owner service")
+	}
+	if got, ok := ctx.Value(scopeKey{}).(*SolveScope); !ok || got != s {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV context does not carry the exact approved solve scope")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.abortRequested || s.completionAttempted || time.Now().After(s.auth.ExpiresAt) {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV solve scope expired or terminating")
+	}
+	if len(s.records) != 0 {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV requires an empty fresh solve scope")
+	}
+	if s.auth.Generation != s.binding.Nonce || len(s.auth.ContextSessionIDsV8) != len(requiredContexts) ||
+		len(s.auth.ContextTreeDigests) != len(requiredContexts) {
+		return DevV52ScopeExpectations{}, errors.New("V52 DEV requires exactly four independently approved V3 context commitments")
+	}
+	return DevV52ScopeExpectations{
+		Nonce: s.auth.Generation, WorkerID: s.auth.WorkerID,
+		TreeSchema:  s.auth.ContextTreeDigestSchema,
+		TreeDigests: maps.Clone(s.auth.ContextTreeDigests),
+		SessionIDs:  maps.Clone(s.auth.ContextSessionIDsV8),
+	}, nil
+}
+
+// DevV52BeginProtectedGroup prevents a caller holding a copied SolveScope
+// reference from triggering CausalInputs or C4 Complete between the fourth
+// ContextConsumed and the final four-root remeasurement/fence fsync.
+func (s *SolveScope) DevV52BeginProtectedGroup(ctx context.Context, manager *Manager) (*DevV52GroupCapability, error) {
+	if _, err := s.DevV52ExpectedFour(ctx, manager); err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.devV52GroupPending || s.closed || s.abortRequested || s.completionAttempted || len(s.records) != 0 {
+		return nil, errors.New("V52 DEV group already pending, used or terminating")
+	}
+	capability := &DevV52GroupCapability{private: 1}
+	s.devV52GroupPending = true
+	s.devV52GroupCapability = capability
+	return capability, nil
+}
+
+// DevV52PendingCausalInputs is available only to the protected coordinator.
+// The ordinary CausalInputs and Complete remain gated while this method
+// validates the four records. This method signs and authorizes nothing.
+func (s *SolveScope) DevV52PendingCausalInputs(ctx context.Context, manager *Manager, capability *DevV52GroupCapability) (string, ExporterIntent, []Consumption, error) {
+	if ctx == nil || s == nil || manager == nil || s.manager != manager {
+		return "", ExporterIntent{}, nil, errors.New("V52 DEV pending scope/manager unavailable")
+	}
+	if err := ctx.Err(); err != nil {
+		return "", ExporterIntent{}, nil, fmt.Errorf("V52 DEV pending causal scope canceled: %w", err)
+	}
+	if got, ok := ctx.Value(scopeKey{}).(*SolveScope); !ok || got != s {
+		return "", ExporterIntent{}, nil, errors.New("V52 DEV pending causal request belongs to another solve")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if capability == nil || s.devV52GroupCapability != capability ||
+		!s.devV52GroupPending || s.closed || s.abortRequested || s.completionAttempted ||
+		time.Now().After(s.auth.ExpiresAt) || len(s.records) != len(requiredContexts) {
+		return "", ExporterIntent{}, nil, errors.New("V52 DEV pending group is not exactly four valid protected observations")
+	}
+	result := make([]Consumption, 0, len(requiredContexts))
+	for _, name := range requiredContexts {
+		record, ok := s.records[name]
+		if !ok {
+			return "", ExporterIntent{}, nil, errors.New("V52 DEV pending group missing required context")
+		}
+		record.StreamBytes = append([]byte(nil), record.StreamBytes...)
+		result = append(result, record)
+	}
+	return s.auth.WorkerID, s.auth.ExporterPolicy, result, nil
+}
+
+// DevV52MarkFourReady lifts the extra candidate/causal gate only AFTER the
+// coordinator has rechecked every root and synced the inert READY marker.
+// This is NOT C4 authorization and does not call Complete.
+func (s *SolveScope) DevV52MarkFourReady(ctx context.Context, manager *Manager, capability *DevV52GroupCapability) error {
+	if ctx == nil || manager == nil || s == nil || s.manager != manager {
+		return errors.New("V52 DEV ready scope/manager unavailable")
+	}
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("V52 DEV ready scope canceled: %w", err)
+	}
+	if got, ok := ctx.Value(scopeKey{}).(*SolveScope); !ok || got != s {
+		return errors.New("V52 DEV ready context does not match the protected group")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("V52 DEV ready scope canceled while protected: %w", err)
+	}
+	if capability == nil || s.devV52GroupCapability != capability ||
+		!s.devV52GroupPending || s.closed || s.abortRequested || s.completionAttempted ||
+		time.Now().After(s.auth.ExpiresAt) || len(s.records) != len(requiredContexts) {
+		return errors.New("V52 DEV cannot expose incomplete or terminated group")
+	}
+	s.devV52GroupPending = false
+	s.devV52GroupCapability = nil
+	return nil
+}
