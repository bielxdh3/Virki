+			filepath.Clean(base) != base || base == "/var/tmp/virki-v52-physical-" {
+			t.Fatalf("V52 crashed child returned invalid cleanup root: %q", base)
+		}
+		t.Cleanup(func() { _ = os.RemoveAll(base) })
+		fenceDir := filepath.Join(base, "group-fence")
+		fenceName := "v52-" + strings.Repeat("a", 32) + ".state"
+		marker, err := os.ReadFile(filepath.Join(fenceDir, fenceName))
+		if err != nil || string(marker) != v52Pending {
+			t.Fatalf("V52 abrupt crash must leave durable PENDING fence: %q %v", marker, err)
+		}
+		log, err := os.ReadFile(filepath.Join(base, "ledger", v40LogName))
+		if err != nil || bytes.Count(log, []byte{10}) != 1 {
+			t.Fatalf("V52 abrupt crash must retain exactly one durable V40 claim: %q %v", log, err)
+		}
+		for i := 0; i < 4; i++ {
+			_, err := os.Lstat(filepath.Join(base, "protected", "candidate-"+strconv.Itoa(i)))
+			if i == 0 && err != nil || i > 0 && !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("V52 unexpected root after crash at context %d: %v", i, err)
+			}
+		}
+		if _, err := v52CreateGroupFence(fenceDir, strings.Repeat("a", 32)); err == nil {
+			t.Fatal("V52 abrupt-crash group attempt was replayable")
+		}
+	})
+}
