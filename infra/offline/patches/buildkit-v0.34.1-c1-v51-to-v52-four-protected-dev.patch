+// A V3 TEST-only authority double supplies independent, precomputed context
+// commitments to the REAL Manager. It cannot sign, create a C4 receipt or
+// authorize production. The real native V3 verifier is tested separately.
+type v52NonauthorizingTESTScope struct {
+	auth          localcontext.Authorization
+	abortCalls    atomic.Int32
+	completeCalls atomic.Int32
+}
+
+func (s *v52NonauthorizingTESTScope) Begin(context.Context, localcontext.Binding) (localcontext.Authorization, error) {
+	return s.auth, nil
+}
+func (s *v52NonauthorizingTESTScope) Complete(context.Context, localcontext.Completion) error {
+	s.completeCalls.Add(1)
+	return errors.New("V52 TEST forbids all C4 candidate/production completion")
+}
+func (s *v52NonauthorizingTESTScope) Abort(context.Context, string, string) error {
+	s.abortCalls.Add(1)
+	return nil
+}
+
+type v52RealFixture struct {
+	t           *testing.T
+	base        string
+	ledger      string
+	trust       string
+	initialCP   []byte
+	group       V52DevProtectedGroup
+	owner       *v52NonauthorizingTESTScope
+	manager     *localcontext.Manager
+	scope       *localcontext.SolveScope
+	ctx         context.Context
+	permitPriv  ed25519.PrivateKey
+	expectBytes [4][]byte
+	connections [4]*net.UnixConn
+	cmds        [4]*exec.Cmd
+}
+
+func v52RequireRootFixture(t *testing.T) {
+	t.Helper()
+	if os.Getenv("VIRKI_V52_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("V52 DEV requires explicitly enabled disposable Linux root multi-UID tests")
+	}
+	for i := 0; i < 4; i++ {
+		if _, err := user.LookupId(strconv.Itoa(60020 + i)); err == nil {
+			t.Skipf("V52 nonroot test UID %d belongs to an existing user", 60020+i)
+		}
+	}
+}
+
+func v52ChildSender(t *testing.T) bool {
+	t.Helper()
+	if os.Getenv("VIRKI_V52_TEST_CHILD") != "sender" {
+		return false
+	}
+	expectedUID, err := strconv.Atoi(os.Getenv("VIRKI_V52_UID"))
+	if err != nil || os.Getuid() != expectedUID || os.Geteuid() != expectedUID {
+		t.Fatal("V52 test sender is not running under the expected distinct UID")
+	}
+	source, err := os.Open(os.Getenv("VIRKI_V52_SOURCE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer source.Close()
+	conn, err := net.DialUnix("unix", nil, &net.UnixAddr{
+		Name: os.Getenv("VIRKI_V52_SOCKET"), Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, _, err := conn.WriteMsgUnix([]byte{'V'}, unix.UnixRights(int(source.Fd())), nil); err != nil {
+		t.Fatal(err)
+	}
+	// Remain alive until the root supervisor closes the socket or cleans up.
+	// SO_PEERCRED and SCM_CREDENTIALS must identify this *living* child, not
+	// an inherited/forwarded descriptor from another process.
+	_ = conn.SetReadDeadline(time.Now().Add(15 * time.Second))
+	var reply [1]byte
+	_, _ = conn.Read(reply[:])
+	return true
+}
+
+func v52NewPhysicalFixture(t *testing.T) *v52RealFixture {
