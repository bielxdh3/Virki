+		filepath.Join(f.ledger, v40LogName):       nil,
+		filepath.Join(f.trust, v40KeyName):        macKey,
+		filepath.Join(f.trust, v40CheckpointName): f.initialCP,
+	} {
+		mode := os.FileMode(0600)
+		if filepath.Base(path) == v40KeyName {
+			mode = 0400
+		}
+		if err := os.WriteFile(path, content, mode); err != nil {
+			t.Fatal(err)
+		}
+		file, err := os.Open(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := file.Sync(); err != nil {
+			t.Fatal(err)
+		}
+		if err := file.Close(); err != nil {
