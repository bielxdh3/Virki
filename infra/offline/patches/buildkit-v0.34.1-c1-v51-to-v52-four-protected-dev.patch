+
+// V52DevProtectedInput describes ONE independent, already-accepted and
+// kernel-authenticated nonroot FileSync publisher. All four inputs share one
+// V3 TEST-only Manager scope and a separately rooted V40 replay ledger.
+// Vertex/snapshot identifiers remain test inputs, NOT witnessed solver facts.
+type V52DevProtectedInput struct {
+	Conn        *net.UnixConn
+	SenderPID   int
+	SenderUID   uint32
+	SenderGID   uint32
+	Destination string
+	Manifest    V15SealedManifest
+	TestPermit  V15OwnerPermit
+	Record      localcontext.Consumption
+}
+
+type V52DevProtectedGroup struct {
+	// GroupGeneration is the exact one-use V3 TEST solve generation (32
+	// lowercase hex), independent from all four distinct V15 test nonces.
+	GroupGeneration string
+	LedgerDir       string
+	FenceDir        string // pre-provisioned root:root 0700, never user-controlled
+	TestPermitKey   ed25519.PublicKey
+	MinimumEpoch    uint64
+	MaximumEpoch    uint64
+	Inputs          [4]V52DevProtectedInput
+}
+
+const (
+	v52Pending = "V52_PENDING_DEV_NO_CANDIDATE\n"
+	v52Fenced  = "V52_FENCED_DEV_NO_CANDIDATE\n"
+	v52Ready   = "V52_FOUR_CONTEXTS_READY_DEV_NOT_OWNER_AUTHORIZED\n"
+)
+
+// PublishV52DevFourProtectedContexts consumes FOUR distinct authentic V50
+// SCM_RIGHTS handoffs and signed V15 TEST-domain permits. It submits the
+// root-owned V36 copies to one existing V3 TEST Manager scope and returns only
+// after CausalInputs proves all four observations, remeasured from protected
+// roots. NEVER invokes SolveScope.Complete/C4, signs, exports or deploys.
+// Every failure aborts the scope and persists an inert group fence.
+func PublishV52DevFourProtectedContexts(ctx context.Context, manager *localcontext.Manager,
+	scope *localcontext.SolveScope, group V52DevProtectedGroup) (records []localcontext.Consumption, err error) {
+	return publishV52FourProtectedContexts(ctx, manager, scope, group, nil, nil)
+}
+
+// Hook functions exist ONLY inside the DEV-tagged package for deterministic
+// fault injection. Not part of any production call graph or exported API.
+func publishV52FourProtectedContexts(ctx context.Context, manager *localcontext.Manager,
+	scope *localcontext.SolveScope, group V52DevProtectedGroup,
+	before, after func(int) error) (records []localcontext.Consumption, err error) {
+	if ctx == nil || manager == nil || scope == nil || os.Getuid() != 0 || os.Geteuid() != 0 {
+		return nil, errors.New("V52 DEV needs root, Manager and an existing separate V3 TEST scope")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	// Prove the context's actual owner-scoped identity before registering an
+	// abort on it: a caller with context.Background must not burn permits or
+	// mutate another solve's authority through an invalid abort attempt.
+	expected, err := scope.DevV52ExpectedFour(ctx, manager)
+	if err != nil {
+		return nil, err
+	}
+	// An aborted scope cannot supply CausalInputs or Complete, even if a
+	// later V40 fsync is ambiguous or the individual copies remain on disk.
+	defer func() {
+		if err == nil {
+			return
+		}
+		abortCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+		defer cancel()
+		err = errors.Join(err, scope.Abort(abortCtx, err))
+		records = nil
+	}()
+
+	if group.GroupGeneration != expected.Nonce || !v52CanonicalNonce(group.GroupGeneration) ||
+		group.MinimumEpoch == 0 || group.MaximumEpoch < group.MinimumEpoch ||
+		len(group.TestPermitKey) != ed25519.PublicKeySize {
+		return nil, errors.New("V52 DEV group generation/epoch/key is not the independent approved TEST scope")
+	}
+	names := localcontext.RequiredContextNames()
+	approvalIDs := make(map[string]bool, len(names))
+	testNonces := make(map[string]bool, len(names))
+	sessions := make(map[string]bool, len(names))
+	destinations := make(map[string]bool, len(names))
+	senderPIDs := make(map[int]bool, len(names))
+	parent := ""
+	for i, input := range group.Inputs {
+		m, p, rec := input.Manifest, input.TestPermit, input.Record
+		if rec.Name != names[i] || m.ContextName != names[i] ||
+			rec.WorkerID != expected.WorkerID || m.WorkerID != expected.WorkerID ||
+			m.SessionID != rec.SessionID || m.SessionID != expected.SessionIDs[names[i]] ||
+			rec.Generation != group.GroupGeneration ||
+			(rec.TreeDigest != "" && rec.TreeDigest != expected.TreeDigests[names[i]]) ||
+			m.Digest == "" || v15ManifestDigest(m) != m.Digest {
+			return nil, fmt.Errorf("V52 DEV input %d disagrees with V3 TEST scope or frozen V15 manifest", i)
+		}
+		if err := validateV15Request(V15SnapshotRequest{Root: "v52-test-only",
+			ContextName: m.ContextName, WorkerID: m.WorkerID, SessionID: m.SessionID,
+			Nonce: m.Nonce, Files: m.Files, ExcludePatterns: m.ExcludePatterns}); err != nil {
+			return nil, fmt.Errorf("V52 DEV invalid manifest %d: %w", i, err)
+		}
+		if p.Domain != V15OwnerDomain || p.ApprovalID == "" ||
+			p.ManifestDigest != m.Digest || p.ContextName != m.ContextName ||
+			p.WorkerID != m.WorkerID || p.SessionID != m.SessionID ||
+			p.Nonce != m.Nonce || p.Epoch < group.MinimumEpoch ||
+			p.Epoch > group.MaximumEpoch ||
+			!ed25519.Verify(group.TestPermitKey, v15PermitBytes(p), p.Signature) {
+			return nil, fmt.Errorf("V52 DEV distinct V15 test-domain permit %d is invalid", i)
+		}
+		if approvalIDs[p.ApprovalID] || testNonces[p.Nonce] ||
+			sessions[m.SessionID] || senderPIDs[input.SenderPID] ||
+			destinations[input.Destination] {
+			return nil, errors.New("V52 DEV group reuses a test permit, sender, session or destination")
+		}
+		approvalIDs[p.ApprovalID], testNonces[p.Nonce] = true, true
+		sessions[m.SessionID], senderPIDs[input.SenderPID] = true, true
+		destinations[input.Destination] = true
+		if input.SenderUID == 0 || input.SenderGID == 0 || input.SenderPID <= 1 ||
+			input.Conn == nil || !filepath.IsAbs(input.Destination) ||
+			filepath.Clean(input.Destination) != input.Destination {
+			return nil, fmt.Errorf("V52 DEV sender/destination %d cannot be trusted", i)
+		}
+		if i == 0 {
+			parent = filepath.Dir(input.Destination)
+		} else if filepath.Dir(input.Destination) != parent {
+			return nil, errors.New("V52 DEV group destinations must share one protected root-only parent")
+		}
+		// Authenticate all four live kernel connectors BEFORE the first V40
+		// claim. A malicious fourth peer cannot consume any earlier permit.
+		if err := v41AuthenticatePeerBeforeClaim(input.Conn, input.SenderPID,
+			input.SenderUID, input.SenderGID); err != nil {
+			return nil, fmt.Errorf("V52 DEV sender %d failed pre-claim kernel authentication: %w", i, err)
+		}
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	fence, err := v52CreateGroupFence(group.FenceDir, group.GroupGeneration)
+	if err != nil {
+		return nil, err
+	}
+	defer fence.Close()
+	// The group is permanently non-replayable once the PENDING fence has been
+	// fsynced. An EIO/crash before READY leaves no automatic recovery path.
+	defer func() {
+		if err != nil {
+			err = errors.Join(err, fence.write(v52Fenced))
+		}
+	}()
+	capability, err := scope.DevV52BeginProtectedGroup(ctx, manager)
+	if err != nil {
+		return nil, fmt.Errorf("V52 DEV cannot lock CausalInputs/Complete before first claim: %w", err)
+	}
+
+	for i, input := range group.Inputs {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if before != nil {
+			if err := before(i); err != nil {
+				return nil, fmt.Errorf("V52 DEV interpublication fault before %s: %w", names[i], err)
+			}
+		}
+		if err := PublishV51DevContextToV3(ctx, manager, group.LedgerDir, input.Conn,
+			input.SenderPID, input.SenderUID, input.SenderGID, input.Destination,
+			input.Manifest, input.TestPermit, group.TestPermitKey,
+			group.MinimumEpoch, group.MaximumEpoch, input.Record); err != nil {
+			return nil, fmt.Errorf("V52 DEV protected context %d/%d (%s) rejected: %w", i+1, len(names), names[i], err)
+		}
+		if after != nil {
+			if err := after(i); err != nil {
+				return nil, fmt.Errorf("V52 DEV interpublication fault after %s: %w", names[i], err)
+			}
+		}
+	}
+	// A cancellation after the FOURTH ContextConsumed but before the final
+	// protected-root measurements must still abort and fence the group.
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("V52 DEV canceled before four-context revalidation: %w", err)
+	}
+	worker, _, observed, err := scope.DevV52PendingCausalInputs(ctx, manager, capability)
+	if err != nil {
+		return nil, fmt.Errorf("V52 DEV incomplete V3 TEST four-context scope: %w", err)
+	}
+	if worker != expected.WorkerID || len(observed) != len(group.Inputs) {
+		return nil, errors.New("V52 DEV scope returned an inconsistent four-context group")
+	}
+	// Cross-check that every actual byte handed to Manager still matches its
+	// independently root-owned V36 publication before returning CausalInputs.
+	records = make([]localcontext.Consumption, len(group.Inputs))
+	for i, item := range observed {
+		if item.Name != names[i] || item.WorkerID != expected.WorkerID ||
+			item.SessionID != group.Inputs[i].Manifest.SessionID ||
+			item.Generation != group.GroupGeneration ||
+			item.TreeDigest != expected.TreeDigests[names[i]] ||
+			item.TreeDigestSchema != expected.TreeSchema {
+			return nil, fmt.Errorf("V52 DEV CausalInputs context %d diverged from V3 TEST scope", i)
+		}
+		recheck, data, readErr := v51MeasureProtectedPublication(
+			group.Inputs[i].Destination, group.Inputs[i].Manifest)
+		if readErr != nil || recheck.TreeDigest != item.TreeDigest ||
+			recheck.StreamDigest != item.StreamDigest ||
+			recheck.StreamLength != item.StreamLength ||
+			recheck.RegularFileBytes != item.RegularFileBytes ||
+			recheck.EntryCount != item.EntryCount || !bytes.Equal(data, item.StreamBytes) {
+			return nil, fmt.Errorf("V52 DEV protected context %s changed after V3 admission: %w", names[i],
+				errors.Join(readErr, errors.New("published bytes differ from authorized causal stream")))
+		}
+		item.StreamBytes = bytes.Clone(item.StreamBytes)
+		records[i] = item
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("V52 DEV canceled before durable group readiness: %w", err)
+	}
+	if err := fence.write(v52Ready); err != nil {
+		return nil, fmt.Errorf("V52 DEV four-context readiness fsync uncertain; never candidate: %w", err)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("V52 DEV canceled before completing protected TEST scope: %w", err)
+	}
+	if err := scope.DevV52MarkFourReady(ctx, manager, capability); err != nil {
+		return nil, fmt.Errorf("V52 DEV four-context TEST scope cannot be exposed: %w", err)
+	}
+	return records, nil
+}
+
+func v52CanonicalNonce(nonce string) bool {
+	if len(nonce) != 32 {
+		return false
+	}
+	for _, char := range nonce {
+		if char < '0' || char > '9' && (char < 'a' || char > 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+type v52GroupFence struct {
+	dirFD int
+	fd    int
+	name  string
+}
+
+func v52CreateGroupFence(dir, generation string) (*v52GroupFence, error) {
+	if !v52CanonicalNonce(generation) || !filepath.IsAbs(dir) ||
+		filepath.Clean(dir) != dir || dir == "/" {
+		return nil, errors.New("V52 DEV group fence path/generation must be canonical")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(rootFD)
+	dirFD, err := v40OpenRootDir(rootFD, dir)
+	if err != nil {
+		return nil, fmt.Errorf("V52 DEV root-only fence directory untrusted: %w", err)
+	}
+	name := "v52-" + generation + ".state"
+	fd, err := unix.Openat(dirFD, name, unix.O_RDWR|unix.O_CREAT|unix.O_EXCL|
+		unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		_ = unix.Close(dirFD)
+		return nil, fmt.Errorf("V52 DEV replayed or inaccessible group fence: %w", err)
+	}
+	fence := &v52GroupFence{dirFD: dirFD, fd: fd, name: name}
+	if err := fence.write(v52Pending); err != nil {
+		_ = fence.Close()
+		return nil, fmt.Errorf("V52 DEV cannot durably fence group attempt: %w", err)
+	}
+	return fence, nil
+}
+
+func (f *v52GroupFence) write(status string) error {
+	if f == nil {
+		return errors.New("V52 DEV group fence missing")
+	}
+	if err := v40CheckFileIdentity(f.dirFD, f.fd, f.name, 0600); err != nil {
+		return err
+	}
+	if err := unix.Ftruncate(f.fd, 0); err != nil {
+		return err
+	}
+	data := []byte(status)
+	if n, err := unix.Pwrite(f.fd, data, 0); err != nil || n != len(data) {
+		return errors.New("V52 DEV group fence write incomplete")
+	}
+	if err := unix.Fsync(f.fd); err != nil {
+		return err
+	}
+	if err := v40CheckFileIdentity(f.dirFD, f.fd, f.name, 0600); err != nil {
+		return err
+	}
+	return unix.Fsync(f.dirFD)
+}
+
+func (f *v52GroupFence) Close() error {
+	if f == nil {
+		return nil
+	}
+	return errors.Join(unix.Close(f.fd), unix.Close(f.dirFD))
+}
+
+// Keep the marker forever: READY means an inert DEV four-context measurement,
+// never an owner-approved C4 candidate. PENDING/FENCED require new permits,
+// a new V3 TEST generation and an independent root-owned attempt.
