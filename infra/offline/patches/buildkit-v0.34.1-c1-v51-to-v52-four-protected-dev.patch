+func (f *v52RealFixture) assertNoCandidate(t *testing.T, count int) {
+	t.Helper()
+	if _, _, _, err := f.scope.CausalInputs(); err == nil {
+		t.Fatal("incomplete/aborted V52 group unexpectedly exposes CausalInputs")
+	}
+	if f.owner.completeCalls.Load() != 0 || f.owner.abortCalls.Load() != 1 {
+		t.Fatalf("V52 requested candidate or did not abort TEST owner: complete=%d abort=%d",
+			f.owner.completeCalls.Load(), f.owner.abortCalls.Load())
+	}
+	for i, input := range f.group.Inputs {
+		_, err := os.Lstat(input.Destination)
+		if i < count && err != nil {
+			t.Fatalf("V52 protected earlier root %d missing despite spent permit: %v", i, err)
+		}
+		if i >= count && !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("V52 group published unexpected later context %d: %v", i, err)
+		}
+	}
+	log, err := os.ReadFile(filepath.Join(f.ledger, v40LogName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := bytes.Count(log, []byte{10}); got != count {
+		t.Fatalf("V52 V40 permit claims=%d want=%d", got, count)
+	}
+}
