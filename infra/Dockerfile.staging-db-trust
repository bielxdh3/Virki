# Staging-only CA overlay; never use Dockerfile.prod's implicit default target.
# The operator must independently approve a signed, immutable runtime image
# from ghcr.io/bielxdh3/virki-runtime before providing its manifest digest.
# A repository/digest spelling check is NOT source-signature verification.
# No base image, CA hash, or BuildKit secret has an automatic fallback.
ARG VIRKI_STAGING_APPROVED_BASE_IMAGE
FROM ${VIRKI_STAGING_APPROVED_BASE_IMAGE} AS staging-db-trust
ARG VIRKI_STAGING_APPROVED_BASE_IMAGE
ARG VIRKI_STAGING_APPROVED_DB_CA_SHA256
USER root
RUN --mount=type=secret,id=virki_staging_db_root_ca,required=true \
  node -e 'const { createHash, X509Certificate } = require("node:crypto"); \
    const { statSync, readFileSync, mkdirSync, writeFileSync, chmodSync } = require("node:fs"); \
    const approvedBase = process.argv[1]; \
    const expected = process.argv[2]; \
    if (!/^ghcr\.io\/bielxdh3\/virki-runtime@sha256:[a-f0-9]{64}$/u.test(approvedBase ?? "")) throw Error("Staging database CA base must be the separately approved immutable Virki runtime image"); \
    if (!/^[a-f0-9]{64}$/u.test(expected ?? "")) throw Error("Staging database CA approved SHA256 must be exactly 64 lowercase hex characters"); \
    const secretPath = "/run/secrets/virki_staging_db_root_ca"; \
    const size = statSync(secretPath).size; \
    if (size < 64 || size > 131072) throw Error("Staging database CA PEM size rejected"); \
    const source = readFileSync(secretPath); \
    if (createHash("sha256").update(source).digest("hex") !== expected) throw Error("Staging database CA digest mismatch"); \
    const pem = source.toString("utf8"); \
    if (!Buffer.from(pem, "utf8").equals(source)) throw Error("Staging database CA is not valid UTF8"); \
    const block = /-----BEGIN CERTIFICATE-----\n([A-Za-z0-9+/=\n]+)-----END CERTIFICATE-----\n/gu; \
    let end = 0; let count = 0; const fingerprints = new Set(); const now = Date.now(); \
    for (const match of pem.matchAll(block)) { \
      if (match.index !== end || ++count > 8) throw Error("Staging CA PEM contains extra material"); \
      const encoded = match[1].replace(/\n/gu, ""); \
      if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/u.test(encoded)) throw Error("Staging CA PEM has noncanonical base64"); \
      const der = Buffer.from(encoded, "base64"); \
      const certificate = new X509Certificate(match[0]); \
      const validFrom = Date.parse(certificate.validFrom); const validTo = Date.parse(certificate.validTo); \
      if (!certificate.ca || !certificate.raw.equals(der) || !Number.isFinite(validFrom) || !Number.isFinite(validTo) || validFrom > now || validTo <= now || fingerprints.has(certificate.fingerprint256)) throw Error("Staging CA PEM contains a non-CA, invalid, expired or duplicate certificate"); \
      fingerprints.add(certificate.fingerprint256); end = match.index + match[0].length; \
    } \
    if (count === 0 || end !== pem.length) throw Error("Staging database CA PEM contains no exclusively valid CA certificates"); \
    mkdirSync("/app/ca", { recursive: true, mode: 0o755 }); \
    writeFileSync("/app/ca/staging-db-root.pem", source, { flag: "wx", mode: 0o444 }); \
    chmodSync("/app/ca/staging-db-root.pem", 0o444);' "$VIRKI_STAGING_APPROVED_BASE_IMAGE" "$VIRKI_STAGING_APPROVED_DB_CA_SHA256"
# Metadata is only a declared consistency claim, NEVER evidence of CA approval.
LABEL org.virki.staging.db-root-ca.sha256="${VIRKI_STAGING_APPROVED_DB_CA_SHA256}"
USER node:node
