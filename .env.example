NODE_ENV=development

# Public BielOS surfaces
PUBLIC_SITE_URL=https://biel.dev.br
# Set only after the portal route is available and verified.
BIELOS_PORTAL_URL=
BIELOS_HUB_URL=https://hub.biel.dev.br
BIELOS_PORTAL_HOSTNAME=portal.biel.dev.br
BIELOS_HUB_HOSTNAME=hub.biel.dev.br

# Local application ports
PUBLIC_SITE_PORT=3000
HUB_PORT=3001
OIDC_ISSUER_PORT=3003

# PostgreSQL
POSTGRES_DB=bielos
POSTGRES_USER=bielos_app
POSTGRES_PASSWORD=change-me-in-your-local-env
DATABASE_URL=postgresql://bielos_app:change-me-in-your-local-env@postgres:5432/bielos?schema=public

# Authentication, rate limits, MFA, and encrypted mail
BIELOS_RATE_LIMIT_HASH_SECRET=replace-with-local-secret
BIELOS_TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
BIELOS_EMAIL_TRANSPORT=
BIELOS_EMAIL_OUTBOX_KEY=replace-with-a-32-byte-base64url-key
BIELOS_EMAIL_SMTP_HOST=
BIELOS_EMAIL_SMTP_PORT=587
BIELOS_EMAIL_SMTP_SECURE=false
BIELOS_EMAIL_SMTP_USER=
BIELOS_EMAIL_SMTP_PASSWORD=
BIELOS_EMAIL_FROM=no-reply@example.invalid
BIELOS_EMAIL_REPLY_TO=
SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUDIT_LOG_RETENTION_DAYS=180

# Local development only. In production, keep issuer signing/cookie keys in
# the remote .env.oidc file and the shared OIDC data-encryption key in
# .env.oidc-data; only the services that need each key receive it.
BIELOS_OIDC_ISSUER=https://portal.biel.dev.br
BIELOS_OIDC_SIGNING_JWKS=replace-with-private-es256-jwks-json
BIELOS_OIDC_COOKIE_KEY=replace-with-a-32-byte-base64url-key
BIELOS_OIDC_ADAPTER_KEY=replace-with-a-32-byte-hex-key
# Direct npm run dev reaches the issuer over loopback; Compose overrides this with its service DNS.
BIELOS_OIDC_PROXY_URL=http://127.0.0.1:3003

# Production Cloudflare Access values live in an untracked operator .env.
# The tunnel token is passed only to the Cloudflare Tunnel service.
CLOUDFLARE_ACCESS_JWT_REQUIRED=false
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=replace-with-private-tunnel-token
