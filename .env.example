NODE_ENV=development

# Public URLs
PUBLIC_SITE_URL=https://biel.dev.br
HUB_URL=https://hub.biel.dev.br
NEXT_PUBLIC_HUB_URL=https://hub.biel.dev.br

# Local application ports for Docker and development
PUBLIC_SITE_PORT=3000
HUB_PORT=3001

# PostgreSQL
POSTGRES_DB=bielos
POSTGRES_USER=bielos_app
POSTGRES_PASSWORD=change-me-in-your-local-env
DATABASE_URL=postgresql://bielos_app:change-me-in-your-local-env@postgres:5432/bielos?schema=public

# Future Cloudflare integration placeholders
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ACCESS_AUDIENCE=

# Auth placeholders. Generate real values only in a private .env file.
AUTH_SESSION_SECRET=
AUTH_PEPPER=
