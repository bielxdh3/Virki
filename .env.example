NODE_ENV=development

# Public Virki surfaces
PUBLIC_SITE_URL=https://biel.dev.br
# Set only after the portal route is available and verified.
VIRKI_PORTAL_URL=
VIRKI_HUB_URL=https://hub.biel.dev.br
VIRKI_ADMIN_PASSKEYS_ENABLED=false
VIRKI_PORTAL_HOSTNAME=portal.biel.dev.br
VIRKI_HUB_HOSTNAME=hub.biel.dev.br

# Local application ports
PUBLIC_SITE_PORT=3000
HUB_PORT=3001
OIDC_ISSUER_PORT=3003

# PostgreSQL
POSTGRES_DB=virki
POSTGRES_USER=virki_bootstrap
POSTGRES_PASSWORD=change-me-in-your-local-env
VIRKI_RUNTIME_DB_PASSWORD=replace-with-64-hex-character-secret
VIRKI_MIGRATOR_DB_PASSWORD=replace-with-a-different-64-hex-character-secret
VIRKI_AUDIT_MAINTENANCE_DB_PASSWORD=replace-with-another-different-64-hex-character-secret
DATABASE_URL=postgresql://virki_runtime:replace-with-64-hex-character-secret@postgres:5432/virki?schema=public
MIGRATION_DATABASE_URL=postgresql://virki_migrator:replace-with-a-different-64-hex-character-secret@postgres:5432/virki?schema=public
AUDIT_MAINTENANCE_DATABASE_URL=postgresql://virki_audit_maintenance:replace-with-another-different-64-hex-character-secret@postgres:5432/virki?schema=public

# Authentication, rate limits, MFA, and encrypted mail
VIRKI_RATE_LIMIT_HASH_SECRET=replace-with-local-secret
VIRKI_AUDIT_HASH_SECRET=replace-with-a-64-hex-character-secret
VIRKI_CSRF_SIGNING_KEY=replace-with-a-64-hex-character-secret
# During rotation, retain the prior 64-hex-character CSRF key here until its
# issued tokens have expired, then remove it.
VIRKI_CSRF_SIGNING_KEY_PREVIOUS=
VIRKI_TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
VIRKI_EMAIL_TRANSPORT=
VIRKI_EMAIL_OUTBOX_KEY=replace-with-a-32-byte-base64url-key
VIRKI_EMAIL_SMTP_HOST=
VIRKI_EMAIL_SMTP_PORT=587
VIRKI_EMAIL_SMTP_SECURE=false
VIRKI_EMAIL_SMTP_USER=
VIRKI_EMAIL_SMTP_PASSWORD=
VIRKI_EMAIL_MIN_SEND_INTERVAL_MS=250
VIRKI_EMAIL_FROM=no-reply@example.invalid
VIRKI_EMAIL_REPLY_TO=
SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUDIT_LOG_RETENTION_DAYS=180

# Local development only. In production, keep issuer signing/cookie keys in
# the remote .env.oidc file and the shared OIDC data-encryption key in
# .env.oidc-data; only the services that need each key receive it.
VIRKI_OIDC_ISSUER=https://portal.biel.dev.br
VIRKI_OIDC_SIGNING_JWKS=replace-with-private-es256-jwks-json
VIRKI_OIDC_COOKIE_KEY=replace-with-a-32-byte-base64url-key
VIRKI_OIDC_ADAPTER_KEY=replace-with-a-32-byte-hex-key
# Optional during a bounded data-key rotation window; remove after all stored OIDC ciphertext has been rewritten or expired.
VIRKI_OIDC_ADAPTER_KEY_PREVIOUS=
# Direct npm run dev reaches the issuer over loopback; Compose overrides this with its service DNS.
VIRKI_OIDC_PROXY_URL=http://127.0.0.1:3003

# Production Cloudflare Access values live in an untracked operator .env.
# The tunnel token is passed only to the Cloudflare Tunnel service.
CLOUDFLARE_ACCESS_JWT_REQUIRED=false
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=replace-with-private-tunnel-token
