NODE_ENV=development

# Public URLs
PUBLIC_SITE_URL=https://biel.dev.br
HUB_URL=https://hub.biel.dev.br
NEXT_PUBLIC_HUB_URL=https://hub.biel.dev.br
NEXT_PUBLIC_INTAKE_URL=
PUBLIC_SITE_ORIGIN=https://biel.dev.br

# Local application ports for Docker and development
PUBLIC_SITE_PORT=3000
HUB_PORT=3001

# Production session cleanup worker
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Audit logs are retained for this many days before cleanup.
AUDIT_LOG_RETENTION_DAYS=180

# Required in production. Private stable key for HMAC hashing login rate limit identifiers.
BIELOS_RATE_LIMIT_HASH_SECRET=replace-with-local-secret

# Email remains disabled until a real SMTP provider, credentials, sender domain,
# and encrypted outbox key are configured.
BIELOS_EMAIL_TRANSPORT=
BIELOS_EMAIL_OUTBOX_KEY=replace-with-a-32-byte-base64url-key
BIELOS_TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
BIELOS_EMAIL_SMTP_HOST=smtp-relay.brevo.com
BIELOS_EMAIL_SMTP_PORT=587
BIELOS_EMAIL_SMTP_SECURE=false
BIELOS_EMAIL_SMTP_USER=
BIELOS_EMAIL_SMTP_PASSWORD=
BIELOS_EMAIL_FROM=notifications@notify.biel.dev.br
BIELOS_EMAIL_REPLY_TO=

# Intake is disabled until a separately restricted database credential and HMAC key exist.
BIELOS_INTAKE_ENABLED=false
BIELOS_INTAKE_DATABASE_URL=
BIELOS_INTAKE_ABUSE_SECRET=replace-with-a-local-intake-secret

# PostgreSQL
POSTGRES_DB=bielos
POSTGRES_USER=bielos_app
POSTGRES_PASSWORD=change-me-in-your-local-env
DATABASE_URL=postgresql://bielos_app:change-me-in-your-local-env@postgres:5432/bielos?schema=public

# Future Cloudflare integration placeholders
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=bielos
CLOUDFLARE_PUBLIC_HOSTNAME=biel.dev.br
CLOUDFLARE_WWW_HOSTNAME=www.biel.dev.br
CLOUDFLARE_HUB_HOSTNAME=hub.biel.dev.br
# Development may explicitly disable origin JWT validation. Production Compose always enables it and requires both values below.
CLOUDFLARE_ACCESS_JWT_REQUIRED=false
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_TEAM_DOMAIN=

# Local owner seed. Use private values only in your local .env file.
BIELOS_OWNER_EMAIL=owner@example.invalid
BIELOS_OWNER_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
