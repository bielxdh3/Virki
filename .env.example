NODE_ENV=development

# Public URLs
PUBLIC_SITE_URL=https://biel.dev.br
HUB_URL=https://hub.biel.dev.br
NEXT_PUBLIC_HUB_URL=https://hub.biel.dev.br

# Local application ports for Docker and development
PUBLIC_SITE_PORT=3000
HUB_PORT=3001

# PostgreSQL
POSTGRES_DB=bielos
POSTGRES_USER=bielos_app
POSTGRES_PASSWORD=change-me-in-your-local-env
DATABASE_URL=postgresql://bielos_app:change-me-in-your-local-env@postgres:5432/bielos?schema=public

# Future Cloudflare integration placeholders
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=bielos
CLOUDFLARE_PUBLIC_HOSTNAME=biel.dev.br
CLOUDFLARE_WWW_HOSTNAME=www.biel.dev.br
CLOUDFLARE_HUB_HOSTNAME=hub.biel.dev.br
CLOUDFLARE_ACCESS_JWT_REQUIRED=false
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_TEAM_DOMAIN=

# Local owner seed. Use private values only in your local .env file.
BIELOS_OWNER_EMAIL=owner@example.invalid
BIELOS_OWNER_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
