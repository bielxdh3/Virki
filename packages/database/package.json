{
  "name": "@virki/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:generate": "prisma generate && node scripts/copy-prisma-client.mjs",
    "prisma:push": "node scripts/prisma-migrate.mjs push",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://virki_app:local-validation-only@validation.invalid/virki prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "node scripts/prisma-migrate.mjs dev",
    "prisma:migrate:deploy": "node scripts/prisma-migrate.mjs deploy",
    "prisma:migrate:status": "node scripts/prisma-migrate.mjs status",
    "prisma:migrate:resolve-baseline": "node scripts/prisma-migrate.mjs resolve-baseline",
    "prisma:migrate:verify-schema": "node scripts/prisma-migrate.mjs verify-schema",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
