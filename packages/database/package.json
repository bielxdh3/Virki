{
  "name": "@bielos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma:generate": "prisma generate && node scripts/copy-prisma-client.mjs",
    "prisma:push": "prisma db push",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://bielos_app:local-validation-only@validation.invalid/bielos prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
