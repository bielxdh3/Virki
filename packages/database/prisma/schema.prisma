generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
  INACTIVE
}

enum SecondFactorMethod {
  EMAIL
  TOTP
}

enum OutboxMessageStatus {
  QUEUED
  PROCESSING
  SENT
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
}

enum EmailMessageKind {
  NEW_DEVICE_VERIFICATION
  EMAIL_TWO_FACTOR
  PASSWORD_CHANGED
  SESSION_TERMINATED
  ACCOUNT_RECOVERY
  SECOND_FACTOR_CHANGED
  ADMIN_EMAIL_VERIFICATION
  ADMIN_CREDENTIAL_CHANGED
  ELEVATION_CHANGED
  ACCOUNT_INVITATION
}

enum DeliveryAttemptStatus {
  SENT
  FAILED
}

enum SecurityFactorStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DeviceChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum TrustedDeviceStatus {
  TRUSTED
  REVOKED
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CONSUMED
}

enum AdministrativeCredentialStatus {
  NOT_CONFIGURED
  ACTIVE
  REVOKED
}

enum SecurityElevationStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  CONSUMED
}

model User {
  id                       String              @id @default(cuid())
  email                    String              @unique
  emailNormalized          String?             @unique
  displayName              String?
  passwordHash             String?
  role                     UserRole            @default(USER)
  isActive                 Boolean             @default(true)
  accountStatus            AccountStatus       @default(ACTIVE)
  emailVerifiedAt          DateTime?
  secondFactorMethod       SecondFactorMethod  @default(EMAIL)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  sessions                 Session[]
  auditLogs                AuditLog[]
  projectGrants            UserProjectGrant[]
  connectionsCreated       ProjectConnection[] @relation("ConnectionCreator")
  totpFactor               TotpFactor?
  recoveryCodes            RecoveryCode[]
  deviceChallenges         DeviceChallenge[]
  trustedDevices           TrustedDevice[]
  accountRecoveryRequests  AccountRecoveryRequest[]
  reviewedRecoveryRequests AccountRecoveryRequest[] @relation("RecoveryReviewer")
  administrativeCredential AdministrativeCredential?
  administrativeRecoveryCodes AdministrativeRecoveryCode[]
  securityElevations       SecurityElevation[]
}

model Session {
  id         String    @id @default(cuid())
  sessionKey String    @unique @default(cuid())
  userId     String
  tokenHash  String    @unique
  authenticationMethods String[] @default(["pwd"])
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginRateLimit {
  id              String    @id @default(cuid())
  identifierHash  String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([expiresAt])
}

model ProjectConnection {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  description          String?
  origin               String
  launchUrl            String?
  enabled              Boolean            @default(true)
  clientId             String             @unique
  clientSecretCiphertext String
  redirectUris         Json
  createdByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            User?              @relation("ConnectionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  grants               UserProjectGrant[]

  @@index([enabled])
}

model UserProjectGrant {
  id              String           @id @default(cuid())
  userId          String
  connectionId    String
  grantedByUserId String?
  createdAt       DateTime         @default(now())
  revokedAt       DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      ProjectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId])
  @@index([connectionId, revokedAt])
  @@index([userId, revokedAt])
}

model OidcArtifact {
  id             String   @id @default(cuid())
  model          String
  idHash         String
  payloadCiphertext String
  grantHash      String?
  uidHash        String?
  userCodeHash   String?
  clientIdHash   String?
  accountIdHash  String?
  expiresAt      DateTime?
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([model, idHash])
  @@index([model, uidHash])
  @@index([model, userCodeHash])
  @@index([model, grantHash])
  @@index([clientIdHash, accountIdHash])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  eventType      String
  actorUserId    String?
  actorEmailHash String?
  result         String
  resource       String?
  message        String?
  metadata       Json?
  createdAt      DateTime @default(now())
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([eventType])
  @@index([actorUserId])
  @@index([actorEmailHash])
  @@index([createdAt])
}

model EmailOutboxMessage {
  id               String              @id @default(cuid())
  idempotencyKey   String              @unique
  kind             EmailMessageKind
  recipientEmail   String
  locale           String
  payload          Json
  status           OutboxMessageStatus @default(QUEUED)
  attemptCount     Int                 @default(0)
  availableAt      DateTime            @default(now())
  sentAt           DateTime?
  terminalFailedAt DateTime?
  processingLeaseExpiresAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deliveryAttempts EmailDeliveryAttempt[]

  @@index([status, availableAt])
  @@index([status, processingLeaseExpiresAt])
}

model EmailDeliveryAttempt {
  id          String                @id @default(cuid())
  messageId   String
  attempt     Int
  status      DeliveryAttemptStatus
  errorCode   String?
  attemptedAt DateTime              @default(now())
  message     EmailOutboxMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, attempt])
  @@index([attemptedAt])
}

model TotpFactor {
  id               String             @id @default(cuid())
  userId           String             @unique
  secretCiphertext String
  keyVersion       Int
  lastUsedStep     Int?
  status           SecurityFactorStatus @default(PENDING)
  confirmedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model DeviceChallenge {
  id                String               @id @default(cuid())
  userId            String
  ceremonyId        String               @unique
  deviceIdHash      String
  emailAddressHash  String
  codeHash          String
  requiresTotp      Boolean              @default(false)
  emailVerifiedAt   DateTime?
  status            DeviceChallengeStatus @default(PENDING)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceIdHash])
  @@index([expiresAt])
}

model TrustedDevice {
  id                String              @id @default(cuid())
  deviceKey         String              @unique @default(cuid())
  userId            String
  deviceIdHash      String
  label             String?
  status            TrustedDeviceStatus @default(TRUSTED)
  lastSeenAt        DateTime            @default(now())
  rememberedUntil   DateTime?
  strongVerifiedAt  DateTime?
  revokedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdHash])
  @@index([userId, status])
  @@index([rememberedUntil])
}

model AccountRecoveryRequest {
  id                 String                @id @default(cuid())
  requestKeyHash     String                @unique
  emailAddressHash   String
  userId             String
  emailChallengeHash String
  emailVerifiedAt    DateTime?
  status             RecoveryRequestStatus @default(PENDING)
  expiresAt          DateTime
  reviewedByUserId   String?
  approvedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser     User?                 @relation("RecoveryReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([expiresAt])
}

model AdministrativeCredential {
  id           String                         @id @default(cuid())
  userId       String                         @unique
  passwordHash String
  status       AdministrativeCredentialStatus @default(NOT_CONFIGURED)
  keyVersion   Int                            @default(1)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  revokedAt    DateTime?
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdministrativeRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model SecurityElevation {
  id                 String                  @id @default(cuid())
  requestKey         String                  @unique
  userId             String
  sessionId          String
  protocolVersion    Int
  scope              String
  challengeHash      String
  status             SecurityElevationStatus @default(PENDING)
  manualUntilRevoked Boolean                 @default(false)
  expiresAt          DateTime
  activatedAt        DateTime?
  revokedAt          DateTime?
  consumedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, scope])
  @@index([status, expiresAt])
  @@index([sessionId])
}

model SanitizedAuditReference {
  id            String   @id @default(cuid())
  referenceHash String   @unique
  category      String
  createdAt     DateTime @default(now())

  @@index([category, createdAt])
}
