{
  "name": "bielos",
  "version": "0.1.0",
  "private": true,
  "description": "BielOS identity, authentication, security, project access, and audit gateway.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "dev": "concurrently -n public,hub,issuer -c cyan,magenta,yellow \"npm run dev --workspace @bielos/public-site\" \"npm run dev --workspace @bielos/hub\" \"npm run start --workspace @bielos/issuer\"",
    "build": "npm run build --workspace @bielos/public-site && npm run build --workspace @bielos/hub",
    "typecheck": "npm run typecheck --workspaces --if-present",
  "test:unit": "tsx --test apps/hub/src/lib/admin-policy.test.ts apps/hub/src/lib/connection-policy.test.ts apps/hub/src/lib/surface.test.ts apps/hub/src/proxy.test.ts packages/auth/src/email.test.ts packages/auth/src/security.test.ts packages/auth/src/administration.test.ts packages/auth/src/cloudflare-access.test.ts packages/auth/src/command-output.test.ts packages/auth/src/rate-limit-config.test.ts packages/auth/src/session-cookie.test.ts packages/auth/src/oidc-secrets.test.ts apps/issuer/src/adapter.test.ts apps/issuer/src/authorization-policy.test.ts",
    "test:public-site": "tsx --test apps/public-site/src/app/public-surface.test.tsx",
    "test:migration": "node scripts/migration-validation.mjs",
    "test:backup:restore": "node scripts/backup-restore-validation.mjs",
    "test:production:runtime": "node scripts/production-runtime-smoke.mjs",
    "test:production-revision": "node --test scripts/production-revision.test.mjs scripts/production-compose.test.mjs scripts/production-remote.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "preflight:prod": "node scripts/production-preflight.mjs",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "start:prod": "node scripts/production-remote.mjs start",
    "stop:prod": "node scripts/production-remote.mjs stop",
    "restart:prod": "node scripts/production-remote.mjs restart",
    "revision:prod": "node scripts/production-remote.mjs revision",
    "status:prod": "node scripts/production-remote.mjs status",
    "status:ports": "node scripts/production-remote.mjs ports",
    "logs:prod": "node scripts/production-remote.mjs logs",
    "backup:prod": "node scripts/production-remote.mjs backup-verify",
    "health:prod": "node scripts/production-remote.mjs health",
    "health:local": "node scripts/health-local.mjs",
    "audit:recent": "node scripts/production-remote.mjs audit-recent",
    "audit:cleanup": "node scripts/production-remote.mjs audit-cleanup",
    "sessions:cleanup": "node scripts/production-remote.mjs sessions-cleanup",
    "prisma:push": "npm run prisma:push --workspace @bielos/database",
    "prisma:generate": "npm run prisma:generate --workspace @bielos/database",
    "prisma:validate": "npm run prisma:validate --workspace @bielos/database",
    "prisma:migrate": "npm run prisma:migrate --workspace @bielos/database",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @bielos/database",
    "prisma:migrate:status": "npm run prisma:migrate:status --workspace @bielos/database"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next@16.3.5": {
      "postcss": "8.5.25",
      "sharp": "0.35.4"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.0.0"
  }
}
