{
  "name": "bielos",
  "version": "0.1.0",
  "private": true,
  "description": "BielOS personal operating-system-style hub.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "dev": "concurrently -n public,hub -c cyan,magenta \"npm run dev --workspace @bielos/public-site\" \"npm run dev --workspace @bielos/hub\"",
    "build": "npm run build --workspace @bielos/public-site && npm run build --workspace @bielos/hub",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:prod": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.cloudflare.yml up --build -d",
    "stop:prod": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.cloudflare.yml down",
    "restart:prod": "npm run stop:prod && npm run start:prod",
    "status:prod": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.cloudflare.yml ps",
    "logs:prod": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.cloudflare.yml logs --tail=120 -f",
    "health:local": "node scripts/health-local.mjs",
    "audit:recent": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.cloudflare.yml exec -T hub npm run audit:recent --workspace @bielos/auth",
    "seed:owner": "npm run seed:owner --workspace @bielos/auth",
    "sessions:cleanup": "npm run sessions:cleanup --workspace @bielos/auth",
    "prisma:push": "npm run prisma:push --workspace @bielos/database",
    "prisma:generate": "npm run prisma:generate --workspace @bielos/database",
    "prisma:validate": "npm run prisma:validate --workspace @bielos/database",
    "prisma:migrate": "npm run prisma:migrate --workspace @bielos/database"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0"
  }
}
