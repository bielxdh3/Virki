{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@virki/auth": ["packages/auth/src"],
      "@virki/auth/cloudflare-access": ["packages/auth/src/cloudflare-access"],
      "@virki/auth/constants": ["packages/auth/src/constants"],
      "@virki/auth/oidc-secrets": ["packages/auth/src/oidc-secrets"],
      "@virki/auth/security": ["packages/auth/src/security"],
      "@virki/auth/administration": ["packages/auth/src/administration"],
      "@virki/database": ["packages/database/src"]
    }
  }
}
