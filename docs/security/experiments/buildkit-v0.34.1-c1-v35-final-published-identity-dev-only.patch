+func TestC1V35PublishedPathSwapAfterLastContentSealNeverReportsAdmission(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	dest := filepath.Join(t.TempDir(), "published")
+	var invoked bool
+	err := receiveV35QuarantinedWithFinalNameProbe(dest, m,
+		func(stage string) error {
+			return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+		}, unix.Fsync, func() error {
+			invoked = true
+			// Same-UID peer replaces the published directory AFTER its pinned
+			// contents were verified and synced. The original stage FD still
+			// reads SAFE, while the pathname now resolves to unapproved bytes.
+			if err := os.Rename(dest, dest+"-approved-inode"); err != nil {
+				return err
+			}
+			if err := os.Mkdir(dest, 0700); err != nil {
+				return err
+			}
+			return os.WriteFile(filepath.Join(dest, "app.js"), []byte("EVIL"), 0600)
+		})
+	require.True(t, invoked, "test must reach the postseal race window")
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal)
+	require.ErrorContains(t, err, "published pathname changed after final seal")
+	approved, readErr := os.ReadFile(filepath.Join(dest+"-approved-inode", "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("SAFE"), approved)
+	unapproved, readErr := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("EVIL"), unapproved,
+		"detected postseal mutation can still expose transient wrong bytes: production NO-GO")
+}
