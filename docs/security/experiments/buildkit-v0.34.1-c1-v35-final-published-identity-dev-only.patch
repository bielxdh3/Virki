+func TestC1V35ParentPathSwapAfterFsyncNeverReportsAdmission(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	root := t.TempDir()
+	parent := filepath.Join(root, "owner")
+	require.NoError(t, os.Mkdir(parent, 0700))
+	dest := filepath.Join(parent, "published")
+	err := receiveV23QuarantinedWithParentSync(dest, m,
+		func(stage string) error { return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600) },
+		func(fd int) error {
+			// Mutable parent pathname is replaced while the publication stays
+			// pinned to the old owner directory FD.
+			if err := os.Rename(parent, parent+"-moved"); err != nil {
+				return err
+			}
+			if err := os.Mkdir(parent, 0700); err != nil {
+				return err
+			}
+			return unix.Fsync(fd)
+		})
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal)
+	require.ErrorContains(t, err, "published parent pathname changed")
+	_, statErr := os.Stat(dest)
+	require.ErrorIs(t, statErr, os.ErrNotExist, "requested destination must not be falsely admitted")
+	got, readErr := os.ReadFile(filepath.Join(parent+"-moved", "published", "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("SAFE"), got)
+}
