+func TestC1V35PinnedStageReceiverWritesSurviveStageNameSwap(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	parent := t.TempDir()
+	dest := filepath.Join(parent, "published")
+	var originalStage string
+	err := receiveV19Quarantined(dest, m, func(stage string) error {
+		items, err := os.ReadDir(parent)
+		if err != nil {
+			return err
+		}
+		for _, item := range items {
+			if strings.HasPrefix(item.Name(), ".virki-v19-") {
+				originalStage = filepath.Join(parent, item.Name())
+			}
+		}
+		if originalStage == "" {
+			return errors.New("test did not observe stage basename")
+		}
+		if err := os.Rename(originalStage, originalStage+"-pinned"); err != nil {
+			return err
+		}
+		if err := os.Mkdir(originalStage, 0700); err != nil {
+			return err
+		}
+		if err := os.WriteFile(filepath.Join(originalStage, "app.js"), []byte("EVIL"), 0600); err != nil {
+			return err
+		}
+		// Receiver writes to its FD-rooted original, not the replacement.
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	})
+	require.NotEmpty(t, originalStage)
+	require.ErrorContains(t, err, "no longer identifies verified directory")
+	_, statErr := os.Stat(dest)
+	require.ErrorIs(t, statErr, os.ErrNotExist, "replaced stage must never publish")
+	approved, readErr := os.ReadFile(filepath.Join(originalStage+"-pinned", "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("SAFE"), approved)
+	attacker, readErr := os.ReadFile(filepath.Join(originalStage, "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("EVIL"), attacker)
+}
