+func requireV35ParentPathIdentity(rootFD, pinnedParentFD int, parent string) error {
+	observedFD := rootFD
+	if parent != "/" {
+		var err error
+		observedFD, err = unix.Openat2(rootFD, strings.TrimPrefix(parent, "/"), &unix.OpenHow{
+			Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+		})
+		if err != nil {
+			return fmt.Errorf("C1 V35 published parent lookup failed: %w", err)
+		}
+		defer unix.Close(observedFD)
+	}
+	var published, pinned unix.Stat_t
+	if err := unix.Fstat(observedFD, &published); err != nil {
+		return err
+	}
+	if err := unix.Fstat(pinnedParentFD, &pinned); err != nil {
+		return err
+	}
+	if published.Ino != pinned.Ino || published.Dev != pinned.Dev {
+		return errors.New("C1 V35 requested parent pathname no longer identifies pinned directory")
+	}
 	return nil
