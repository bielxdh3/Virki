+// V32: NoNewPrivs does not prevent an untrusted same-UID process from
+// attaching with ptrace or inspecting /proc/<pid>/fd. Must execute AFTER
+// execve, because Linux may reset dumpability during that transition.
+// This does not establish unique UID ownership or remove pathname races.
+func enforceV32NonDumpableReceiver() error {
+	if err := unix.Prctl(unix.PR_SET_DUMPABLE, 0, 0, 0, 0); err != nil {
+		return fmt.Errorf("C1 V32 cannot disable receiver ptrace access: %w", err)
+	}
+	dumpable, err := unix.PrctlRetInt(unix.PR_GET_DUMPABLE, 0, 0, 0, 0)
+	if err != nil || dumpable != 0 {
+		return fmt.Errorf("C1 V32 receiver dumpability invariant failed: value=%d error=%v", dumpable, err)
+	}
+	return nil
 }
 
