+// Same-UID peers may share filesystem authority, but must at least be unable
+// to read the independent receiver's live file descriptors or change its
+// memory through ptrace. The child test process isolates PR_SET_DUMPABLE from
+// the main Go test runner, and tests the real Linux permission boundary.
+func TestC1V32SameUIDPeerCannotPtraceReceiver(t *testing.T) {
+	if os.Getenv("VIRKI_V32_PTRACE_CHILD") == "1" {
+		require.NoError(t, enforceV32NonDumpableReceiver())
+		fmt.Fprintln(os.Stdout, "ready")
+		_, _ = io.Copy(io.Discard, os.Stdin)
+		return
+	}
+	if os.Geteuid() == 0 {
+		t.Skip("same-UID ptrace denial must be tested as an unprivileged UID")
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^TestC1V32SameUIDPeerCannotPtraceReceiver$")
+	cmd.Env = append(os.Environ(), "VIRKI_V32_PTRACE_CHILD=1")
+	stdin, err := cmd.StdinPipe()
+	require.NoError(t, err)
+	stdout, err := cmd.StdoutPipe()
+	require.NoError(t, err)
+	require.NoError(t, cmd.Start())
+	t.Cleanup(func() {
+		_ = stdin.Close()
+		if cmd.ProcessState == nil {
+			_ = cmd.Process.Kill()
+			_ = cmd.Wait()
+		}
+	})
+	ready, err := bufio.NewReader(stdout).ReadString('\n')
+	require.NoError(t, err)
+	require.Equal(t, "ready\n", ready)
+	if err := unix.PtraceAttach(cmd.Process.Pid); err == nil {
+		_ = unix.PtraceDetach(cmd.Process.Pid)
+		t.Fatal("same-UID peer attached to protected receiver")
+	}
+	_, err = os.Readlink(fmt.Sprintf("/proc/%d/fd/1", cmd.Process.Pid))
+	require.Error(t, err, "same-UID peer must not inspect receiver file descriptors")
+	require.NoError(t, stdin.Close())
+	require.NoError(t, cmd.Wait())
+}
