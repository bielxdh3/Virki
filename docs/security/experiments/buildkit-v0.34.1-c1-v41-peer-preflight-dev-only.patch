diff --git a/session/filesync/sealed_publication_preflight_v41_linux.go b/session/filesync/sealed_publication_preflight_v41_linux.go
new file mode 100644
index 0000000..ca2d483
--- /dev/null
+++ b/session/filesync/sealed_publication_preflight_v41_linux.go
@@ -0,0 +1,42 @@
+//go:build linux
+
+package filesync
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// v41AuthenticatePeerBeforeClaim is a DEV-only preflight on the already
+// accepted Unix socket. It must never receive application bytes or SCM_RIGHTS:
+// an unrelated caller cannot exhaust one-time signed permits merely by
+// presenting a socket with the wrong kernel identity. The V37 receiver still
+// verifies these kernel credentials both before AND after receiving a single
+// source FD. A matching SO_PEERCRED is not itself a C4 owner authorization.
+func v41AuthenticatePeerBeforeClaim(conn *net.UnixConn, expectedPID int,
+	expectedUID, expectedGID uint32) error {
+	if conn == nil || os.Getuid() != 0 || os.Geteuid() != 0 ||
+		expectedPID <= 1 || expectedUID == 0 || expectedGID == 0 {
+		return errors.New("C1 V41 requires trusted root broker and pinned nonroot peer identity")
+	}
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return fmt.Errorf("C1 V41 cannot inspect accepted Unix peer: %w", err)
+	}
+	var peer *unix.Ucred
+	var peerErr error
+	if err := raw.Control(func(fd uintptr) {
+		peer, peerErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+	}); err != nil {
+		return fmt.Errorf("C1 V41 peer credential control refused: %w", err)
+	}
+	if peerErr != nil || peer == nil || peer.Pid != int32(expectedPID) ||
+		peer.Uid != expectedUID || peer.Gid != expectedGID {
+		return fmt.Errorf("C1 V41 refused untrusted socket peer before durable permit claim: %w", peerErr)
+	}
+	return nil
+}
