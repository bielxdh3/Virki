+// Re-establish a durable MANUAL recovery fence after a recoverable failure of
+// the final intent-unlink fsync. The original log/checkpoint have already been
+// durably synced; this is not automatic admission or authorization to publish.
+// Persistent storage failure may prevent restoration, so the caller still
+// returns an error and must never claim power-loss guarantees from this hook.
+func v40RestoreTerminalIntent(trustFD int) error {
+	fd, err := unix.Openat(trustFD, v40IntentName, unix.O_WRONLY|unix.O_CREAT|
+		unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return fmt.Errorf("V40 cannot restore recovery fence after final fsync failure: %w", err)
+	}
+	if n, err := unix.Write(fd, []byte("V40_INFLIGHT\n")); err != nil || n != len("V40_INFLIGHT\n") {
+		_ = unix.Close(fd)
+		return errors.New("V40 recovery fence write failed, storage integrity indeterminate")
+	}
+	if err := unix.Fsync(fd); err != nil {
+		_ = unix.Close(fd)
+		return fmt.Errorf("V40 recovery fence file fsync failed: %w", err)
+	}
+	if err := unix.Close(fd); err != nil {
+		return fmt.Errorf("V40 recovery fence file close failed: %w", err)
+	}
+	if err := unix.Fsync(trustFD); err != nil {
+		return fmt.Errorf("V40 recovery fence parent fsync failed: %w", err)
+	}
+	return nil
+}
