 	require.Equal(t, []byte("EVIL"), unapproved,
 		"same-UID attack may expose wrong bytes; detector must never claim GO")
 }
+
+func TestC1V33PublishedSameInodeFileMutationNeverReportsAdmission(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	dest := filepath.Join(t.TempDir(), "published")
+	var originalIno, changedIno uint64
+	err := receiveV23QuarantinedWithParentSync(dest, m, func(stage string) error {
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	}, func(fd int) error {
+		path := filepath.Join(dest, "app.js")
+		var before unix.Stat_t
+		if err := unix.Stat(path, &before); err != nil {
+			return err
+		}
+		originalIno = before.Ino
+		// This attacker shares the receiver's UID and changes the file AFTER
+		// rename without changing its inode or the published directory inode.
+		if err := os.WriteFile(path, []byte("EVIL"), 0600); err != nil {
+			return err
+		}
+		var after unix.Stat_t
+		if err := unix.Stat(path, &after); err != nil {
+			return err
+		}
+		changedIno = after.Ino
+		return unix.Fsync(fd)
+	})
+	require.NotZero(t, originalIno)
+	require.Equal(t, originalIno, changedIno, "the attack must preserve inode identity")
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal)
+	require.ErrorContains(t, err, "published stage content changed")
+	got, readErr := os.ReadFile(filepath.Join(dest, "app.js"))
+	require.NoError(t, readErr)
+	require.Equal(t, []byte("EVIL"), got, "observed mutation shows C1/C4 production still NO-GO")
+}
+
+func TestC1V33PublishedNewEntryNeverReportsAdmission(t *testing.T) {
+	t.Setenv("TMPDIR", "/tmp")
+	m := v15PacketManifest()
+	dest := filepath.Join(t.TempDir(), "published")
+	err := receiveV23QuarantinedWithParentSync(dest, m, func(stage string) error {
+		return os.WriteFile(filepath.Join(stage, "app.js"), []byte("SAFE"), 0600)
+	}, func(fd int) error {
+		if err := os.WriteFile(filepath.Join(dest, "secret.env"), []byte("UNAPPROVED"), 0600); err != nil {
+			return err
+		}
+		return unix.Fsync(fd)
+	})
+	var terminal *V22PublishedButUnadmittedError
+	require.ErrorAs(t, err, &terminal)
+	require.ErrorContains(t, err, "published stage membership changed")
+	_, statErr := os.Stat(filepath.Join(dest, "secret.env"))
+	require.NoError(t, statErr, "injected entry may be exposed transiently, so NEVER assert security GO")
+}
