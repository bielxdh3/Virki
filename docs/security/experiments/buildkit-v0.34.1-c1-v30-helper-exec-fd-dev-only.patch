+func TestC1V30RootSupervisorExecutableCustody(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("synthetic root-supervised receiver executable custody fixture")
+	}
+	root, err := os.MkdirTemp("/tmp", "virki-v30-helper-")
+	require.NoError(t, err)
+	defer os.RemoveAll(root)
+	require.NoError(t, os.Chmod(root, 0711))
+	const receiverUID uint32 = 60001
+	tmp := filepath.Join(root, "private-tmp")
+	require.NoError(t, os.Mkdir(tmp, 0700))
+	require.NoError(t, os.Chown(tmp, int(receiverUID), int(receiverUID)))
+	policy := V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         ptrV30(receiverUID),
+		ExpectedReceiverGID:         ptrV30(receiverUID),
+		PrivateTempDir:              tmp,
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+
+	trusted := filepath.Join(root, "trusted-helper")
+	require.NoError(t, os.WriteFile(trusted, []byte("#!/bin/sh\nexit 0\n"), 0555))
+	require.NoError(t, os.Chmod(trusted, 0555))
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, trusted, nil, policy, nil)
+	require.NoError(t, err, "root-owned helper under a root-owned immutable chain must run")
+
+	// This is a root-owned, read-only helper under a receiver-UID owned
+	// directory. The receiver UID can rename the executable by PATH even
+	// though it cannot write the original file's bytes. Fail before launch.
+	unsafeParent := filepath.Join(root, "receiver-writable")
+	require.NoError(t, os.Mkdir(unsafeParent, 0700))
+	unsafeHelper := filepath.Join(unsafeParent, "unsafe-helper")
+	require.NoError(t, os.WriteFile(unsafeHelper, []byte("#!/bin/sh\nexit 9\n"), 0555))
+	require.NoError(t, os.Chmod(unsafeHelper, 0555))
+	require.NoError(t, os.Chown(unsafeParent, int(receiverUID), int(receiverUID)))
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, unsafeHelper, nil, policy, nil)
+	require.ErrorContains(t, err, "untrusted isolated helper executable ancestry")
+
+	// Directory safety is not sufficient if the helper inode is owned by a
+	// less-trusted identity that can replace bytes or chmod it separately.
+	foreign := filepath.Join(root, "foreign-owned-helper")
+	require.NoError(t, os.WriteFile(foreign, []byte("#!/bin/sh\nexit 9\n"), 0555))
+	require.NoError(t, os.Chown(foreign, int(receiverUID), int(receiverUID)))
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, foreign, nil, policy, nil)
+	require.ErrorContains(t, err, "must be owned by trusted root supervisor")
+}
+
+func ptrV30(v uint32) *uint32 { return &v }
+
+func TestC1V30PinnedHelperExecSurvivesAdversarialRename(t *testing.T) {
+	// This fixture simulates the EXACT pre-exec pathname swap. The helper
+	// inode was opened while SAFE, then the original name was renamed and
+	// replaced with EVIL before execution. The inherited FD executes SAFE.
+	parent := t.TempDir()
+	help := filepath.Join(parent, "helper")
+	require.NoError(t, os.WriteFile(help, []byte("#!/bin/sh\nprintf SAFE\n"), 0555))
+	require.NoError(t, os.Chmod(help, 0555))
+	exeFD, err := unix.Open(help, unix.O_PATH|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	require.NoError(t, err)
+	exeFile := os.NewFile(uintptr(exeFD), "verified-helper")
+	defer exeFile.Close()
+	require.NoError(t, os.Rename(help, help+"-original"))
+	require.NoError(t, os.WriteFile(help, []byte("#!/bin/sh\nprintf EVIL\n"), 0555))
+	require.NoError(t, os.Chmod(help, 0555))
+	cmd := v30PinnedHelperCommand(t.Context(), exeFile, nil, nil)
+	out, err := cmd.Output()
+	require.NoError(t, err)
+	require.Equal(t, "SAFE", string(out), "substituted path must never execute unverified bytes")
+}
