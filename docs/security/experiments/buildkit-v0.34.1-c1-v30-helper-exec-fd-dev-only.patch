+// The validated executable must be inherited after all existing socket FDs.
+// /proc/self/fd in the child resolves the already-open inode, not a mutable
+// pathname which may have been renamed after the supervisor opened it.
+func v30PinnedHelperCommand(ctx context.Context, exeFile *os.File, files []*os.File, args []string) *exec.Cmd {
+	childFD := 3 + len(files)
+	cmd := exec.CommandContext(ctx, fmt.Sprintf("/proc/self/fd/%d", childFD), args...)
+	cmd.ExtraFiles = append(append([]*os.File(nil), files...), exeFile)
+	return cmd
+}
