diff --git a/session/filesync/sealed_publication_peer_sender_v49_linux_test.go b/session/filesync/sealed_publication_peer_sender_v49_linux_test.go
new file mode 100644
index 0000000..1db49dc
--- /dev/null
+++ b/session/filesync/sealed_publication_peer_sender_v49_linux_test.go
@@ -0,0 +1,183 @@
+//go:build linux
+
+package filesync
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"os/user"
+	"path/filepath"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// V49 proves that an inherited Unix socket cannot impersonate the process
+// that initially connected, even after that process has exited and been
+// reaped. All files and credentials are synthetic /var/tmp test fixtures.
+func TestC1V49InheritedUnixSocketCannotSpendPermit(t *testing.T) {
+	const uid uint32 = 60017
+	mode := os.Getenv("VIRKI_V49_CHILD")
+	if mode == "spawner" {
+		conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: os.Getenv("VIRKI_V49_SOCKET"), Net: "unix"})
+		require.NoError(t, err)
+		passed, err := conn.File()
+		require.NoError(t, err)
+		helper, err := os.Executable()
+		require.NoError(t, err)
+		next := exec.Command(helper, "-test.run=^TestC1V49InheritedUnixSocketCannotSpendPermit$")
+		next.ExtraFiles = []*os.File{passed}
+		next.Env = append(os.Environ(), "VIRKI_V49_CHILD=forwarder")
+		require.NoError(t, next.Start())
+		require.NoError(t, passed.Close())
+		require.NoError(t, conn.Close())
+		return
+	}
+	if mode == "forwarder" {
+		inherited := os.NewFile(3, "unix-inherited")
+		require.NotNil(t, inherited)
+		defer inherited.Close()
+		c, err := net.FileConn(inherited)
+		require.NoError(t, err)
+		defer c.Close()
+		sock, ok := c.(*net.UnixConn)
+		require.True(t, ok)
+		source, err := os.Open(os.Getenv("VIRKI_V49_SOURCE"))
+		require.NoError(t, err)
+		defer source.Close()
+		_, _, err = sock.WriteMsgUnix([]byte{'V'}, unix.UnixRights(int(source.Fd())), nil)
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(os.Getenv("VIRKI_V49_SENT_MARKER"), []byte("sent"), 0666))
+		return
+	}
+	if os.Getenv("VIRKI_V49_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("V49 synthetic sender PID test requires explicit disposable root fixture")
+	}
+	if _, err := user.LookupId(strconv.Itoa(int(uid))); err == nil {
+		t.Skip("synthetic V49 sender UID is already assigned")
+	}
+	base, err := os.MkdirTemp("/var/tmp", "virki-v49-peer-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(base)) })
+	require.NoError(t, os.Chmod(base, 0711))
+	src := filepath.Join(base, "src")
+	require.NoError(t, os.Mkdir(src, 0700))
+	require.NoError(t, os.Chown(src, int(uid), int(uid)))
+	content := filepath.Join(src, "app.js")
+	require.NoError(t, os.WriteFile(content, []byte("SAFE"), 0600))
+	require.NoError(t, os.Chown(content, int(uid), int(uid)))
+
+	helper, err := os.Executable()
+	require.NoError(t, err)
+	input, err := os.Open(helper)
+	require.NoError(t, err)
+	defer input.Close()
+	copied := filepath.Join(base, "helper")
+	output, err := os.OpenFile(copied, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	require.NoError(t, err)
+	_, err = io.Copy(output, input)
+	require.NoError(t, err)
+	require.NoError(t, output.Close())
+	require.NoError(t, os.Chmod(copied, 0555))
+
+	sender := func(label string) (*net.UnixConn, int) {
+		t.Helper()
+		socketPath := filepath.Join(base, label+".sock")
+		marker := filepath.Join(base, label+".sent")
+		require.NoError(t, os.WriteFile(marker, nil, 0666))
+		require.NoError(t, os.Chmod(marker, 0666))
+		listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: socketPath, Net: "unix"})
+		require.NoError(t, err)
+		t.Cleanup(func() { _ = listener.Close() })
+		require.NoError(t, os.Chown(socketPath, 0, int(uid)))
+		require.NoError(t, os.Chmod(socketPath, 0660))
+		cmd := exec.Command(copied, "-test.run=^TestC1V49InheritedUnixSocketCannotSpendPermit$")
+		cmd.Env = append(os.Environ(), "VIRKI_V49_CHILD=spawner", "VIRKI_V49_SOURCE="+src,
+			"VIRKI_V49_SOCKET="+socketPath, "VIRKI_V49_SENT_MARKER="+marker)
+		cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{
+			Uid: uid, Gid: uid, Groups: []uint32{},
+		}}
+		require.NoError(t, cmd.Start())
+		require.NoError(t, listener.SetDeadline(time.Now().Add(5*time.Second)))
+		conn, err := listener.AcceptUnix()
+		require.NoError(t, err)
+		require.NoError(t, cmd.Wait(), "original socket creator must have exited and been reaped")
+		deadline := time.Now().Add(5 * time.Second)
+		for {
+			data, _ := os.ReadFile(marker)
+			if string(data) == "sent" {
+				break
+			}
+			require.True(t, time.Now().Before(deadline), "inherited child must send a real SCM_RIGHTS FD")
+			time.Sleep(10 * time.Millisecond)
+		}
+		return conn, cmd.Process.Pid
+	}
+
+	t.Run("C4 precursor rejects inherited-socket sender identity", func(t *testing.T) {
+		conn, originalPID := sender("handoff")
+		defer conn.Close()
+		fd, err := receiveV37AuthenticatedStageFD(conn, originalPID, uid, uid)
+		if fd >= 0 {
+			_ = unix.Close(fd)
+		}
+		require.Error(t, err, "SO_PEERCRED alone must not accept a dead creator's socket inherited by another PID")
+	})
+
+	t.Run("unauthorized sender cannot burn a valid durable V40 permit", func(t *testing.T) {
+		ledger := filepath.Join(base, "ledger")
+		trust := v40TrustDir(ledger)
+		require.NoError(t, os.Mkdir(ledger, 0700))
+		require.NoError(t, os.Mkdir(trust, 0700))
+		pub, priv, err := ed25519.GenerateKey(rand.Reader)
+		require.NoError(t, err)
+		macKey := make([]byte, 32)
+		_, err = rand.Read(macKey)
+		require.NoError(t, err)
+		manifest := v15PacketManifest()
+		permit := V15OwnerPermit{Domain: V15OwnerDomain, ApprovalID: "v49-inherited",
+			ManifestDigest: manifest.Digest, WorkerID: manifest.WorkerID,
+			SessionID: manifest.SessionID, ContextName: manifest.ContextName,
+			Nonce: manifest.Nonce, Epoch: 7, ExpiresUnix: time.Now().Add(time.Hour).Unix()}
+		permit.Signature = ed25519.Sign(priv, v15PermitBytes(permit))
+		for _, item := range []struct {
+			path string
+			data []byte
+			mode os.FileMode
+		}{
+			{filepath.Join(ledger, v40LogName), nil, 0600},
+			{filepath.Join(trust, v40KeyName), macKey, 0400},
+			{filepath.Join(trust, v40CheckpointName), v40InitialCheckpoint(ledger, pub, macKey), 0600},
+		} {
+			require.NoError(t, os.WriteFile(item.path, item.data, item.mode))
+			f, err := os.Open(item.path)
+			require.NoError(t, err)
+			require.NoError(t, f.Sync())
+			require.NoError(t, f.Close())
+		}
+		for _, dir := range []string{ledger, trust} {
+			fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+			require.NoError(t, err)
+			require.NoError(t, unix.Fsync(fd))
+			require.NoError(t, unix.Close(fd))
+		}
+		conn, originalPID := sender("permit")
+		defer conn.Close()
+		dest := filepath.Join(base, "private-publication")
+		err = publishV39FromAuthorizedTestPeer(ledger, conn, originalPID, uid, uid,
+			dest, manifest, permit, pub, 7, 8)
+		require.Error(t, err, "inherited child cannot publish under a dead creator's trusted PID")
+		_, err = os.Lstat(dest)
+		require.ErrorIs(t, err, os.ErrNotExist)
+		require.NoError(t, claimV39DurableTestOwnerPermit(ledger, manifest, permit, pub, 7, 8),
+			"rejected sender must leave the original signed one-time permit usable")
+	})
+}
