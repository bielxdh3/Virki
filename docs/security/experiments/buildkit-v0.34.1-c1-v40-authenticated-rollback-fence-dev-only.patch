+		if err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err == nil {
+			break
+		} else if !errors.Is(err, unix.EWOULDBLOCK) || time.Now().After(deadline) {
+			return fmt.Errorf("V40 exclusive claim lock unavailable: %w", err)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	defer unix.Flock(fd, unix.LOCK_UN)
+	if err := v40CheckFileIdentity(ledgerFD, fd, v40LogName, 0600); err != nil {
+		return err
+	}
+	if err := v40NoPending(trustFD); err != nil {
+		return err
+	}
+	key, err := v40ReadProtected(trustFD, v40KeyName, 0400, 32)
+	if err != nil || len(key) != 32 {
+		return errors.New("V40 root-only independent MAC key missing or malformed")
+	}
+	anchor, err := v40ReadProtected(trustFD, v40CheckpointName, 0600, 256)
+	if err != nil {
+		return fmt.Errorf("V40 trusted checkpoint unavailable: %w", err)
+	}
+	if _, err := unix.Seek(fd, 0, io.SeekStart); err != nil {
+		return err
+	}
+	log, err := v40ReadBoundedFD(fd, v39LedgerMaxBytes)
+	if err != nil || len(log) > v39LedgerMaxBytes {
+		return errors.New("V40 ledger unreadable/overflow")
+	}
+	claims, count, floor, tip, err := v40VerifyHistory(log, anchor, ledgerDir, pub, key)
+	if err != nil {
+		return err
+	}
+	effectiveFloor := minimumEpoch
+	if floor > effectiveFloor {
+		effectiveFloor = floor
+	}
+	if err := NewV15LocalReplayLedger(effectiveFloor).VerifyAndClaim(m, p, pub); err != nil {
+		return fmt.Errorf("V40 signed test owner permit refused: %w", err)
+	}
+	keyHash := sha256.Sum256([]byte(fmt.Sprintf("%s\x00%d\x00%s", V15OwnerDomain, p.Epoch, p.ApprovalID)))
+	claimKey := hex.EncodeToString(keyHash[:])
+	if _, exists := claims[claimKey]; exists {
+		return errors.New("V40 signed owner permit replayed after restart or concurrent claim")
+	}
+	epoch := strconv.FormatUint(p.Epoch, 10)
+	next := v40MAC(key, "virki-v40-test-row", ledgerDir, tip, epoch, claimKey)
+	row := []byte("V40 " + epoch + " " + claimKey + " " + next + "\n")
+	if len(log)+len(row) > v39LedgerMaxBytes || count == ^uint64(0) {
+		return errors.New("V40 ledger full, refuse until independently authorized migration")
+	}
+	// Persist an independent in-flight marker BEFORE mutating the ledger.
+	// A crash/EIO between log append and checkpoint replacement MUST NOT
+	// accidentally look like a clean, publishable history after restart,
+	// even if both log and checkpoint happen to persist.
+	intentFD, err := unix.Openat(trustFD, v40IntentName, unix.O_WRONLY|unix.O_CREAT|
+		unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return fmt.Errorf("V40 cannot fence pending transaction: %w", err)
+	}
+	if n, writeErr := unix.Write(intentFD, []byte("V40_INFLIGHT\n")); writeErr != nil || n != len("V40_INFLIGHT\n") {
+		_ = unix.Close(intentFD)
+		return errors.New("V40 ambiguous durable transaction intent: publication forbidden")
+	}
+	if err := unix.Fsync(intentFD); err != nil {
+		_ = unix.Close(intentFD)
+		return fmt.Errorf("V40 transaction intent fsync failed: %w", err)
+	}
+	if err := unix.Close(intentFD); err != nil {
+		return err
+	}
+	if err := unix.Fsync(trustFD); err != nil {
+		return fmt.Errorf("V40 transaction intent parent fsync failed: %w", err)
+	}
+	if _, err := unix.Seek(fd, 0, io.SeekEnd); err != nil {
+		return err
+	}
+	if n, err := unix.Write(fd, row); err != nil || n != len(row) {
+		return errors.New("V40 ambiguous log write; publication forbidden")
+	}
+	if err := syncLog(fd); err != nil {
+		return fmt.Errorf("V40 ambiguous log fsync; publication forbidden: %w", err)
+	}
+	if err := unix.Fsync(ledgerFD); err != nil {
+		return fmt.Errorf("V40 ambiguous ledger parent fsync; publication forbidden: %w", err)
+	}
+	newFloor := floor
+	if p.Epoch > newFloor {
+		newFloor = p.Epoch
+	}
+	checkpoint := v40CheckpointBytes(ledgerDir, pub, key, count+1, newFloor, next)
+	pendingFD, err := unix.Openat(trustFD, v40PendingName, unix.O_WRONLY|unix.O_CREAT|
+		unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return fmt.Errorf("V40 unable to establish exclusive pending checkpoint: %w", err)
+	}
+	if n, writeErr := unix.Write(pendingFD, checkpoint); writeErr != nil || n != len(checkpoint) {
+		_ = unix.Close(pendingFD)
+		return errors.New("V40 ambiguous pending checkpoint write, manual recovery")
+	}
+	if err := syncCheckpoint(pendingFD); err != nil {
+		_ = unix.Close(pendingFD)
+		return fmt.Errorf("V40 ambiguous checkpoint fsync, manual recovery: %w", err)
+	}
+	if err := unix.Close(pendingFD); err != nil {
+		return err
+	}
+	if err := v40CheckFileIdentity(ledgerFD, fd, v40LogName, 0600); err != nil {
+		return err
+	}
+	if err := unix.Renameat2(trustFD, v40PendingName, trustFD, v40CheckpointName, 0); err != nil {
+		return fmt.Errorf("V40 ambiguous atomic checkpoint replacement, manual recovery: %w", err)
+	}
+	if err := syncTrustParent(trustFD); err != nil {
+		return fmt.Errorf("V40 ambiguous checkpoint parent fsync, manual recovery: %w", err)
+	}
+	if err := v40CheckFileIdentity(ledgerFD, fd, v40LogName, 0600); err != nil {
+		return err
+	}
+	current, err := v40ReadProtected(trustFD, v40CheckpointName, 0600, 256)
+	if err != nil || !hmac.Equal(current, checkpoint) {
+		return errors.New("V40 newly committed checkpoint untrusted; never publish")
+	}
+	if err := unix.Unlinkat(trustFD, v40IntentName, 0); err != nil {
+		return fmt.Errorf("V40 cannot clear durable transaction fence: %w", err)
+	}
+	if err := unix.Fsync(trustFD); err != nil {
+		return fmt.Errorf("V40 transaction fence clearing fsync failed: %w", err)
+	}
+	if err := v40NoPending(trustFD); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Read without an os.File wrapper/finalizer around the locked descriptor.
+// An independently finalized duplicate wrapper could close the flock FD.
+func v40ReadBoundedFD(fd, limit int) ([]byte, error) {
+	buf := make([]byte, 0, 4096)
+	part := make([]byte, 4096)
+	for len(buf) <= limit {
+		n, err := unix.Read(fd, part)
+		if n > 0 {
+			buf = append(buf, part[:n]...)
+		}
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		if n == 0 {
+			return buf, nil
+		}
+	}
+	return nil, errors.New("V40 ledger limit exceeded")
+}
