+
+// A separate synthetic fixture isolates tamper tests from the V39 positive
+// path. It cannot attest production C4/TPM or a maliciously compromised root.
+func TestC1V40AuthenticatedLedgerDetectsValidHexTamperAndRollback(t *testing.T) {
+	if os.Getenv("VIRKI_V40_CHILD") == "claim" {
+		raw, err := base64.StdEncoding.DecodeString(os.Getenv("VIRKI_V40_CLAIM"))
+		require.NoError(t, err)
+		var cfg v39ChildClaim
+		require.NoError(t, json.Unmarshal(raw, &cfg))
+		if err := claimV39DurableTestOwnerPermit(cfg.Ledger, cfg.Manifest, cfg.Permit, cfg.Public, 7, 8); err != nil {
+			_, _ = os.Stdout.WriteString("CLAIM_REFUSED\n")
+		} else {
+			_, _ = os.Stdout.WriteString("CLAIM_ACCEPTED\n")
+		}
+		return
+	}
+	if os.Getenv("VIRKI_V40_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("V40 requires explicit isolated root fixture")
+	}
+	base, err := os.MkdirTemp("/var/tmp", "virki-v40-tamper-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(base)) })
+	require.NoError(t, os.Chmod(base, 0711))
+	manifest := v15PacketManifest()
+	pub, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	key := make([]byte, 32)
+	_, err = rand.Read(key)
+	require.NoError(t, err)
+	sign := func(approval string, epoch uint64) V15OwnerPermit {
+		p := V15OwnerPermit{
+			Domain: V15OwnerDomain, ApprovalID: approval, ManifestDigest: manifest.Digest,
+			WorkerID: manifest.WorkerID, SessionID: manifest.SessionID,
+			ContextName: manifest.ContextName, Nonce: manifest.Nonce,
+			Epoch: epoch, ExpiresUnix: time.Now().Add(time.Hour).Unix(),
+		}
+		p.Signature = ed25519.Sign(private, v15PermitBytes(p))
+		return p
+	}
+	provision := func(name string) string {
+		t.Helper()
+		dir := filepath.Join(base, name)
+		trust := v40TrustDir(dir)
+		require.NoError(t, os.Mkdir(dir, 0700))
+		require.NoError(t, os.Mkdir(trust, 0700))
+		files := []struct {
+			path string
+			data []byte
+			mode os.FileMode
+		}{
+			{filepath.Join(dir, v40LogName), nil, 0600},
+			{filepath.Join(trust, v40KeyName), key, 0400},
+			{filepath.Join(trust, v40CheckpointName), v40InitialCheckpoint(dir, pub, key), 0600},
+		}
+		for _, item := range files {
+			require.NoError(t, os.WriteFile(item.path, item.data, item.mode))
+			f, err := os.Open(item.path)
+			require.NoError(t, err)
+			require.NoError(t, f.Sync())
+			require.NoError(t, f.Close())
+		}
+		for _, path := range []string{dir, trust} {
+			d, err := unix.Open(path, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+			require.NoError(t, err)
+			require.NoError(t, unix.Fsync(d))
+			require.NoError(t, unix.Close(d))
+		}
+		return dir
+	}
+	claim := func(dir string, p V15OwnerPermit) error {
+		return claimV39DurableTestOwnerPermit(dir, manifest, p, pub, 7, 8)
+	}
+	assertRestartRefused := func(dir string, permit V15OwnerPermit) {
+		t.Helper()
+		self, err := os.Executable()
+		require.NoError(t, err)
+		cfg, err := json.Marshal(v39ChildClaim{dir, manifest, permit, pub})
+		require.NoError(t, err)
+		cmd := exec.Command(self, "-test.run=^TestC1V40AuthenticatedLedgerDetectsValidHexTamperAndRollback$")
+		cmd.Env = append(os.Environ(), "VIRKI_V40_CHILD=claim",
+			"VIRKI_V40_CLAIM="+base64.StdEncoding.EncodeToString(cfg))
+		output, err := cmd.CombinedOutput()
+		require.NoError(t, err, "%s", output)
+		require.Contains(t, string(output), "CLAIM_REFUSED")
+		require.NotContains(t, string(output), "CLAIM_ACCEPTED")
+	}
+	refusePublication := func(dir string, p V15OwnerPermit) {
+		t.Helper()
+		dest := filepath.Join(base, "must-not-exist")
+		err := publishV39FromAuthorizedTestPeer(dir, &net.UnixConn{}, 12345,
+			60014, 60014, dest, manifest, p, pub, 7, 8)
+		require.Error(t, err)
+		_, err = os.Lstat(dest)
+		require.ErrorIs(t, err, os.ErrNotExist)
+	}
+	t.Run("valid hexadecimal mutation of signed replay key", func(t *testing.T) {
+		dir := provision("hex")
+		first := sign("first", 7)
+		require.NoError(t, claim(dir, first))
+		file := filepath.Join(dir, v40LogName)
+		raw, err := os.ReadFile(file)
+		require.NoError(t, err)
+		fields := strings.Fields(string(raw))
+		require.Len(t, fields, 4)
+		require.True(t, v40CanonicalHash(fields[2]))
+		broken := []byte(fields[2])
+		if broken[4] == 'a' {
+			broken[4] = 'b'
+		} else {
+			broken[4] = 'a'
+		}
+		tampered := strings.Replace(string(raw), fields[2], string(broken), 1)
+		require.NoError(t, os.WriteFile(file, []byte(tampered), 0600))
+		require.True(t, v40CanonicalHash(string(broken)), "attack preserves exact valid 64-digit lowercase hex format")
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		require.ErrorContains(t, claim(dir, sign("second", 7)), "authenticated claim history")
+		assertRestartRefused(dir, first)
+		refusePublication(dir, first)
+	})
+	t.Run("intermediate record mutation stays syntactically valid", func(t *testing.T) {
+		dir := provision("middle")
+		for _, id := range []string{"a", "b", "c"} {
+			require.NoError(t, claim(dir, sign(id, 7)))
+		}
+		file := filepath.Join(dir, v40LogName)
+		raw, err := os.ReadFile(file)
+		require.NoError(t, err)
+		lines := strings.Split(strings.TrimSuffix(string(raw), "\n"), "\n")
+		require.Len(t, lines, 3)
+		fields := strings.Split(lines[1], " ")
+		require.Len(t, fields, 4)
+		flipped := []byte(fields[2])
+		if flipped[0] == 'f' {
+			flipped[0] = 'e'
+		} else {
+			flipped[0] = 'f'
+		}
+		fields[2] = string(flipped)
+		lines[1] = strings.Join(fields, " ")
+		require.NoError(t, os.WriteFile(file, []byte(strings.Join(lines, "\n")+"\n"), 0600))
+		require.ErrorContains(t, claim(dir, sign("b", 7)), "authenticated claim history")
+		assertRestartRefused(dir, sign("b", 7))
+		refusePublication(dir, sign("b", 7))
+	})
+	t.Run("truncation, rollback, inode replacement and independent checkpoint rollback", func(t *testing.T) {
+		dir := provision("rollback")
+		anchorFile := filepath.Join(v40TrustDir(dir), v40CheckpointName)
+		logFile := filepath.Join(dir, v40LogName)
+		genesis, err := os.ReadFile(anchorFile)
+		require.NoError(t, err)
+		first := sign("earlier", 7)
+		require.NoError(t, claim(dir, first))
+		firstLog, err := os.ReadFile(logFile)
+		require.NoError(t, err)
+		require.NoError(t, claim(dir, sign("later", 8)))
+		fullLog, err := os.ReadFile(logFile)
+		require.NoError(t, err)
+		fullAnchor, err := os.ReadFile(anchorFile)
+		require.NoError(t, err)
+		// Roll back only the ledger to a previously valid prefix, with a fresh
+		// root-owned inode. Even a legitimate older chain cannot bypass anchor.
+		require.NoError(t, os.Remove(logFile))
+		require.NoError(t, os.WriteFile(logFile, firstLog, 0600))
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		assertRestartRefused(dir, first)
+		// A reset checkpoint cannot authorize a still-current, longer log.
+		require.NoError(t, os.WriteFile(logFile, fullLog, 0600))
+		require.NoError(t, os.WriteFile(anchorFile, genesis, 0600))
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		assertRestartRefused(dir, first)
+		// An empty log with the independently retained nonzero checkpoint
+		// must fail. Resetting BOTH files would require compromising the
+		// trust principal and cannot be solved with a same-root MAC key.
+		require.NoError(t, os.WriteFile(anchorFile, fullAnchor, 0600))
+		require.NoError(t, os.WriteFile(logFile, nil, 0600))
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		refusePublication(dir, first)
+	})
+	t.Run("authenticated anchor and key tamper cannot fake replay history", func(t *testing.T) {
+		dir := provision("anchor-tamper")
+		first := sign("anchor-first", 7)
+		require.NoError(t, claim(dir, first))
+		anchor := filepath.Join(v40TrustDir(dir), v40CheckpointName)
+		raw, err := os.ReadFile(anchor)
+		require.NoError(t, err)
+		fields := strings.Fields(string(raw))
+		require.Len(t, fields, 5)
+		digest := []byte(fields[4])
+		digest[3] = 'a'
+		if fields[4][3] == 'a' {
+			digest[3] = 'b'
+		}
+		fields[4] = string(digest)
+		require.NoError(t, os.WriteFile(anchor, []byte(strings.Join(fields, " ")+"\n"), 0600))
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		assertRestartRefused(dir, first)
+	})
+	t.Run("fsync errors never authorize or silently repair historical claims", func(t *testing.T) {
+		for _, fault := range []string{"log", "checkpoint", "checkpoint-parent"} {
+			t.Run(fault, func(t *testing.T) {
+				dir := provision("fault-" + fault)
+				first := sign("fault-"+fault, 7)
+				syncLog := unix.Fsync
+				syncCheckpoint := unix.Fsync
+				syncParent := unix.Fsync
+				switch fault {
+				case "log":
+					syncLog = func(int) error { return unix.EIO }
+				case "checkpoint":
+					syncCheckpoint = func(int) error { return unix.EIO }
+				case "checkpoint-parent":
+					syncParent = func(int) error { return unix.EIO }
+				}
+				err := claimV40AuthenticatedTestPermitWithHooks(dir, manifest, first, pub,
+					7, 8, syncLog, syncCheckpoint, syncParent)
+				require.Error(t, err)
+				// The same signed permit is never re-admitted; rollback to the
+				// clean genesis after a failure is forbidden without oversight.
+				require.Error(t, claim(dir, first))
+				assertRestartRefused(dir, first)
+				refusePublication(dir, first)
+				// Even a different, freshly signed permit must be rejected
+				// after a durably ambiguous transaction, including restart.
+				next := sign("different-after-"+fault, 8)
+				require.ErrorContains(t, claim(dir, next), "ambiguous crash")
+				assertRestartRefused(dir, next)
+				refusePublication(dir, next)
+				if fault == "checkpoint" {
+					_, err := os.Lstat(filepath.Join(v40TrustDir(dir), v40PendingName))
+					require.NoError(t, err, "unsynced checkpoint retained as crash evidence")
+				}
+			})
+		}
+	})
+	t.Run("fresh epoch remains live only after verified prior claim", func(t *testing.T) {
+		dir := provision("positive")
+		require.NoError(t, claim(dir, sign("first", 7)))
+		require.NoError(t, claim(dir, sign("next", 8)))
+		require.ErrorContains(t, claim(dir, sign("first", 7)), "stale")
+		raw, err := os.ReadFile(filepath.Join(dir, v40LogName))
+		require.NoError(t, err)
+		anchor, err := os.ReadFile(filepath.Join(v40TrustDir(dir), v40CheckpointName))
+		require.NoError(t, err)
+		claims, count, floor, _, err := v40VerifyHistory(raw, anchor, dir, pub, key)
+		require.NoError(t, err)
+		require.Len(t, claims, 2)
+		require.Equal(t, uint64(2), count)
+		require.Equal(t, uint64(8), floor)
+		_, err = os.Lstat(filepath.Join(v40TrustDir(dir), v40IntentName))
+		require.ErrorIs(t, err, os.ErrNotExist, "successful commit must clear in-flight marker")
+		_, err = os.Lstat(filepath.Join(v40TrustDir(dir), v40PendingName))
+		require.ErrorIs(t, err, os.ErrNotExist, "successful commit must clear pending checkpoint")
+	})
+	t.Run("legacy unauthenticated V39 records cannot be imported silently", func(t *testing.T) {
+		dir := provision("legacy")
+		synthetic := "V39 7 " + strings.Repeat("a", 64) + "\n"
+		require.NoError(t, os.WriteFile(filepath.Join(dir, v40LogName), []byte(synthetic), 0600))
+		permit := sign("legacy-test", 7)
+		require.ErrorContains(t, claim(dir, permit), "authenticated claim history")
+		assertRestartRefused(dir, permit)
+		refusePublication(dir, permit)
+	})
+	t.Run("same-sized root key replacement cannot authenticate prior history", func(t *testing.T) {
+		dir := provision("key-replaced")
+		first := sign("key-first", 7)
+		require.NoError(t, claim(dir, first))
+		file := filepath.Join(v40TrustDir(dir), v40KeyName)
+		newKey := make([]byte, len(key))
+		_, err := rand.Read(newKey)
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(file, newKey, 0400))
+		require.ErrorContains(t, claim(dir, first), "authenticated claim history")
+		assertRestartRefused(dir, first)
+		refusePublication(dir, first)
+	})
+	t.Run("untrusted trust anchor replaced or symlinked always fails", func(t *testing.T) {
+		dir := provision("symlink")
+		first := sign("first", 7)
+		require.NoError(t, claim(dir, first))
+		keyPath := filepath.Join(v40TrustDir(dir), v40KeyName)
+		require.NoError(t, os.Remove(keyPath))
+		require.NoError(t, os.Symlink("/dev/null", keyPath))
+		require.Error(t, claim(dir, sign("second", 7)))
+	})
+}
