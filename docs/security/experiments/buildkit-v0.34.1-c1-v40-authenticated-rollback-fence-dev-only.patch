@@ -0,0 +1,411 @@
+//go:build linux
+
+package filesync
+
+import (
+	"crypto/ed25519"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	v40KeyName        = ".virki-v40-key"
+	v40CheckpointName = ".virki-v40-checkpoint"
+	v40PendingName    = ".virki-v40-checkpoint.pending"
+	v40IntentName     = ".virki-v40-inflight"
+	v40LogName        = ".virki-v39-claims"
+)
+
+// The trust directory is a distinct root-owned sibling of the ledger. The
+// trusted supervisor provisions its 0400 random key, 0600 authenticated
+// genesis checkpoint and empty ledger BEFORE starting the broker. Rollback of
+// BOTH ledger and independent checkpoint by a compromised root is outside
+// this root-trusting DEV threat model: production needs an external monotonic
+// owner authority (e.g. C4/TPM), not this synthetic replay fence.
+func v40TrustDir(ledgerDir string) string { return ledgerDir + "-anchor" }
+
+func v40MAC(key []byte, domain string, fields ...string) string {
+	m := hmac.New(sha256.New, key)
+	_, _ = m.Write([]byte(domain))
+	for _, field := range fields {
+		_, _ = m.Write([]byte{0})
+		_, _ = m.Write([]byte(field))
+	}
+	return hex.EncodeToString(m.Sum(nil))
+}
+
+func v40Genesis(ledgerDir string, pub ed25519.PublicKey, key []byte) string {
+	return v40MAC(key, "virki-v40-test-genesis", ledgerDir, hex.EncodeToString(pub))
+}
+
+func v40CheckpointBytes(ledgerDir string, pub ed25519.PublicKey, key []byte,
+	count, floor uint64, tip string) []byte {
+	data := fmt.Sprintf("V40A %d %d %s", count, floor, tip)
+	tag := v40MAC(key, "virki-v40-test-anchor", ledgerDir, hex.EncodeToString(pub), data)
+	return []byte(data + " " + tag + "\n")
+}
+
+func v40InitialCheckpoint(ledgerDir string, pub ed25519.PublicKey, key []byte) []byte {
+	return v40CheckpointBytes(ledgerDir, pub, key, 0, 0, v40Genesis(ledgerDir, pub, key))
+}
+
+func v40CanonicalHash(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	b, err := hex.DecodeString(s)
+	return err == nil && len(b) == sha256.Size && hex.EncodeToString(b) == s
+}
+
+func v40OpenRootDir(rootFD int, path string) (int, error) {
+	if err := validateV24TrustedSupervisorAncestors(rootFD, path); err != nil {
+		return -1, fmt.Errorf("V40 untrusted ancestor: %w", err)
+	}
+	fd, err := unix.Openat2(rootFD, strings.TrimPrefix(path, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_NOFOLLOW | unix.O_CLOEXEC),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+	})
+	if err != nil {
+		return -1, err
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		_ = unix.Close(fd)
+		return -1, err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != 0 || st.Gid != 0 || st.Mode&07777 != 0700 {
+		_ = unix.Close(fd)
+		return -1, errors.New("V40 trust directory must be root:root 0700")
+	}
+	return fd, nil
+}
+
+// Never follow symlinks, accept link aliases, or trust a descriptor whose
+// pathname has been replaced. Recheck each pinned inode after lock/commit.
+func v40CheckFileIdentity(dirFD, fd int, name string, mode uint32) error {
+	var st, named unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return err
+	}
+	if err := unix.Fstatat(dirFD, name, &named, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG || st.Mode&07777 != mode ||
+		st.Uid != 0 || st.Gid != 0 || st.Nlink != 1 ||
+		named.Mode&unix.S_IFMT != unix.S_IFREG ||
+		st.Dev != named.Dev || st.Ino != named.Ino {
+		return fmt.Errorf("V40 %s untrusted mode, owner, links or inode", name)
+	}
+	return nil
+}
+
+func v40ReadProtected(dirFD int, name string, mode uint32, limit int64) ([]byte, error) {
+	fd, err := unix.Openat(dirFD, name, unix.O_RDONLY|unix.O_NONBLOCK|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), name)
+	defer f.Close()
+	if err := v40CheckFileIdentity(dirFD, fd, name, mode); err != nil {
+		return nil, err
+	}
+	data, err := io.ReadAll(io.LimitReader(f, limit+1))
+	if err != nil || int64(len(data)) > limit {
+		return nil, errors.New("V40 trust file unreadable or outside size limit")
+	}
+	if err := v40CheckFileIdentity(dirFD, fd, name, mode); err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+func v40NoPending(trustFD int) error {
+	for _, name := range []string{v40PendingName, v40IntentName} {
+		var st unix.Stat_t
+		err := unix.Fstatat(trustFD, name, &st, unix.AT_SYMLINK_NOFOLLOW)
+		if errors.Is(err, unix.ENOENT) {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		return fmt.Errorf("V40 %s remains: ambiguous crash, manual recovery only", name)
+	}
+	return nil
+}
+
+func v40VerifyHistory(log []byte, anchor []byte, ledgerDir string,
+	pub ed25519.PublicKey, key []byte) (map[string]struct{}, uint64, uint64, string, error) {
+	fail := func() (map[string]struct{}, uint64, uint64, string, error) {
+		return nil, 0, 0, "", errors.New("V40 authenticated claim history/anchor mismatch: fail closed")
+	}
+	if len(key) != 32 || len(pub) != ed25519.PublicKeySize || len(anchor) == 0 ||
+		anchor[len(anchor)-1] != '\n' || len(anchor) > 256 {
+		return fail()
+	}
+	fields := strings.Split(strings.TrimSuffix(string(anchor), "\n"), " ")
+	if len(fields) != 5 || fields[0] != "V40A" ||
+		!v40CanonicalHash(fields[3]) || !v40CanonicalHash(fields[4]) {
+		return fail()
+	}
+	count, errCount := strconv.ParseUint(fields[1], 10, 64)
+	floor, errFloor := strconv.ParseUint(fields[2], 10, 64)
+	if errCount != nil || errFloor != nil ||
+		strconv.FormatUint(count, 10) != fields[1] ||
+		strconv.FormatUint(floor, 10) != fields[2] {
+		return fail()
+	}
+	prefix := strings.Join(fields[:4], " ")
+	if !hmac.Equal([]byte(fields[4]), []byte(v40MAC(key, "virki-v40-test-anchor",
+		ledgerDir, hex.EncodeToString(pub), prefix))) {
+		return fail()
+	}
+	tip := v40Genesis(ledgerDir, pub, key)
+	claims := make(map[string]struct{})
+	var n, high uint64
+	if len(log) > 0 {
+		if log[len(log)-1] != '\n' {
+			return fail()
+		}
+		for _, line := range strings.Split(strings.TrimSuffix(string(log), "\n"), "\n") {
+			fields := strings.Split(line, " ")
+			if len(fields) != 4 || fields[0] != "V40" ||
+				!v40CanonicalHash(fields[2]) || !v40CanonicalHash(fields[3]) {
+				return fail()
+			}
+			epoch, err := strconv.ParseUint(fields[1], 10, 64)
+			if err != nil || epoch == 0 || strconv.FormatUint(epoch, 10) != fields[1] ||
+				epoch < high {
+				return fail()
+			}
+			next := v40MAC(key, "virki-v40-test-row", ledgerDir, tip, fields[1], fields[2])
+			if !hmac.Equal([]byte(next), []byte(fields[3])) {
+				return fail()
+			}
+			if _, exists := claims[fields[2]]; exists {
+				return fail()
+			}
+			claims[fields[2]] = struct{}{}
+			high = epoch
+			tip = next
+			n++
+		}
+	}
+	if n != count || high != floor || tip != fields[3] {
+		return fail()
+	}
+	return claims, count, floor, tip, nil
+}
+
+func claimV40AuthenticatedTestPermitWithSync(ledgerDir string, m V15SealedManifest, p V15OwnerPermit,
+	pub ed25519.PublicKey, minimumEpoch, maximumEpoch uint64, syncLog func(int) error) error {
+	return claimV40AuthenticatedTestPermitWithHooks(ledgerDir, m, p, pub, minimumEpoch,
+		maximumEpoch, syncLog, unix.Fsync, unix.Fsync)
+}
+
+// DEV-only injection seams for log fsync, checkpoint file fsync and checkpoint
+// directory fsync. Any uncertain result is terminal and not publishable.
+func claimV40AuthenticatedTestPermitWithHooks(ledgerDir string, m V15SealedManifest, p V15OwnerPermit,
