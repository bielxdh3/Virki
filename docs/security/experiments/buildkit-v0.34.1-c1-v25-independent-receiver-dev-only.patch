+)
+
+// This is an opt-in, ordinary positive DEV integration fixture. It uses
+// synthetic content and temporary numeric identities, not host accounts,
+// persistent configuration or protected FileSync.
+const (
+	v24FixtureReceiverUID uint32 = 60001
+	v24FixtureSenderUID   uint32 = 60002
+)
+
+type v24IndependentFixture struct {
+	Manifest V15SealedManifest
+	Permit   V15OwnerPermit
+	Public   ed25519.PublicKey
+}
+
+func v24FixturePolicy(uid, peer uint32) V24ReceiverCustodyPolicy {
+	return V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &uid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		ExpectedSenderUID:           &peer,
+		ExpectedSenderGID:           &peer,
+	}
+}
+
+func TestC1V24IndependentReceiverProcess(t *testing.T) {
+	switch os.Getenv("VIRKI_V24_INDEPENDENT_ROLE") {
+	case "sender":
+		v24IndependentSender(t)
+		return
+	case "receiver":
+		v24IndependentReceiver(t)
+		return
+	}
+	if os.Getenv("VIRKI_V24_RUN_ROOT_FIXTURE") != "1" || os.Geteuid() != 0 {
+		t.Skip("opt-in synthetic multi-UID fixture requires a privileged DEV supervisor")
+	}
+	for _, uid := range []uint32{v24FixtureReceiverUID, v24FixtureSenderUID} {
+		id := strconv.FormatUint(uint64(uid), 10)
+		_, err := user.LookupId(id)
+		if err == nil {
+			t.Skipf("fixture UID %s is already assigned", id)
+		}
+		require.IsType(t, user.UnknownUserIdError(0), err)
+		_, err = user.LookupGroupId(id)
+		if err == nil {
+			t.Skipf("fixture GID %s is already assigned", id)
+		}
+		require.IsType(t, user.UnknownGroupIdError(""), err)
+	}
+	root, err := os.MkdirTemp("/tmp", "virki-v24-custody-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(root)) })
+	require.NoError(t, os.Chmod(root, 0711))
+	for name, uid := range map[string]uint32{"sender": v24FixtureSenderUID, "receiver": v24FixtureReceiverUID} {
+		dir := filepath.Join(root, name)
+		require.NoError(t, os.Mkdir(dir, 0700))
+		require.NoError(t, os.Chown(dir, int(uid), int(uid)))
+	}
+	src := filepath.Join(root, "sender", "app.js")
+	require.NoError(t, os.WriteFile(src, []byte("SAFE"), 0600))
+	require.NoError(t, os.Chown(src, int(v24FixtureSenderUID), int(v24FixtureSenderUID)))
+	m := v15PacketManifest()
+	permit, pub, _ := v15SignedPermitFixture(t, m)
+	data, err := json.Marshal(v24IndependentFixture{Manifest: m, Permit: permit, Public: pub})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(root, "fixture.json"), data, 0444))
+
+	// Both children execute the same root-owned, read-only fixture binary.
+	self, err := os.Executable()
+	require.NoError(t, err)
+	input, err := os.Open(self)
+	require.NoError(t, err)
+	defer input.Close()
+	helper := filepath.Join(root, "fixture")
+	output, err := os.OpenFile(helper, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+	require.NoError(t, err)
+	_, copyErr := io.Copy(output, input)
+	closeErr := output.Close()
+	require.NoError(t, copyErr)
+	require.NoError(t, closeErr)
+	require.NoError(t, os.Chmod(helper, 0555))
+
+	// The existing session runs over a private, inherited socketpair.
+	// No listening service or external network is involved.
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	require.NoError(t, err)
+	senderFD := os.NewFile(uintptr(fds[0]), "sender-session")
+	receiverFD := os.NewFile(uintptr(fds[1]), "receiver-session")
+	defer senderFD.Close()
+	defer receiverFD.Close()
+
+	ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+	defer cancel()
+	type result struct {
+		out []byte
+		err error
+	}
+	senderDone := make(chan result, 1)
+	receiverDone := make(chan result, 1)
+	launch := func(role string, fd *os.File, uid, peer uint32, done chan<- result) {
+		out, err := runV24IsolatedSubprocessWithFiles(ctx, helper,
+			[]string{"-test.run=^TestC1V24IndependentReceiverProcess$", "-test.v"},
+			v24FixturePolicy(uid, peer), []*os.File{fd},
+			"VIRKI_V24_INDEPENDENT_ROLE="+role, "VIRKI_V24_FIXTURE_ROOT="+root)
+		done <- result{out, err}
+	}
+	go launch("sender", senderFD, v24FixtureSenderUID, v24FixtureReceiverUID, senderDone)
+	go launch("receiver", receiverFD, v24FixtureReceiverUID, v24FixtureSenderUID, receiverDone)
+	receiver := <-receiverDone
+	// Release the supervisor's copies only after the receiver has finished.
+	// This lets the sender observe EOF and terminate its existing session.
+	require.NoError(t, receiverFD.Close())
+	if receiver.err != nil {
+		cancel()
+	}
+	sender := <-senderDone
+	require.NoError(t, receiver.err, "receiver: %s", receiver.out)
+	require.NoError(t, sender.err, "sender: %s", sender.out)
+	published := filepath.Join(root, "receiver", "published", "app.js")
+	got, err := os.ReadFile(published)
+	require.NoError(t, err)
+	require.Equal(t, []byte("SAFE"), got)
+	var st unix.Stat_t
+	require.NoError(t, unix.Stat(published, &st))
+	require.Equal(t, v24FixtureReceiverUID, st.Uid)
+	t.Log("positive sealed FileSync completed across two unprivileged process identities")
+}
+
+func v24FixtureInputs(t *testing.T, uid uint32) (string, v24IndependentFixture, net.Conn) {
+	t.Helper()
+	require.Equal(t, uid, uint32(os.Geteuid()))
+	require.Equal(t, uid, uint32(os.Getegid()))
+	groups, err := os.Getgroups()
+	require.NoError(t, err)
+	require.Empty(t, groups)
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, 1, nnp)
+	root := os.Getenv("VIRKI_V24_FIXTURE_ROOT")
+	require.NotEmpty(t, root)
+	data, err := os.ReadFile(filepath.Join(root, "fixture.json"))
+	require.NoError(t, err)
+	var fixture v24IndependentFixture
+	require.NoError(t, json.Unmarshal(data, &fixture))
+	fd := os.NewFile(3, "fixture-session")
+	require.NotNil(t, fd)
+	conn, err := net.FileConn(fd)
+	require.NoError(t, err)
+	require.NoError(t, fd.Close())
+	t.Cleanup(func() { _ = conn.Close() })
+	return root, fixture, conn
+}
+
+// Only fixture transport glue: existing session.Dialer metadata is carried
+// once over the inherited socket before passing it to Manager.HandleConn.
+func v24IndependentSender(t *testing.T) {
+	root, f, conn := v24FixtureInputs(t, v24FixtureSenderUID)
+	ctx, cancel := context.WithTimeout(t.Context(), 35*time.Second)
+	defer cancel()
+	m := f.Manifest
+	snapshot, err := NewLinuxSealedSnapshotV15(ctx, V15SnapshotRequest{
+		Root: filepath.Join(root, "sender"), ContextName: m.ContextName,
+		WorkerID: m.WorkerID, SessionID: m.SessionID, Nonce: m.Nonce, Files: m.Files,
+	})
+	require.NoError(t, err)
+	require.Equal(t, m.Digest, snapshot.Manifest().Digest)
+	s, err := session.NewSession(ctx, "v24-independent-fixture")
+	require.NoError(t, err)
+	s.Allow(NewSealedFSSyncProviderV15(snapshot))
+	require.NoError(t, s.Run(ctx, func(_ context.Context, _ string, meta map[string][]string) (net.Conn, error) {
+		header, err := json.Marshal(meta)
+		if err != nil {
+			return nil, err
+		}
+		if err := binary.Write(conn, binary.BigEndian, uint32(len(header))); err != nil {
+			return nil, err
+		}
+		if _, err := io.Copy(conn, bytes.NewReader(header)); err != nil {
+			return nil, err
+		}
+		return conn, nil
+	}))
+}
+
+func v24IndependentReceiver(t *testing.T) {
+	root, f, conn := v24FixtureInputs(t, v24FixtureReceiverUID)
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	require.NoError(t, conn.SetReadDeadline(time.Now().Add(10*time.Second)))
+	var length uint32
+	require.NoError(t, binary.Read(conn, binary.BigEndian, &length))
+	require.Positive(t, length)
+	require.LessOrEqual(t, length, uint32(65536))
+	header := make([]byte, length)
+	_, err := io.ReadFull(conn, header)
+	require.NoError(t, err)
+	require.NoError(t, conn.SetReadDeadline(time.Time{}))
+	var meta map[string][]string
+	require.NoError(t, json.Unmarshal(header, &meta))
+	ids := meta["X-Docker-Expose-Session-Uuid"]
+	require.Len(t, ids, 1)
+	manager, err := session.NewManager()
+	require.NoError(t, err)
+	done := make(chan error, 1)
+	go func() { done <- manager.HandleConn(ctx, conn, meta) }()
+	caller, err := manager.Get(ctx, ids[0], false)
+	require.NoError(t, err)
+	m := f.Manifest
+	dest := filepath.Join(root, "receiver", "published")
+	require.NoError(t, FSSyncSealedV24(ctx, caller, FSSendRequestOpt{
+		Name: m.ContextName, FollowPaths: []string{"app.js"}, DestDir: dest,
+	}, m, f.Permit, f.Public, NewV15LocalReplayLedger(f.Permit.Epoch), v24FixturePolicy(v24FixtureReceiverUID, v24FixtureSenderUID)))
+	cancel()
+	_ = conn.Close()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("session shutdown timed out")
+	}
+}
