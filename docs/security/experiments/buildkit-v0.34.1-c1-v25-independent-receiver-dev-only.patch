+// validateV24IndependentCustody checks the explicit DEV supervisor contract.
+// The caller is responsible for independent trusted provisioning of identities
+// and the enclosing filesystem. Local checks are not an owner attestation.
+func validateV24IndependentCustody(dest string, policy V24ReceiverCustodyPolicy) error {
+	if !policy.RequireUnprivileged || !policy.RequirePrivateParent || !policy.RequireImmutableGrandparent ||
+		policy.ExpectedReceiverUID == nil || policy.ExpectedReceiverGID == nil || len(policy.ForbiddenPeerUIDs) == 0 {
+		return errors.New("C1 V24 independent receiver custody requires explicit supervisor identity and private namespace policy")
+	}
+	if policy.ExpectedSenderUID == nil || policy.ExpectedSenderGID == nil ||
+		*policy.ExpectedSenderUID == 0 || *policy.ExpectedSenderGID == 0 ||
+		*policy.ExpectedSenderUID == *policy.ExpectedReceiverUID ||
+		*policy.ExpectedSenderGID == *policy.ExpectedReceiverGID ||
+		!slices.Contains(policy.ForbiddenPeerUIDs, *policy.ExpectedSenderUID) {
+		return errors.New("C1 V24 independent receiver requires explicit distinct sender ownership")
+	}
+	if err := validateV24ProcessIdentity(policy); err != nil {
+		return err
+	}
+	groups, err := os.Getgroups()
+	if err != nil {
+		return err
+	}
+	if len(groups) != 0 {
+		return errors.New("C1 V24 independent receiver refuses supplementary groups")
+	}
+	nnp, err := unix.PrctlRetInt(unix.PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0)
+	if err != nil {
+		return err
+	}
+	if nnp != 1 {
+		return errors.New("C1 V24 independent receiver requires NoNewPrivs")
+	}
+	return validateV24CustodyDirs(dest, policy)
+}
