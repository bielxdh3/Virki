@@ -0,0 +1,262 @@
+//go:build linux
+
+package filesync
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"os/user"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+type v39ChildClaim struct {
+	Ledger   string
+	Manifest V15SealedManifest
+	Permit   V15OwnerPermit
+	Public   ed25519.PublicKey
+}
+
+// Every path, permit, peer and published byte in this test is a disposable
+// synthetic fixture. These assertions are NOT a C4 production authorization.
+func TestC1V39DurableTestPermitAndAuthenticatedPublication(t *testing.T) {
+	const uid uint32 = 60014
+	if os.Getenv("VIRKI_V39_CHILD") == "claim" {
+		raw, err := base64.StdEncoding.DecodeString(os.Getenv("VIRKI_V39_CLAIM"))
+		require.NoError(t, err)
+		var c v39ChildClaim
+		require.NoError(t, json.Unmarshal(raw, &c))
+		if err := claimV39DurableTestOwnerPermit(c.Ledger, c.Manifest, c.Permit, c.Public, 7, 8); err != nil {
+			fmt.Println("V39_CLAIM_REJECTED")
+		} else {
+			fmt.Println("V39_CLAIM_ACCEPTED")
+		}
+		return
+	}
+	if os.Getenv("VIRKI_V39_CHILD") == "sender" {
+		require.Equal(t, int(uid), os.Getuid())
+		fd, err := os.Open(os.Getenv("VIRKI_V39_SOURCE"))
+		require.NoError(t, err)
+		defer fd.Close()
+		conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: os.Getenv("VIRKI_V39_SOCKET"), Net: "unix"})
+		require.NoError(t, err)
+		defer conn.Close()
+		_, _, err = conn.WriteMsgUnix([]byte{'V'}, unix.UnixRights(int(fd.Fd())), nil)
+		require.NoError(t, err)
+		return
+	}
+	if os.Getenv("VIRKI_V39_RUN_ROOT_FIXTURE") != "1" || os.Getuid() != 0 || os.Geteuid() != 0 {
+		t.Skip("V39 requires explicit disposable root-owned fixture")
+	}
+	if _, err := user.LookupId(strconv.FormatUint(uint64(uid), 10)); err == nil {
+		t.Skip("synthetic V39 sender UID already exists")
+	}
+	// /tmp is a separate tmpfs on this WSL host; ledger custody deliberately
+	// forbids cross-mount path traversal. /var/tmp remains on root ext4 here.
+	base, err := os.MkdirTemp("/var/tmp", "virki-v39-permit-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(base)) })
+	require.NoError(t, os.Chmod(base, 0711))
+	ledgerFile := func(dir string) string { return filepath.Join(dir, ".virki-v39-claims") }
+	provision := func(name string) string {
+		dir := filepath.Join(base, name)
+		require.NoError(t, os.Mkdir(dir, 0700))
+		require.NoError(t, os.WriteFile(ledgerFile(dir), nil, 0600))
+		fd, err := unix.Open(dir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		require.NoError(t, err)
+		require.NoError(t, unix.Fsync(fd), "fixture ledger must exist durably before broker use")
+		require.NoError(t, unix.Close(fd))
+		return dir
+	}
+	manifest := v15PacketManifest()
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	sign := func(approval string, epoch uint64) V15OwnerPermit {
+		p := V15OwnerPermit{
+			Domain: V15OwnerDomain, ApprovalID: approval, ManifestDigest: manifest.Digest,
+			WorkerID: manifest.WorkerID, SessionID: manifest.SessionID,
+			ContextName: manifest.ContextName, Nonce: manifest.Nonce,
+			Epoch: epoch, ExpiresUnix: time.Now().Add(time.Hour).Unix(),
+		}
+		p.Signature = ed25519.Sign(priv, v15PermitBytes(p))
+		return p
+	}
+	claim := func(dir string, p V15OwnerPermit) error {
+		return claimV39DurableTestOwnerPermit(dir, manifest, p, pub, 7, 8)
+	}
+	mainLedger := provision("main-ledger")
+	p := sign("first", 7)
+	require.NoError(t, claim(mainLedger, p))
+	require.ErrorContains(t, claim(mainLedger, p), "replayed", "new file open must retain replay fence")
+	for _, bad := range []V15OwnerPermit{sign("stale", 6), sign("future", 9)} {
+		require.Error(t, claim(mainLedger, bad), "out-of-policy epoch must not be claimed")
+	}
+	forged := sign("forged", 8)
+	forged.Signature = append([]byte(nil), forged.Signature...)
+	forged.Signature[0] ^= 1
+	require.Error(t, claim(mainLedger, forged))
+	require.Error(t, claimV39DurableTestOwnerPermit(mainLedger, manifest, sign("wrong-key", 8),
+		make(ed25519.PublicKey, ed25519.PublicKeySize), 7, 8))
+	require.NoError(t, claim(mainLedger, sign("second", 8)))
+	require.Error(t, claim(mainLedger, sign("epoch-fenced", 7)))
+
+	t.Run("concurrent independent processes accept at most one", func(t *testing.T) {
+		dir := provision("concurrent")
+		cfg, err := json.Marshal(v39ChildClaim{dir, manifest, sign("racing-claim", 7), pub})
+		require.NoError(t, err)
+		self, err := os.Executable()
+		require.NoError(t, err)
+		var wg sync.WaitGroup
+		results := make(chan string, 2)
+		for i := 0; i < 2; i++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				cmd := exec.Command(self, "-test.run=^TestC1V39DurableTestPermitAndAuthenticatedPublication$")
+				cmd.Env = append(os.Environ(), "VIRKI_V39_CHILD=claim",
+					"VIRKI_V39_CLAIM="+base64.StdEncoding.EncodeToString(cfg))
+				out, err := cmd.CombinedOutput()
+				results <- fmt.Sprintf("err=%v out=%s", err, out)
+			}()
+		}
+		wg.Wait()
+		close(results)
+		accepted := 0
+		rejected := 0
+		for result := range results {
+			require.Contains(t, result, "err=<nil>", result)
+			if strings.Contains(result, "V39_CLAIM_ACCEPTED") {
+				accepted++
+			}
+			if strings.Contains(result, "V39_CLAIM_REJECTED") {
+				rejected++
+			}
+		}
+		require.Equal(t, 1, accepted, "flock must serialize independent claims")
+		require.Equal(t, 1, rejected)
+		require.Error(t, claim(dir, sign("racing-claim", 7)), "claim must remain consumed after children exit")
+	})
+
+	t.Run("malformed, insecure, or missing ledger always refuses", func(t *testing.T) {
+		dir := provision("untrusted")
+		file := ledgerFile(dir)
+		bad := sign("safety", 7)
+		require.NoError(t, os.WriteFile(file, []byte("V39 7 abc"), 0600))
+		require.Error(t, claim(dir, bad), "interrupted append without LF is terminal")
+		require.NoError(t, os.WriteFile(file, []byte("V39 7 "+strings.Repeat("z", 64)+"\n"), 0600))
+		require.Error(t, claim(dir, bad), "malformed hash cannot silently reset replay floor")
+		require.NoError(t, os.WriteFile(file, nil, 0600))
+		require.NoError(t, os.Chmod(file, 0644))
+		require.Error(t, claim(dir, bad), "world-readable ledger forbidden")
+		require.NoError(t, os.Chmod(file, 0600))
+		require.NoError(t, os.Link(file, filepath.Join(dir, "linked")))
+		require.Error(t, claim(dir, bad), "hardlink alias forbidden")
+		require.NoError(t, os.Remove(filepath.Join(dir, "linked")))
+		require.NoError(t, os.WriteFile(file, bytes.Repeat([]byte("x"), v39LedgerMaxBytes+1), 0600))
+		require.Error(t, claim(dir, bad), "oversize ledger forbidden")
+		require.NoError(t, os.Remove(file))
+		require.Error(t, claim(dir, bad), "missing ledger must not be recreated empty")
+		require.NoError(t, os.Symlink("/dev/null", file))
+		require.Error(t, claim(dir, bad), "symlink ledger forbidden")
+		require.NoError(t, os.Remove(file))
+		require.NoError(t, os.Chmod(dir, 0777))
+		require.Error(t, claim(dir, bad), "directory authority must be root-owned private")
+	})
+
+	t.Run("ambiguous fsync consumes or fails closed", func(t *testing.T) {
+		dir := provision("failed-fsync")
+		bad := sign("fault-claim", 7)
+		reached := false
+		err := claimV39DurableTestOwnerPermitWithSync(dir, manifest, bad, pub, 7, 8, func(fd int) error {
+			reached = true
+			return unix.EIO
+		})
+		require.True(t, reached)
+		require.ErrorContains(t, err, "ambiguous claim file fsync")
+		require.Error(t, claim(dir, bad), "no successful publication after uncertain claim write")
+	})
+
+	t.Run("authentic peer is admitted only after durable claim", func(t *testing.T) {
+		dir := provision("publish-ledger")
+		private := filepath.Join(base, "protected")
+		source := filepath.Join(base, "source")
+		require.NoError(t, os.Mkdir(private, 0700))
+		require.NoError(t, os.Mkdir(source, 0700))
+		require.NoError(t, os.Chown(source, int(uid), int(uid)))
+		require.NoError(t, os.WriteFile(filepath.Join(source, "app.js"), []byte("SAFE"), 0600))
+		require.NoError(t, os.Chown(filepath.Join(source, "app.js"), int(uid), int(uid)))
+		// This preaccept refusal cannot read even a malformed peer connection:
+		// no FD is consumed, no destination is touched, and no permit is claimed.
+		dest := filepath.Join(private, "published")
+		unauthorized := sign("unauthorized", 7)
+		unauthorized.Signature = []byte("fake")
+		require.Error(t, publishV39FromAuthorizedTestPeer(dir, &net.UnixConn{}, 42, uid, uid,
+			dest, manifest, unauthorized, pub, 7, 8))
+		_, err := os.Lstat(dest)
+		require.ErrorIs(t, err, os.ErrNotExist)
+
+		self, err := os.Executable()
+		require.NoError(t, err)
+		input, err := os.Open(self)
+		require.NoError(t, err)
+		defer input.Close()
+		helper := filepath.Join(base, "helper")
+		output, err := os.OpenFile(helper, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0555)
+		require.NoError(t, err)
+		_, err = io.Copy(output, input)
+		require.NoError(t, err)
+		require.NoError(t, output.Close())
+		require.NoError(t, os.Chmod(helper, 0555))
+		sock := filepath.Join(base, "test.sock")
+		listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: sock, Net: "unix"})
+		require.NoError(t, err)
+		defer listener.Close()
+		require.NoError(t, os.Chown(sock, 0, int(uid)))
+		require.NoError(t, os.Chmod(sock, 0660))
+		cmd := exec.Command(helper, "-test.run=^TestC1V39DurableTestPermitAndAuthenticatedPublication$")
+		cmd.Env = append(os.Environ(), "VIRKI_V39_CHILD=sender",
+			"VIRKI_V39_SOURCE="+source, "VIRKI_V39_SOCKET="+sock)
+		cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{
+			Uid: uid, Gid: uid, Groups: []uint32{},
+		}}
+		require.NoError(t, cmd.Start())
+		t.Cleanup(func() {
+			if cmd.ProcessState == nil {
+				_ = cmd.Process.Kill()
+				_ = cmd.Wait()
+			}
+		})
+		require.NoError(t, listener.SetDeadline(time.Now().Add(5*time.Second)))
+		conn, err := listener.AcceptUnix()
+		require.NoError(t, err)
+		defer conn.Close()
+		permit := sign("published-once", 7)
+		require.NoError(t, publishV39FromAuthorizedTestPeer(dir, conn, cmd.Process.Pid,
+			uid, uid, dest, manifest, permit, pub, 7, 8))
+		require.NoError(t, cmd.Wait())
+		got, err := os.ReadFile(filepath.Join(dest, "app.js"))
+		require.NoError(t, err)
+		require.Equal(t, []byte("SAFE"), got)
+		require.ErrorContains(t, publishV39FromAuthorizedTestPeer(dir, &net.UnixConn{},
+			cmd.Process.Pid, uid, uid, filepath.Join(private, "replayed"),
+			manifest, permit, pub, 7, 8), "replayed")
+		_, err = os.Lstat(filepath.Join(private, "replayed"))
+		require.ErrorIs(t, err, os.ErrNotExist)
+	})
+}
