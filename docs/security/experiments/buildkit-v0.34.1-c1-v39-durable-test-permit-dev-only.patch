@@ -0,0 +1,177 @@
+//go:build linux
+
+package filesync
+
+import (
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const v39LedgerMaxBytes = 1024 * 1024
+
+// claimV39DurableTestOwnerPermit reserves a TEST-DOMAIN V15 signed owner
+// permit BEFORE accepting any descriptor/network bytes. The ledger file must
+// be provisioned and durably synced by a trusted root supervisor BEFORE the
+// broker is available; its absence is a terminal refusal, never an empty
+// auto-created replay history. The public key,
+// manifest, epoch floor and ledger directory must be supplied by a distinct
+// trusted supervisor, never by the untrusted sender. This is an UNWIRED DEV
+// reference, not actual C4 owner signing/rollout authorization.
+func claimV39DurableTestOwnerPermit(ledgerDir string, m V15SealedManifest, p V15OwnerPermit,
+	trustedPub ed25519.PublicKey, minimumEpoch, maximumEpoch uint64) error {
+	return claimV39DurableTestOwnerPermitWithSync(ledgerDir, m, p, trustedPub,
+		minimumEpoch, maximumEpoch, unix.Fsync)
+}
+
+// withSync is a private deterministic fault injection seam. The normal
+// entrypoint above always uses the real Linux fsync syscall.
+func claimV39DurableTestOwnerPermitWithSync(ledgerDir string, m V15SealedManifest, p V15OwnerPermit,
+	trustedPub ed25519.PublicKey, minimumEpoch, maximumEpoch uint64, syncFile func(int) error) error {
+	if os.Getuid() != 0 || os.Geteuid() != 0 || minimumEpoch == 0 ||
+		maximumEpoch < minimumEpoch || p.Epoch > maximumEpoch || syncFile == nil ||
+		!filepath.IsAbs(ledgerDir) || filepath.Clean(ledgerDir) != ledgerDir || ledgerDir == "/" {
+		return errors.New("C1 V39 requires trusted root-owned canonical ledger and positive owner epoch floor")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	defer unix.Close(rootFD)
+	if err := validateV24TrustedSupervisorAncestors(rootFD, ledgerDir); err != nil {
+		return fmt.Errorf("C1 V39 ledger ancestor untrusted: %w", err)
+	}
+	parentFD, err := unix.Openat2(rootFD, strings.TrimPrefix(ledgerDir, "/"), &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_XDEV,
+	})
+	if err != nil {
+		return err
+	}
+	defer unix.Close(parentFD)
+	var parentStat unix.Stat_t
+	if err := unix.Fstat(parentFD, &parentStat); err != nil {
+		return err
+	}
+	if parentStat.Mode&unix.S_IFMT != unix.S_IFDIR || parentStat.Uid != 0 ||
+		parentStat.Gid != 0 || parentStat.Mode&07777 != 0700 {
+		return errors.New("C1 V39 durable ledger parent must be trusted root:root 0700")
+	}
+	fd, err := unix.Openat(parentFD, ".virki-v39-claims",
+		unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return err
+	}
+	f := os.NewFile(uintptr(fd), "v39-claims")
+	defer f.Close()
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG || st.Uid != 0 || st.Gid != 0 ||
+		st.Mode&07777 != 0600 || st.Nlink != 1 || st.Size > v39LedgerMaxBytes {
+		return errors.New("C1 V39 claim ledger has untrusted metadata or exceeded bounded size")
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		if err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err == nil {
+			break
+		} else if !errors.Is(err, unix.EWOULDBLOCK) || time.Now().After(deadline) {
+			return fmt.Errorf("C1 V39 exclusive durable claim lock unavailable: %w", err)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	defer unix.Flock(fd, unix.LOCK_UN)
+	if _, err := f.Seek(0, io.SeekStart); err != nil {
+		return err
+	}
+	data, err := io.ReadAll(io.LimitReader(f, v39LedgerMaxBytes+1))
+	if err != nil || len(data) > v39LedgerMaxBytes {
+		return errors.New("C1 V39 durable claim log malformed or unbounded")
+	}
+	floor := minimumEpoch
+	claims := make(map[string]struct{})
+	if len(data) > 0 {
+		if data[len(data)-1] != '\n' {
+			return errors.New("C1 V39 incomplete persistent claim record; manual review required")
+		}
+		for _, line := range strings.Split(strings.TrimSuffix(string(data), "\n"), "\n") {
+			fields := strings.Split(line, " ")
+			if len(fields) != 3 || fields[0] != "V39" || len(fields[2]) != 64 {
+				return errors.New("C1 V39 malformed persistent claim record")
+			}
+			epoch, err := strconv.ParseUint(fields[1], 10, 64)
+			if err != nil || epoch == 0 {
+				return errors.New("C1 V39 invalid persistent epoch")
+			}
+			keyBytes, err := hex.DecodeString(fields[2])
+			if err != nil || len(keyBytes) != sha256.Size {
+				return errors.New("C1 V39 invalid persistent claim key")
+			}
+			if _, exists := claims[fields[2]]; exists {
+				return errors.New("C1 V39 duplicated persistent claim key")
+			}
+			claims[fields[2]] = struct{}{}
+			if epoch > floor {
+				floor = epoch
+			}
+		}
+	}
+	// Reuse existing signed-permit validation/expiry checks, but never rely on
+	// its volatile map for replay; that is enforced by the fsynced root ledger.
+	if err := NewV15LocalReplayLedger(floor).VerifyAndClaim(m, p, trustedPub); err != nil {
+		return fmt.Errorf("C1 V39 signed owner permit refused: %w", err)
+	}
+	hash := sha256.Sum256([]byte(fmt.Sprintf("%s\x00%d\x00%s", V15OwnerDomain, p.Epoch, p.ApprovalID)))
+	key := hex.EncodeToString(hash[:])
+	if _, exists := claims[key]; exists {
+		return errors.New("C1 V39 signed owner permit replayed after restart or concurrent claim")
+	}
+	row := fmt.Sprintf("V39 %d %s\n", p.Epoch, key)
+	if len(data)+len(row) > v39LedgerMaxBytes {
+		return errors.New("C1 V39 durable ledger full; refuse until independent operator migration")
+	}
+	if _, err := f.Seek(0, io.SeekEnd); err != nil {
+		return err
+	}
+	if n, err := f.Write([]byte(row)); err != nil || n != len(row) {
+		return errors.New("C1 V39 ambiguous claim write; never publish")
+	}
+	if err := syncFile(fd); err != nil {
+		return fmt.Errorf("C1 V39 ambiguous claim file fsync; never publish: %w", err)
+	}
+	if err := unix.Fsync(parentFD); err != nil {
+		return fmt.Errorf("C1 V39 ambiguous ledger parent fsync; never publish: %w", err)
+	}
+	return nil
+}
+
+// publishV39FromAuthorizedTestPeer is an UNWIRED, synthetic test composition:
+// the independently trusted V15 test permit is claimed and made durable
+// BEFORE any SCM_RIGHTS receive, source read, or publication side effect.
+// Even if a later handoff or publish fails, the permit is consumed. The
+// real C4 approval, operational receiver identity and crash-recovery state
+// machine DO NOT exist here. Do not connect this to a production RPC.
+func publishV39FromAuthorizedTestPeer(ledgerDir string, conn *net.UnixConn,
+	expectedPID int, expectedUID, expectedGID uint32, dest string,
+	manifest V15SealedManifest, permit V15OwnerPermit,
+	trustedPub ed25519.PublicKey, minimumEpoch, maximumEpoch uint64) error {
+	if conn == nil || expectedPID <= 1 || expectedUID == 0 || expectedGID == 0 {
+		return errors.New("C1 V39 requires a preaccepted peer and trusted nonroot identity")
+	}
+	if err := claimV39DurableTestOwnerPermit(ledgerDir, manifest, permit, trustedPub, minimumEpoch, maximumEpoch); err != nil {
+		return fmt.Errorf("C1 V39 refused publication before descriptor admission: %w", err)
+	}
+	return publishV37FromAuthenticatedPeer(conn, expectedPID, expectedUID, expectedGID, dest, manifest)
+}
