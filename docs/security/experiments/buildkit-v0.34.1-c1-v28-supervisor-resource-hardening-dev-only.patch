+func TestC1V28IndependentCustodyPolicyRefusals(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("unprivileged independent custody policy test requires non-root euid")
+	}
+	uid := uint32(os.Geteuid())
+	gid := uint32(os.Getegid())
+	peer := uid + 1
+
+	base := t.TempDir()
+	require.NoError(t, os.Chmod(base, 0700))
+	dest := filepath.Join(base, "published")
+	privateTmp := filepath.Join(base, "tmp")
+	require.NoError(t, os.Mkdir(privateTmp, 0700))
+	t.Setenv("TMPDIR", privateTmp)
+
+	require.ErrorContains(t, validateV24IndependentCustody(dest, V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &gid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		PrivateTempDir:              privateTmp,
+	}), "explicit distinct sender ownership")
+
+	require.ErrorContains(t, validateV24IndependentCustody(dest, V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &gid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		ExpectedSenderUID:           &uid,
+		ExpectedSenderGID:           &peer,
+		PrivateTempDir:              privateTmp,
+	}), "explicit distinct sender ownership")
+
+	require.ErrorContains(t, validateV24IndependentCustody(filepath.Join(privateTmp, "published"), V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &gid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		ExpectedSenderUID:           &peer,
+		ExpectedSenderGID:           &peer,
+		PrivateTempDir:              privateTmp,
+	}), "PrivateTempDir distinct from destination custody parent")
+
+	require.ErrorContains(t, validateV24IndependentCustody(filepath.Join(privateTmp, "nested", "published"), V24ReceiverCustodyPolicy{
+		RequireUnprivileged:         true,
+		RequirePrivateParent:        true,
+		RequireImmutableGrandparent: true,
+		ExpectedReceiverUID:         &uid,
+		ExpectedReceiverGID:         &gid,
+		ForbiddenPeerUIDs:           []uint32{peer},
+		ExpectedSenderUID:           &peer,
+		ExpectedSenderGID:           &peer,
+		PrivateTempDir:              privateTmp,
+	}), "PrivateTempDir distinct from destination custody parent")
+}
