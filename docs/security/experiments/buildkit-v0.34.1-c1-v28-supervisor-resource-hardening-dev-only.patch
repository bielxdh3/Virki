+func TestC1V28LauncherResourceAndIdentityRefusals(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("unprivileged launcher refusal test requires non-root euid")
+	}
+	t.Setenv("TMPDIR", "/tmp")
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0700))
+
+	helper := filepath.Join(dir, "helper")
+	require.NoError(t, os.WriteFile(helper, []byte("#!/bin/sh\n"), 0700))
+	symlinkHelper := filepath.Join(dir, "helper-link")
+	require.NoError(t, os.Symlink(helper, symlinkHelper))
+
+	writableHelper := filepath.Join(dir, "helper-writable")
+	require.NoError(t, os.WriteFile(writableHelper, []byte("#!/bin/sh\n"), 0755))
+	require.NoError(t, os.Chmod(writableHelper, 0775))
+
+	privateTmp := filepath.Join(dir, "tmp")
+	require.NoError(t, os.Mkdir(privateTmp, 0700))
+	publicTmp := filepath.Join(dir, "public-tmp")
+	require.NoError(t, os.Mkdir(publicTmp, 0755))
+	symlinkTmp := filepath.Join(dir, "link-tmp")
+	require.NoError(t, os.Symlink(privateTmp, symlinkTmp))
+
+	uid := uint32(os.Geteuid())
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+
+	_, err := runV24IsolatedSubprocessWithFiles(ctx, symlinkHelper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      privateTmp,
+	}, nil)
+	require.ErrorContains(t, err, "must be non-symlink regular file")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, writableHelper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      privateTmp,
+	}, nil)
+	require.ErrorContains(t, err, "must not be group/world writable")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      privateTmp,
+	}, []*os.File{nil})
+	require.ErrorContains(t, err, "refuses nil inherited file")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		ExpectedReceiverUID: &uid,
+		ExpectedSenderUID:   &uid,
+		PrivateTempDir:      privateTmp,
+	}, nil)
+	require.ErrorContains(t, err, "refuses identical receiver and sender UID")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      publicTmp,
+	}, nil)
+	require.ErrorContains(t, err, "real 0700 private temporary directory")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      symlinkTmp,
+	}, nil)
+	require.ErrorContains(t, err, "real 0700 private temporary directory")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      privateTmp,
+	}, nil, "TMPDIR=/tmp")
+	require.ErrorContains(t, err, "refuses unsafe env override")
+
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		PrivateTempDir:      privateTmp,
+	}, nil, "LD_PRELOAD=/tmp/evil.so")
+	require.ErrorContains(t, err, "refuses unsafe env override")
+
+	wrongGID := uint32(os.Getegid()) + 1
+	_, err = runV24IsolatedSubprocessWithFiles(ctx, helper, nil, V24ReceiverCustodyPolicy{
+		RequireUnprivileged: true,
+		ExpectedReceiverUID: &uid,
+		ExpectedReceiverGID: &wrongGID,
+		PrivateTempDir:      privateTmp,
+	}, nil)
+	require.ErrorContains(t, err, "receiver GID")
+}
