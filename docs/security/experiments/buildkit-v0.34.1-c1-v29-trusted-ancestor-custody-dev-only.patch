+func TestC1V29SupervisorAncestorChainRejectsUntrustedPaths(t *testing.T) {
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	require.NoError(t, err)
+	defer unix.Close(rootFD)
+	require.NoError(t, validateV24TrustedSupervisorAncestors(rootFD, "/"))
+	require.NoError(t, validateV24TrustedSupervisorAncestors(rootFD, "/tmp"))
+
+	// Restricting only the grandparent inode is insufficient: an untrusted
+	// ancestor can rename the supposedly trusted root-owned grandparent.
+	untrusted := t.TempDir()
+	child := filepath.Join(untrusted, "child")
+	require.NoError(t, os.Mkdir(child, 0700))
+	require.ErrorContains(t,
+		validateV24TrustedSupervisorAncestors(rootFD, child),
+		"not root-owned and protected from untrusted rename")
+
+	link := filepath.Join(untrusted, "symlink")
+	require.NoError(t, os.Symlink("/tmp", link))
+	require.Error(t, validateV24TrustedSupervisorAncestors(rootFD, link))
+}
+
+func TestC1V29SupervisorAncestorRejectsWritableRootPath(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("root-supervised, synthetic negative ancestor fixture")
+	}
+	rootFD, err := unix.Open("/", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	require.NoError(t, err)
+	defer unix.Close(rootFD)
+	base, err := os.MkdirTemp("/tmp", "virki-v29-ancestor-")
+	require.NoError(t, err)
+	defer os.RemoveAll(base)
+	child := filepath.Join(base, "root-controlled-child")
+	require.NoError(t, os.Mkdir(child, 0700))
+	require.NoError(t, os.Chmod(base, 0777))
+	require.ErrorContains(t, validateV24TrustedSupervisorAncestors(rootFD, child),
+		"not root-owned and protected from untrusted rename")
+	// Sticky root-owned ancestors protect root-owned children in /tmp-like
+	// namespaces; ordinary writable ancestors do not.
+	require.NoError(t, os.Chmod(base, 0777|os.ModeSticky))
+	require.NoError(t, validateV24TrustedSupervisorAncestors(rootFD, child))
+}
