+// validateV24TrustedSupervisorAncestors verifies the WHOLE ancestor chain of
+// the root-owned grandparent, not merely its immediate inode. Otherwise an
+// attacker can rename a root-owned grandparent from a writable untrusted
+// ancestor and redirect a later pathname-based lookup. A root-owned sticky
+// directory (for example /tmp) protects its root-owned child from rename by
+// unprivileged users; a non-sticky group/world-writable ancestor does not.
+// This deliberately refuses user-owned ancestors even if mode 0700: the
+// trusted receiver UID could otherwise rename a root-owned child there.
+func validateV24TrustedSupervisorAncestors(rootFD int, grandparent string) error {
+	if !filepath.IsAbs(grandparent) || filepath.Clean(grandparent) != grandparent {
+		return errors.New("C1 V24 supervisor ancestor must be canonical absolute path")
+	}
+	currentFD := rootFD
+	var rootStat unix.Stat_t
+	if err := unix.Fstat(currentFD, &rootStat); err != nil {
+		return err
+	}
+	validate := func(st unix.Stat_t) error {
+		if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != 0 ||
+			(st.Mode&0022 != 0 && st.Mode&unix.S_ISVTX == 0) {
+			return errors.New("C1 V24 supervisor ancestor is not root-owned and protected from untrusted rename")
+		}
+		return nil
+	}
+	if err := validate(rootStat); err != nil {
+		return err
+	}
+	if grandparent == "/" {
+		return nil
+	}
+	for _, component := range strings.Split(strings.TrimPrefix(grandparent, "/"), "/") {
+		fd, err := unix.Openat2(currentFD, component, &unix.OpenHow{
+			Flags:   uint64(unix.O_PATH | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_SYMLINKS | unix.RESOLVE_NO_MAGICLINKS,
+		})
+		if err != nil {
+			if currentFD != rootFD {
+				_ = unix.Close(currentFD)
+			}
+			return fmt.Errorf("C1 V24 supervisor ancestor resolution refused: %w", err)
+		}
+		var stat unix.Stat_t
+		statErr := unix.Fstat(fd, &stat)
+		if statErr == nil {
+			statErr = validate(stat)
+		}
+		if currentFD != rootFD {
+			_ = unix.Close(currentFD)
+		}
+		if statErr != nil {
+			_ = unix.Close(fd)
+			return statErr
+		}
+		currentFD = fd
+	}
+	if currentFD != rootFD {
+		return unix.Close(currentFD)
+	}
+	return nil
+}
