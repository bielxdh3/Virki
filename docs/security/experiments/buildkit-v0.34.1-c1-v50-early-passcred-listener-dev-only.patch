+// socket path is opened to any sender. Linux SCM_CREDENTIALS is selected when
+// the sender queues the rights message, not retroactively at ReadMsgUnix.
+// Merely enabling SO_PASSCRED on the accepted socket after the message was
+// sent caused a legitimate positive handoff to fail on native Ubuntu CI.
+func v50ArmPasscredBeforeAccept(listener *net.UnixListener) error {
+	if listener == nil {
+		return errors.New("C1 V50 requires a protected Unix stream listener")
+	}
+	raw, err := listener.SyscallConn()
+	if err != nil {
+		return fmt.Errorf("C1 V50 cannot inspect listener: %w", err)
+	}
+	var enableErr error
+	if err := raw.Control(func(fd uintptr) {
+		enableErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_PASSCRED, 1)
+	}); err != nil || enableErr != nil {
+		return fmt.Errorf("C1 V50 cannot arm passcred before accept: %w", errors.Join(err, enableErr))
+	}
+	return nil
+}
