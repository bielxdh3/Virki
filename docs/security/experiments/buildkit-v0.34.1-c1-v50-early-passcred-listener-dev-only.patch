diff --git a/session/filesync/sealed_publication_listener_v50_linux_test.go b/session/filesync/sealed_publication_listener_v50_linux_test.go
new file mode 100644
index 0000000..f1654de
--- /dev/null
+++ b/session/filesync/sealed_publication_listener_v50_linux_test.go
@@ -0,0 +1,28 @@
+//go:build linux
+
+package filesync
+
+import (
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// A passcred option enabled only after AcceptUnix is too late when SCM_RIGHTS
+// has already been queued; GitHub's native Ubuntu kernel reproduced this
+// false refusal, whereas WSL supplied credentials to the late receiver.
+// This invariant must be checked BEFORE the receiver can touch the socket.
+func v50AssertPasscredPrearmed(t *testing.T, conn *net.UnixConn) {
+	t.Helper()
+	raw, err := conn.SyscallConn()
+	require.NoError(t, err)
+	var value int
+	var socketErr error
+	require.NoError(t, raw.Control(func(fd uintptr) {
+		value, socketErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_PASSCRED)
+	}))
+	require.NoError(t, socketErr)
+	require.Equal(t, 1, value, "trusted broker must arm SO_PASSCRED on the LISTENER before accepting an untrusted peer")
+}
