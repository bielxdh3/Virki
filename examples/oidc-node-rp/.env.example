# Use an EXACT HTTPS origin / callback approved on the confidential Virki connection.
RP_ORIGIN=https://localhost:8443
RP_TLS_CERT_FILE=./certs/localhost.pem
RP_TLS_KEY_FILE=./certs/localhost-key.pem
OIDC_ISSUER=https://portal.example.invalid
OIDC_CLIENT_ID=replace_with_registered_client_id
OIDC_CLIENT_SECRET=replace-with-local-secret
OIDC_REDIRECT_URI=https://localhost:8443/oidc/callback

# RP-owned disposable PostgreSQL database: never use the issuer's database.
RP_DATABASE_URL=postgresql://rp_example:replace-with-local-secret@127.0.0.1:5432/rp_example
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RP_ENCRYPTION_KEY_HEX=replace_with_64_random_hex_characters
RP_REVOKE_ON_LOGOUT=true
